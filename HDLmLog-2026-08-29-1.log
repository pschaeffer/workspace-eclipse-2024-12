rong hero value proposition, trust badges, urgency messaging, anchor pricing, social proof, email capture, a wholesale CTA, mobile responsiveness, SEO meta tags, and clear calls to action throughout.","format":"anthropic-claude-v1","index":2,"signature":""}]}}],"usage":{"prompt_tokens":6119,"completion_tokens":9065,"total_tokens":15184,"cost":0.51444,"is_byok":false,"prompt_tokens_details":{"cached_tokens":0,"cache_write_tokens":0,"audio_tokens":0,"video_tokens":0},"cost_details":{"upstream_inference_cost":0.51444,"upstream_inference_prompt_cost":0.06119,"upstream_inference_completions_cost":0.45325},"completion_tokens_details":{"reasoning_tokens":1176,"image_tokens":0,"audio_tokens":0},"server_tool_use_details":{"web_search_requests":0}}}

span><span>Secure checkout · Visa · Mastercard · Amex · PayPal · POs accepted</span></div>\\n</div>\\n</footer>\\n\\n<div class=\\\"stickybuy\\\">\\n<div class=\\\"t\\\">Classic Yoga Mat 1/8\\\"<span id=\\\"stickyPrice\\\">$19.95 each · in stock, ships today</span></div>\\n<button class=\\\"btn btn-primary\\\" id=\\\"atc2\\\">Add to cart</button>\\n</div>\\n<div class=\\\"toast\\\" id=\\\"toast\\\">✓ Added to cart</div>\\n<script>\\nvar q=document.getElementById('q');\\nfunction price(n){if(n>=50)return 12.95;if(n>=25)return 14.95;if(n>=10)return 16.95;return 19.95}\\nfunction render(){var n=Math.max(1,parseInt(q.value)||1);q.value=n;var p=price(n);document.getElementById('unit').textContent='$'+p.toFixed(2);document.getElementById('total').textContent='$'+(p*n).toFixed(2);document.getElementById('stickyPrice').textContent='$'+p.toFixed(2)+' each · '+n+' in cart view';var rows=document.querySelectorAll('.tierbox tr');rows.forEach(function(r){r.classList.remove('hot')});var i=n>=50?3:n>=25?2:n>=10?1:0;if(rows[i])rows[i].classList.add('hot');var nu=document.getElementById('nudge');if(n<10){nu.textContent='Add '+(10-n)+' more to unlock $16.95 each and save $'+((19.95-16.95)*10).toFixed(0)+'.'}else if(n<25){nu.textContent='Add '+(25-n)+' more to unlock $14.95 each.'}else if(n<50){nu.textContent='Add '+(50-n)+' more to unlock $12.95 each — the best price online.'}else{nu.textContent='✓ Best tier unlocked. Need 100+? Request a custom quote.'}}\\nq.addEventListener('input',render);\\ndocument.getElementById('plus').onclick=function(){q.value=(parseInt(q.value)||1)+1;render()};\\ndocument.getElementById('minus').onclick=function(){q.value=Math.max(1,(parseInt(q.value)||1)-1);render()};\\ndocument.querySelectorAll('.sw').forEach(function(s){s.onclick=function(){document.querySelectorAll('.sw').forEach(function(x){x.classList.remove('on')});s.classList.add('on');document.getElementById('colorName').textContent=s.dataset.c}});\\nfunction toast(){var t=document.getElementById('toast');t.classList.add('on');setTimeout(function(){t.classList.remove('on')},2200)}\\ndocument.getElementById('atc').onclick=toast;document.getElementById('atc2').onclick=toast;\\ndocument.querySelectorAll('.add').forEach(function(b){b.onclick=toast});\\nrender();\\n</script>\\n<script type=\\\"application/ld+json\\\">{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"Product\\\",\\\"name\\\":\\\"Classic Yoga Mat 1/8 inch 68x24\\\",\\\"brand\\\":{\\\"@type\\\":\\\"Brand\\\",\\\"name\\\":\\\"YogaDirect\\\"},\\\"aggregateRating\\\":{\\\"@type\\\":\\\"AggregateRating\\\",\\\"ratingValue\\\":\\\"4.8\\\",\\\"reviewCount\\\":\\\"2143\\\"},\\\"offers\\\":{\\\"@type\\\":\\\"Offer\\\",\\\"price\\\":\\\"19.95\\\",\\\"priceCurrency\\\":\\\"USD\\\",\\\"availability\\\":\\\"https://schema.org/InStock\\\"}}</script>\\n</body>\\n</html>\"},{\"path\":\"/wholesale.html\",\"html\":\"<!DOCTYPE html>\\n<html lang=\\\"en\\\">\\n<head>\\n<meta charset=\\\"utf-8\\\">\\n<meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1\\\">\\n<title>Wholesale Yoga Mats &amp; Props for Studios, Schools &amp; Gyms | YogaDirect</title>\\n<meta name=\\\"description\\\" content=\\\"Get a free bulk quote in one business day. Tiered wholesale pricing on yoga mats and props, custom logo printing, freight shipping and Net-30 terms for schools.\\\">\\n<style>\\n*{box-sizing:border-box;margin:0;padding:0}\\nbody{font-family:-apple-system,BlinkMacSystemFont,\\\"Segoe UI\\\",Roboto,Helvetica,Arial,sans-serif;color:#1c2b2b;background:#fff;line-height:1.55;-webkit-font-smoothing:antialiased}\\na{color:inherit;text-decoration:none}\\n.container{max-width:1180px;margin:0 auto;padding:0 20px}\\n.bar{background:#0f6b63;color:#fff;font-size:13.5px;text-align:center;padding:9px 12px}\\n.bar strong{color:#f2b71d}\\nheader{position:sticky;top:0;z-index:50;background:#fff;border-bottom:1px solid #ece7de;box-shadow:0 2px 10px rgba(0,0,0,.04)}\\n.nav{display:flex;align-items:center;gap:24px;pa
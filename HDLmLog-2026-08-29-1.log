px;color:#4b5b59}\\nfooter{background:#12201f;color:#cfd8d6;padding:44px 0 22px;font-size:14.5px}\\n.fgrid{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:30px;margin-bottom:26px}\\nfooter h4{color:#fff;font-size:15px;margin-bottom:12px}\\nfooter ul{list-style:none}\\nfooter li{padding:4px 0}\\n.fbot{border-top:1px solid #263735;padding-top:16px;font-size:13px;color:#8d9b99;display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px}\\n@media(max-width:960px){.hero-grid,.grid3,.revs{grid-template-columns:1fr}.nav ul{display:none}.fgrid{grid-template-columns:1fr 1fr}h1{font-size:32px}}\\n</style>\\n</head>\\n<body>\\n<div class=\\\"bar\\\">📦 <strong>Free bulk quotes in 1 business day</strong> &nbsp;·&nbsp; Net-30 for schools &amp; government &nbsp;·&nbsp; Custom logo printing available</div>\\n<header>\\n<div class=\\\"container nav\\\">\\n<a class=\\\"logo\\\" href=\\\"/index.html\\\">Yoga<span>Direct</span></a>\\n<ul>\\n<li><a href=\\\"/shop.html\\\">Mats</a></li>\\n<li><a href=\\\"/shop.html\\\">Props</a></li>\\n<li><a href=\\\"/shop.html\\\">Studio Packs</a></li>\\n<li><a href=\\\"/wholesale.html\\\">Wholesale</a></li>\\n<li><a href=\\\"/contact.html\\\">Contact</a></li>\\n</ul>\\n<div class=\\\"spacer\\\"></div>\\n<div class=\\\"navcta\\\">\\n<a class=\\\"phone\\\" href=\\\"tel:18005551234\\\">(800) 555-1234<small>Mon–Fri 9–5 PT</small></a>\\n<a class=\\\"btn btn-primary btn-sm\\\" href=\\\"#quote\\\">Get my quote</a>\\n</div>\\n</div>\\n</header>\\n\\n<section class=\\\"hero\\\">\\n<div class=\\\"container hero-grid\\\">\\n<div>\\n<span class=\\\"eyebrow\\\">Wholesale &amp; bulk · Studios, schools, gyms, hotels, therapists</span>\\n<h1>Outfit your whole floor for less — quote back in 1 business day.</h1>\\n<p class=\\\"lead\\\">We manufacture and source our own mats and props, so you buy at the source. No membership fees, no annual minimums, no reseller license required.</p>\\n<ul class=\\\"checks\\\">\\n<li>Save up to 45% vs. retail with automa
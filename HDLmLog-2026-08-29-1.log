px;max-width:34em;color:#dff0ea}\\n.email form{display:flex;gap:10px;max-width:470px;margin:0 auto;flex-wrap:wrap}\\n.email .field{margin:0;flex:1;min-width:220px}\\ndetails{border:1px solid var(--line);border-radius:12px;padding:14px 18px;margin-bottom:10px;background:#fff}\\nsummary{font-weight:700;cursor:pointer}\\ndetails p{color:var(--muted);margin:10px 0 0}\\nfooter.site{background:#17211f;color:#c8d2cf;padding:46px 0 90px;font-size:14.5px}\\n.fcols{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:28px}\\nfooter h4{color:#fff;font-size:14px;text-transform:uppercase;letter-spacing:1px;margin:0 0 12px}\\nfooter a{display:block;padding:4px 0}footer a:hover{color:#fff}\\n.fbot{border-top:1px solid #2c3936;margin-top:30px;padding-top:18px;display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap;font-size:13px}\\n.sticky{position:fixed;bottom:0;left:0;right:0;background:#fff;border-top:1px solid var(--line);padding:10px 14px;display:none;gap:10px;z-index:70;box-shadow:0 -6px 20px rgba(0,0,0,.08)}\\n.sticky .btn{flex:1;padding:12px}\\n@media(max-width:900px){.hero-in,.about-in,.bulk{grid-template-columns:1fr;gap:26px}.prods,.cats,.bundles,.revs{grid-template-columns:repeat(2,1fr)}.strip-in{grid-template-columns:repeat(2,1fr)}nav.main{display:none}h1{font-size:34px}.sec-head h2{font-size:27px}.fcols{grid-template-columns:1fr 1fr}.sticky{display:flex}.hide-sm{display:none}}\\n@media(max-width:560px){.prods,.cats,.bundles,.revs{grid-template-columns:1fr}.bulk{padding:24px}}\\n</style></head><body>\\n<div class=\\\"bar\\\">🚚 <b>Free shipping on orders $75+</b> &nbsp;·&nbsp; Studio &amp; bulk pricing on every prop &nbsp;·&nbsp; 60-day easy returns</div>\\n<header class=\\\"site\\\"><div class=\\\"wrap hd\\\"><a class=\\\"logo\\\" href=\\\"/\\\">Yoga<span>Direct</span><small>Direct from the maker · since 1999</small></a>\\n<nav class=\\\"main\\\"><a href=\\\"/shop\\\">Mats</a><a href=\\\"/shop\\\">Blocks &amp; Straps</a><a href=\\\"/shop\\\">Bolsters &amp; Blankets</a><a href=\\\"/shop\\\">Studio Packages</a><a href=\\\"/wholesale\\\">Bulk / Wholesale</a></nav>\\n<div class=\\\"hd-actions\\\"><a class=\\\"btn btn-o btn-sm hide-sm\\\" href=\\\"/wholesale\\\">Get bulk pricing</a><a class=\\\"btn btn-p btn-sm\\\" href=\\\"/shop\\\">Shop now</a></div></div></header>\\n\\n<div class=\\\"hero\\\"><div class=\\\"wrap hero-in\\\">\\n<div><span class=\\\"eyebrow\\\">Manufacturer-direct pricing</span>\\n<h1>Yoga mats &amp; props built for daily use — at prices studios love.</h1>\\n<p class=\\\"lead\\\">We make and source our own gear, so you skip the middleman markup. One of the country's largest suppliers of yoga mats and props, faithfully serving the yoga community since 1999.</p>\\n<ul class=\\\"ticks\\\"><li>Save up to 40% vs. retail brands</li><li>Automatic volume discounts — no account needed</li><li>Free shipping over $75 · Ships same day before 2pm ET</li><li>60-day returns, no restocking fees</li></ul>\\n<div class=\\\"cta-row\\\"><a class=\\\"btn btn-p\\\" href=\\\"#bestsellers\\\">Shop best sellers</a><a class=\\\"btn btn-o\\\" href=\\\"#bulk\\\">Get studio &amp; bulk pricing →</a></div>\\n<p class=\\\"hero-trust\\\"><span class=\\\"stars\\\">★★★★★</span> Rated 4.8/5 by yoga teachers, studios, schools and home practitioners nationwide.</p></div>\\n<div class=\\\"hero-card\\\"><h3>Need 10+ mats or props?</h3><p>Send a quick request and a real person emails you a quote (usually within one business day) with your best tiered price, freight included.</p>\\n<form onsubmit=\\\"alert('Thanks! Your quote request has been received — we\\\\u2019ll email your tiered pricing within 1 business day.');return false;\\\">\\n<input class=\\\"field\\\" placeholder=\\\"Your name\\\" required><input class=\\\"field\\\" type=\\\"email\\\" placeholder=\\\"Work email\\\" required><input class=\\\"field\\\" placeholder=\\\"Studio / school / organization\\\"><input class=\\\"field\\\" placeholder=\\\"What do you need? (e.g. 24 mats, 40 blocks)\\\" required><button class=\\\"btn btn-b\\\" style=\\\"width:100%\\\">Get my free quote</button></form>\\n<p class=\\\"mini\\\">No obligation. No spam. 25+ years of outfitting studios, gyms, schools, hotels &amp; events.</p></div>\\n</div></div>\\n\\n<div class=\\\"strip\\\"><div class=\\\"wrap strip-in\\\"><div><b>Since 1999</b>25+ years in yoga</div><div><b>We manufacture it</b>Factory-direct prices</div><div><b>Free shipping $75+</b>Fast US warehouses</div><div><b>60-day returns</b>Talk to real humans</div></div></div>\\n\\n<section><div class=\\\"wrap\\\"><div class=\\\"sec-head\\\"><h2>Shop by category</h2><p>Everything you need for a studio, an event, or your practice at home.</p></div>\\n<div class=\\\"cats\\\">\\n<a class=\\\"cat\\\" href=\\\"/shop\\\"><div class=\\\"ph\\\">🧘</div><div class=\\\"tx\\\"><h3>Yoga Mats</h3><p>Standard, extra-thick, eco-TPE, jute &amp; studio bulk rolls.</p><span class=\\\"from\\\">From $14.95 →</span></div></a>\\n<a class=\\\"cat\\\" href=\\\"/shop\\\"><div class=\\\"ph\\\">🧱</div><div class=\\\"tx\\\"><h3>Blocks &amp; Bricks</h3><p>Foam, cork and recycled blocks. Case pricing available.</p><span class=\\\"from\\\">From $5.95 →</span></div></a>\\n<a class=\\\"cat\\\" href=\\\"/shop\\\"><div class=\\\"ph\\\">🪢</div><div class=\\\"tx\\\"><h3>Straps &amp; Slings</h3><p>6ft, 8ft, 10ft cinch &amp; D-ring cotton straps.</p><span class=\\\"from\\\">From $4.50 →</span></div></a>\\n<a class=\\\"cat\\\" href=\\\"/shop\\\"><div class=\\\"ph\\\">🛏️</div><div class=\\\"tx\\\"><h3>Bolsters &amp; Blankets</h3><p>Restorative bolsters, Mexican-style blankets, eye pillows.</p><span class=\\\"from\\\">From $12.95 →</span></div></a>\\n<a class=\\\"cat\\\" href=\\\"/shop\\\"><div class=\\\"ph\\\">⭕</div><div class=\\\"tx\\\"><h3>Wheels &amp; Cushions</h3><p>Yoga wheels, zafus, zabutons and meditation seating.</p><span class=\\\"from\\\">From $19.95 →</span></div></a>\\n<a class=\\\"cat\\\" href=\\\"/wholesale\\\"><div class=\\\"ph\\\">📦</div><div class=\\\"tx\\\"><h3>Studio Packages</h3><p>Pre-built prop kits for 10, 20 or 30 students — save more.</p><span class=\\\"from\\\">Save up to 30% →</span></div></a>\\n</div></div></section>\\n\\n<section id=\\\"bestsellers\\\" style=\\\"padding-top:0\\\"><div class=\\\"wrap\\\"><div class=\\\"sec-head\\\"><h2>Customer best sellers</h2><p>The gear studios reorder again and again. Volume discounts apply automatically in cart.</p></div>\\n<div class=\\\"prods\\\">\\n<div class=\\\"prod\\\"><span class=\\\"tag\\\">Best seller</span><div class=\\\"ph\\\">🧘</div><h3>Studio Classic Yoga Mat, 1/4\\\"</h3><div class=\\\"rv\\\"><span class=\\\"stars\\\">★★★★★</span> 4.8 (2,140)</div><div class=\\\"price\\\">$19.95 <span class=\\\"was\\\">$29.95</span></div><div class=\\\"spacer\\\"></div><a class=\\\"btn btn-p\\\" href=\\\"/shop\\\">Add to cart</a></div>\\n<div class=\\\"prod\\\"><span class=\\\"tag\\\">Case value</span><div class=\\\"ph\\\">🧱</div><div><h3>Foam Yoga Block (9\\\"x6\\\"x4\\\")</h3></div><div class=\\\"rv\\\"><span class=\\\"stars\\\">★★★★★</span> 4.9 (1,806)</div><div class=\\\"price\\\">$6.95 <span class=\\\"was\\\">$11.95</span></div><div class=\\\"spacer\\\"></div><a class=\\\"btn btn-p\\\" href=\\\"/shop\\\">Add to cart</a></div>\\n<div class=\\\"prod\\\"><span class=\\\"tag\\\">Studio favorite</span><div class=\\\"ph\\\">🛏️</div><h3>Restorative Rectangular Bolster</h3><div class=\\\"rv\\\"><span class=\\\"stars\\\">★★★★☆</span> 4.7 (932)</div><div class=\\\"price\\\">$39.95 <span class=\\\"was\\\">$59.00</span></div><div class=\\\"spacer\\\"></div><a class=\\\"btn btn-p\\\" href=\\\"/shop\\\">Add to cart</a></div>\\n<div class=\\\"prod\\\"><span class=\\\"tag\\\">Eco pick</span><div class=\\\"ph\\\">🌿</div><h3>Eco-TPE Non-Slip Mat, 6mm</h3><div class=\\\"rv\\\"><span class=\\\"stars\\\">★★★★★</span> 4.8 (654)</div><div class=\\\"price\\\">$34.95 <span class=\\\"was\\\">$49.95</span></div><div class=\\\"spacer\\\"></div><a class=\\\"btn btn-p\\\" href=\\\"/shop\\\">Add to cart</a></div>\\n</div>\\n<p style=\\\"text-align:center;margin-top:26px\\\"><a class=\\\"btn btn-o\\\" href=\\\"/shop\\\">View all products →</a></p></div></section>\\n\\n<section id=\\\"bulk\\\" style=\\\"padding-top:0\\\"><div class=\\\"wrap\\\"><div class=\\\"bulk\\\">\\n<div><h2>Outfitting a studio, school or event? You'll pay less here.</h2>\\n<p>Tell us what you need and we'll build the quote — including freight — so you can compare apples to apples. Purchase orders, tax exemption and net terms welcome.</p>\\n<ul class=\\\"ticks\\\"><li>Tiered pricing starts at just 10 units</li><li>Custom color mixes &amp; logo printing available</li><li>Dedicated rep for reorders — no phone trees</li><li>Ships from US warehouses in 1–3 business days</li></ul>\\n<a class=\\\"btn btn-p\\\" href=\\\"/wholesale\\\">See wholesale program →</a></div>\\n<div><table class=\\\"tiers\\\"><tr><th>Quantity</th><th>Your discount</th></tr><tr><td>10 – 24 units</td><td><b>10% off</b></td></tr><tr><td>25 – 49 units</td><td><b>15% off</b></td></tr><tr><td>50 – 99 units</td><td><b>20% off</b></td></tr><tr><td>100+ units</td><td><b>Custom quote + free freight</b></td></tr></table>\\n<p style=\\\"font-size:13px;color:#cfe1db;margin:12px 0 0\\\">Discounts apply automatically at checkout — or request a formal quote for your PO.</p></div>\\n</div></div></section>\\n\\n<section style=\\\"padding-top:0\\\"><div class=\\\"wrap\\\"><div class=\\\"sec-head\\\"><h2>Studio starter packages</h2><p>Prop kits priced per student. Everything arrives together, ready for your first class.</p></div>\\n<div class=\\\"bundles\\\">\\n<div class=\\\"bundle\\\"><h3>Class of 10</h3><div class=\\\"p\\\">$449</div><div class=\\\"save\\\">Save $120 (21%)</div><ul><li>10 Studio Classic mats</li><li>20 foam blocks</li><li>10 cotton straps</li><li>5 blankets</li></ul><div class=\\\"spacer\\\"></div><a class=\\\"btn btn-o\\\" href=\\\"/wholesale\\\">Add package</a></div>\\n<div class=\\\"bundle best\\\"><h3>Class of 20</h3><div class=\\\"p\\\">$829</div><div class=\\\"save\\\">Save $310 (27%) + free freight</div><ul><li>20 Studio Classic mats</li><li>40 foam blocks</li><li>20 cotton straps</li><li>10 blankets + 10 bolsters</li></ul><div class=\\\"spacer\\\"></div><a class=\\\"btn btn-p\\\" href=\\\"/wholesale\\\">Add package</a></div>\\n<div class=\\\"bundle\\\"><h3>Class of 30</h3><div class=\\\"p\\\">$1,189</div><div class=\\\"save\\\">Save $510 (30%) + free freight</div><ul><li>30 Studio Classic mats</li><li>60 foam blocks</li><li>30 cotton straps</li><li>15 blankets + 15 bolsters</li></ul><div class=\\\"spacer\\\"></div><a class=\\\"btn btn-o\\\" href=\\\"/wholesale\\\">Add package</a></div>\\n</div>\\n<p style=\\\"text-align:center;margin-top:22px;color:var(--muted)\\\">Need a different mix? <a href=\\\"/wholesale\\\" style=\\\"color:var(--brand-dk);font-weight:700;text-decoration:underline\\\">Build a custom package</a> and we'll price it for you.</p></div></section>\\n\\n<section style=\\\"padding-top:0\\\"><div class=\\\"wrap\\\"><div class=\\\"sec-head\\\"><h2>What customers tell us</h2></div><div class=\\\"revs\\\">\\n<div class=\\\"rev\\\"><span class=\\\"stars\\\">★★★★★</span><p>\\\"We've furnished three studios with YogaDirect mats and props. The pricing is hard to beat and the mats hold up to 20+ classes a week.\\\"</p><b>Marisa T.</b><small>Studio owner, Denver CO</small></div>\\n<div class=\\\"rev\\\"><span class=\\\"stars\\\">★★★★★</span><p>\\\"Ordered 60 blocks for our school PE program. Quote came back the same day, arrived in two days, invoice worked with our PO system.\\\"</p><b>Dan R.</b><small>Athletic director, Ohio</small></div>\\n<div class=\\\"rev\\\"><span class=\\\"stars\\\">★★★★★</span><p>\\\"Bought a mat, block and strap set for home. Great quality for the price and it shipped faster than the big brands.\\\"</p><b>Priya S.</b><small>Home practitioner</small></div>\\n</div></div></section>\\n\\n<div class=\\\"about\\\"><section><div class=\\\"wrap about-in\\\">\\n<div><h2 style=\\\"font-size:31px;letter-spacing:-.7px;margin:0 0 12px\\\">From our team of yoga lovers to you</h2>\\n<p style=\\\"color:var(--muted)\\\">Thanks to our loyal customers, YogaDirect has become one of the largest suppliers of yoga mats and props in the country. We have been faithfully supplying the yoga community since 1999 and are confident that we can help you grow your studio, event, or personal practice with everything you need and more.</p>\\n<p style=\\\"color:var(--muted)\\\">We manufacture and source our own goods, which is how we can consistently offer high-quality yoga gear at amazing prices. When you shop at YogaDirect, feel proud knowing that you are helping to grow not only your business or personal practice, but the yoga community as a whole. Thank you.</p>\\n<div class=\\\"stat\\\"><div><b>1999</b><span>Serving yogis since</span></div><div><b>1M+</b><span>Mats &amp; props shipped</span></div><div><b>60 days</b><span>Risk-free returns</span></div></div></div>\\n<div class=\\\"hero-card\\\"><h3>Talk to a real person</h3><p>Not sure which mat thickness, block density or bolster fill is right? Our team practices too — we'll help you choose the first time.</p>\\n<p style=\\\"margin:0 0 6px\\\"><b>Mon–Fri, 9am–5pm ET</b></p><a class=\\\"btn btn-b\\\" href=\\\"/contact\\\" style=\\\"width:100%\\\">Ask a product question</a><p class=\\\"mini\\\">Average email reply time: under 1 business day.</p></div>\\n</div></section></div>\\n\\n<div class=\\\"email\\\"><section><div class=\\\"wrap\\\"><h2>Get 10% off your first order</h2><p>Join our list for restock alerts, seasonal studio deals and practical tips for keeping props in service longer.</p>\\n<form onsubmit=\\\"alert('Thanks! Check your inbox for your 10% off code.');return false;\\\"><input class=\\\"field\\\" type=\\\"email\\\" placeholder=\\\"you@email.com\\\" required><button class=\\\"btn btn-p\\\">Send my code</button></form>\\n<p class=\\\"mini\\\" style=\\\"color:#dff0ea\\\">One or two emails a month. Unsubscribe anytime.</p></div></section></div>\\n\\n<section><div class=\\\"wrap\\\" style=\\\"max-width:820px\\\"><div class=\\\"sec-head\\\"><h2>Common questions</h2></div>\\n<details open><summary>How fast will my order ship?</summary><p>In-stock orders placed before 2pm ET ship the same business day from our US warehouses. Most orders arrive in 2–5 business days. Large bulk orders ship by freight in 1–3 business days.</p></details>\\n<details><summary>When is shipping free?</summary><p>Standard shipping is free on orders over $75 within the contiguous US. Qualifying bulk orders of 50+ units ship freight-free — ask for it in your quote.</p></details>\\n<details><summary>Do I need a wholesale account to get discounts?</summary><p>No. Volume discounts apply automatically starting at 10 units. If you need a formal quote, PO billing, net terms or tax exemption, request a quote and we'll set it up.</p></details>\\n<details><summary>What if a product isn't right?</summary><p>Return unused items within 60 days for a refund or exchange — no restocking fees. If something arrives damaged, email us a photo and we'll replace it immediately.</p></details>\\n<details><summary>Can you add our studio logo to mats?</summary><p>Yes. We offer custom printing and custom color mixes on qualifying quantities. Mention it in your quote request and we'll send samples and pricing.</p></details>\\n</div></section>\\n\\n<footer class=\\\"site\\\"><div class=\\\"wrap\\\"><div class=\\\"fcols\\\">\\n<div><div class=\\\"logo\\\" style=\\\"color:#fff\\\">Yoga<span style=\\\"color:#9ad1bf\\\">Direct</span></div><p>Supplying the yoga community with mats, props and studio packages direct from the maker since 1999.</p><p><b style=\\\"color:#fff\\\">Mon–Fri 9am–5pm ET</b><br>Fast, friendly, US-based support.</p></div>\\n<div><h4>Shop</h4><a href=\\\"/shop\\\">Yoga mats</a><a href=\\\"/shop\\\">Blocks &amp; bricks</a><a href=\\\"/shop\\\">Straps</a><a href=\\\"/shop\\\">Bolsters &amp; blankets</a><a href=\\\"/shop\\\">Wheels &amp; cushions</a></div>\\n<div><h4>For business</h4><a href=\\\"/wholesale\\\">Wholesale &amp; bulk</a><a href=\\\"/wholesale\\\">Studio packages</a><a href=\\\"/wholesale\\\">Custom logo printing</a><a href=\\\"/wholesale\\\">Request a quote</a></div>\\n<div><h4>Help</h4><a href=\\\"/contact\\\">Contact us</a><a href=\\\"/contact\\\">Shipping info</a><a href=\\\"/contact\\\">Returns (60 days)</a><a href=\\\"/\\\">FAQ</a></div>\\n</div><div class=\\\"fbot\\\"><span>© 1999–2025 YogaDirect. All rights reserved.</span><span>Secure checkout · Visa · Mastercard · Amex · PayPal</span></div></div></footer>\\n<div class=\\\"sticky\\\"><a class=\\\"btn btn-o\\\" href=\\\"/wholesale\\\">Bulk quote</a><a class=\\\"btn btn-p\\\" href=\\\"/shop\\\">Shop mats</a></div>\\n</body></html>\"},{\"path\":\"/shop\",\"html\":\"<!DOCTYPE html><html lang=\\\"en\\\"><head><meta charset=\\\"utf-8\\\"><meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\"><title>Shop Yoga Mats, Blocks, Straps &amp; Props | YogaDirect</title><meta name=\\\"description\\\" content=\\\"Shop yoga mats, blocks, straps, bolsters, blankets and wheels direct from the manufacturer. Volume discounts from 10 units, free shipping over $75, 60-day returns.\\\"><style>\\n*{box-sizing:border-box}:root{--ink:#17211f;--muted:#5b6b67;--brand:#2f6f5e;--brand-dk:#1e4a3f;--accent:#d9622f;--sand:#f7f4ee;--line:#e6e1d8;--radius:14px}\\nbody{margin:0;font-family:-apple-system,BlinkMacSystemFont,\\\"Segoe UI\\\",Helvetica,Arial,sans-serif;color:var(--ink);line-height:1.55;background:#fff}\\nimg{max-width:100%;display:block}a{color:inherit;text-decoration:none}\\n.wrap{max-width:1180px;margin:0 auto;padding:0 20px}\\n.bar{background:var(--brand-dk);color:#fff;font-size:13.5px;text-align:center;padding:9px 14px}.bar b{color:#ffd8a8}\\nheader.site{position:sticky;top:0;z-index:60;background:#fff;border-bottom:1px solid var(--line)}\\n.hd{display:flex;align-items:center;gap:20px;padding:14px 0}\\n.logo{font-weight:800;font-size:23px;letter-spacing:-.5px}.logo span{color:var(--brand)}\\n.logo small{display:block;font-size:10px;letter-spacing:2px;color:var(--muted);font-weight:600;text-transform:uppercase}\\nnav.main{display:flex;gap:22px;margin-left:14px;font-size:15px;font-weight:600;flex:1}\\n.hd-actions{display:flex;align-items:center;gap:12px}\\n.btn{display:inline-block;border:0;cursor:pointer;font-weight:700;font-size:15px;padding:13px 22px;border-radius:999px;text-align:center;transition:.15s}\\n.btn-p{background:var(--accent);color:#fff}.btn-p:hover{background:#bf5225}\\n.btn-b{background:var(--brand);color:#fff}.btn-b:hover{background:var(--brand-dk)}\\n.btn-o{background:#fff;color:var(--brand-dk);border:2px solid var(--brand)}.btn-o:hover{background:var(--sand)}\\n.btn-sm{padding:9px 16px;font-size:14px}\\n.head{background:linear-gradient(180deg,var(--sand),#fff);padding:34px 0 26px}\\n.head h1{font-size:35px;margin:0 0 8px;letter-spacing:-1px}\\n.head p{color:var(--muted);margin:0;max-width:56em}\\n.promo{display:flex;gap:14px;flex-wrap:wrap;background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:16px 18px;margin-top:20px;align-items:center;justify-content:space-between}\\n.promo b{color:var(--brand-dk)}\\n.chips{display:flex;gap:10px;flex-wrap:wrap;padding:20px 0}\\n.chip{border:1px solid var(--line);border-radius:999px;padding:8px 15px;font-size:14px;font-weight:600;background:#fff;cursor:pointer}\\n.chip.on{background:var(--brand);color:#fff;border-color:var(--brand)}\\n.layout{display:grid;grid-template-columns:1fr;gap:22px}\\n.prods{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;padding-bottom:20px}\\n.prod{border:1px solid var(--line);border-radius:var(--radius);padding:14px;display:flex;flex-direction:column;position:relative;background:#fff}\\n.prod .ph{background:#eef1ea;border-radius:10px;height:165px;display:flex;align-items:center;justify-content:center;font-size:44px;margin-bottom:12px}\\n.tag{position:absolute;top:20px;left:20px;background:var(--accent);color:#fff;font-size:11.5px;font-weight:800;padding:4px 9px;border-radius:999px}\\n.prod h3{font-size:16px;margin:0 0 4px}\\n.prod .rv{font-size:13px;color:var(--muted);margin-bottom:6px}\\n.stars{color:#e8a33d;letter-spacing:2px}\\n.price{font-weight:800;font-size:18px}.was{color:var(--muted);text-decoration:line-through;font-weight:500;font-size:14px;margin-left:6px}\\n.bulkline{font-size:12.5px;color:var(--brand-dk);font-weight:700;margin-top:6px}\\n.prod .spacer{flex:1}.prod .btn{margin-top:12px;width:100%}\\n.stock{font-size:12.5px;color:#2f6f5e;font-weight:700;margin-top:6px}\\n.band{background:var(--brand-dk);color:#fff;border-radius:18px;padding:30px;display:grid;grid-template-columns:1.1fr .9fr;gap:28px;align-items:center;margin:30px 0}\\n.band h2{margin:0 0 8px;font-size:28px;letter-spacing:-.6px}.band p{color:#d5e5df;margin:0 0 14px}\\n.field{width:100%;padding:12px 14px;border:1px solid var(--line);border-radius:10px;font-size:15px;margin-bottom:10px;font-family:inherit}\\n.card{background:#fff;border-radius:var(--radius);padding:20px;color:var(--ink)}\\nfooter.site{background:#17211f;color:#c8d2cf;padding:44px 0 90px;font-size:14.5px;margin-top:30px}\\n.fcols{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:28px}\\nfooter h4{color:#fff;font-size:14px;text-transform:uppercase;letter-spacing:1px;margin:0 0 12px}\\nfooter a{display:block;padding:4px 0}\\n.fbot{border-top:1px solid #2c3936;margin-top:30px;padding-top:18px;display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap;font-size:13px}\\n.sticky{position:fixed;bottom:0;left:0;right:0;background:#fff;border-top:1px solid var(--line);padding:10px 14px;display:none;gap:10px;z-index:70;box-shadow:0 -6px 20px rgba(0,0,0,.08)}\\n.sticky .btn{flex:1;padding:12px}\\n@media(max-width:900px){.prods{grid-template-columns:repeat(2,1fr)}nav.main{display:none}.band{grid-template-columns:1fr}.fcols{grid-template-columns:1fr 1fr}.sticky{display:flex}.hide-sm{display:none}.head h1{font-size:28px}}\\n@media(max-width:560px){.prods{grid-template-columns:1fr}}\\n</style></head><body>\\n<div class=\\\"bar\\\">🚚 <b>Free shipping on orders $75+</b> &nbsp;·&nbsp; Volume discounts start at 10 units &nbsp;·&nbsp; 60-day returns</div>\\n<header class=\\\"site\\\"><div class=\\\"wrap hd\\\"><a class=\\\"logo\\\" href=\\\"/\\\">Yoga<span>Direct</span><small>Direct from the maker · since 1999</small></a>\\n<nav class=\\\"main\\\"><a href=\\\"/shop\\\">Mats</a><a href=\\\"/shop\\\">Blocks &amp; Straps</a><a href=\\\"/shop\\\">Bolsters &amp; Blankets</a><a href=\\\"/shop\\\">Studio Packages</a><a href=\\\"/wholesale\\\">Bulk / Wholesale</a></nav>\\n<div class=\\\"hd-actions\\\"><a class=\\\"btn btn-o btn-sm hide-sm\\\" href=\\\"/wholesale\\\">Get bulk pricing</a><a class=\\\"btn btn-p btn-sm\\\" href=\\\"#grid\\\">Shop now</a></div></div></header>\\n\\n<div class=\\\"head\\\"><div class=\\\"wrap\\\"><h1>Shop yoga mats &amp; props</h1><p>Manufacturer-direct gear trusted by studios, schools, gyms and home practitioners since 1999. Volume pricing is applied automatically in your cart — the more you add, the less you pay per unit.</p>\\n<div class=\\\"promo\\\"><div>💰 <b>Buy 10+ save 10% · 25+ save 15% · 50+ save 20%</b> — no account or minimum order required.</div><a class=\\\"btn btn-b btn-sm\\\" href=\\\"/wholesale\\\">Need a formal quote? →</a></div></div></div>\\n\\n<div class=\\\"wrap\\\"><div class=\\\"chips\\\"><span class=\\\"chip on\\\">All products</span><span class=\\\"chip\\\">Mats</span><span class=\\\"chip\\\">Blocks</span><span class=\\\"chip\\\">Straps</span><span class=\\\"chip\\\">Bolsters</span><span class=\\\"chip\\\">Blankets</span><span class=\\\"chip\\\">Wheels &amp; cushions</span><span class=\\\"chip\\\">Studio packages</span><span class=\\\"chip\\\">Under $20</span></div>\\n\\n<div id=\\\"grid\\\" class=\\\"prods\\\">\\n<div class=\\\"prod\\\
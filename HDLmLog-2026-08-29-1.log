ont-size:26px;letter-spacing:-.8px}.stat span{font-size:13.5px;color:var(--muted)}.revs{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.rev{border:1px solid var(--line);border-radius:16px;padding:22px;background:#fff}.rev p{font-size:15px;margin:10px 0 14px}.rev b{font-size:14px}.rev span{font-size:13px;color:var(--muted)}details{border:1px solid var(--line);border-radius:12px;padding:16px 18px;margin-bottom:10px;background:#fff}summary{font-weight:700;cursor:pointer;font-size:16px;list-style:none;display:flex;justify-content:space-between;gap:12px}summary::-webkit-details-marker{display:none}summary:after{content:'+';color:var(--sage);font-size:22px;line-height:1}details[open] summary:after{content:'–'}details p{color:var(--muted);margin-top:10px;font-size:15px}.news{background:linear-gradient(115deg,#eef2e9,#f6f2ea);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.news-in{padding:54px 20px;text-align:center}.news form{display:flex;gap:10px;max-width:470px;margin:20px auto 10px;flex-wrap:wrap}.news input{flex:1;min-width:200px;padding:14px 16px;border:1.5px solid var(--line);border-radius:999px;font:inherit;background:#fff}.news small{color:var(--muted);font-size:12.5px}footer{background:#161a18;color:#b9c2bb;padding:54px 0 26px;font-size:14.5px}.f-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:32px}footer h4{color:#fff;font-size:15px;margin-bottom:12px}footer a{display:block;padding:4px 0}footer a:hover{color:#fff}.f-bot{border-top:1px solid #2a302c;margin-top:34px;padding-top:18px;display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap;font-size:13px}.toast{position:fixed;left:50%;bottom:26px;transform:translate(-50%,140%);background:var(--ink);color:#fff;padding:14px 22px;border-radius:999px;font-weight:700;font-size:14.5px;z-index:99;transition:.3s;box-shadow:0 10px 30px rgba(0,0,0,.25)}.toast.on{transform:translate(-50%,0)}.mob-cta{display:none}@media(max-width:1000px){.hero-in,.band-in,.about-in{grid-template-columns:1fr}.grid4{grid-template-columns:repeat(2,1fr)}.cats{grid-template-columns:repeat(2,1fr)}.trust-in{grid-template-columns:repeat(2,1fr)}.revs{grid-template-columns:1fr}.f-grid{grid-template-columns:1fr 1fr}}@media(min-width:1001px){.phone{display:block}}@media(max-width:820px){.nav{display:none;position:absolute;top:100%;left:0;right:0;background:#fff;flex-direction:column;padding:14px 20px 20px;border-bottom:1px solid var(--line);box-shadow:0 14px 24px rgba(0,0,0,.08)}.nav.open{display:flex}.burger{display:block}.hdr-in{gap:12px}.mob-cta{display:flex;position:fixed;left:0;right:0;bottom:0;z-index:70;background:#fff;border-top:1px solid var(--line);padding:10px 14px;gap:10px}.mob-cta .btn{flex:1;padding:14px}body{padding-bottom:70px}}</style></head><body><div class='bar'>Manufacturer&#8209;direct pricing &bull; <strong>Fast US shipping</strong> &bull; Volume discounts on 10+ items &mdash; <a href='/pages/wholesale' style='text-decoration:underline'>Get a bulk quote</a></div><header class='hdr'><div class='wrap hdr-in'><a class='logo' href='/'>Yoga<span>Direct</span></a><nav class='nav' id='nav'><a href='/collections/yoga-mats'>Yoga Mats</a><a href='/collections/yoga-mats#props'>Blocks &amp; Props</a><a href='/collections/yoga-mats#props'>Bolsters &amp; Blankets</a><a href='/pages/wholesale'>Studios &amp; Bulk</a><a class='hot' href='#best'>Deals</a></nav><div class='hdr-act'><span class='phone'>Talk to a yoga pro<b>1-800-503-4426</b></span><a class='cart' href='#best' aria-label='Cart'><svg width='18' height='18' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><path d='M6 6h15l-1.5 9h-12z'/><circle cx='9' cy='20' r='1.4'/><circle cx='18' cy='20' r='1.4'/><path d='M6 6L5 3H2'/></svg>Cart <b id='cartN'>0</b></a><button class='burger' id='burger' aria-label='Menu'>&#9776;</button></div></header><main><section class='hero'><div class='wrap hero-in'><div><span class='eyebrow'>Supplying the yoga community since 1999</span><h1>Studio-quality yoga mats &amp; props, straight from the source.</h1><p class='sub'>We manufacture and source our own goods &mdash; so you get high-quality gear at prices studios, schools and event planners can actually budget for.</p><div class='hero-cta'><a class='btn btn-p' href='#best'>Shop bestsellers</a><a class='btn btn-s' href='/pages/wholesale'>Get bulk pricing &rarr;</a></div><ul class='ticks'><li>One of the largest US suppliers</li><li>Volume discounts on 10+</li><li>Easy 30-day returns</li></ul></div><div class='hero-art'><div class='mats'><div class='mat m1'></div><div class='mat m2'></div><div class='mat m3'></div><div class='mat m4'></div><div class='mat m5'></div><div class='mat m6'></div></div><h4>Deluxe 1/4&quot; Yoga Mats &mdash; 12 colors</h4><small>Buy 1 for your practice or 20 for your studio floor.</small><span class='badge'>From $22.95</span></div></div></section><section class='trust'><div class='wrap trust-in'><div class='tr'><svg width='22' height='22' viewBox='0 0 24 24' fill='none' stroke-width='2'><path d='M3 12h13V6H3zM16 9h4l1 3v3h-5z'/><circle cx='7' cy='17' r='2'/><circle cx='18' cy='17' r='2'/></svg><div><b>Fast US shipping</b><span>Orders ship from our own warehouse</span></div></div><div class='tr'><svg width='22' height='22' viewBox='0 0 24 24' fill='none' stroke-width='2'><path d='M12 3l8 4v5c0 5-3.5 8-8 9-4.5-1-8-4-8-9V7z'/><path d='M9 12l2 2 4-4'/></svg><div><b>Made &amp; sourced by us</b><span>No middleman markup, ever</span></div></div><div class='tr'><svg width='22' height='22' viewBox='0 0 24 24' fill='none' stroke-width='2'><path d='M4 7h16v12H4z'/><path d='M9 7V4h6v3'/><path d='M4 12h16'/></svg><div><b>Bulk &amp; wholesale</b><span>Tiered pricing for studios &amp; events</span></div></div><div class='tr'><svg width='22' height='22' viewBox='0 0 24 24' fill='none' stroke-width='2'><path d='M21 12a9 9 0 11-3-6.7'/><path d='M21 3v6h-6'/></svg><div><b>30-day returns</b><span>Not the right mat? Send it back</span></div></div></div></section><section class='pad wrap' id='shop'><div class='sec-head'><div><h2>Shop by category</h2><p>Everything you need to outfit a class, a retreat or your living room floor.</p></div><a class='link' href='/collections/yoga-mats'>See all products</a></div><div class='cats'><a class='cat' href='/collections/yoga-mats'><div class='ph' style='background:#6f8f6b'><svg viewBox='0 0 24 24' fill='none' stroke-width='1.6'><rect x='2' y='8' width='20' height='8' rx='2'/><path d='M6 8v8'/></svg></div><div class='tx'><b>Yoga Mats</b><span>1/8&quot;, 1/4&quot; &amp; 1/2&quot; &bull; 12 colors</span></div></a><a class='cat' href='/collections/yoga-mats#props'><div class='ph' style='background:#c1613a'><svg viewBox='0 0 24 24' fill='none' stroke-width='1.6'><rect x='3' y='7' width='18' height='10' rx='2'/><path d='M3 12h18'/></svg></div><div class='tx'><b>Blocks &amp; Wedges</b><span>Foam, cork &amp; recycled</span></div></a><a class='cat' href='/collections/yoga-mats#props'><div class='ph' style='background:#3f5c74'><svg viewBox='0 0 24 24' fill='none' stroke-width='1.6'><path d='M4 6c6 4 10 8 16 12'/><rect x='2' y='4' width='4' height='4' rx='1'/></svg></div><div class='tx'><b>Straps &amp; Slings</b><span>6ft, 8ft &amp; 10ft cotton</span></div></a><a class='cat' href='/collections/yoga-mats#props'><div class='ph' style='background:#8f6f9b'><svg viewBox='0 0 24 24' fill='none' stroke-width='1.6'><rect x='3' y='9' width='18' height='7' rx='3.5'/><path d='M7 9v7M17 9v7'/></svg></div><div class='tx'><b>Bolsters &amp; Cushions</b><span>Restorative &amp; meditation</span></div></a><a class='cat' href='/collections/yoga-mats#props'><div class='ph' style='background:#d9a24a'><svg viewBox='0 0 24 24' fill='none' stroke-width='1.6'><rect x='3' y='5' width='18' height='14' rx='2'/><path d='M3 10h18M3 15h18'/></svg></div><div class='tx'><b>Blankets &amp; Towels</b><span>Mexican, cotton &amp; microfiber</span></div></a><a class='cat' href='/pages/wholesale'><div class='ph' style='background:#4b5f56'><svg viewBox='0 0 24 24' fill='none' stroke-width='1.6'><path d='M4 8h16v11H4z'/><path d='M9 8V5h6v3M4 13h16'/></svg></div><div class='tx'><b>Studio &amp; Bulk Packs</b><span>10, 20 &amp; 30-unit bundles</span></div></a></div></section><section class='pad wrap' id='best' style='padding-top:0'><div class='sec-head'><div><h2>Customer favorites</h2><p>Our most-reordered mats and props &mdash; the same gear stocked by studios nationwide.</p></div><a class='link' href='/collections/yoga-mats'>Shop all mats</a></div><div class='grid4'><article class='card'><div class='ph' style='background:#6f8f6b'><span class='tag'>Bestseller</span><svg viewBox='0 0 24 24' fill='none' stroke-width='1.4'><rect x='2' y='8' width='20' height='8' rx='2'/><path d='M6 8v8'/></svg></div><div class='body'><div class='stars'>&#9733;&#9733;&#9733;&#9733;&#9733;<span>(1,842)</span></div><h3>Deluxe 1/4&quot; Yoga Mat</h3><p class='desc'>Extra cushion, non-slip texture, 68&quot; long. 12 colors.</p><div class='price'>$22.95<em>Save more at 10+ units</em></div><button class='btn btn-g btn-sm add'>Add to cart</button></div></article><article class='card'><div class='ph' style='background:#c1613a'><span class='tag sale'>Save 15%</span><svg viewBox='0 0 24 24' fill='none' stroke-width='1.4'><rect x='3' y='7' width='18' height='10' rx='2'/><path d='M3 12h18'/></svg></div><div class='body'><div class='stars'>&#9733;&#9733;&#9733;&#9733;&#9733;<span>(963)</span></div><h3>Foam Yoga Block (4&quot;)</h3><p class='desc'>Firm, lightweight support for alignment and restoratives.</p><div class='price'>$6.95 <s>$8.25</s><em>Studio packs of 20 available</em></div><button class='btn btn-g btn-sm add'>Add to cart</button></div></article><article class='card'><div class='ph' style='background:#3f5c74'><svg viewBox='0 0 24 24' fill='none' stroke-width='1.4'><path d='M4 6c6 4 10 8 16 12'/><rect x='2' y='4' width='4' height='4' rx='1'/></svg></div><div class='body'><div class='stars'>&#9733;&#9733;&#9733;&#9733;&#9734;<span>(511)</span></div><h3>8ft Cotton Yoga Strap</h3><p class='desc'>Heavy cotton webbing with a secure D-ring buckle.</p><div class='price'>$8.95<em>Free shipping in 10-packs</em></div><button class='btn btn-g btn-sm add'>Add to cart</button></div></article><article class='card'><div class='ph' style='background:#8f6f9b'><svg viewBox='0 0 24 24' fill='none' stroke-width='1.4'><rect x='3' y='9' width='18' height='7' rx='3.5'/><path d='M7 9v7M17 9v7'/></svg></div><div class='body'><div class='stars'>&#9733;&#9733;&#9733;&#9733;&#9733;<span>(387)</span></div><h3>Rectangular Yoga Bolster</h3><p class='desc'>Dense cotton fill with a removable, washable cover.</p><div class='price'>$44.95<em>Ships in 1&ndash;2 business days</em></div><button class='btn btn-g btn-sm add'>Add to cart</button></div></article></div></section><section class='band'><div class='wrap band-in'><div><h2>Outfitting a studio, school or event?</h2><p>Tell us how many mats and props you need and we&rsquo;ll send a same-day quote with volume pricing, freight options and color availability. We&rsquo;ve been doing this for the yoga community since 1999.</p><a class='btn btn-p' href='/pages/wholesale'>Request a free bulk quote</a> <a class='btn btn-s' style='background:transparent;color:#fff;border-color:rgba(255,255,255,.5)' href='tel:18005034426'>Call 1-800-503-4426</a></div><div class='tier'><h4 style='color:#fff;font-size:16px;margin-bottom:12px'>Example volume pricing &mdash; Deluxe 1/4&quot; Mat</h4><table><tr><td>1&ndash;9 mats</td><td>$22.95 ea</td></tr><tr><td>10&ndash;19 mats</td><td>$19.95 ea</td></tr><tr><td>20&ndash;49 mats</td><td>$17.95 ea</td></tr><tr><td>50+ mats</td><td>Custom quote</td></tr></table><p style='color:#c9d2cb;font-size:13px;margin-top:12px'>Mixed-color orders welcome. Purchase orders and net terms available for schools and studios.</p></div></div></section><section class='about'><div class='wrap about-in'><div><h2>Thank you for 25+ years of practice together.</h2><div class='stats'><div class='stat'><b>1999</b><span>Serving yogis since</span></div><div class='stat'><b>#1</b><span>One of the largest US suppliers of mats &amp; props</span></div><div class='stat'><b>Direct</b><span>We manufacture &amp; source our own goods</span></div><div class='stat'><b>30 days</b><span>Hassle-free returns</span></div></div></div><div><p style='font-size:17px;color:var(--muted)'>Thanks to our loyal customers, YogaDirect has become one of the largest suppliers of yoga mats and props in the country. We have been faithfully supplying the yoga community since 1999 and are confident that we can help you grow your studio, event, or personal practice with everything you need and more.</p><p style='font-size:17px;color:var(--muted);margin-top:14px'>We manufacture and source our own goods, which is how we can consistently offer high-quality yoga gear at amazing prices. When you shop at YogaDirect, feel proud knowing that you are helping to grow not only your business or personal practice, but the yoga community as a whole. From our team of yoga lovers to you &mdash; thank you.</p><a class='btn btn-s btn-sm' style='margin-top:20px' href='/collections/yoga-mats'>Start shopping</a></div></div></section><section class='pad wrap'><div class='sec-head'><div><h2>What customers tell us</h2><p>Studio owners, teachers and home practitioners keep coming back.</p></div></div><div class='revs'><div class='rev'><div class='stars'>&#9733;&#9733;&#9733;&#9733;&#9733;</div><p>&ldquo;Re-matted our whole studio for less than half of what our old supplier quoted. The 1/4&quot; mats have held up through two years of heated classes.&rdquo;</p><b>Studio owner</b> <span>&mdash; verified buyer</span></div><div class='rev'><div class='stars'>&#9733;&#9733;&#9733;&#9733;&#9733;</div><p>&ldquo;Ordered 60 blocks and 40 straps for a teacher training. Quote came back the same day and everything arrived ahead of schedule.&rdquo;</p><b>Event coordinator</b> <span>&mdash; verified buyer</span></div><div class='rev'><div class='stars'>&#9733;&#9733;&#9733;&#9733;&#9734;</div><p>&ldquo;Great mat for the price &mdash; thicker than the one I paid triple for at a big-box store. The bolster is my favorite purchase.&rdquo;</p><b>Home practitioner</b> <span>&mdash; verified buyer</span></div></div></section><section class='pad wrap' style='padding-top:0;max-width:820px'><h2 style='margin-bottom:20px'>Questions before you order?</h2><details open><summary>How fast will my order ship?</summary><p>In-stock mats and props leave our warehouse quickly &mdash; typically within 1&ndash;2 business days. Large bulk and freight orders are scheduled with you directly so you know exactly when your gear lands.</p></details><details><summary>Do you offer wholesale or studio pricing?</summary><p>Yes. Volume discounts start at 10 units and get better as quantities grow. Request a free quote and we&rsquo;ll price your full list, including mixed colors, freight and purchase-order terms.</p></details><details><summary>Which mat thickness should I choose?</summary><p>1/8&quot; for travel and grip-focused practice, 1/4&quot; for the best all-around cushion (our bestseller), and 1/2&quot; for restorative, therapy and floor-work classes.</p></details><details><summary>What is your return policy?</summary><p>Unused items can be returned within 30 days. If something arrives damaged, contact us and we&rsquo;ll make it right immediately.</p></details><details><summary>Can I get samples before a large order?</summary><p>Absolutely. Many studios order one or two mats first to check color, thickness and grip before placing a bulk order. Mention it in your quote request.</p></details></section><section class='news'><div class='wrap news-in'><h2>Get sale alerts &amp; new colors first</h2><p style='color:var(--muted);margin-top:8px'>One short email when prices drop, colors restock, or bulk deals open up.</p><form onsubmit='event.preventDefault();this.innerHTML=\\\"<p style=&#39;font-weight:700;color:#435c42&#39;>You&#39;re on the list. Namaste. &#127807;</p>\\\"'><input type='email' required placeholder='you@email.com' aria-label='Email address'><button class='btn btn-p' type='submit'>Sign me up</button></form><small>No spam. Unsubscribe anytime.</small></div></section></main><footer><div class='wrap'><div class='f-grid'><div><a class='logo' href='/' style='color:#fff'>Yoga<span style='color:#8fb08c'>Direct</span></a><p style='margin-top:12px;max-width:300px'>Supplying yoga mats, props and studio equipment to the yoga community since 1999.</p><p style='margin-top:14px;color:#fff;font-weight:700'>1-800-503-4426</p><p style='font-size:13px'>Mon&ndash;Fri, 9am&ndash;5pm PT</p></div><div><h4>Shop</h4><a href='/collections/yoga-mats'>Yoga mats</a><a href='/collections/yoga-mats#props'>Blocks &amp; wedges</a><a href='/collections/yoga-mats#props'>Straps &amp; slings</a><a href='/collections/yoga-mats#props'>Bolsters &amp; blankets</a><a href='/pages/wholesale'>Bulk packs</a></div><div><h4>For studios</h4><a href='/pages/wholesale'>Wholesale program</a><a href='/pages/wholesale'>Request a quote</a><a href='/pages/wholesale'>Purchase orders</a><a href='/pages/wholesale'>Freight shipping</a></div><div><h4>Help</h4><a href='#best'>Shipping info</a><a href='#best'>Returns &amp; exchanges</a><a href='#best'>Contact us</a><a href='#best'>Mat buying guide</a></div></div><div class='f-bot'><span>&copy; 1999&ndash;2025 YogaDirect. All rights reserved.</span><span>Secure checkout &bull; Visa &bull; Mastercard &bull; Amex &bull; PayPal</span></div></div></footer><div class='mob-cta'><a class='btn btn-s btn-sm' href='tel:18005034426'>Call us</a><a class='btn btn-p btn-sm' href='#best'>Shop bestsellers</a></div><div class='toast' id='toast'>Added to cart &#10003;</div><script>document.getElementById('burger').onclick=function(){document.getElementById('nav').classList.toggle('open')};var n=0;document.querySelectorAll('.add').forEach(function(b){b.onclick=function(){n++
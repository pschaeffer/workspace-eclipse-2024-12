 setImg(e){document.getElementById('hero').innerHTML=e+'<span class=badge>#1 Best Seller</span>'}function pick(el,name){var s=document.querySelectorAll('.sw');for(var i=0;i<s.length;i++)s[i].classList.remove('on');el.classList.add('on');COLOR=name;document.getElementById('colorName').textContent=name}function unitPrice(q){if(q>=24)return 32.76;if(q>=12)return 34.36;if(q>=6)return 35.96;return 39.95}function updatePrice(){var q=parseInt(document.getElementById('q').value,10);var u=unitPrice(q);var t=(u*q).toFixed(2);document.getElementById('btnPrice').textContent='$'+t;document.getElementById('stickyPrice').textContent='$'+u.toFixed(2)+(q>1?' each':'');document.getElementById('qtyNote').innerHTML=q>=6?'<b style=\\\"color:#0f6b5c\\\">Bulk discount applied: $'+u.toFixed(2)+' each</b>':'Buying 6+? Discount applied automatically.'}function buyMat(){var q=parseInt(document.getElementById('q').value,10);var u=unitPrice(q);for(var i=0;i<q;i++)CART.push({n:'Pro-Grip Studio Mat 6mm ('+COLOR+')',p:u});save();openCart();toast(q+' mat'+(q>1?'s':'')+' added to cart')}function addBundle(){var added=0;if(document.getElementById('b1').checked){CART.push({n:'Foam Blocks 2-pack (bundle)',p:12.71});added++}if(document.getElementById('b2').checked){CART.push({n:'8ft Cotton Strap (bundle)',p:8.46});added++}if(document.getElementById('b3').checked){CART.push({n:'Mat Carry Bag (bundle)',p:16.96});added++}if(!added){toast('Select at least one item');return}save();openCart();toast('Bundle added &mdash; you saved 15%')}updatePrice();render();</script></body></html>\"},{\"path\":\"/wholesale\",\"html\":\"<!DOCTYPE html><html lang='en'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><title>Studio, Gym &amp; Bulk Yoga Equipment Pricing | YogaDirect Wholesale</title><meta name='description' content='Outfit your studio, gym, school or event with manufacturer-direct yoga mats and props. Volume discounts from 6 units, 25%+ at 50 units, custom logo print
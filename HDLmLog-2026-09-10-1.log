12px;justify-content:center;margin:22px 0 6px}\\n.btn{display:inline-block;text-decoration:none;font-family:Helvetica,Arial,sans-serif;font-weight:700;border-radius:8px;padding:14px 26px;font-size:1.02rem}\\n.btn-primary{background:var(--emerald);color:#fff;box-shadow:0 4px 12px rgba(14,122,95,.32)}\\n.btn-primary:hover{background:var(--emerald-dark)}\\n.btn-secondary{background:#fff;color:var(--emerald-dark);border:2px solid var(--emerald)}\\n.btn-secondary:hover{background:#f0f8f4}\\n.hint{text-align:center;font-size:.9rem;color:#6b7a6c;margin:6px 0 0}\\n/* sections */\\nsection{padding:30px 0}\\nh2{font-size:1.5rem;margin:0 0 6px}\\n.lead{margin:0 0 18px;color:#4a5a4b}\\n/* cards */\\n.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:14px;list-style:none;padding:0;margin:0}\\n.card{background:#fff;border:1px solid var(--line);border-radius:10px;transition:transform .12s ease,box-shadow .12s ease}\\n.card:hover{transform:translateY(-2px);box-shadow:0 8px 18px rgba(0,0,0,.09)}\\n.card a{display:block;padding:14px 16px;text-decoration:none;color:var(--ink)}\\n.card .num{display:inline-block;font-family:Helvetica,Arial,sans-serif;font-size:.72rem;letter-spacing:.06em;text-transform:uppercase;color:var(--emerald-dark);background:#e8f4ef;border-radius:20px;padding:2px 9px;margin-bottom:8px}\\n.card .num.extra{color:#8a6410;background:#fdf3dd}\\n.card .t{display:block;font-size:1.06rem;font-weight:bold;line-height:1.3}\\n.card .y{display:block;font-size:.9rem;color:#6b7a6c;margin-top:4px}\\n.card .go{display:block;margin-top:8px;font-family:Helvetica,Arial,sans-serif;font-size:.85rem;font-weight:700;color:var(--emerald)}\\n.card.start{border-color:var(--emerald);box-shadow:0 0 0 2px rgba(14,122,95,.15)}\\n/* signup */\\n.signup{background:#0e7a5f;color:#fff;border-radius:12px;padding:26px 22px;text-align:center;margin:10px 0}\\n.signup h2{color:#fff}\\n.signup p{max-width:560px;margin:0 auto 16px;color:#e7f5ef}\\n.signup form{display:flex;
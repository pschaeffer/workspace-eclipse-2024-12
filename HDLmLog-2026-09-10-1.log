ckground:var(--bg);color:var(--ink);font-family:Georgia,\\\"Iowan Old Style\\\",\\\"Times New Roman\\\",serif;line-height:1.55;-webkit-text-size-adjust:100%}\\na{color:var(--emerald-dark)}\\n.wrap{max-width:1060px;margin:0 auto;padding:0 18px}\\n.topbar{background:var(--emerald);color:#fff;font-family:-apple-system,BlinkMacSystemFont,\\\"Segoe UI\\\",Helvetica,Arial,sans-serif;font-size:14px;text-align:center;padding:9px 12px}\\n.topbar strong{color:#ffe9a8}\\n.hero{background:linear-gradient(180deg,#ffffff 0%,#fbf8f1 100%);border-bottom:1px solid var(--line);padding:26px 0 34px}\\n.hero-grid{display:flex;gap:34px;align-items:center;flex-wrap:wrap}\\n.hero-art{flex:1 1 300px;min-width:260px;text-align:center}\\n.hero-art img{max-width:100%;height:auto;border-radius:10px;box-shadow:0 10px 28px rgba(20,40,30,.18)}\\n.hero-copy{flex:1 1 380px;min-width:280px}\\nh1{font-size:clamp(28px,4.4vw,44px);line-height:1.14;margin:6px 0 12px}\\n.sub{font-size:clamp(17px,2.2vw,20px);color:var(--muted);margin:0 0 20px}\\n.cta{display:inline-block;background:var(--gold);color:#241c00;font-family:-apple-system,BlinkMacSystemFont,\\\"Segoe UI\\\",Helvetica,Arial,sans-serif;font-weight:700;font-size:18px;text-decoration:none;padding:15px 26px;border-radius:8px;box-shadow:0 4px 0 #b8850c;transition:transform .08s ease}\\n.cta:hover{transform:translateY(-1px)}\\n.cta.secondary{background:var(--emerald);color:#fff;box-shadow:0 4px 0 var(--emerald-dark);margin-left:10px}\\n.cta-row{display:flex;flex-wrap:wrap;gap:12px;align-items:center}\\n.trust{list-style:none;display:flex;flex-wrap:wrap;gap:8px 18px;padding:0;margin:18px 0 0;font-family:-apple-system,BlinkMacSystemFont,\\\"Segoe UI\\\",Helvetica,Arial,sans-serif;font-size:14px;color:var(--muted)}\\n.trust li:before{content:\\\"\\\\2713\\\";color:var(--emerald);font-weight:700;margin-right:6px}\\nsection{padding:38px 0}\\nh2{font-size:clamp(22px,3vw,30px);margin:0 0 6px}\\n.lead{color:var(--muted);margin:0 0 22px}\\n.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:14px;list-style:none;padding:0;margin:0}\\n.book{background:var(--card);border:1px solid var(--line);border-radius:10px;transition:box-shadow .12s ease,transform .12s ease}\\n.book:hover{box-shadow:0 8px 20px rgba(20,40,30,.12);transform:translateY(-2px)}\\n.book a{display:block;padding:16px 16px 14px;text-decoration:none;color:inherit;height:100%}\\n.book .num{font-family:-apple-system,BlinkMacSystemFont,\\\"Segoe UI\\\",Helvetica,Arial,sans-serif;font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:var(--emerald);font-weight:700}\\n.book .title{display:block;font-size:19px;margin:5px 0 4px;font-weight:700}\\n.book .year{font-family:-apple-system,BlinkMacSystemFont,\\\"Segoe UI\\\",Helvetica,Arial,sans-serif;font-size:13px;color:var(--muted)}\\n.book .go{font-family:-apple-system,BlinkMacSystemFont,\\\"Segoe UI\\\",Helvetica,Arial,sans-serif;font-size:14px;font-weight:700;color:var(--emerald-dark);margin-top:9px;display:block}\\n.book.featured{border-color:var(--gold);box-shadow:0 6px 18px rgba(224,166,21,.22)}\\n.badge{display:inline-block;background:#fff5d6;color:#7a5a00;border:1px solid #f0dca0;border-radius:99px;font-family:-apple-system,BlinkMacSystemFont,\\\"Segoe UI\\\",Helvetica,Arial,sans-serif;font-size:11px;font-weight:700;padding:2px 9px;margin-left:6px;vertical-align:2px}\\n.signup{background:var(--emerald);color:#fff;border-radius:12px;padding:28px 22px;text-align:center}\\n.signup h2{color:#fff}\\n.signup p{color:#dff0e8;max-width:560px;margin:0 auto 18px}\\n.signup form{display:flex;flex-wrap:wrap;gap:10px;justify-content:center}\\n.signup input[type=email]{font-size:16px;padding:14px 14px;border:0;border-radius:8px;min-width:260px;flex:0 1 320px;font-family:-apple-system,BlinkMacSystemFont,\\\"Segoe UI\\\",Helvetica,Arial,sans-serif}\\n.signup button{font-family:-apple-system,BlinkMacSystemFont,\\\"Segoe UI\\\",Helvetica,Arial,sans-serif;font-weight:700;font-size:16px;padding
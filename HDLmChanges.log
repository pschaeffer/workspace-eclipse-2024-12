yleSheet.textContent \\u003d \\u0027.header-specials, .bannertxt h2, .cart-title {\\\\n    color: #333333;\\\\n    font-weight: bold;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.availability, .on-sale-badge {\\\\n    background-color: #FFC300;\\\\n    padding: 2px 5px;\\\\n    color: #000;\\\\n    border-radius: 3px;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027/* Add whitespace and distinct section styling */\\\\n.section {\\\\n    padding: 40px 0px;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.message {\\\\n    background-color: #f7f7f7;\\\\n    padding: 20px;\\\\n    margin-bottom: 30px;\\\\n    border-radius: 5px;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.homepage-slider, .homeTopBanner {\\\\n    margin-bottom: 40px;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.message h6, .BottomBannertxt h4 {\\\\n    margin-bottom: 10px;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\"],\"updated\":false},\"nodePath\":[\"Top\",\"Companies\",\"www.yogadirect.com\",\"Rules\",\"example.com\",\"example.com\",\"Mod Enhanced Visual Hierarchy Draws Attention To The Most Important Script\"]}"}

{"source":"web","type":"modify","time":"2025-08-04T05:30:42.192863900Z","top":"Top","group":"Companies","company":"www.yogadirect.com","location":"rules","division":"example.com","site":"example.com","name":"Script Mod CC Variant 8","info":"{\"tooltip\":\"Script modification\",\"type\":\"mod\",\"details\":{\"name\":\"Script Mod CC Variant 8\",\"extra\":\"\",\"enabled\":true,\"type\":\"script\",\"created\":\"2025-06-05T07:16:10.434Z\",\"lastmodified\":\"2025-08-04T05:30:42.185Z\",\"find\":[],\"prob\":1,\"xpath\":\"\",\"pathre\":false,\"scripts\":[\"( function() {    /* alert(\\\"This script modifies the page\\u0027s background color to a light blue and adds a shadow to product items for a more visually appealing look.\\\"); */    if (window.self !\\u003d\\u003d window.top) {        // Running inside an iframe \\n        document.body.style.backgroundColor \\u003d \\\"#e0f7fa\\\"; // light blue background \\n    } else {        // Running in the main window \\n        document.body.style.backgroundColor \\u003d \\\"#e0f7fa\\\"; // light blue background \\n    }    const productItems \\u003d document.querySelectorAll(\\u0027.product-item\\u0027);    productItems.forEach(item \\u003d\\u003e {        item.style.boxShadow \\u003d \\\"0 4px 8px rgba(0, 0, 0, 0.2)\\\";        item.style.transition \\u003d \\\"0.3s\\\"; // Smooth transition \\n        item.addEventListener(\\u0027mouseenter\\u0027, function() {            item.style.transform \\u003d \\\"scale(1.05)\\\";        })();        item.addEventListener(\\u0027mouseleave\\u0027, function() {            item.style.transform \\u003d \\\"scale(1)\\\";        })();    })();})();    \"],\"updated\":true,\"usemode\":\"prod\",\"comments\":\"\",\"nodeiden\":{\"type\":\"tag\",\"counts\":{\"tag\":1},\"parent\":{\"tag\":\"html\"},\"attributes\":{\"tag\":\"head\"}},\"parameter\":0,\"cssselector\":\"\",\"probability\":\"\",\"path\":\"//.*/\"},\"nodePath\":[\"Top\",\"Companies\",\"www.yogadirect.com\",\"Rules\",\"example.com\",\"
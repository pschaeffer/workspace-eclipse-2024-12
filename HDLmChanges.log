classList.add(\\u0027category-group\\u0027); var categoryTitle \\u003d document.createElement(\\u0027div\\u0027); categoryTitle.classList.add(\\u0027category-group-title\\u0027); categoryTitle.innerText \\u003d category.title; categoryGroup.appendChild(categoryTitle); category.links.forEach(linkText \\u003d\\u003e { var linkItem \\u003d document.createElement(\\u0027a\\u0027); linkItem.href \\u003d \\u0027#\\u0027; linkItem.innerText \\u003d linkText; categoryGroup.appendChild(linkItem); }); dropdownMenu.appendChild(categoryGroup); }); listItem.appendChild(dropdownMenu); parent.insertBefore(listItem, parent.firstChild); });\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027body { font-family: Lato, sans-serif; }\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.navbar-nav \\u003e li.dropdown \\u003e a { display: flex; align-items: center; }\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.navbar-nav .dropdown-menu { padding: 10px 0; }\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.dropdown-menu \\u003e .category-group { margin-bottom: 10px; }\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.dropdown-menu \\u003e .category-group a { margin-left: 20px; }\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.category-group-title { font-weight: bold; margin: 0 0 5px 20px; }\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\"
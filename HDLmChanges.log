{"source":"WebSockets","type":"add","time":"2025-10-17T23:58:47.406316Z","top":"Top","group":"Companies","company":"www.yogadirect.com","location":"rules","division":"example.com","site":"example.com","name":"Mod Using Storytelling In Product Descriptions Helps Create Script","info":"{\"tooltip\":\"Script modification\",\"type\":\"mod\",\"children\":[],\"details\":{\"name\":\"Mod Using Storytelling In Product Descriptions Helps Create Script\",\"extra\":\"\",\"type\":\"script\",\"created\":\"2025-10-17T23:58:46.767Z\",\"lastmodified\":\"2025-10-17T23:58:46.767Z\",\"pathvalue\":\"/\",\"comments\":\"\",\"probability\":100,\"usemode\":\"off\",\"cssselector\":\"\",\"xpath\":\"\",\"find\":[],\"nodeiden\":{\"type\":\"tag\",\"attributes\":{\"tag\":\"head\"},\"counts\":{\"tag\":1},\"parent\":{\"tag\":\"html\"}},\"parameter\":0,\"scripts\":[\"function enrichProductDescriptions() {\\n    var products \\u003d [\\n        {\\n            id: 2421,\\n            story: \\\"Our 1/4 Inch Yoga Mat is more than just a yoga accessory—it\\u0027s your daily companion in the pursuit of mindfulness. Crafted for comfort and durability, it perfectly supports you through every pose, making your practice an experience to look forward to every day.\\\" \\n        },\\n        {\\n            id: 2422,\\n            story: \\\"The 1/8 Inch Yoga Mat from Yoga Direct is designed for flexibility. Its lightweight design is perfect for yogis on the go, offering balanced support and grip wherever your journey takes you.\\\"\\n        },\\n        {\\n            id: 71,\\n            story: \\\"Experience balance and stability with our Anti Burst Deluxe Yoga Ball. A must-have for anyone looking to enhance their fitness routine or rehabilitate from injury, it promises to strengthen core muscles and improve posture.\\\" \\n        },\\n        {\\n            id: 161,\\n            story: \\\"The 8 Ft Cinch Buckle Yoga Strap brings flexibility to your fingertips. Whether you\\u0027re a beginner or a seasoned yogi, it aids in deepening your stretches and improving alignment.\\\" \\n        },\\n        {\\n            id: 148,\\n            story: \\\"Our 8 Ft D-Ring Yoga Strap is built for durability and strength, perfect for enhancing your yoga stretches and support exercises.\\\" \\n        },\\n        {\\n            id: 1142,\\n            story: \\\"Give the gift of wellness with our E-Gift Cards. Perfect for any occasion, they offer the flexibility to choose their ideal yoga gear.\\\" \\n        },\\n        \\n        {\\n            id: 2509,\\n            story: \\\"Introduce your child to the joy of yoga with our Fun Yoga Mat for Kids. Designed with playful colors and made for comfort, it transforms yoga practice into a fun-filled activity.\\\" \\n        },\\n        {\\n            id: 2510,\\n            story: \\\"For those who demand quality, our Premium Weight Yoga Mat is crafted with denser material for better balance and support. Ideal for both beginners and professionals.\\\" \\n        },\\n        {\\n            id: 2525,\\n            story: \\\"Our Supportive Rectangular Cotton Yoga Bolster is the ideal companion for restorative yoga. Its firm support helps in deep relaxation and sustained poses.\\\" \\n        },\\n        {\\n            id: 2567,\\n            story: \\\"Embrace nature with our Textured Natural Rubber Yoga Mat. Its non-slip design is perfect for a sustainable, eco-friendly practice, offering unparalleled grip and comfort.\\\" \\n        }\\n    ];\\n\\n    products.forEach(function(product) {\\n        var productElement \\u003d document.querySelector(\\u0027[data-catalogid\\u003d\\\"\\u0027 + product.id + \\u0027\\\"] .name\\u0027);\\n        if (productElement) {\\n            var descriptionElement \\u003d document.createElement(\\u0027div\\u0027);\\n            descriptionElement.className \\u003d \\u0027product-story\\u0027;\\n            descriptionElement.innerText \\u003d product.story;\\n            productElement.parentNode.appendChild(descriptionElement);\\n        }\\n    });\\n}\\n\\ndocument.addEventListener(\\u0027DOMContentLoaded\\u0027, enrichProductDescriptions);\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.product-story {\\\\n    font-size: 0.9em;\\\\n    color: #555;\\\\n    margin-top: 10px;\\\\n    line-height: 1.4;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\"],\"updated\":false},\"nodePath\":[\"Top\",\"Companies\",\"www.yogadirect.com\",\"Rules\",\"example.com\",\"example.com\",\"Mod Using Storytelling In Product Descriptions Helps Create Script\"]}"}

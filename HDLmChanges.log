thing\\u0027 }\\n          ]\\n        },\\n        {\\n          title: \\u0027Deals \\u0026 Offers\\u0027,\\n          href: \\u0027#\\u0027,\\n          subCategories: [\\n            { title: \\u0027Current Deals\\u0027, href: \\u0027https://www.yogadirect.com/deals\\u0027 },\\n            { title: \\u0027Custom Printing\\u0027, href: \\u0027https://www.yogadirect.com/custom-printing\\u0027 },\\n            { title: \\u0027Rewards\\u0027, href: \\u0027https://www.yogadirect.com/rewards-program\\u0027 }\\n          ]\\n        }\\n      ];\\n\\n      // Clear current navbar content\\n      navbar.innerHTML \\u003d \\u0027\\u0027;\\n\\n      // Add new categories to navbar\\n      newCategories.forEach(category \\u003d\\u003e {\\n        var li \\u003d document.createElement(\\u0027li\\u0027);\\n        li.className \\u003d \\u0027dropdown new-category\\u0027;\\n\\n        var a \\u003d document.createElement(\\u0027a\\u0027);\\n        a.href \\u003d category.href;\\n        a.textContent \\u003d category.title;\\n        a.setAttribute(\\u0027data-toggle\\u0027, \\u0027dropdown\\u0027);\\n\\n        var ul \\u003d document.createElement(\\u0027ul\\u0027);\\n        ul.className \\u003d \\u0027dropdown-menu\\u0027;\\n\\n        category.subCategories.forEach(subCategory \\u003d\\u003e {\\n          var subLi \\u003d document.createElement(\\u0027li\\u0027);\\n          var subA \\u003d document.createElement(\\u0027a\\u0027);\\n          subA.href \\u003d subCategory.href;\\n          subA.textContent \\u003d subCategory.title;\\n          subLi.appendChild(subA);\\n          ul.appendChild(subLi);\\n        });\\n\\n        li.appendChild(a);\\n        li.appendChild(ul);\\n        navbar.appendChild(li);\\n      });\\n    }\\n  });\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.navbar-nav \\u003e li.new-category {\\\\n    margin: 0 15px;\\\\n  }\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\"],\"updated\":false},\"nodePath\":[\"Top\",\"Companies\",\"www.yogadirect.com\",\"Rules\",\"example.com\",\"example.com\",\"Mod A Simplified Navigation Menu With Clearer Categorization Script\"]}"}

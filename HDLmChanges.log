{"source":"WebSockets","type":"add","time":"2024-10-15T01:22:10.214423700Z","top":"Top","group":"Companies","company":"www.yogadirect.com","location":"rules","division":"example.com","site":"example.com","name":"Mod Yoga Direct 1 4 Inch Yoga Mat Script (9)","info":"{\"tooltip\":\"Script modification\",\"type\":\"mod\",\"children\":[],\"details\":{\"name\":\"Mod Yoga Direct 1 4 Inch Yoga Mat Script (9)\",\"extra\":\"\",\"enabled\":true,\"type\":\"script\",\"created\":\"2024-10-15T01:22:05.922Z\",\"lastmodified\":\"2024-10-15T01:22:05.922Z\",\"pathvalue\":\"/yoga-direct-1-4-inch-yoga-mat.html\",\"comments\":\"\",\"prob\":100.0,\"usemode\":\"test\",\"cssselector\":\"\",\"xpath\":\"\",\"find\":[],\"nodeiden\":{\"type\":\"tag\",\"attributes\":{\"tag\":\"head\"},\"counts\":{\"tag\":1},\"parent\":{\"tag\":\"html\"}},\"parameter\":0,\"scripts\":[\"\\n// Create testimonial section and append it to the specified location\\n(function() {\\n    // Define the testimonials\\n    const testimonials \\u003d [\\n        {\\n            text: \\u0027This yoga mat is fantastic! It provides great cushion and support without being too bulky.\\u0027,\\n            author: \\u0027Alex J.\\u0027\\n        },\\n        {\\n            text: \\u0027I love the color options and the durability of this mat. Highly recommend!\\u0027,\\n            author: \\u0027Jamie T.\\u0027\\n        },\\n        {\\n            text: \\u0027Perfect mat for my yoga practice. It stays in place and is very comfortable.\\u0027,\\n            author: \\u0027Taylor R.\\u0027\\n        }\\n    ];\\n\\n    // Locate the product details section\\n    var productDetailsSection \\u003d document.querySelector(\\u0027.product-details\\u0027);\\n\\n    // Create the testimonials HTML structure\\n    var testimonialSection \\u003d document.createElement(\\u0027div\\u0027);\\n    testimonialSection.id \\u003d \\u0027testimonial-section\\u0027;\\n    \\n    var testimonialHeader \\u003d document.createElement(\\u0027h3\\u0027);\\n    testimonialHeader.textContent \\u003d \\u0027What Our Customers Are Saying\\u0027;\\n    testimonialSection.appendChild(testimonialHeader);\\n\\n    var testimonialCarousel \\u003d document.createElement(\\u0027div\\u0027);\\n    testimonialCarousel.id \\u003d \\u0027testimonial-carousel\\u0027;\\n\\n    testimonials.forEach(function(testimonial) {\\n        var testimonialItem \\u003d document.createElement(\\u0027div\\u0027);\\n        testimonialItem.className \\u003d \\u0027testimonial\\u0027;\\n        testimonialItem.innerHTML \\u003d \\u0027\\u003cp\\u003e\\\"\\u0027 + testimonial.text + \\u0027\\\"\\u003c/p\\u003e\\u0027 +\\n                                    \\u0027\\u003cp class\\u003d\\\"testimonial-author\\\"\\u003e─ \\u0027 + testimonial.author + \\u0027\\u003c/p\\u003e\\u0027;\\n        testimonialCarousel.appendChild(testimonialItem);\\n    });\\n\\n    testimonialSection.appendChild(testimonialCarousel);\\n    \\n    // Append the testimonial section below the product details\\n    productDetailsSection.parentNode.insertBefore(testimonialSection, productDetailsSection.nextSibling);\\n})();\\n\"],\"updated\":false},\"nodePath\":[\"Top\",\"Companies\",\"www.yogadirect.com\",\"Rules\",\"example.com\",\"example.com\",\"Mod Yoga Direct 1 4 Inch Yoga Mat Script (9)\"]}"}

{"source":"web","type":"modify","time":"2025-08-03T20:47:22.261083700Z","top":"Top","group":"Companies","company":"www.yogadirect.com","location":"rules","division":"example.com","site":"example.com","name":"Mod Compelling Storytelling Helps Users Connect Emotionally Script","info":"{\"tooltip\":\"Script modification\",\"type\":\"mod\",\"details\":{\"name\":\"Mod Compelling Storytelling Helps Users Connect Emotionally Script\",\"extra\":\"\",\"enabled\":false,\"type\":\"script\",\"created\":\"2025-03-05T18:24:25.312Z\",\"lastmodified\":\"2025-08-03T20:47:22.247Z\",\"find\":[],\"xpath\":\"\",\"pathre\":false,\"scripts\":[\"  document.addEventListener(\\u0027DOMContentLoaded\\u0027, function() {\\n    var newDescription \\u003d `\\n      \\u003cp style\\u003d\\\"font-size: 12pt; font-family: \\u0027Lucida Unicode\\u0027, sans-serif; color: #000; background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\\\"\\u003e\\n        Discover the path to tranquility with our 1/4 Inch Yoga Mat. Designed for both the yoga novice and the devoted practitioner, our mat is more than just a surface ? it\\u0027s your personal sanctuary. Elevate your practice with the perfect blend of support and cushioning, enabling you to achieve the poses you\\u0027ve always aspired to master with ease and comfort.\\n      \\u003c/p\\u003e\\n      \\u003cp style\\u003d\\\"font-size: 12pt; font-family: \\u0027Lucida Unicode\\u0027, sans-serif; color: #000; background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\\\"\\u003e\\n        Feel the unrivaled grip and embrace your focus as you glide through each session, whether at home or in the studio. With a palette of colors to align with your mood and intent, our mat becomes an extension of your yoga journey, helping you to transform your day from ordinary to extraordinary.\\n      \\u003c/p\\u003e\\n      \\u003cp style\\u003d\\\"font-size: 12pt; font-family: \\u0027Lucida Unicode\\u0027, sans-serif; color: #000; background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\\\"\\u003e\\n        Find your peace on our mat and let its stability ground you, while you explore the serenity and strength within.\\n      \\u003c/p\\u003e\\n    `;\\n    var descriptionElement \\u003d document.querySelector(\\u0027#tab-1 .item[itemprop\\u003d\\\"description\\\"]\\u0027);\\n    if (descriptionElement) {\\n      descriptionElement.innerHTML \\u003d newDescription;\\n    }\\n  });\"],\"updated\":true,\"usemode\":\"test\",\"comments\":\"\",\"nodeiden\":{\"type\":\"tag\",\"counts\":{\"tag\":1},\"parent\":{\"tag\":\"html\"},\"attributes\":{\"tag\":\"head\"}},\"parameter\":0,\"cssselector\":\"\",\"probability\":\"\",\"path\":\"/yoga-direct-1-4-inch-yoga-mat.html\"},\"nodePath\":[\"Top\",\"Companies\",\"www.yogadirect.com\",\"Rules\",\"example.com\",\"example.com\",\"Mod Compelling Storytelling Helps Users Connect Emotionally Script\"]}"}
{"source":"web","type":"modify","time":"2025-08-03T20:47:57.936123100Z","top":"Top","group":"Companies","company":"www.yogadirect.com","location":"rules","division":"example.com","site":"example.com","name":"Mod Customer Reviews Provide Social Proof, Increase Trust, Script","info":"{\"tooltip\":\"Script modification\",\"type\":\"mod\",\"details\":{\"name\":\"Mod Customer Reviews Provide Social Proof, Increase Trust, Script\",\"extra\":\"\",\"enabled\":false,\"type\":\"script\",\"created\":\"2025-01-30T21:08:23.214Z\",\"lastmodified\":\"2025-08-03T20:47:57.910Z\",\"find\":[],\"xpath\":\"\",\"pathre\":false,\"scripts\":[\"(function() {\\n    var reviewSectionHTML \\u003d \\u0027\\u003cdiv class\\u003d\\\"review-section\\\"\\u003e\\u0027  \\n        \\u0027\\u003ch2\\u003eCustomer Reviews\\u003c/h2\\u003e\\u0027  \\n        \\u0027\\u003cdiv class\\u003d\\\"star-rating\\\"\\u003e\\u0027  \\n            \\u0027\\u003ci class\\u003d\\\"la la-star\\\"\\u003e\\u003c/i\\u003e\\u0027  \\n            \\u0027\\u003ci class\\u003d\\\"la la-star\\\"\\u003e\\u003c/i\\u003e\\u0027  \\n            \\u0027\\u003ci class\\u003d\\\"la la-star\\\"\\u003e\\u003c/i\\u003e\\u0027  \\n            \\u0027\\u003ci class\\u003d\\\"la la-star\\\"\\u003e\\u003c/i\\u003e\\u0027  \\n            \\u0027\\u003ci class\\u003d\\\"la la-star-half\\\"\\u003e\\u003c/i\\u003e\\u0027  \\n        \\u0027\\u003c/div\\u003e\\u0027  \\n        \\u0027\\u003cp\\u003eShare your thoughts with other customers and let us know what you think about this product!\\u003c/p\\u003e\\u0027  \\n        \\u0027\\u003cdiv class\\u003d\\\"call-to-action\\\"\\u003e\\u0027  \\n            \\u0027\\u003ca href\\u003d\\\"#createreview-modal\\\" data-toggle\\u003d\\\"modal\\\"\\u003eLeave a Review\\u003c/a\\u003e\\u0027  \\n        \\u0027\\u003c/div\\u003e\\u0027  \\n    \\u0027\\u003c/div\\u003e\\u0027;\\n    \\n    var productDetails \\u003d document.querySelector(\\u0027.product-details\\u0027);\\n    if (productDetails) {\\n        var reviewSection \\u003d document.createElement(\\u0027div\\u0027);\\n        reviewSection.innerHTML \\u003d reviewSectionHTML;\\n        productDetails.parentNode.insertBefore(reviewSection, productDetails.nextSibling);\\n    }\\n})();\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.review-section {\\\\n    margin-top: 40px;\\\\n    padding: 20px;\\\\n    border: 1px solid #e6e6e6;\\\\n    border-radius: 8px;\\\\n    background-color: #f9f9f9;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.review-section h2 {\\\\n    font-family: \\\\\\u0027Playfair Display\\\\\\u0027, serif;\\\\n    font-size: 24px;\\\\n    margin-bottom: 10px;\\\\n    color: #333;\\\\n    text-align: center;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.star-rating {\\\\n    display: flex;\\\\n    justify-content: center;\\\\n    margin-bottom: 15px;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.star-rating i {\\\\n    font-size: 18px;\\\\n    color: #ffcc00;\\\\n    margin-right: 3px;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.call-to-action {\\\\n    text-align: center;\\\\n    margin-top: 20px;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.call-to-action a {\\\\n    display: inline-block;\\\\n    padding: 10px 20px;\\\\n    background-color: #007bff;\\\\n    color: #fff;\\\\n    text-decoration: none;\\\\n    border-radius: 4px;\\\\n    transition: background-color 0.3s ease;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.call-to-action a:hover {\\\\n    background-color: #0056b3;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\"],\"updated\":true,\"usemode\":\"test\",\"comments\":\"\",\"nodeiden\":{\"type\":\"tag\",\"counts\":{\"tag\":1},\"parent\":{\"tag\":\"html\"},\"attributes\":{\"tag\":\"head\"}},\"parameter\":0,\"cssselector\":\"\",\"probability\":\"\",\"path\":\"/yoga-direct-1-4-inch-yoga-mat.html\"},\"nodePath\":[\"Top\",\"Companies\",\"www.yogadirect.com\",\"Rules\",\"example.com\",\"example.com\",\"Mod Customer Reviews Provide Social Proof, Increase Trust, Script\"]}"}

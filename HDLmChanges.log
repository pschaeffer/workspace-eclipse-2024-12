et.textContent \\u003d \\u0027h3 {\\\\n    font-size: 1.75em;\\\\n    line-height: 1.4;\\\\n  }\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027h4, h5, h6 {\\\\n    font-size: 1.5em;\\\\n    line-height: 1.5;\\\\n  }\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027p, ul, ol, a {\\\\n    font-size: 1em;\\\\n    line-height: 1.6;\\\\n  }\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.site-header, .footer-logo {\\\\n    text-align: center;\\\\n  }\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.content-holder, .section {\\\\n    text-align: left;\\\\n    margin: 0 auto;\\\\n    max-width: 1200px;\\\\n    padding: 0 20px;\\\\n  }\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.navbar-wrapper, .products-section, .site-footer {\\\\n    text-align: left;\\\\n  }\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\"],\"updated\":false},\"nodePath\":[\"Top\",\"Companies\",\"www.yogadirect.com\",\"Rules\",\"example.com\",\"example.com\",\"Mod Improved Typography Enhances Readability, Makes Important Script\"]}"}
{"source":"WebSockets","type":"add","time":"2025-09-07T16:22:21.172643300Z","top":"Top","group":"Companies","company":"www.yogadirect.com","location":"rules","division":"example.com","site":"example.com","name":"Mod Integrating Social Proof (Customer Reviews And Ratings) Script","info":"{\"tooltip\":\"Script modification\",\"type\":\"mod\",\"children\":[],\"details\":{\"name\":\"Mod Integrating Social Proof (Customer Reviews And Ratings) Script\",\"extra\":\"\",\"enabled\":true,\"type\":\"script\",\"created\":\"2025-09-07T16:22:21.032Z\",\"lastmodified\":\"2025-09-07T16:22:21.032Z\",\"pathvalue\":\"/\",\"comments\":\"\",\"probability\":100,\"usemode\":\"off\",\"cssselector\":\"\",\"xpath\":\"\",\"find\":[],\"nodeiden\":{\"type\":\"tag\",\"attributes\":{\"tag\":\"head\"},\"counts\":{\"tag\":1},\"parent\":{\"tag\":\"html\"}},\"parameter\":0,\"scripts\":[\"    document.addEventListener(\\u0027DOMContentLoaded\\u0027, function() {\\n        const reviewData \\u003d {\\n            2421: {stars: 4, testimonial: \\\"Great mat for beginners!\\\"},\\n            2422: {stars: 5, testimonial: \\\"Love the comfort and grip!\\\"},\\n            71: {stars: 4, testimonial: \\\"Bounce and stability are perfect.\\\"},\\n            161: {stars: 3, testimonial: \\\"Good strap, but could be stronger.\\\"}\\n        };\\n\\n        const products \\u003d document.querySelectorAll(\\u0027.product-item\\u0027);\\n        products.forEach(function(product) {\\n            const catalogId \\u003d product.getAttribute(\\u0027data-catalogid\\u0027);\\n            if (reviewData[catalogId]) {\\n                const {stars, testimonial} \\u003d reviewData[catalogId];\\n                let starsHtml \\u003d \\u0027\\u0027;\\n                for (let i \\u003d 0; i \\u003c stars; i++) {\\n                    starsHtml +\\u003d \\u0027\\u003cspan class\\u003d\\\"fa fa-star\\\"\\u003e\\u003c/span\\u003e\\u0027;\\n                }\\n                for (let i \\u003d stars; i \\u003c 5; i++) {\\n                    starsHtml +\\u003d \\u0027\\u003cspan class\\u003d\\\"fa fa-star-o\\\"\\u003e\\u003c/span\\u003e\\u0027;\\n                }\\n                const reviewHtml \\u003d `\\n                    \\u003cdiv class\\u003d\\\"review-section\\\"\\u003e\\n                        \\u003cdiv class\\u003d\\u0027stars\\u0027\\u003e${starsHtml}\\u003c/div\\u003e\\n                        \\u003cdiv class\\u003d\\u0027testimonial\\u0027\\u003e\\\"${testimonial}\\\"\\u003c/div\\u003e\\n                    \\u003c/div\\u003e\\n                `;\\n                const imgElement \\u003d product.querySelector(\\u0027.img\\u0027);\\n                if (imgElement) {\\n                    imgElement.insertAdjacentHTML(\\u0027afterend\\u0027, reviewHtml);\\n                }\\n            }\\n        });\\n    });\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.product-item .review-section {\\\\n        font-family: \\\\\\u0027Lato\\\\\\u0027, sans-serif;\\\\n        font-size: 0.9em;\\\\n        color: #555;\\\\n        margin-top: 10px;\\\\n    }\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.product-item .stars {\\\\n        color: #FFD700;\\\\n        display: inline-block;\\\\n        margin-right: 5px;\\\\n    }\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\"],\"updated\":false},\"nodePath\":[\"Top\",\"Companies\",\"www.yogadirect.com\",\"Rules\",\"example.com\",\"example.com\",\"Mod Integrating Social Proof (Customer Reviews And Ratings) Script\"]}"}

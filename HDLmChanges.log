{"source":"WebSockets","type":"add","time":"2025-10-27T05:18:28.629951500Z","top":"Top","group":"Companies","company":"www.yogadirect.com","location":"rules","division":"example.com","site":"example.com","name":"Mod Prominent Buttons With Action Focused Text, Like Buy Now Script","info":"{\"tooltip\":\"Script modification\",\"type\":\"mod\",\"children\":[],\"details\":{\"name\":\"Mod Prominent Buttons With Action Focused Text, Like Buy Now Script\",\"extra\":\"\",\"type\":\"script\",\"created\":\"2025-10-27T05:18:28.536Z\",\"lastmodified\":\"2025-10-27T05:18:28.536Z\",\"pathvalue\":\"/\",\"comments\":\"\",\"probability\":100,\"usemode\":\"off\",\"cssselector\":\"\",\"xpath\":\"\",\"find\":[],\"nodeiden\":{\"type\":\"tag\",\"attributes\":{\"tag\":\"head\"},\"counts\":{\"tag\":1},\"parent\":{\"tag\":\"html\"}},\"parameter\":0,\"scripts\":[\"document.addEventListener(\\u0027DOMContentLoaded\\u0027, function() {\\n    document.querySelectorAll(\\u0027button.btn-primary\\u0027).forEach(function(button) {\\n        button.classList.add(\\u0027cta-button\\u0027);\\n        if (button.querySelector(\\u0027.buyitlink-text\\u0027)) {\\n            button.querySelector(\\u0027.buyitlink-text\\u0027).textContent \\u003d \\u0027Add to Cart\\u0027;\\n        }\\n    });\\n\\n    document.querySelectorAll(\\u0027a.btn.btn-primary\\u0027).forEach(function(link) {\\n        link.classList.add(\\u0027cta-button\\u0027);\\n        var buttonText \\u003d link.textContent.trim();\\n        if (buttonText \\u003d\\u003d\\u003d \\u0027Shop Now\\u0027) {\\n            link.textContent \\u003d \\u0027Explore Now\\u0027;\\n        } else if (buttonText \\u003d\\u003d\\u003d \\u0027Select Options\\u0027) {\\n            link.textContent \\u003d \\u0027Add to Cart\\u0027;\\n        }\\n    });\\n});\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.cta-button {\\\\n    background-color: #ff6453;\\\\n    color: #fff !important;\\\\n    padding: 10px 20px;\\\\n    font-size: 18px;\\\\n    border-radius: 5px;\\\\n    margin-top: 10px;\\\\n    display: inline-block;\\\\n    text-transform: uppercase;\\\\n    font-weight: bold;\\\\n    transition: background-color 0.3s ease;\\\\n    cursor: pointer;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.cta-button:hover {\\\\n    background-color: #e05a48;\\\\n    text-decoration: none;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.cta-button:focus {\\\\n    outline: none;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\"],\"updated\":false},\"nodePath\":[\"Top\",\"Companies\",\"www.yogadirect.com\",\"Rules\",\"example.com\",\"example.com\",\"Mod Prominent Buttons With Action Focused Text, Like Buy Now Script\"]}"}
{"source":"WebSockets","type":"add","time":"2025-10-27T05:18:28.643764900Z","top":"Top","group":"Companies","company":"www.yogadirect.com","location":"rules","division":"example.com","site":"example.com","name":"Mod Storytelling In Product Descriptions Can Engage Customers Script","info":"{\"tooltip\":\"Script modification\",\"type\":\"mod\",\"children\":[],\"details\":{\"name\":\"Mod Storytelling In Product Descriptions Can Engage Customers Script\",\"extra\":\"\",\"type\":\"script\",\"created\":\"2025-10-27T05:18:28.539Z\",\"lastmodified\":\"2025-10-27T05:18:28.539Z\",\"pathvalue\":\"/\",\"comments\":\"\",\"probability\":100,\"usemode\":\"off\",\"cssselector\":\"\",\"xpath\":\"\",\"find\":[],\"nodeiden\":{\"type\":\"tag\",\"attributes\":{\"tag\":\"head\"},\"counts\":{\"tag\":1},\"parent\":{\"tag\":\"html\"}},\"parameter\":0,\"scripts\":[\"function enrichProductDescriptions() {\\n    const productsData \\u003d {\\n        \\u00272421\\u0027: \\\"This 1/4 Inch Yoga Mat by Yoga Direct is perfect for both beginners and experienced yogis seeking balance and stability during their practice. Ideal for home or studio use.\\\",\\n        \\u00272422\\u0027: \\\"1/8 Inch Yoga Mat by Yoga Direct is lightweight and great for travel. Its non-slip surface enhances your grip, ensuring safety during difficult poses.\\\",\\n        \\u002771\\u0027: \\\"Our 55-65cm Anti Burst Deluxe Yoga Ball is perfect for core strengthening workouts and physiotherapy routines; use it at home or in your gym.\\\",\\n        \\u0027161\\u0027: \\\"The 8 Ft Cinch Buckle Yoga Strap assists you in achieving difficult poses and improves flexibility. A must-have for any yogi.\\\",\\n        \\u0027148\\u0027: \\\"The 8 Ft D-Ring Yoga Strap offers superior support while deepening your stretches, enabling advanced asanas.\\\",\\n        \\u00271142\\u0027: \\\"Give the gift of yoga with our E-Gift Cards, perfect for yoga enthusiasts to choose their favorite props and accessories.\\\",\\n        \\u00272513\\u0027: \\\"Extra Long Yoga Mat by Yoga Direct is designed for taller practitioners or those who love extra space during their practice.\\\",\\n        \\u00272429\\u0027: \\\"Enhance your stability with this Foam Yoga Block, perfect for beginners and experts to refine their yoga practice.\\\",\\n        \\u00272509\\u0027: \\\"The Fun Yoga Mat For Kids encourages your child\\u0027s interest in yoga with engaging colors and a kid-friendly size.\\\",\\n        \\u00272540\\u0027: \\\"Our Handmade Traditional Mexican Yoga Blanket offers warmth and comfort, a perfect prop for restorative yoga sessions.\\\",\\n        \\u00272510\\u0027: \\\"The Premium Weight Yoga Mat by Yoga Direct offers superior comfort and durability, ideal for intense yoga sessions.\\\",\\n        \\u00271116\\u0027: \\\"Small Cotton Eye Pillow (Natural) is perfect for relaxation and meditation sessions, enhancing your sense of calm.\\\",\\n        \\u00272541\\u0027: \\\"Solid Color Mexican Yoga Blanket delivers on style and function, easily blending with your studio or home décor.\\\",\\n        \\u00272525\\u0027: \\\"Supportive Rectangular Cotton Yoga Bolster aids in restorative yoga by providing the needed support during poses.\\\",\\n        \\u00272567\\u0027: \\\"Textured Natural Rubber Yoga Mat is eco-friendly and provides a non-slip surface, perfect for hot yoga classes.\\\",\\n        \\u00272568\\u0027: \\\"Yoga Mat Towel by Yoga Direct adds extra grip and absorption, ensuring a slip-free practice even in hot yoga.\\\"\\n    };\\n\\n    document.querySelectorAll(\\u0027.product-item\\u0027).forEach(item \\u003d\\u003e {\\n        const catalogId \\u003d item.getAttribute(\\u0027data-catalogid\\u0027);\\n        if (productsData[catalogId]) {\\n            const descriptionElement \\u003d document.createElement(\\u0027div\\u0027);\\n            descriptionElement.className \\u003d \\u0027product-description\\u0027;\\n            descriptionElement.innerText \\u003d productsData[catalogId];\\n            item.querySelector(\\u0027.name\\u0027).parentElement.appendChild(descriptionElement);\\n        }\\n    });\\n}\\n\\ndocument.addEventListener(\\u0027DOMContentLoaded\\u0027, enrichProductDescriptions);\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.product-description {\\\\n    display: none;\\\\n    color: #333;\\\\n    font-size: 0.9em;\\\\n    padding: 10px 0;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.product-item:hover .product-description {\\\\n    display: block;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\"],\"updated\":false},\"nodePath\":[\"Top\",\"Companies\",\"www.yogadirect.com\",\"Rules\",\"example.com\",\"example.com\",\"Mod Storytelling In Product Descriptions Can Engage Customers Script\"]}"}
{"source":"WebSockets","type":"add","time":"2025-10-27T21:59:57.145780400Z","top":"Top","group":"Companies","company":"www.yogadirect.com","location":"rules","division":"example.com","site":"example.com","name":"Mod By Immediately Communicating Key Benefits And Distinguishing Script","info":"{\"tooltip\":\"Script modification\",\"type\":\"mod\",\"children\":[],\"details\":{\"name\":\"Mod By Immediately Communicating Key Benefits And Distinguishing Script\",\"extra\":\"\",\"type\":\"script\",\"created\":\"2025-10-27T21:59:56.926Z\",\"lastmodified\":\"2025-10-27T21:59:56.926Z\",\"pathvalue\":\"/\",\"comments\":\"\",\"probability\":100,\"usemode\":\"off\",\"cssselector\":\"\",\"xpath\":\"\",\"find\":[],\"nodeiden\":{\"type\":\"tag\",\"attributes\":{\"tag\":\"head\"},\"counts\":{\"tag\":1},\"parent\":{\"tag\":\"html\"}},\"parameter\":0,\"scripts\":[\"function enhanceBanner() {\\n    const banner \\u003d document.createElement(\\u0027div\\u0027);\\n    banner.id \\u003d \\u0027homeBanner\\u0027;\\n    banner.innerHTML \\u003d `\\n        \\u003ch1\\u003eDiscover Premium Yoga Gear\\u003c/h1\\u003e\\n        \\u003cp\\u003eExperience unmatched quality and support with our wide range of yoga products.\\u003c/p\\u003e\\n        \\u003ca href\\u003d\\u0027/yoga-mats\\u0027\\u003eShop Now\\u003c/a\\u003e\\n    `;\\n    const sliderSection \\u003d document.querySelector(\\u0027.homepage-slider\\u0027);\\n    sliderSection.parentNode.insertBefore(banner, sliderSection);\\n}\\n\\ndocument.addEventListener(\\u0027DOMContentLoaded\\u0027, enhanceBanner);\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027#homeBanner {\\\\n    background-color: #f5f5f5;\\\\n    padding: 20px 0;\\\\n    text-align: center;\\\\n    margin-bottom: 30px;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027#homeBanner h1 {\\\
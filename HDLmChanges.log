{"source":"web","type":"modify","time":"2025-08-03T20:48:33.276351300Z","top":"Top","group":"Companies","company":"www.yogadirect.com","location":"rules","division":"example.com","site":"example.com","name":"Mod Highlighting Additional Benefits Like Rewards And Savings Script","info":"{\"tooltip\":\"Script modification\",\"type\":\"mod\",\"details\":{\"name\":\"Mod Highlighting Additional Benefits Like Rewards And Savings Script\",\"extra\":\"\",\"enabled\":false,\"type\":\"script\",\"created\":\"2025-01-30T17:25:20.288Z\",\"lastmodified\":\"2025-08-03T20:48:33.263Z\",\"find\":[],\"xpath\":\"\",\"pathre\":false,\"scripts\":[\"window.addEventListener(\\u0027DOMContentLoaded\\u0027, function() {\\n    var productDetailsSection \\u003d document.querySelector(\\u0027.product-cols .col-md-6 .product-details\\u0027);\\n    if (productDetailsSection) {\\n        var rewardsProgram \\u003d document.querySelector(\\u0027.message-1\\u0027);\\n        var quantityPricing \\u003d document.querySelector(\\u0027.message-2\\u0027);\\n\\n        // Clone these elements to insert them inside the product details section if they exist\\n        if (rewardsProgram \\u0026\\u0026 quantityPricing) {\\n            var rewardsClone \\u003d rewardsProgram.cloneNode(true);\\n            var quantityClone \\u003d quantityPricing.cloneNode(true);\\n\\n            // Remove existing messages to avoid duplicate display\\n            rewardsProgram.remove();\\n            quantityPricing.remove();\\n\\n            // Insert the cloned elements into the product details section, before the short description\\n            var shortDescription \\u003d productDetailsSection.querySelector(\\u0027.short-description\\u0027);\\n            if (shortDescription) {\\n                productDetailsSection.insertBefore(quantityClone, shortDescription);\\n                productDetailsSection.insertBefore(rewardsClone, shortDescription);\\n            }\\n        }\\n    }\\n});\"],\"updated\":true,\"usemode\"
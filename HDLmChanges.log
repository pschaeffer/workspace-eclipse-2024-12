u0027Zafus \\u0026 Zabutons\\u0027, href: \\u0027https://www.yogadirect.com/zafus-zabutons\\u0027 },\\n          { label: \\u0027Straps\\u0027, href: \\u0027https://www.yogadirect.com/straps-sandbags\\u0027 }\\n        ]\\n      }\\n    ];\\n    \\n    var otherCategories \\u003d [\\n      { label: \\u0027Bolsters\\u0027, href: \\u0027https://www.yogadirect.com/bolsters\\u0027 },\\n      { label: \\u0027Blankets\\u0027, href: \\u0027https://www.yogadirect.com/blankets\\u0027 },\\n      { label: \\u0027Fitness\\u0027, href: \\u0027https://www.yogadirect.com/yoga-fitness\\u0027, subcategories: [\\n          { label: \\u0027Kids\\u0027, href: \\u0027https://www.yogadirect.com/Kids_c_649.html\\u0027 },\\n          { label: \\u0027Fitness Balls\\u0027, href: \\u0027https://www.yogadirect.com/fitness-balls\\u0027 }\\n        ]\\n      },\\n      { label: \\u0027Clothing\\u0027, href: \\u0027https://www.yogadirect.com/clothing\\u0027 },\\n      { label: \\u0027Deals\\u0027, href: \\u0027https://www.yogadirect.com/deals\\u0027, subcategories: [\\n          { label: \\u0027Sale\\u0027, href: \\u0027https://www.yogadirect.com/sale\\u0027 },\\n          { label: \\u0027Yoga Kits\\u0027, href: \\u0027https://www.yogadirect.com/yoga-kits\\u0027 }\\n        ]\\n      }\\n    ];\\n\\n    var buildMenuItem \\u003d function(category, isPopular) {\\n      var li \\u003d document.createElement(\\u0027li\\u0027);\\n      if (isPopular) li.classList.add(\\u0027popular\\u0027);\\n      var a \\u003d document.createElement(\\u0027a\\u0027);\\n      a.href \\u003d category.href;\\n      a.innerText \\u003d category.label;\\n      li.appendChild(a);\\n\\n      if (category.subcategories) {\\n        li.classList.add(\\u0027dropdown\\u0027);\\n        var ul \\u003d document.createElement(\\u0027ul\\u0027);\\n        ul.className \\u003d \\u0027dropdown-menu\\u0027;\\n        category.subcategories.forEach(function(subcat) {\\n          var subLi \\u003d document.createElement(\\u0027li\\u0027);\\n          var subA \\u003d document.createElement(\\u0027a\\u0027);\\n          subA.href \\u003d subcat.href;\\n          subA.innerText \\u003d subcat.label;\\n          subLi.appendChild(subA);\\n          ul.appendChild(subLi);\\n        });\\n        li.appendChild(ul);\\n      }\\n\\n      return li;\\n    };\\n\\n    categories.innerHTML \\u003d \\u0027\\u0027;\\n    popularCategories.forEach(function(cat) {\\n      categories.appendChild(buildMenuItem(cat, true));\\n    });\\n    otherCategories.forEach(function(cat) {\\n      categories.appendChild(buildMenuItem(cat, false));\\n    });\\n  });\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.navbar-nav \\u003e li.popular {\\\\n    font-weight: bold;\\\\n  }\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027/* Ensure dropdowns are accessible on hover */\\\\n  .navbar-nav \\u003e li:hover \\u003e ul.dropdown-menu {\\\\n    display: block;\\\\n  }\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.dropdown-menu {\\\\n    display: none;\\\\n    position: absolute;\\\\n    background-color: #f9f9f9;\\\\n    min-width: 160px;\\\\n    z-index: 1;\\\\n  }\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.navbar-toggle.collapsed .icon-bar {\\\\n    background-color: #000;\\\\n  }\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.dropdown-menu \\u003e li \\u003e a {\\\\n    padding: 8px 16px;\\\\n    text-decoration: none;\\\\n    display: block;\\\\n  }\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\"],\"updated\":false},\"nodePath\":[\"Top\",\"Companies\",\"www.yogadirect.com\",\"Rules\",\"example.com\",\"example.com\",\"Mod A Streamlined Navigation Will Guide Users More Intuitively, Script\"]}"}

{"source":"WebSockets","type":"add","time":"2025-09-16T17:45:27.556405100Z","top":"Top","group":"Companies","company":"www.yogadirect.com","location":"rules","division":"example.com","site":"example.com","name":"Mod Having Reviews Prominently Displayed Can Enhance The Trust Script","info":"{\"tooltip\":\"Script modification\",\"type\":\"mod\",\"children\":[],\"details\":{\"name\":\"Mod Having Reviews Prominently Displayed Can Enhance The Trust Script\",\"extra\":\"\",\"enabled\":true,\"type\":\"script\",\"created\":\"2025-09-16T17:45:26.877Z\",\"lastmodified\":\"2025-09-16T17:45:26.877Z\",\"pathvalue\":\"/\",\"comments\":\"\",\"probability\":100,\"usemode\":\"off\",\"cssselector\":\"\",\"xpath\":\"\",\"find\":[],\"nodeiden\":{\"type\":\"tag\",\"attributes\":{\"tag\":\"head\"},\"counts\":{\"tag\":1},\"parent\":{\"tag\":\"html\"}},\"parameter\":0,\"scripts\":[\"function fetchRatings(productId) {\\n    // In a real implementation, this function would fetch review data from the server.\\n    return Math.floor(Math.random() * 5) + 1; // Generates a random rating between 1 and 5\\n}\\n\\ndocument.addEventListener(\\u0027DOMContentLoaded\\u0027, function() {\\n    var productItems \\u003d document.querySelectorAll(\\u0027.product-item\\u0027);\\n    productItems.forEach(function(item) {\\n        var catalogId \\u003d item.getAttribute(\\u0027data-catalogid\\u0027);\\n        if (catalogId) {\\n            var ratingValue \\u003d fetchRatings(catalogId);\\n            var ratingDisplay \\u003d document.createElement(\\u0027div\\u0027);\\n            ratingDisplay.className \\u003d \\u0027rating-display\\u0027;\\n            var starContainer \\u003d document.createElement(\\u0027span\\u0027);\\n            starContainer.className \\u003d \\u0027rating-stars\\u0027;\\n            for (var i \\u003d 0; i \\u003c 5; i++) {\\n                if (i \\u003c ratingValue) {\\n                    starContainer.innerHTML +\\u003d \\\"\\u0026#9733;\\\";\\n                } else {\\n                    starContainer.innerHTML +\\u003d \\\"\\u0026#9734;\\\";\\n                }\\n            }\\n            var ratingText \\u003d document.createElement(\\u0027span\\u0027);\\n            ratingText.textContent \\u003d ratingValue.toFixed(1) + \\u0027 out of 5\\u0027;\\n            ratingDisplay.appendChild(starContainer);\\n            ratingDisplay.appendChild(ratingText);\\n            item.querySelector(\\u0027.name\\u0027).appendChild(ratingDisplay);\\n        }\\n    });\\n});\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.product-item .rating-display {\\\\n    display: flex;\\\\n    align-items: center;\\\\n    margin-top: 5px;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.rating-stars {\\\\n    color: #FFD700;\\\\n    margin-right: 5px;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\"],\"updated\":false},\"nodePath\":[\"Top\",\"Companies\",\"www.yogadirect.com\",\"Rules\",\"example.com\",\"example.com\",\"Mod Having Reviews Prominently Displayed Can Enhance The Trust Script\"]}"}

le\\\");\\n  styleSheet.textContent \\u003d \\u0027.product-item .img:hover img {\\\\n  -webkit-transform: scale(1.2);\\\\n  transform: scale(1.2);\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.product-item .zoom-overlay {\\\\n  position: absolute;\\\\n  top: 0;\\\\n  left: 0;\\\\n  right: 0;\\\\n  bottom: 0;\\\\n  display: flex;\\\\n  justify-content: center;\\\\n  align-items: center;\\\\n  background-color: rgba(0, 0, 0, 0.5);\\\\n  opacity: 0;\\\\n  -webkit-transition: opacity 0.3s ease-out;\\\\n  transition: opacity 0.3s ease-out;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.product-item .img:hover .zoom-overlay {\\\\n  opacity: 1;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.zoom-overlay span {\\\\n  color: #fff;\\\\n  font-size: 1.5rem;\\\\n  font-weight: bold;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\"],\"updated\":false},\"nodePath\":[\"Top\",\"Companies\",\"www.yogadirect.com\",\"Rules\",\"example.com\",\"example.com\",\"Mod High Quality Images And Quick Zoom Allow Users To Get A Script\"]}"}

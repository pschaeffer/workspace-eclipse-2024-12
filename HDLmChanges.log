{"source":"WebSockets","type":"modify","time":"2025-11-17T20:30:45.816513300Z","top":"Top","group":"Companies","company":"www.yogadirect.com","location":"rules","division":"example.com","site":"example.com","name":"Mod A Cleaner Header With Organized Navigation Makes It Easier Script","info":"{\"tooltip\":\"Script modification\",\"type\":\"mod\",\"children\":[],\"details\":{\"name\":\"Mod A Cleaner Header With Organized Navigation Makes It Easier Script\",\"extra\":\"\",\"type\":\"script\",\"created\":\"2025-10-27T22:14:48.068Z\",\"lastmodified\":\"2025-10-27T22:14:48.068Z\",\"find\":[],\"prob\":100,\"xpath\":\"\",\"pathre\":false,\"scripts\":[\"    document.addEventListener(\\u0027DOMContentLoaded\\u0027, function() {\\n        document.querySelector(\\u0027.site-header\\u0027).classList.add(\\u0027custom-header\\u0027);\\n        const headerContainer \\u003d document.querySelector(\\u0027.site-header .container-fluid\\u0027);\\n        const customNavHtml \\u003d `\\n            \\u003cnav class\\u003d\\\"custom-nav\\\"\\u003e\\n                \\u003ca href\\u003d\\\"/yoga-mats\\\"\\u003eYoga Mats\\u003c/a\\u003e\\n                \\u003ca href\\u003d\\\"/bolsters\\\"\\u003eBolsters\\u003c/a\\u003e\\n                \\u003ca href\\u003d\\\"/blankets\\\"\\u003eBlankets\\u003c/a\\u003e\\n                \\u003ca href\\u003d\\\"/yoga-props\\\"\\u003eProps\\u003c/a\\u003e\\n                \\u003ca href\\u003d\\\"/yoga-fitness\\\"\\u003eFitness\\u003c/a\\u003e\\n                \\u003ca href\\u003d\\\"/clothing\\\"\\u003eClothing\\u003c/a\\u003e\\n            \\u003c/nav\\u003e`;\\n        const existingLogo \\u003d headerContainer.querySelector(\\u0027.logo\\u0027);\\n        const existingSearch \\u003d headerContainer.querySelector(\\u0027#FRAME_SEARCH\\u0027);\\n        const existingMinicart \\u003d headerContainer.querySelector(\\u0027.minicart\\u0027);\\n\\n        const customGrid \\u003d document.createElement(\\u0027div\\u0027);\\n        customGrid.classL
{"source":"web","type":"modify","time":"2025-08-04T05:30:38.908026700Z","top":"Top","group":"Companies","company":"www.yogadirect.com","location":"rules","division":"example.com","site":"example.com","name":"Script Mod CC Variant 1","info":"{\"tooltip\":\"Script modification\",\"type\":\"mod\",\"details\":{\"name\":\"Script Mod CC Variant 1\",\"extra\":\"\",\"enabled\":false,\"type\":\"script\",\"created\":\"2025-06-05T07:16:10.434Z\",\"lastmodified\":\"2025-08-04T05:30:38.889Z\",\"find\":[],\"prob\":1,\"xpath\":\"\",\"pathre\":false,\"scripts\":[\"( function() {    /* alert(\\\"This script modifies the webpage by adding a call-to-action button and updating the header text to enhance user conversion rates. The button encourages users to shop yoga mats.\\\"); */    const body \\u003d (window.self !\\u003d\\u003d window.top) ? window.parent.document.body : document.body;    if (!body) return;    // Update header text \\n    const header \\u003d body.querySelector(\\u0027.site-header h1\\u0027);    if (header) {        header.innerText \\u003d \\\"Explore Our Premium Yoga Products Today!\\\";    }    // Create a new button \\n    const buttonContainer \\u003d body.querySelector(\\u0027.content-holder\\u0027);    if (buttonContainer) {        const button \\u003d document.createElement(\\u0027button\\u0027);        button.innerText \\u003d \\\"Shop Yoga Mats Now!\\\";        button.className \\u003d \\\"btn btn-success\\\";        button.style.display \\u003d \\\"block\\\";        button.style.margin \\u003d \\\"20px auto\\\";        button.onclick \\u003d function() {            window.location.href \\u003d \\\"/yoga-mats\\\";        };        buttonContainer.prepend(button);    }})();    \"],\"updated\":true,\"usemode\":\"prod\",\"comments\":\"\",\"nodeiden\":{\"type\":\"tag\",\"counts\":{\"tag\":1},\"parent\":{\"tag\":\"html\"},\"attributes\":{\"tag\":\"head\"}},\"parameter\":0,\"cssselector\":\"\",\"probability\":\"\",\"path\":\"//.*/\"},\"nodePath\":[\"Top\",\"Comp
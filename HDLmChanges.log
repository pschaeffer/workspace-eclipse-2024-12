ages \\u003d document.getElementById(\\u0027addl-images\\u0027);\\n  addlImages.parentNode.insertBefore(slider, addlImages.nextSibling);\\n\\n  var currentIndex \\u003d 0;\\n  function showNextTestimonial() {\\n    var active \\u003d slider.querySelector(\\u0027.testimonial.active\\u0027);\\n    active.classList.remove(\\u0027active\\u0027);\\n    currentIndex \\u003d (currentIndex + 1) % testimonials.length;\\n    slider.querySelectorAll(\\u0027.testimonial\\u0027)[currentIndex].classList.add(\\u0027active\\u0027);\\n  }\\n  setInterval(showNextTestimonial, 5000);\\n});\\n\"],\"updated\":false},\"nodePath\":[\"Top\",\"Companies\",\"www.yogadirect.com\",\"Rules\",\"example.com\",\"example.com\",\"Mod Yoga Direct 1 4 Inch Yoga Mat Script (21)\"]}"}

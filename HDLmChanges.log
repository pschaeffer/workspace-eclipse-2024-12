{"source":"WebSockets","type":"add","time":"2025-10-27T21:59:57.163462200Z","top":"Top","group":"Companies","company":"www.yogadirect.com","location":"rules","division":"example.com","site":"example.com","name":"Mod Structuring The Homepage To Lead With High Impact Content Script","info":"{\"tooltip\":\"Script modification\",\"type\":\"mod\",\"children\":[],\"details\":{\"name\":\"Mod Structuring The Homepage To Lead With High Impact Content Script\",\"extra\":\"\",\"type\":\"script\",\"created\":\"2025-10-27T21:59:56.930Z\",\"lastmodified\":\"2025-10-27T21:59:56.930Z\",\"pathvalue\":\"/\",\"comments\":\"\",\"probability\":100,\"usemode\":\"off\",\"cssselector\":\"\",\"xpath\":\"\",\"find\":[],\"nodeiden\":{\"type\":\"tag\",\"attributes\":{\"tag\":\"head\"},\"counts\":{\"tag\":1},\"parent\":{\"tag\":\"html\"}},\"parameter\":0,\"scripts\":[\"  document.addEventListener(\\u0027DOMContentLoaded\\u0027, function() {\\n    const mainContent \\u003d document.querySelector(\\u0027.content-holder\\u0027);\\n    const productSection \\u003d document.querySelector(\\u0027.products-section\\u0027);\\n\\n    const dealsSection \\u003d document.createElement(\\u0027section\\u0027);\\n    dealsSection.className \\u003d \\u0027homepage-section deals-section\\u0027;\\n    dealsSection.innerHTML \\u003d `\\n      \\u003ch2\\u003eSpecial Deals\\u003c/h2\\u003e\\n      \\u003cdiv class\\u003d\\\"deals-items\\\"\\u003e\\n        \\u003c!-- A list of promotional deals could be added here --\\u003e\\n        \\u003cdiv class\\u003d\\\"deal-item\\\"\\u003eUp to 50% off on Yoga Mats!\\u003c/div\\u003e\\n      \\u003c/div\\u003e`;\\n    \\n    const testimonialSection \\u003d document.createElement(\\u0027section\\u0027);\\n    testimonialSection.className \\u003d \\u0027homepage-section testimonial-section\\u0027;\\n    testimonialSection.innerHTML \\u003d `\\n      \\u003ch2\\u003eTestimonials\\u003c/h2\\u003e\\n      \\u003cp\\u003e\\\"YogaDirect\\u0027s products are absolutely top-notch and have significantly enhanced my yoga practice.\\\" - A Happy Customer\\u003c/p\\u003e`;\\n\\n    mainContent.insertAdjacentElement(\\u0027afterbegin\\u0027, productSection);\\n    mainContent.insertAdjacentElement(\\u0027beforeend\\u0027, dealsSection);\\n    mainContent.insertAdjacentElement(\\u0027beforeend\\u0027, testimonialSection);\\n  });\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.homepage-section {\\\\n    display: flex;\\\\n    justify-content: center;\\\\n    align-items: center;\\\\n    flex-wrap: wrap;\\\\n    margin-bottom: 30px;\\\\n  }\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.homepage-section h2 {\\\\n    width: 100%;\\\\n    text-align: center;\\\\n    margin-bottom: 20px;\\\\n    font-family: \\\\\\u0027Playfair Display\\\\\\u0027, serif;\\\\n    font-size: 2rem;\\\\n  }\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.category-section, .deals-section, .testimonial-section {\\\\n    width: 100%;\\\\n    box-sizing: border-box;\\\\n    padding: 20px;\\\\n    background-color: #f7f7f7;\\\\n  }\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.testimonial-section p {\\\\n    font-style: italic;\\\\n    text-align: center;\\\\n  }\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\"],\"updated\":false},\"nodePath\":[\"Top\",\"Companies\",\"www.yogadirect.com\",\"Rules\",\"example.com\",\"example.com\",\"Mod Structuring The Homepage To Lead With High Impact Content Script\"]}"}
{"source":"WebSockets","type":"add","time":"2025-10-27T22:14:48.129559700Z","top":"Top","group":"Companies","company":"www.yogadirect.com","location":"rules","division":"example.com","site":"example.com","name":"Mod A Cleaner Header With Organized Navigation Makes It Easier Script","info":"{\"tooltip\":\"Script modification\",\"type\":\"mod\",\"children\":[],\"details\":{\"name\":\"Mod A Cleaner Header With Organized Navigation Makes It Easier Script\",\"extra\":\"\",\"type\":\"script\",\"created\":\"2025-10-27T22:14:48.068Z\",\"lastmodified\":\"2025-10-27T22:14:48.068Z\",\"pathvalue\":\"/\",\"comments\":\"\",\"probability\":100,\"usemode\":\"off\",\"cssselector\":\"\",\"xpath\":\"\",\"find\":[],\"nodeiden\":{\"type\":\"tag\",\"attributes\":{\"tag\":\"head\"},\"counts\":{\"tag\":1},\"parent\":{\"tag\":\"html\"}},\"parameter\":0,\"scripts\":[\"    document.addEventListener(\\u0027DOMContentLoaded\\u0027, function() {\\n        document.querySelector(\\u0027.site-header\\u0027).classList.add(\\u0027custom-header\\u0027);\\n        const headerContainer \\u003d document.querySelector(\\u0027.site-header .container-fluid\\u0027);\\n        const customNavHtml \\u003d `\\n            \\u003cnav class\\u003d\\\"custom-nav\\\"\\u003e\\n                \\u003ca href\\u003d\\\"/yoga-mats\\\"\\u003eYoga Mats\\u003c/a\\u003e\\n                \\u003ca href\\u003d\\\"/bolsters\\\"\\u003eBolsters\\u003c/a\\u003e\\n                \\u003ca href\\u003d\\\"/blankets\\\"\\u003eBlankets\\u003c/a\\u003e\\n                \\u003ca href\\u003d\\\"/yoga-props\\\"\\u003eProps\\u003c/a\\u003e\\n                \\u003ca href\\u003d\\\"/yoga-fitness\\\"\\u003eFitness\\u003c/a\\u003e\\n                \\u003ca href\\u003d\\\"/clothing\\\"\\u003eClothing\\u003c/a\\u003e\\n            \\u003c/nav\\u003e`;\\n        const existingLogo \\u003d headerContainer.querySelector(\\u0027.logo\\u0027);\\n        const existingSearch \\u003d headerContainer.querySelector(\\u0027#FRAME_SEARCH\\u0027);\\n  
;\\n      label.classList.add(\\u0027category-label\\u0027);\\n      item.appendChild(image);\\n      item.appendChild(label);\\n      container.appendChild(item);\\n    });\\n    document.body.prepend(container);\\n  });\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.category-grid {\\\\n    display: grid;\\\\n    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));\\\\n    gap: 16px;\\\\n    margin-top: 20px;\\\\n  }\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.category-item {\\\\n    background-color: #f5f5f5;\\\\n    border-radius: 8px;\\\\n    padding: 10px;\\\\n    text-align: center;\\\\n    transition: transform 0.3s;\\\\n  }\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.category-item:hover {\\\\n    transform: scale(1.05);\\\\n  }\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.category-label {\\\\n    font-size: 1.2em;\\\\n    margin-top: 10px;\\\\n    color: #333;\\\\n  }\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.category-image {\\\\n    width: 100%;\\\\n    height: auto;\\\\n    max-height: 150px;\\\\n    object-fit: cover;\\\\n    border-radius: 5px;\\\\n  }\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\"],\"updated\":false},\"nodePath\":[\"Top\",\"Companies\",\"www.yogadirect.com\",\"Rules\",\"example.com\",\"example.com\",\"Mod An Intuitive And Visually Organized Layout Helps Users Script\"]}"}

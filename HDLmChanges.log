{"source":"WebSockets","type":"add","time":"2025-09-26T16:35:19.122374Z","top":"Top","group":"Companies","company":"www.yogadirect.com","location":"rules","division":"example.com","site":"example.com","name":"Mod User Generated Content Like Customer Reviews Can Greatly Script","info":"{\"tooltip\":\"Script modification\",\"type\":\"mod\",\"children\":[],\"details\":{\"name\":\"Mod User Generated Content Like Customer Reviews Can Greatly Script\",\"extra\":\"\",\"type\":\"script\",\"created\":\"2025-09-26T16:35:18.407Z\",\"lastmodified\":\"2025-09-26T16:35:18.407Z\",\"pathvalue\":\"/\",\"comments\":\"\",\"probability\":100,\"usemode\":\"off\",\"cssselector\":\"\",\"xpath\":\"\",\"find\":[],\"nodeiden\":{\"type\":\"tag\",\"attributes\":{\"tag\":\"head\"},\"counts\":{\"tag\":1},\"parent\":{\"tag\":\"html\"}},\"parameter\":0,\"scripts\":[\"    const reviews \\u003d {\\n        \\\"2421\\\": [\\n            { name: \\\"Jessica\\\", text: \\\"Great mat, very comfortable and durable!\\\" },\\n            { name: \\\"John\\\", text: \\\"Good quality for the price.\\\" }\\n        ],\\n        \\\"2422\\\": [\\n            { name: \\\"Emily\\\", text: \\\"Lightweight and easy to carry around.\\\" }\\n        ]\\n    };\\n    function appendReviews() {\\n        document.querySelectorAll(\\u0027.product-item\\u0027).forEach(item \\u003d\\u003e {\\n            let catalogid \\u003d item.getAttribute(\\u0027data-catalogid\\u0027);\\n            if (reviews[catalogid]) {\\n                let reviewSection \\u003d document.createElement(\\u0027div\\u0027);\\n                reviewSection.className \\u003d \\u0027reviews-section\\u0027;\\n                let heading \\u003d document.createElement(\\u0027div\\u0027);\\n                heading.className \\u003d \\u0027reviews-heading\\u0027;\\n                heading.innerText \\u003d \\u0027Customer Reviews\\u0027;\\n                reviewSection.appendChild(heading);\\n                reviews[catalogid].forEach(review \\u003d\\u003e {\\n                    let reviewItem \\u003d document.createElement(\\u0027div\\u0027);\\n                    reviewItem.className \\u003d \\u0027review-item\\u0027;\\n                    let name \\u003d document.createElement(\\u0027div\\u0027);\\n                    name.className \\u003d \\u0027reviewer-name\\u0027;\\n                    name.innerText \\u003d review.name;\\n                    let text \\u003d document.createElement(\\u0027div\\u0027);\\n                    text.className \\u003d \\u0027review-text\\u0027;\\n                    text.innerText \\u003d review.text;\\n                    reviewItem.appendChild(name);\\n                    reviewItem.appendChild(text);\\n                    reviewSection.appendChild(reviewItem);\\n                });\\n                item.appendChild(reviewSection);\\n            }\\n        });\\n    }\\n    document.addEventListener(\\u0027DOMContentLoaded\\u0027, appendReviews);\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.reviews-section {\\\\n        margin: 20px 0;\\\\n    }\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.reviews-heading {\\\\n        font-size: 1.2em;\\\\n        margin-bottom: 10px;\\\\n    }\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.review-item {\\\\n        border: 1px solid #e3e3e3;\\\\n        padding: 15px;\\\\n        margin-bottom: 15px;\\\\n        background-color: #f8f8f8;\\\\n        border-radius: 5px;\\\\n    }\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.reviewer-name {\\\\n        font-weight: bold;\\\\n        margin-bottom: 5px;\\\\n    }
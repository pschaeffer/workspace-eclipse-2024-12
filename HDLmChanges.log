ga mat, keeps them active and entertained - Sarah W.\\\"\\n    ];\\n\\n    const storytellingDiv \\u003d document.createElement(\\u0027div\\u0027);\\n    storytellingDiv.classList.add(\\u0027storytelling\\u0027);\\n    storytellingDiv.textContent \\u003d storytellingContent[index % storytellingContent.length];\\n\\n    const reviewDiv \\u003d document.createElement(\\u0027div\\u0027);\\n    reviewDiv.classList.add(\\u0027storytelling\\u0027);\\n    reviewDiv.innerHTML \\u003d `\\u003cspan class\\u003d\\\"review-highlight\\\"\\u003eCustomer Review:\\u003c/span\\u003e \\\"${customerReviews[index % customerReviews.length]}\\\"`;\\n\\n    product.querySelector(\\u0027.name\\u0027).insertAdjacentElement(\\u0027afterend\\u0027, storytellingDiv);\\n    storytellingDiv.insertAdjacentElement(\\u0027afterend\\u0027, reviewDiv);\\n  });\\n});\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.storytelling {\\\\n  background-color: #f9f9f9;\\\\n  padding: 20px;\\\\n  border: 1px solid #eaeaea;\\\\n  border-radius: 8px;\\\\n  margin-bottom: 20px;\\\\n  font-style: italic;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.review-highlight {\\\\n  color: #2c7;\\\\n  font-weight: bold;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\"],\"updated\":false},\"nodePath\":[\"Top\",\"Companies\",\"www.yogadirect.com\",\"Rules\",\"example.com\",\"example.com\",\"Mod Storytelling Helps In Building An Emotional Connection Script\"]}"}

{"source":"web","type":"modify","time":"2025-08-03T20:47:06.948763600Z","top":"Top","group":"Companies","company":"www.yogadirect.com","location":"rules","division":"example.com","site":"example.com","name":"Mod By Making The Add to Cart Button More Visually Striking, Script","info":"{\"tooltip\":\"Script modification\",\"type\":\"mod\",\"details\":{\"name\":\"Mod By Making The Add to Cart Button More Visually Striking, Script\",\"extra\":\"\",\"enabled\":false,\"type\":\"script\",\"created\":\"2025-01-31T19:29:40.007Z\",\"lastmodified\":\"2025-08-03T20:47:06.935Z\",\"find\":[],\"xpath\":\"\",\"pathre\":false,\"scripts\":[\"    document.addEventListener(\\u0027DOMContentLoaded\\u0027, function() {\\n        var addToCartButton \\u003d document.querySelector(\\u0027.btn-addcart\\u0027);\\n        if (addToCartButton) {\\n            addToCartButton.style.width \\u003d \\u0027100%\\u0027;  /* Ensures full-width for better visibility */\\n        }\\n    });\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.btn-addcart {\\\\n        background-color: #ff9800; /* Brighten the contrast with a vivid color */\\\\n        color: white;\\\\n        font-size: 1.25rem; /* Larger font size for prominence */\\\\n        padding: 12px 16px; /* Extra padding for a large button */\\\\n        border-radius: 5px;\\\\n        text-transform: uppercase;\\\\n        transition: background-color 0.3s ease;\\\\n    }\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.btn-addcart:hover {\\\\n        background-color: #e68900; /* Slightly darker shade on hover for effect */\\\\n    }\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\"],\"updated\":true,\"usemode\":\"test\",\"comments\":\"\",\"nodeiden\":{\"type\":\"tag\",\"counts\":{\"tag\":1},\"parent\":{\"tag\":\"html\"},\"attributes\":{\"tag\":\"head\"}}
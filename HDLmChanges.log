{"source":"web","type":"modify","time":"2025-08-03T20:46:17.114383700Z","top":"Top","group":"Companies","company":"www.yogadirect.com","location":"rules","division":"example.com","site":"example.com","name":"Mod A Faster Loading Website Improves User Experience, Reducing Script","info":"{\"tooltip\":\"Script modification\",\"type\":\"mod\",\"details\":{\"name\":\"Mod A Faster Loading Website Improves User Experience, Reducing Script\",\"extra\":\"\",\"enabled\":false,\"type\":\"script\",\"created\":\"2025-02-06T19:42:42.179Z\",\"lastmodified\":\"2025-08-03T20:46:17.103Z\",\"find\":[],\"xpath\":\"\",\"pathre\":false,\"scripts\":[\"  document.addEventListener(\\u0027DOMContentLoaded\\u0027, function() {\\n    var nonEssentialScripts \\u003d [\\n      \\\"https://www.yogadirect.com/assets/templates/common-core/js/jquery.ui.widget.js?vcart\\u003d25.3.0\\\",\\n      \\\"https://www.yogadirect.com/assets/templates/common-core/js/jquery.iframe-transport.js?vcart\\u003d25.3.0\\\",\\n      \\\"https://www.yogadirect.com/assets/templates/common-core/js/jquery.fileupload.js?vcart\\u003d25.3.0\\\",\\n      \\\"https://www.yogadirect.com/assets/templates/common-core/js/listing-reviews.js?vcart\\u003d25.3.0\\\",\\n      \\\"https://www.yogadirect.com/assets/templates/common-core/quicksearch/jquery.quicksearch.js?vcart\\u003d25.3.0\\\"\\n    ];\\n    nonEssentialScripts.forEach(function(src) {\\n      var script \\u003d document.createElement(\\u0027script\\u0027);\\n      script.async \\u003d true;\\n      script.src \\u003d src;\\n      document.body.appendChild(script);\\n    });\\n  });\"],\"updated\":true,\"usemode\":\"test\",\"comments\":\"\",\"nodeiden\":{\"type\":\"tag\",\"counts\":{\"tag\":1},\"parent\":{\"tag\":\"html\"},\"attributes\":{\"tag\":\"head\"}},\"parameter\":0,\"cssselector\":\"\",\"probability\":\"\",\"path\":\"/yoga-direct-1-4-inch-yoga-mat.html\"},\"nodePath\":[\"Top\",\"Companies\",\"www.yogadirect.com\",\"Rules\",\"example.com\",\"example.com\",\"Mod A Fa
ustom-grid {\\\\n        display: grid;\\\\n        grid-template-columns: 1fr 2fr 1fr;\\\\n        align-items: center;\\\\n        gap: 10px;\\\\n    }\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.custom-search {\\\\n        max-width: 280px;\\\\n        padding-left: 15px;\\\\n    }\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.custom-cart {\\\\n        text-align: right;\\\\n    }\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\"],\"updated\":false,\"usemode\":\"test\",\"comments\":\"\",\"nodeiden\":{\"type\":\"tag\",\"counts\":{\"tag\":1},\"parent\":{\"tag\":\"html\"},\"attributes\":{\"tag\":\"head\"}},\"parameter\":0,\"cssselector\":\"\",\"pathvalue\":\"/\",\"probability\":\"\"},\"id\":\"17995\",\"nodePath\":[\"Top\",\"Companies\",\"www.yogadirect.com\",\"Rules\",\"example.com\",\"example.com\",\"Mod A Cleaner Header With Organized Navigation Makes It Easier Script\"]}"}

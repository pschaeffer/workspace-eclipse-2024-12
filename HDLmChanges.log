{"source":"WebSockets","type":"add","time":"2025-10-05T16:38:59.988336800Z","top":"Top","group":"Companies","company":"www.yogadirect.com","location":"rules","division":"example.com","site":"example.com","name":"Mod Vibrant, Contrasting Colors Draw Users\u0027 Attention And Make Script","info":"{\"tooltip\":\"Script modification\",\"type\":\"mod\",\"children\":[],\"details\":{\"name\":\"Mod Vibrant, Contrasting Colors Draw Users\\u0027 Attention And Make Script\",\"extra\":\"\",\"type\":\"script\",\"created\":\"2025-10-05T16:38:50.977Z\",\"lastmodified\":\"2025-10-05T16:38:50.977Z\",\"pathvalue\":\"/\",\"comments\":\"\",\"probability\":100,\"usemode\":\"off\",\"cssselector\":\"\",\"xpath\":\"\",\"find\":[],\"nodeiden\":{\"type\":\"tag\",\"attributes\":{\"tag\":\"head\"},\"counts\":{\"tag\":1},\"parent\":{\"tag\":\"html\"}},\"parameter\":0,\"scripts\":[\"\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027/* Update button colors for better visibility and engagement */\\\\n.btn-primary {\\\\n    background-color: #ff5700; /* vibrant orange */\\\\n    border-color: #ff5700;\\\\n    color: #ffffff;\\\\n    font-weight: bold;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027/* Update banner text and button hover effect */\\\\n.bannertxt h2 {\\\\n    font-family: \\\\\\u0027Roboto Condensed\\\\\\u0027, sans-serif;\\\\n    color: #2c3e50; /* dark blue for contrast */\\\\n    text-shadow: 1px 1px 2px #ffffff; /* subtle text shadow for depth */\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.btn-primary:hover {\\\\n    background-color: #e14a00; /* slightly darker shade on hover */\\\\n    border-color: #e14a00;\\\\n    color: #ffffff;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027/* Banner section styles */\\\\n.homeTopBanner a img, .homeBottomBanner a img {\\\\n    filter: brightness(0.9); /* make images slightly darker to enhance text readability */\\\\n    transition: filter 0.3s ease;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.homeTopBanner a img:hover, .homeBottomBanner a img:hover {\\\\n    filter: brightness(1); /* revert to original when hovered */\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027/* Adjust promotional banners for consistency */\\\\n.shippingtext, .store-messages .message {\\\\n    background-color: #2c3e50; /* unify with dark blue color */\\\\n    color: #ffffff;\\\\n    padding: 10px;\\\\n    border-radius: 5px;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027/* Ensure promotional links are visible */\\\\n.shippingtext a, .store-messages .message a {\\\\n    color: #ff5700;\\\\n    font-weight: bold;\\\\n    text-decoration: none;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.shippingtext a:hover, .store-messages .message a:hover {\\\\n    text-decoration: underline;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\"],\"updated\":false},\"nodePath\":[\"Top\",\"Companies\",\"www.yogadirect.com\",\"Rules\",\"example.com\",\"example.com\",\"Mod Vibrant, Contrasting Colors Draw Users\\u0027 Attention And Make Script\"]}"}
{"source":"WebSockets","type":"add","time":"2025-10-05T16:39:00.008103500Z","top":"Top","group":"Companies","company":"www.yogadirect.com","location":"rules","division":"example.com","site":"example.com","name":"Mod Streamlining The Navigation Menu Focuses Users\u0027 Attention Script","info":"{\"tooltip\":\"Script modification\",\"type\":\"mod\",\"children\":[],\"details\":{\"name\":\"Mod Streamlining The Navigation Menu Focuses Users\\u0027 Attention Script\",\"extra\":\"\",\"type\":\"script\",\"created\":\"2025-10-05T16:38:50.982Z\",\"lastmodified\":\"2025-10-05T16:38:50.982Z\",\"pathvalue\":\"/\",\"comments\":\"\",\"probability\":100,\"usemode\":\"off\",\"cssselector\":\"\",\"xpath\":\"\",\"find\":[],\"nodeiden\":{\"type\":\"tag\",\"attributes\":{\"tag\":\"head\"},\"counts\":{\"tag\":1},\"parent\":{\"tag\":\"html\"}},\"parameter\":0,\"scripts\":[\"  document.addEventListener(\\u0027DOMContentLoaded\\u0027, function() {\\n    var navbar \\u003d document.getElementById(\\u0027navbar\\u0027);\\n    var categories \\u003d document.getElementById(\\u0027categories\\u0027);\\n\\n    var newCategories \\u003d [\\n      { name: \\u0027Yoga Mats\\u0027, href: \\u0027/yoga-mats\\u0027 },\\n      { name: \\u0027Deals\\u0027, href: \\u0027/deals\\u0027 },\\n      { name: \\u0027More\\u0027, href: \\u0027#\\u0027, dropdown: true, subcategories: [\\n        { name: \\u0027Props\\u0027, href: \\u0027/yoga-props\\u0027 },\\n        { name: \\u0027Fitness\\u0027, href: \\u0027/yoga-fitness\\u0027 },\\n        { name: \\u0027Clothing\\u0027, href: \\u0027/clothing\\u0027 },\\n        { name: \\u0027Custom Printing\\u0027, href: \\u0027/custom-printing\\u0027 },\\n      ] }\\n    ];\\n\\n    var navHTML \\u003d newCategories.map(function(category) {\\n      if (category.dropdown) {\\n        return \\u0027\\u003cli class\\u003d\\\"dropdown\\\"\\u003e\\u0027 +\\n                 \\u0027\\u003ca href\\u003d\\\"\\u0027+category.href+\\u0027\\\" data-toggle\\u003d\\\"dropdown\\\"\\u00
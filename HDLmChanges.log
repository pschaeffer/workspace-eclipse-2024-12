ndChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027a {    color: #2980b9;    text-decoration: none;    transition: color 0.3s;  }\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027a:hover {    color: #3498db;  }\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.btn-primary {    background-color: #2980b9;    border-color: #2980b9;  }\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.btn-primary:hover {    background-color: #3498db;    border-color: #3498db;  }\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027h2, h3, h4, h5, h6 {    font-family: \\\\\\u0027Playfair Display\\\\\\u0027, serif;    color: #2c3e50;  }\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.footer-logo, .navbar-header {\\\\n     background-color: #ecf0f1;  }\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\"],\"updated\":false},\"nodePath\":[\"Top\",\"Companies\",\"www.yogadirect.com\",\"Rules\",\"example.com\",\"example.com\",\"Mod The Current Use Of Colors And Fonts Appears Outdated And Script\"]}"}
{"source":"WebSockets","type":"add","time":"2025-09-16T03:41:43.414457200Z","top":"Top","group":"Companies","company":"www.yogadirect.com","location":"rules","division":"example.com","site":"example.com","name":"Mod The Current Navigation Menu Is Cluttered With Links That Script","info":"{\"tooltip\":\"Script modification\",\"type\":\"mod\",\"children\":[],\"details\":{\"name\":\"Mod The Current Navigation Menu Is Cluttered With Links That Script\",\"extra\":\"\",\"enabled\":true,\"type\":\"script\",\"created\":\"2025-09-16T03:41:43.087Z\",\"lastmodified\":\"2025-09-16T03:41:43.087Z\",\"pathvalue\":\"/\",\"comments\":\"\",\"probability\":100,\"usemode\":\"off\",\"cssselector\":\"\",\"xpath\":\"\",\"find\":[],\"nodeiden\":{\"type\":\"tag\",\"attributes\":{\"tag\":\"head\"},\"counts\":{\"tag\":1},\"parent\":{\"tag\":\"html\"}},\"parameter\":0,\"scripts\":[\"document.addEventListener(\\u0027DOMContentLoaded\\u0027, function() {\\n    var originalNav \\u003d document.querySelector(\\u0027.navbar-nav\\u0027);\\n    var simplifiedNav \\u003d document.createElement(\\u0027ul\\u0027);\\n    simplifiedNav.className \\u003d \\u0027simplified-menu\\u0027;\\n\\n    var categories \\u003d [\\n        { name: \\u0027Mats\\u0027, href: \\u0027https://www.yogadirect.com/yoga-mats\\u0027, \\n          subCategories: [\\n              { name: \\u0027Classic\\u0027, href: \\u0027https://www.yogadirect.com/Classic_c_662.html\\u0027 },\\n              { name: \\u0027Premium\\u0027, href: \\u0027https://www.yogadirect.com/premium-mats\\u0027 },\\n              { name: \\u0027Specialty Mats\\u0027, href: \\u0027https://www.yogadirect.com/specialty-mats\\u0027 }\\n          ]\\n        },\\n        { name: \\u0027Bolsters\\u0027, href: \\u0027https://www.yogadirect.com/bolsters\\u0027 },\\n        { name: \\u0027Blankets\\u0027, href: \\u0027https://www.yogadirect.com/blankets\\u0027 },\\n        { name: \\u0027Props\\u0027, href: \\u0027https://www.yogadirect.com/yoga-props\\u0027, \\n          subCategories: [\\n              { name: \\u0027Blocks \\u0026 Wedges\\u0027, href: \\u0027https://www.yogadirect.com/blocks-wedges\\u0027 },\\n              { name: \\u0027Straps\\u0027, href: \\u0027https://www.yogadirect.com/straps-sandbags\\u0027 }\\n          ]\\n        },\\n        { name: \\u0027Deals\\u0027, href: \\u0027https://www.yogadirect.com/deals\\u0027 }\\n    ];\\n\\n    categories.forEach(function(category) {\\n        var li \\u003d document.createElement(\\u0027li\\u0027);\\n        var a \\u003d document.createElement(\\u0027a\\u0027);\\n        a.textContent \\u003d category.name;\\n        a.href \\u003d category.href;\\n        li.appendChild(a);\\n\\n        if (category.subCategories) {\\n            var subMenu \\u003d document.createElement(\\u0027ul\\u0027);\\n            subMenu.className \\u003d \\u0027dropdown-menu\\u0027;\\n            category.subCategories.forEach(function(subCategory) {\\n                var subLi \\u003d document.createElement(\\u0027li\\u0027);\\n                var subA \\u003d document.createElement(\\u0027a\\u0027);\\n                subA.textContent \\u003d subCategory.name;\\n                subA.href \\u003d subCategory.href;\\n                subLi.appendChild(subA);\\n                subMenu.appendChild(subLi);\\n            });\\n            li.appendChild(subMenu);\\n        }\\n\\n        simplifiedNav.appendChild(li);\\n    });\\n\\n    originalNav.parentNode.replaceChild(simplifiedNav, originalNav);\\n});\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.simplified-menu {\\\\n    display: flex;\\\\n    justify-content: space-around;\\\\n    align-items: center;\\\\n    background-color: #f8f8f8;\\\\n    padding: 10px 0;\\\\n    margin: 0 auto;\\\\n    width: 100%;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.simplified-menu li {\\\\n    list-style: none;\\\\n    position: relative;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.simplified-menu a {\\\\n    color: #333;\\\\n    text-decoration: none;\\\\n    padding: 10px 15px;\\\\n    display: inline-block;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.simplified-menu a:hover {\\\\n    background-color: #ddd;\\\\n    color: #000;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.simplified-menu li:hover .dropdown-menu {\\\\n    display: block;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.dropdown-menu {\\\\n    display: none;\\\\n    position: absolute;\\\\n    background-color: #f8f8f8;\\\\n    min-width: 150px;\\\\n    box-shadow: 0 8px 16px rgba(0,0,0,0.2);\\\\n    z-index: 1;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.dropdown-menu a {\\\\n    padding: 8px 16px;\\\\n    text-decoration: none;\\\\n    display: block;\\\\n    color: #333;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.dropdown-menu a:hover {\\\\n    background-color: #ddd;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\"],\"updated\":false},\"nodePath\":[\"Top\",\"Companies\",\"www.yogadirect.com\",\"Rules\",\"example.com\",\"example.com\",\"Mod The Current Navigation Menu Is Cluttered With Links That Script\"]}"}

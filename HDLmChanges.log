{"source":"web","type":"modify","time":"2025-08-03T20:46:28.388553300Z","top":"Top","group":"Companies","company":"www.yogadirect.com","location":"rules","division":"example.com","site":"example.com","name":"Mod A Well Crafted Product Description Can Significantly Enhance Script","info":"{\"tooltip\":\"Script modification\",\"type\":\"mod\",\"details\":{\"name\":\"Mod A Well Crafted Product Description Can Significantly Enhance Script\",\"extra\":\"\",\"enabled\":false,\"type\":\"script\",\"created\":\"2025-03-05T18:19:15.828Z\",\"lastmodified\":\"2025-08-03T20:46:28.375Z\",\"find\":[],\"xpath\":\"\",\"pathre\":false,\"scripts\":[\"document.addEventListener(\\\"DOMContentLoaded\\\", function() {\\n    var descriptionContainer \\u003d document.querySelector(\\\"#tab-1 .item\\\");\\n    var enhancedDescriptionHtml \\u003d `\\n        \\u003cdiv class\\u003d\\u0027enhanced-description\\u0027\\u003e\\n            \\u003ch2\\u003eWhy Choose Our 1/4 Inch Yoga Mat?\\u003c/h2\\u003e\\n            \\u003cul\\u003e\\n                \\u003cli\\u003eExtra thick and super sticky for better grip and comfort.\\u003c/li\\u003e\\n                \\u003cli\\u003eDesigned for durability to last through countless sessions.\\u003c/li\\u003e\\n                \\u003cli\\u003eChoose from a variety of colors to match your style.\\u003c/li\\u003e\\n                \\u003cli\\u003eLightweight and portable, ideal for travel and class use.\\u003c/li\\u003e\\n                \\u003cli\\u003eFree from latex and phthalates, ensuring a safe and healthy practice.\\u003c/li\\u003e\\n                \\u003cli\\u003eEasy maintenance and care instructions provided.\\u003c/li\\u003e\\n            \\u003c/ul\\u003e\\n        \\u003c/div\\u003e\\n    `;\\n    descriptionContainer.insertAdjacentHTML(\\u0027afterend\\u0027, enhancedDescriptionHtml);\\n});\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.enhanced-description {\\\\n    margin-top: 20px;\\\\n    border: 1px solid #e0e0e0;\\\\n    padding: 15px;\\\\n    background-color: #f9f9f9;\\\\n    font-family: \\\"Lucida Unicode\\\", sans-serif;\\\\n    font-size: 14px;\\\\n    color: #333;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.enhanced-description h2 {\\\\n    font-size: 18px;\\\\n    color: #000;\\\\n    margin-bottom: 10px;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.enhanced-description ul {\\\\n    list-style-type: disc;\\\\n    padding-left: 20px;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.enhanced-description ul li {\\\\n    margin-bottom: 5px;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\"],\"updated\":true,\"usemode\":\"test\",\"comments\":\"\",\"nodeiden\":{\"type\":\"tag\",\"counts\":{\"tag\":1},\"parent\":{\"tag\":\"html\"},\"attributes\":{\"tag\":\"head\"}},\"parameter\":0,\"cssselector\":\"\",\"probability\":\"\",\"path\":\"/yoga-direct-1-4-inch-yoga-mat.html\"},\"nodePath\":[\"Top\",\"Companies\",\"www.yogadirect.com\",\"Rules\",\"example.com\",\"example.com\",\"Mod A Well Crafted Product Description Can Significantly Enhance Script\"]}"}

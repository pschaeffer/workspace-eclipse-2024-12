ing: 10px 20px;\\\\n  transition: background-color 0.3s ease;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.add-to-cart:hover {\\\\n  background-color: #e35d57;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.header-specials {\\\\n  font-size: 2.5rem;\\\\n  text-align: center;\\\\n  margin-bottom: 20px;\\\\n  color: #333;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\"],\"updated\":false},\"nodePath\":[\"Top\",\"Companies\",\"www.yogadirect.com\",\"Rules\",\"example.com\",\"example.com\",\"Mod Product Images And Their Corresponding CTAs (Add to Cart Script\"]}"}
{"source":"WebSockets","type":"add","time":"2025-09-22T17:50:35.987818100Z","top":"Top","group":"Companies","company":"www.yogadirect.com","location":"rules","division":"example.com","site":"example.com","name":"Mod The Current Navigation Menu Is Complex And Can Appear Overwhelming Script","info":"{\"tooltip\":\"Script modification\",\"type\":\"mod\",\"children\":[],\"details\":{\"name\":\"Mod The Current Navigation Menu Is Complex And Can Appear Overwhelming Script\",\"extra\":\"\",\"type\":\"script\",\"created\":\"2025-09-22T17:50:35.889Z\",\"lastmodified\":\"2025-09-22T17:50:35.889Z\",\"pathvalue\":\"/\",\"comments\":\"\",\"probability\":100,\"usemode\":\"off\",\"cssselector\":\"\",\"xpath\":\"\",\"find\":[],\"nodeiden\":{\"type\":\"tag\",\"attributes\":{\"tag\":\"head\"},\"counts\":{\"tag\":1},\"parent\":{\"tag\":\"html\"}},\"parameter\":0,\"scripts\":[\"window.onload \\u003d function() {\\n    var existingMenu \\u003d document.querySelector(\\u0027#categories\\u0027);\\n    if (existingMenu) {\\n        var simplifiedMenu \\u003d document.createElement(\\u0027nav\\u0027);\\n        simplifiedMenu.className \\u003d \\u0027simplified-menu\\u0027;\\n\\n        var menuItems \\u003d [\\n            {text: \\u0027Mats\\u0027, link: \\u0027https://www.yogadirect.com/yoga-mats\\u0027},\\n            {text: \\u0027Bolsters\\u0027, link: \\u0027https://www.yogadirect.com/bolsters\\u0027},\\n            {text: \\u0027Blankets\\u0027, link: \\u0027https://www.yogadirect.com/blankets\\u0027},\\n            {text: \\u0027Props\\u0027, link: \\u0027https://www.yogadirect.com/yoga-props\\u0027},\\n            {text: \\u0027Fitness\\u0027, link: \\u0027https://www.yogadirect.com/yoga-fitness\\u0027},\\n            {text: \\u0027Clothing\\u0027, link: \\u0027https://www.yogadirect.com/clothing\\u0027},\\n            {text: \\u0027Deals\\u0027, link: \\u0027https://www.yogadirect.com/deals\\u0027},\\n            {text: \\u0027Custom Printing\\u0027, link: \\u0027https://www.yogadirect.com/custom-printing\\u0027},\\n        ];\\n\\n        menuItems.forEach(function(item) {\\n            var a \\u003d document.createElement(\\u0027a\\u0027);\\n            a.href \\u003d item.link;\\n            a.textContent \\u003d item.text;\\n            simplifiedMenu.appendChild(a);\\n        });\\n\\n        existingMenu.parentNode.insertBefore(simplifiedMenu, existingMenu);\\n        existingMenu.style.display \\u003d \\u0027none\\u0027;\\n    }\\n};\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.simplified-menu {\\\\n    display: flex;\\\\n    justify-content: center;\\\\n    background-color: #333;\\\\n    padding: 10px 0;\\\\n    margin: 0;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.simplified-menu a {\\\\n    color: white;\\\\n    text-decoration: none;\\\\n    padding: 10px 15px;\\\\n    text-transform: uppercase;\\\\n    transition: background-color 0.3s ease;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.simplified-menu a:hover {\\\\n    background-color: #555;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\"],\"updated\":false},\"nodePath\":[\"Top\",\"Companies\",\"www.yogadirect.com\",\"Rules\",\"example.com\",\"example.com\",\"Mod The Current Navigation Menu Is Complex And Can Appear Overwhelming Script\"]}"}

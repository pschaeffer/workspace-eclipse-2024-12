{"source":"WebSockets","type":"add","time":"2025-10-01T16:57:40.784955700Z","top":"Top","group":"Companies","company":"www.yogadirect.com","location":"rules","division":"example.com","site":"example.com","name":"Mod Simplifying The Navigation By Reducing The Number Of Visible Script","info":"{\"tooltip\":\"Script modification\",\"type\":\"mod\",\"children\":[],\"details\":{\"name\":\"Mod Simplifying The Navigation By Reducing The Number Of Visible Script\",\"extra\":\"\",\"type\":\"script\",\"created\":\"2025-10-01T16:57:40.715Z\",\"lastmodified\":\"2025-10-01T16:57:40.715Z\",\"pathvalue\":\"/\",\"comments\":\"\",\"probability\":100,\"usemode\":\"off\",\"cssselector\":\"\",\"xpath\":\"\",\"find\":[],\"nodeiden\":{\"type\":\"tag\",\"attributes\":{\"tag\":\"head\"},\"counts\":{\"tag\":1},\"parent\":{\"tag\":\"html\"}},\"parameter\":0,\"scripts\":[\"document.addEventListener(\\u0027DOMContentLoaded\\u0027, function() {\\n    var headerNav \\u003d document.querySelector(\\u0027.navbar-nav\\u0027);\\n    var categories \\u003d document.querySelector(\\u0027#categories\\u0027);\\n    \\n    if (categories \\u0026\\u0026 headerNav) {\\n        var megaMenu \\u003d document.createElement(\\u0027li\\u0027);\\n        megaMenu.classList.add(\\u0027dropdown\\u0027);\\n\\n        var megaMenuLink \\u003d document.createElement(\\u0027a\\u0027);\\n        megaMenuLink.href \\u003d \\u0027#\\u0027;\\n        megaMenuLink.innerText \\u003d \\u0027Shop\\u0027;\\n        megaMenuLink.setAttribute(\\u0027data-toggle\\u0027, \\u0027dropdown\\u0027);\\n\\n        var megaMenuDropdown \\u003d document.createElement(\\u0027ul\\u0027);\\n        megaMenuDropdown.classList.add(\\u0027dropdown-menu\\u0027);\\n\\n        var megaMenuColumns \\u003d 3;\\n        var categoriesClone \\u003d categories.cloneNode(true);\\n        var categoryItems \\u003d Array.from(categoriesClone.children);\\n        var columnSize \\u003d Math.ceil(categoryItems.length / megaMenuColumns);\\n\\n        for (var i \\u003d 0; i \\u003c megaMenuColumns; i++) {\\n            var column \\u003d document.createElement(\\u0027div\\u0027);\\n            column.classList.add(\\u0027mega-menu-column\\u0027);\\n\\n            var columnList \\u003d categoryItems.slice(i * columnSize, (i + 1) * columnSize);\\n            columnList.forEach(function(element) {\\n                var columnItem \\u003d element.cloneNode(true);\\n                column.appendChild(columnItem);\\n            });\\n\\n            megaMenuDropdown.appendChild(column);\\n        }\\n\\n        megaMenu.appendChild(megaMenuLink);\\n        megaMenu.appendChild(megaMenuDropdown);\\n\\n        headerNav.insertBefore(megaMenu, headerNav.firstChild);\\n        categories.style.display \\u003d \\u0027none\\u0027;\\n    }\\n});\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027/* Clear default styles for better customization */\\\\n.navbar-inverse {\\\\n    background-color: #333;\\\\n    border-color: #333;\\\\n    color: #fff;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.navbar-inverse .navbar-nav \\u003e li \\u003e a {\\\\n    color: #fff;\\\\n    transition: background-color 0.3s;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.navbar-inverse .navbar-nav \\u003e li \\u003e a:hover {\\\\n    background-color: #444;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.navbar-inverse .navbar-nav \\u003e .dropdown:hover \\u003e .dropdown-menu {\\\\n    display: block;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.dropdown-menu {\\\\n    background-color: #f9f9f9;\\\\n    border-color: #ccc;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.dropdown-menu \\u003e li \\u003e a {\\\\n    color: #333;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.dropdown-menu \\u003e li \\u003e a:hover {\\\\n    background-color: #e6e6e6;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\"],\"updated\":false},\"nodePath\":[\"Top\",\"Companies\",\"www.yogadirect.com\",\"Rules\",\"example.com\",\"example.com\",\"Mod Simplifying The Navigation By Reducing The Number Of Visible Script\"]}"}

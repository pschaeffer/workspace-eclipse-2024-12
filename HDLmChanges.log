ton.style.backgroundColor \\u003d \\u0027#ff6347\\u0027;\\n                addToCartButton.style.transform \\u003d \\u0027scale(1)\\u0027;\\n            });\\n        }\\n    }\\n})();\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.btn-addcart {\\\\n    background-color: #ff6347;\\\\n    color: #fff;\\\\n    padding: 12px 25px;\\\\n    font-size: 1.2em;\\\\n    border-radius: 5px;\\\\n    border: none;\\\\n    transition: all 0.3s ease;\\\\n    display: inline-block;\\\\n    margin-top: 10px;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.btn-addcart:hover {\\\\n    background-color: #ff4500;\\\\n    transform: scale(1.05);\\\\n    color: #fff;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\"],\"updated\":false,\"usemode\":\"test\",\"comments\":\"\",\"nodeiden\":{\"type\":\"tag\",\"counts\":{\"tag\":1},\"parent\":{\"tag\":\"html\"},\"attributes\":{\"tag\":\"head\"}},\"parameter\":0,\"cssselector\":\"\",\"pathvalue\":\"/yoga-direct-1-4-inch-yoga-mat.html\",\"probability\":\"\"},\"nodePath\":[\"Top\",\"Companies\",\"www.yogadirect.com\",\"Rules\",\"example.com\",\"example.com\",\"Mod Making The Add to Cart Button More Prominent Can Lead Script\"]}"}

{"source":"WebSockets","type":"add","time":"2025-09-03T18:00:25.238589500Z","top":"Top","group":"Companies","company":"www.yogadirect.com","location":"rules","division":"example.com","site":"example.com","name":"Mod A Well Structured, Minimalistic Navigation Bar Reduces Script","info":"{\"tooltip\":\"Script modification\",\"type\":\"mod\",\"children\":[],\"details\":{\"name\":\"Mod A Well Structured, Minimalistic Navigation Bar Reduces Script\",\"extra\":\"\",\"enabled\":true,\"type\":\"script\",\"created\":\"2025-09-03T18:00:25.162Z\",\"lastmodified\":\"2025-09-03T18:00:25.162Z\",\"pathvalue\":\"/\",\"comments\":\"\",\"probability\":100,\"usemode\":\"off\",\"cssselector\":\"\",\"xpath\":\"\",\"find\":[],\"nodeiden\":{\"type\":\"tag\",\"attributes\":{\"tag\":\"head\"},\"counts\":{\"tag\":1},\"parent\":{\"tag\":\"html\"}},\"parameter\":0,\"scripts\":[\"    document.addEventListener(\\u0027DOMContentLoaded\\u0027, function() {\\n        let navItems \\u003d document.querySelectorAll(\\u0027.navbar-nav \\u003e li.dropdown\\u0027);\\n        navItems.forEach(item \\u003d\\u003e {\\n            let popularChoices \\u003d [\\u0027Classic\\u0027, \\u0027Premium\\u0027, \\u0027Sale\\u0027];\\n            let dropdownMenu \\u003d item.querySelector(\\u0027.dropdown-menu\\u0027);\\n            if (dropdownMenu) {\\n                dropdownMenu.querySelectorAll(\\u0027a\\u0027).forEach(link \\u003d\\u003e {\\n                    if (popularChoices.includes(link.textContent)) {\\n                        link.classList.add(\\u0027highlight-popular\\u0027);\\n                    }\\n                });\\n            }\\n        });\\n    });\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.navbar-nav \\u003e li:hover \\u003e .dropdown-menu {\\\\n        display: block;\\\\n    }\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.navbar-nav .dropdown-menu {\\\\n        background-color: #f8f9fa;\\\\n        border: none;\\\\n        box-shadow: 0 4px 8px rgba(0,0,0,0.1);\\\\n    }\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.navbar-nav .dropdown-menu a {\\\\n        color: #333;\\\\n        padding: 10px 20px;\\\\n    }\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.navbar-nav .dropdown-menu a:hover {\\\\n        background-color: #e2e6ea;\\\\n    }\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.navbar-nav \\u003e li \\u003e a {\\\\n        font-weight: bold;\\\\n        text-transform: uppercase;\\\\n    }\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.nav-pills .nav-link.active, .nav-pills .show \\u003e .nav-link {\\\\n        color: #495057;\\\\n        background-color: #e9ecef;\\\\n    }\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.highlight-popular {\\\\n        background-color: #ffeb3b;\\\\n        font-weight: bold;\\\\n    }\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\"],\"updated\":false},\"nodePath\":[\"Top\",\"Companies\",\"www.yogadirect.com\",\"Rules\",\"example.com\",\"example.com\",\"Mod A Well Structured, Minimalistic Navigation Bar Reduces Script\"]}"}

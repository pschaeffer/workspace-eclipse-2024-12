{"source":"WebSockets","type":"add","time":"2025-01-28T14:36:07.945436Z","top":"Top","group":"Companies","company":"www.yogadirect.com","location":"rules","division":"example.com","site":"example.com","name":"Mod Social Proof In The Form Of Testimonials Can Increase Trust Script","info":"{\"tooltip\":\"Script modification\",\"type\":\"mod\",\"children\":[],\"details\":{\"name\":\"Mod Social Proof In The Form Of Testimonials Can Increase Trust Script\",\"extra\":\"\",\"enabled\":true,\"type\":\"script\",\"created\":\"2025-01-28T14:22:43.525Z\",\"lastmodified\":\"2025-01-28T14:22:43.525Z\",\"pathvalue\":\"/yoga-direct-1-4-inch-yoga-mat.html\",\"comments\":\"\",\"prob\":100.0,\"usemode\":\"test\",\"cssselector\":\"\",\"xpath\":\"\",\"find\":[],\"nodeiden\":{\"type\":\"tag\",\"attributes\":{\"tag\":\"head\"},\"counts\":{\"tag\":1},\"parent\":{\"tag\":\"html\"}},\"parameter\":0,\"scripts\":[\"document.addEventListener(\\\"DOMContentLoaded\\\", function() {\\n  const testimonials \\u003d [\\n    { text: \\\"I absolutely love my yoga mat from Yoga Direct. It has changed my practice completely.\\\", author: \\\"Jane Doe\\\" },\\n    { text: \\\"The best quality mat I\\u0027ve ever purchased. Highly recommended!\\\", author: \\\"John Smith\\\" },\\n    { text: \\\"Fantastic customer service and an even better product. A must-buy!\\\", author: \\\"Emily Johnson\\\" }\\n  ];\\n\\n  const testimonialContainer \\u003d document.createElement(\\u0027div\\u0027);\\n  testimonialContainer.className \\u003d \\u0027testimonial-slider\\u0027;\\n  document.querySelector(\\u0027.content-holder\\u0027).prepend(testimonialContainer);\\n\\n  testimonials.forEach((testimonial, index) \\u003d\\u003e {\\n    const slide \\u003d document.createElement(\\u0027div\\u0027);\\n    slide.className \\u003d \\u0027testimonial-slide\\u0027;\\n    if(index \\u003d\\u003d\\u003d 0) slide.classList.add(\\u0027active\\u0027);\\n    slide.innerHTML \\u003d `\\u003cp class\\u003d\\\"testimonial-text\\\"\\u003e\\\"${testimonial.text}\\\"\\u003c/p\\u003e\\u003cp class\\u003d\\\"testimonial-author\\\"\\u003e- ${testimonial.author}\\u003c/p\\u003e`;\\n    testimonialContainer.appendChild(slide);\\n  });\\n\\n  const nav \\u003d document.createElement(\\u0027div\\u0027);\\n  nav.className \\u003d \\u0027testimonial-navigation\\u0027;\\n  nav.innerHTML \\u003d \\u0027\\u003cbutton id\\u003d\\\"prevTestimonial\\\"\\u003ePrev\\u003c/button\\u003e\\u003cbutton id\\u003d\\\"nextTestimonial\\\"\\u003eNext\\u003c/button\\u003e\\u0027;\\n  testimonialContainer.appendChild(nav);\\n\\n  let currentIndex \\u003d 0;\\n  const slides \\u003d document.querySelectorAll(\\u0027.testimonial-slide\\u0027);\\n\\n  document.getElementById(\\u0027nextTestimonial\\u0027).addEventListener(\\u0027click\\u0027, () \\u003d\\u003e {\\n    slides[currentIndex].classList.remove(\\u0027active\\u0027);\\n    currentIndex \\u003d (currentIndex + 1) % slides.length;\\n    slides[currentIndex].classList.add(\\u0027active\\u0027);\\n  });\\n\\n  document.getElementById(\\u0027prevTestimonial\\u0027).addEventListener(\\u0027click\\u0027, () \\u003d\\u003e {\\n    slides[currentIndex].classList.remove(\\u0027active\\u0027);\\n    currentIndex \\u003d (currentIndex - 1 + slides.length) % slides.length;\\n    slides[currentIndex].classList.add(\\u0027active\\u0027);\\n  });\\n\\n  ScrollReveal().reveal(\\u0027.testimonial-slide\\u0027, { interval: 200 });\\n});\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.testimonial-slider {\\\\n  max-width: 800px;\\\\n  margin: 30px auto;\\\\n  position: relative;\\\\n  overflow: hidden;\\\\n  box-shadow: 0 4px 8px rgba(0,0,0,0.1);\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.testimonial-slide {\\\\n  display: none;\\\\n  padding: 20px;\\\\n  background: #fff;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.testimonial-slide.active {\\\\n  display: block;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.testimonial-text {\\\\n  font-size: 1.2em;\\\\n  color: #333;\\\\n  text-align: center;\\\\n  font-family: \\\\\\u0027Lato\\\\\\u0027, sans-serif;\\\\n  line-height: 1.6;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.testimonial-author {\\\\n  margin-top: 15px;\\\\n  font-weight: bold;\\\\n  color: #000;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.testimonial-navigation {\\\\n  text-align: center;\\\\n  margin-top: 15px;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.testimonial-navigation button {\\\\n  background: #007bff;\\\\n  color: #fff;\\\\n  border: none;\\\\n  padding: 10px;\\\\n  cursor: pointer;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.testimonial-navigation button:hover {\\\\n  background: #0056b3;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\"],\"updated\":false},\"nodePath\":[\"Top\",\"Companies\",\"www.yogadirect.com\",\"Rules\",\"example.com\",\"example.com\",\"Mod Social Proof In The Form Of Testimonials Can Increase Trust Script\"]}"}

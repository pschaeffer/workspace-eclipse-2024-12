   color: #fff;\\\\n    text-decoration: none;\\\\n    border-radius: 4px;\\\\n    transition: background-color 0.3s ease;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.call-to-action a:hover {\\\\n    background-color: #0056b3;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\"],\"updated\":false,\"usemode\":\"off\",\"comments\":\"\",\"nodeiden\":{\"type\":\"tag\",\"counts\":{\"tag\":1},\"parent\":{\"tag\":\"html\"},\"attributes\":{\"tag\":\"head\"}},\"parameter\":0,\"cssselector\":\"\",\"pathvalue\":\"/yoga-direct-1-4-inch-yoga-mat.html\",\"probability\":\"\"},\"id\":\"17835\",\"nodePath\":[\"Top\",\"Companies\",\"www.yogadirect.com\",\"Rules\",\"example.com\",\"example.com\",\"Mod Customer Reviews Provide Social Proof, Increase Trust, Script\"]}"}

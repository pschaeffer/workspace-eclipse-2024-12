uct.name} - \\u003cstrong\\u003e${product.price}\\u003c/strong\\u003e\\u003c/div\\u003e\\n            \\u003ca href\\u003d\\\"${product.link}\\\" class\\u003d\\\"btn\\\"\\u003eShop Now\\u003c/a\\u003e\\n        `;\\n        \\n        container.appendChild(productItem);\\n    });\\n\\n    document.querySelector(\\u0027.home-page-content\\u0027).prepend(container);\\n});\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.featured-product {\\\\n    padding: 30px 0;\\\\n    background-color: #f9f9f9;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.featured-product .product-item {\\\\n    margin-bottom: 30px;\\\\n    text-align: center;\\\\n    background: white;\\\\n    border: 1px solid #e0e0e0;\\\\n    padding: 15px;\\\\n    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.featured-product .product-item img {\\\\n    width: 100%;\\\\n    height: auto;\\\\n    transition: transform 0.3s ease;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.featured-product .product-item:hover img {\\\\n    transform: scale(1.05);\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.featured-product .product-item .btn {\\\\n    background-color: #ff5722;\\\\n    color: #fff;\\\\n    padding: 8px 16px;\\\\n    font-size: 16px;\\\\n    border: none;\\\\n    transition: background-color 0.3s;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.featured-product .product-item .btn:hover {\\\\n    background-color: #e64a19;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.featured-product-text {\\\\n    margin: 20px 0;\\\\n    font-size: 18px;\\\\n    color: #333;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\"],\"updated\":false},\"nodePath\":[\"Top\",\"Companies\",\"www.yogadirect.com\",\"Rules\",\"example.com\",\"example.com\",\"Mod Focusing On Best Sellers And Promotions With Prominent Script\"]}"}
{"source":"WebSockets","type":"add","time":"2025-09-07T03:56:19.227427400Z","top":"Top","group":"Companies","company":"www.yogadirect.com","location":"rules","division":"example.com","site":"example.com","name":"Mod The Current Hero Section Has Static Images And Simple Calls Script","info":"{\"tooltip\":\"Script modification\",\"type\":\"mod\",\"children\":[],\"details\":{\"name\":\"Mod The Current Hero Section Has Static Images And Simple Calls Script\",\"extra\":\"\",\"enabled\":true,\"type\":\"script\",\"created\":\"2025-09-07T03:56:18.858Z\",\"lastmodified\":\"2025-09-07T03:56:18.858Z\",\"pathvalue\":\"/\",\"comments\":\"\",\"probability\":100,\"usemode\":\"off\",\"cssselector\":\"\",\"xpath\":\"\",\"find\":[],\"nodeiden\":{\"type\":\"tag\",\"attributes\":{\"tag\":\"head\"},\"counts\":{\"tag\":1},\"parent\":{\"tag\":\"html\"}},\"parameter\":0,\"scripts\":[\"  function updateHeroSection() {\\n    const heroSection \\u003d document.createElement(\\u0027div\\u0027);\\n    heroSection.className \\u003d \\u0027hero-section\\u0027;\\n\\n    const heroContent \\u003d document.createElement(\\u0027div\\u0027);\\n    heroContent.className \\u003d \\u0027hero-content\\u0027;\\n\\n    const title \\u003d document.createElement(\\u0027h1\\u0027);\\n    title.className \\u003d \\u0027hero-title\\u0027;\\n    title.textContent \\u003d \\u0027Welcome to YogaDirect\\u0027;\\n\\n    const subtitle \\u003d document.createElement(\\u0027p\\u0027);\\n    subtitle.className \\u003d \\u0027hero-subtitle\\u0027;\\n    subtitle.textContent \\u003d \\u0027Your Destination for Quality Yoga Gear\\u0027;\\n\\n    const button \\u003d document.createElement(\\u0027a\\u0027);\\n    button.className \\u003d \\u0027hero-button\\u0027;\\n    button.href \\u003d \\u0027https://www.yogadirect.com/deals\\u0027;\\n    button.textContent \\u003d \\u0027Discover Our Deals\\u0027;\\n\\n    heroContent.appendChild(title);\\n    heroContent.appendChild(subtitle);\\n    heroContent.appendChild(button);\\n\\n    const heroBackground \\u003d document.createElement(\\u0027div\\u0027);\\n    heroBackground.className \\u003d \\u0027hero-background\\u0027;\\n    heroBackground.style.backgroundImage \\u003d \\\"url(\\u0027https://www.yogadirect.com/assets/images/banners/YDDealsBanner2023.jpg\\u0027)\\\";\\n\\n    heroSection.appendChild(heroContent);\\n    heroSection.appendChild(heroBackground);\\n\\n    const homePageContent \\u003d document.querySelector(\\u0027.home-page-content\\u0027);\\n    homePageContent.prepend(heroSection);\\n  }\\n\\n  document.addEventListener(\\u0027DOMContentLoaded\\u0027, updateHeroSection);\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.hero-section {\\\\n    display: flex;\\\\n    justify-content: center;\\\\n    align-items: center;\\\\n    min-height: 400px;\\\\n    background-color: #f8f8f8;\\\\n    position: relative;\\\\n    overflow: hidden;\\\\n  }\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.hero-content {\\\\n    text-align: center;\\\\n  }\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.hero-title {\\\\n    font-family: \\\\\\u0027Lato\\\\\\u0027, sans-serif;\\\\n    font-size: 2.5em;\\\\n    color: #333;\\\\n  }\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.hero-subtitle {\\\\n    font-family: \\\\\\u0027Roboto Condensed\\\\\\u0027, sans-serif;\\\\n    font-size: 1.2em;\\\\n    margin-bottom: 20px;\\\\n    color: #666;\\\\n  }\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.hero-button {\\\\n    background-color: #007bff;\\\\n    border: none;\\\\n    padding: 12px 25px;\\\\n    font-size: 16px;\\\\n    font-weight: bold;\\\\n    color: #fff;\\\\n    cursor: pointer;\\\\n    border-radius: 5px;\\\\n    transition: background-color 0.3s ease-in-out;\\\\n  }\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.hero-button:hover {\\\\n    background-color: #0056b3;\\\\n  }\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.hero-background {\\\\n    position: absolute;\\\\n    top: 0;\\\\n    left: 0;\\\\n    right: 0;\\\\n    bottom: 0;\\\\n    background-size: cover;\\\\n    background-position: center;\\\\n    z-index: -1;\\\\n    opacity: 0.5;\\\\n  }\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\"],\"updated\":false},\"nodePath\":[\"Top\",\"Companies\",\"www.yogadirect.com\",\"Rules\",\"example.com\",\"example.com\",\"Mod The Current Hero Section Has Static Images And Simple Calls Script\"]}"}
{"source":"WebSockets","type":"add","time":"2025-09-07T03:56:19.244416400Z","top":"Top","group":"Companies","company":"www.yogadirect.com","location":"rules","division":"example.com","site":"example.com","name":"Mod The Navigation Bar Is Cluttered With Too Many Items, Which Script","info":"{\"tooltip\":\"Script modification\",\"type\":\"mod\",\"children\":[],\"details\":{\"name\":\"Mod The Navigation Bar Is Cluttered With Too Many Items, Which Script\",\"extra\":\"\",\"enabled\":true,\"type\":\"script\",\"created\":\"2025-09-07T03:56:18.866Z\",\"lastmodified\":\"2025-09-07T03:56:18.866Z\",\"pathvalue\":\"/\",\"comments\":\"\",\"probability\":100,\"usemode\":\"off\",\"cssselector\":\"\",\"xpath\":\"\",\"find\":[],\"nodeiden\":{\"type\":\"tag\",\"attributes\":{\"tag\":\"head\"},\"counts\":{\"tag\":1},\"parent\":{\"tag\":\"html\"}},\"parameter\":0,\"scripts\":[\"    document.addEventListener(\\u0027DOMContentLoaded\\u0027, function() {\\n        var navbar \\u003d document.querySelector(\\u0027.navbar-inverse\\u0027);\\n        var topNavigation \\u003d document.querySelector(\\u0027.top-nav\\u0027);\\n        var headerSection \\u003d document.querySelector(\\u0027.site-header\\u0027);\\n        topNavigation.classList.add(\\u0027navbar\\u0027, \\u0027navbar-fixed-top\\u0027);\\n        headerSection.classList.add(\\u0027navbar\\u0027, \\u0027navbar-fixed-top\\u0027);\\n        navbar.style.marginTop \\u003d topNavigation.offsetHeight + \\u0027px\\u0027;\\n        document.querySelector(\\u0027body\\u0027).style.paddingTop \\u003d (topNavigation.offsetHeight + headerSection.offsetHeight) + \\u0027px\\u0027;\\n    });\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027/* Navigation Structure and Visibility Enhancements */\\\\n    .navbar-inverse {\\\\n        background-color: #333;\\\\n        border-color: #080808;\\\\n    }\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u00
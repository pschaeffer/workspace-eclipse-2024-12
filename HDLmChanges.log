{"source":"WebSockets","type":"modify","time":"2025-09-24T20:58:03.188805Z","top":"Top","group":"Companies","company":"www.yogadirect.com","location":"rules","division":"example.com","site":"example.com","name":"Mod User Reviews Are An Essential Factor In Purchase Decisions Script","info":"{\"tooltip\":\"Script modification\",\"type\":\"mod\",\"children\":[],\"details\":{\"name\":\"Mod User Reviews Are An Essential Factor In Purchase Decisions Script\",\"extra\":\"\",\"type\":\"script\",\"created\":\"2025-03-05T18:19:15.833Z\",\"lastmodified\":\"2025-03-05T18:19:15.833Z\",\"find\":[],\"prob\":100,\"xpath\":\"\",\"pathre\":false,\"enabled\":true,\"scripts\":[\" \\n  document.addEventListener(\\u0027DOMContentLoaded\\u0027, function() { \\n    var productTitle \\u003d document.querySelector(\\u0027.product-details h1\\u0027); \\n    var priceBlock \\u003d document.querySelector(\\u0027.pricingBlock\\u0027); \\n    var productReviews \\u003d document.querySelector(\\u0027.product-reviews\\u0027); \\n    if(productTitle \\u0026\\u0026 productReviews) { \\n      var reviewsSection \\u003d document.createElement(\\u0027div\\u0027); \\n      reviewsSection.id \\u003d \\u0027product-reviews-section\\u0027; \\n      reviewsSection.appendChild(productReviews); \\n      priceBlock.parentNode.insertBefore(reviewsSection, priceBlock.nextSibling); \\n    } \\n  }); \\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027#product-reviews-section { \\\\n    margin-top: 10px; \\\\n    padding: 10px; \\\\n    border: 1px solid #ddd; \\\\n    background-color: #f9f9f9; \\\\n  }\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\"],\"updated\":false,\"usemode\":\"off\",\"comments\":\"\",\"nodeiden\":{\"type\":\"tag\",\"counts\":{\"tag\":1},\"parent\":{\"tag\":\"html\"},\"attributes\":{\"tag\":\"head\"}},\"parameter\":0,\"cssselector\":\"\",\"pathvalue\":\"/yoga-direct-1-4-inch-yoga-mat.html\",\"probability\":\"\"},\"id\":\"17
ialText.innerText \\u003d testimonial.text;\\n        var customerName \\u003d document.createElement(\\u0027div\\u0027);\\n        customerName.className \\u003d \\u0027customer-name\\u0027;\\n        customerName.innerText \\u003d \\u0027- \\u0027 + testimonial.name;\\n        testimonialDiv.appendChild(testimonialText);\\n        testimonialDiv.appendChild(customerName);\\n        testimonialSection.appendChild(testimonialDiv);\\n    });\\n    document.querySelector(\\u0027body\\u0027).appendChild(testimonialSection);\\n\\n    var benefitsSection \\u003d document.createElement(\\u0027div\\u0027);\\n    benefitsSection.className \\u003d \\u0027product-benefits\\u0027;\\n    var benefitsTitle \\u003d document.createElement(\\u0027h3\\u0027);\\n    benefitsTitle.innerText \\u003d \\u0027Why Choose Yoga Direct Products?\\u0027;\\n    var benefitsList \\u003d document.createElement(\\u0027ul\\u0027);\\n    var benefits \\u003d [\\n        \\\"High Quality Materials\\\",\\n        \\\"Eco-friendly Options\\\",\\n        \\\"Wholesale Prices\\\",\\n        \\\"Trusted for Over 20 Years\\\"\\n    ];\\n    benefits.forEach(function(benefit) {\\n        var benefitItem \\u003d document.createElement(\\u0027li\\u0027);\\n        benefitItem.innerText \\u003d benefit;\\n        benefitsList.appendChild(benefitItem);\\n    });\\n    benefitsSection.appendChild(benefitsTitle);\\n    benefitsSection.appendChild(benefitsList);\\n    document.querySelector(\\u0027.content-holder\\u0027).insertBefore(benefitsSection, document.querySelector(\\u0027.products-section\\u0027));\\n});\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.testimonial-section {\\\\n    background-color: #f9f9f9;\\\\n    padding: 40px 0;\\\\n    text-align: center;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.testimonial {\\\\n    margin: 20px;\\\\n    padding: 20px;\\\\n    background-color: #fff;\\\\n    border-radius: 5px;\\\\n    box-shadow: 0 0 5px rgba(0,0,0,0.1);\\\\n    display: inline-block;\\\\n    max-width: 300px;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.testimonial .customer-name {\\\\n    font-weight: bold;\\\\n    margin-top: 10px;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.product-benefits {\\\\n    margin-top: 30px;\\\\n    padding: 20px;\\\\n    background-color: #f1f1f1;\\\\n    border-radius: 5px;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.product-benefits h3 {\\\\n    margin-bottom: 15px;\\\\n}\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\"],\"updated\":false},\"nodePath\":[\"Top\",\"Companies\",\"www.yogadirect.com\",\"Rules\",\"example.com\",\"example.com\",\"Mod User Testimonials And Real Life Experiences Build Trust Script\"]}"}

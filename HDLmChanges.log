{"source":"WebSockets","type":"add","time":"2025-10-29T22:29:10.045006300Z","top":"Top","group":"Companies","company":"www.yogadirect.com","location":"rules","division":"example.com","site":"example.com","name":"Mod Engaging Product Descriptions That Emphasize Benefits And Script","info":"{\"tooltip\":\"Script modification\",\"type\":\"mod\",\"children\":[],\"details\":{\"name\":\"Mod Engaging Product Descriptions That Emphasize Benefits And Script\",\"extra\":\"\",\"type\":\"script\",\"created\":\"2025-10-29T22:29:09.860Z\",\"lastmodified\":\"2025-10-29T22:29:09.860Z\",\"pathvalue\":\"/\",\"comments\":\"\",\"probability\":100,\"usemode\":\"off\",\"cssselector\":\"\",\"xpath\":\"\",\"find\":[],\"nodeiden\":{\"type\":\"tag\",\"attributes\":{\"tag\":\"head\"},\"counts\":{\"tag\":1},\"parent\":{\"tag\":\"html\"}},\"parameter\":0,\"scripts\":[\"    document.addEventListener(\\u0027DOMContentLoaded\\u0027, function() {\\n        const productDescriptions \\u003d {\\n            \\u00272421\\u0027: \\u0027Embrace the journey of tranquility on our 1/4 Inch Yoga Mat, designed to provide unwavering support and balance. With its textured surface and eco-friendly materials, it transforms every stretch into an opportunity to connect with nature.\\u0027,\\n            \\u00272422\\u0027: \\u0027Master your poses on the 1/8 Inch Yoga Mat, with lightweight durability that follows you from studio to seaside. Elevate your practice with a mat designed for those passionate about keeping the environment as balanced as their breath.\\u0027,\\n            \\u002771\\u0027: \\u0027Bounce back into fitness with our Deluxe Yoga Ball. Its anti-burst design ensures maximum safety, allowing you to focus on your flow without a second thought.\\u0027,\\n            \\u0027161\\u0027: \\u0027Reach new heights in your practice with the 8 Ft Cinch Buckle Yoga Strap, stretching your possibilities with its flexible design and secure grip for challenging poses.\\u0027,\\n            // Add more descriptions as needed\\n        };\\n        \\n        document.querySelectorAll(\\u0027.product-item\\u0027).forEach(item \\u003d\\u003e {\\n            const catalogId \\u003d item.getAttribute(\\u0027data-catalogid\\u0027);\\n            if (productDescriptions[catalogId]) {\\n                const descriptionElement \\u003d document.createElement(\\u0027div\\u0027);\\n                descriptionElement.className \\u003d \\u0027enhanced-description\\u0027;\\n                descriptionElement.innerHTML \\u003d \\u0027\\u003cspan class\\u003d\\\"highlight\\\"\\u003eFeature:\\u003c/span\\u003e\\u0027 + productDescriptions[catalogId];\\n                item.querySelector(\\u0027.name\\u0027).appendChild(descriptionElement);\\n            }\\n        });\\n    });\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.product-item .enhanced-description {\\\\n        font-size: 1rem;\\\\n        color: #555;\\\\n        margin-top: 0.5em;\\\\n    }\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.product-item .enhanced-description span {\\\\n        display: block;\\\\n        margin-top: 0.3em;\\\\n    }\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\\n{\\n  var styleSheet \\u003d document.createElement(\\\"style\\\");\\n  styleSheet.textContent \\u003d \\u0027.product-item .enhanced-description .highlight {\\\\n        font-weight: bold;\\\\n        color: #333;\\\\n    }\\u0027;\\n  document.head.appendChild(styleSheet);\\n}\"],\"updated\":false},\"nodePath\":[\"Top\",\"Companies\",\"www.yogadirect.com\",\"Rules\",\"example.com\",\"example.com\",\"Mod Engaging Product Descriptions That Emphasize Benefits And Script\"]}"}

{"source":"WebSockets","type":"add","time":"2025-08-04T13:51:14.265426800Z","top":"Top","group":"Companies","company":"www.yogadirect.com","location":"rules","division":"example.com","site":"example.com","name":"Script Mod CC Variant 10","info":"{\"type\":\"mod\",\"tooltip\":\"Script modification\",\"details\":{\"find\":[],\"scripts\":[\"( function() {    if (window.self !\\u003d\\u003d window.top) {        /* alert(\\\"This webpage is being modified to move the menu from the top to the left side.\\\"); */    } else {        /* alert(\\\"This webpage is being modified to move the menu from the top to the left side.\\\"); */    }    const menuBar \\u003d document.querySelector(\\\".navbar-wrapper\\\");    if (menuBar) {        menuBar.style.position \\u003d \\\"fixed\\\";        menuBar.style.top \\u003d \\\"0\\\";        menuBar.style.left \\u003d \\\"0\\\";        menuBar.style.width \\u003d \\\"200px\\\"; // Set menu width \\n        menuBar.style.height \\u003d \\\"100%\\\"; // Full height \\n        menuBar.style.zIndex \\u003d \\\"1000\\\"; // Ensure it\\u0027s on top \\n        menuBar.style.transform \\u003d \\\"translateX(-100%)\\\"; // Start hidden \\n        menuBar.style.transition \\u003d \\\"transform 0.3s ease\\\"; // Animation for transition \\n        document.body.style.marginLeft \\u003d \\\"200px\\\"; // Adjust body margin to make space for menu \\n        // Add a button or mechanism to toggle the menu visibility \\n        const toggleButton \\u003d document.createElement(\\u0027button\\u0027);        toggleButton.innerText \\u003d \\\"Toggle Menu\\\";        toggleButton.style.position \\u003d \\\"fixed\\\";        toggleButton.style.top \\u003d \\\"10px\\\";        toggleButton.style.left \\u003d \\\"210px\\\"; // Slightly away from the menu \\n        toggleButton.onclick \\u003d function() {            menuBar.style.transform \\u003d menuBar.style.transform \\u003d\\u003d\\u003d \\\"translateX(0%)\\\" ? \\\"translateX(-100%)\\\" : \\\"transl
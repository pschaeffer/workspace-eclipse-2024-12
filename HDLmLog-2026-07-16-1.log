{"id":"gen-1784162870-YB2Dd9n2H6DfzOjWMB7S","object":"chat.completion","created":1784162870,"model":"anthropic/claude-fable-5","provider":"Amazon Bedrock","system_fingerprint":null,"service_tier":"default","choices":[{"index":0,"logprobs":null,"finish_reason":"stop","native_finish_reason":"end_turn","message":{"role":"assistant","content":"{\"improvedHtml\": \"<!DOCTYPE html>\\n<html lang=\\\"en\\\">\\n<head>\\n<meta charset=\\\"UTF-8\\\">\\n<meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1.0\\\">\\n<title>Premium Yoga Mats – Extra Thick, Non-Slip &amp; Eco-Friendly | YogaDirect</title>\\n<meta name=\\\"description\\\" content=\\\"Shop premium yoga mats at YogaDirect. Extra-thick, non-slip, eco-friendly mats trusted by studios nationwide. Free shipping over $50, 30-day money-back guarantee.\\\">\\n<link rel=\\\"canonical\\\" href=\\\"https://www.yogadirect.com/premium-mats\\\">\\n<script type=\\\"application/ld+json\\\">\\n{\\n  \\\"@context\\\": \\\"https://schema.org\\\",\\n  \\\"@type\\\": \\\"CollectionPage\\\",\\n  \\\"name\\\": \\\"Premium Yoga Mats\\\",\\n  \\\"description\\\": \\\"Premium extra-thick, non-slip and eco-friendly yoga mats from YogaDirect.\\\",\\n  \\\"url\\\": \\\"https://www.yogadirect.com/premium-mats\\\"\\n}\\n</script>\\n<style>\\n  :root{\\n    --brand:#5b7c5a;\\n    --brand-dark:#43603f;\\n    --accent:#e07b39;\\n    --accent-dark:#c4652a;\\n    --text:#2b2b2b;\\n    --muted:#6b6b6b;\\n    --bg:#fdfcf9;\\n    --card:#ffffff;\\n    --border:#e6e2da;\\n  }\\n  *{box-sizing:border-box;margin:0;padding:0}\\n  body{font-family:'Segoe UI',Helvetica,Arial,sans-serif;color:var(--text);background:var(--bg);line-height:1.6}\\n  a{color:var(--brand);text-decoration:none}\\n  img{max-width:100%;display:block}\\n  .container{max-width:1180px;margin:0 auto;padding:0 20px}\\n\\n  /* Announcement bar */\\n  .announce{background:var(--brand-dark);color:#fff;text-align:center;font-size:14px;padding:8px 12px}\\n  .announce strong{color:#ffd9b3}\\n\\n  /* Header */\\n  header{background:#fff;border-bottom:1px solid var(--border);position:sticky;top:0;z-index:50}\\n  .header-inner{display:flex;align-items:center;justify-content:space-between;padding:14px 20px;max-width:1180px;margin:0 auto}\\n  .logo{font-size:24px;font-weight:800;color:var(--brand-dark);letter-spacing:-0.5px}\\n  .logo span{color:var(--accent)}\\n  nav ul{display:flex;gap:24px;list-style:none}\\n  nav a{font-weight:600;font-size:15px;color:var(--text)}\\n  nav a:hover{color:var(--brand)}\\n  .header-actions{display:flex;align-items:center;gap:18px;font-size:14px}\\n  .cart-btn{background:var(--brand);color:#fff;padding:8px 16px;border-radius:6px;font-weight:700}\\n  .cart-btn:hover{background:var(--brand-dark)}\\n\\n  /* Breadcrumbs */\\n  .breadcrumbs{font-size:13px;color:var(--muted);padding:14px 0}\\n\\n  /* Hero */\\n  .hero{display:flex;gap:40px;align-items:center;padding:24px 0 40px;flex-wrap:wrap}\\n  .hero-copy{flex:1 1 480px}\\n  .hero-copy h1{font-size:38px;line-height:1.15;color:var(--brand-dark);margin-bottom:14px}\\n  .hero-copy p.sub{font-size:18px;color:var(--muted);margin-bottom:22px;max-width:560px}\\n  .hero-ctas{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:18px}\\n  .btn-primary{background:var(--accent);color:#fff;padding:14px 30px;border-radius:8px;font-weight:800;font-size:17px;border:none;cursor:pointer;display:inline-block;box-shadow:0 3px 10px rgba(224,123,57,.35)}\\n  .btn-primary:hover{background:var(--accent-dark)}\\n  .btn-secondary{background:#fff;color:var(--brand-dark);border:2px solid var(--brand);padding:12px 26px;border-radius:8px;font-weight:700;font-size:16px;cursor:pointer;display:inline-block}\\n  .btn-secondary:hover{background:var(--brand);color:#fff}\\n  .hero-trust{display:flex;gap:20px;flex-wrap:wrap;font-size:14px;color:var(--muted)}\\n  .hero-trust span{display:flex;align-items:center;gap:6px}\\n  .stars{color:#f5a623;font-size:16px;letter-spacing:1px}\\n  .hero-img{flex:1 1 380px;background:linear-gradient(135deg,#dce8d8,#f3ede2);border-radius:16px;min-height:320px;display:flex;align-items:center;justify-content:center;color:var(--brand-dark);font-weight:700;font-size:18px;text-align:center;padding:20px}\\n\\n  /* Trust bar */\\n  .trust-bar{background:#fff;border-top:1px solid var(--border);border-bottom:1px solid var(--border);padding:18px 0}\\n  .trust-bar .container{display:flex;justify-content:space-between;flex-wrap:wrap;gap:16px}\\n  .trust-item{display:flex;align-items:center;gap:10px;font-size:14px;font-weight:600}\\n  .trust-item .icon{font-size:22px}\\n\\n  /* Filters */\\n  .toolbar{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;padding:30px 0 10px}\\n  .toolbar h2{font-size:24px;color:var(--brand-dark)}\\n  .filters{display:flex;gap:10px;flex-wrap:wrap}\\n  .chip{border:1px solid var(--border);background:#fff;padding:7px 16px;border-radius:999px;font-size:14px;cursor:pointer;font-weight:600;color:var(--muted)}\\n  .chip.active,.chip:hover{background:var(--brand);color:#fff;border-color:var(--brand)}\\n  select.sort{padding:8px 12px;border:1px solid var(--border);border-radius:8px;font-size:14px;background:#fff}\\n\\n  /* Product grid */\\n  .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:24px;padding:20px 0 40px}\\n  .card{background:var(--card);border:1px solid var(--border);border-radius:14px;overflow:hidden;display:flex;flex-direction:column;transition:box-shadow .2s,transform .2s;position:relative}\\n  .card:hover{box-shadow:0 8px 24px rgba(0,0,0,.09);transform:translateY(-3px)}\\n  .badge{position:absolute;top:12px;left:12px;background:var(--accent);color:#fff;font-size:12px;font-weight:800;padding:4px 10px;border-radius:6px;z-index:2}\\n  .badge.green{background:var(--brand)}\\n  .badge.red{background:#c0392b}\\n  .card-img{background:linear-gradient(135deg,#eef3ea,#f7f2e9);height:210px;display:flex;align-items:center;justify-content:center;color:var(--muted);font-size:14px}\\n  .card-body{padding:16px 18px 20px;display:flex;flex-direction:column;flex:1}\\n  .card-body h3{font-size:17px;line-height:1.3;margin-bottom:6px}\\n  .card-body h3 a{color:var(--text)}\\n  .rating{display:flex;align-items:center;gap:6px;font-size:13px;color:var(--muted);margin-bottom:8px}\\n  .price-row{display:flex;align-items:baseline;gap:10px;margin-bottom:6px}\\n  .price{font-size:20px;font-weight:800;color:var(--brand-dark)}\\n  .compare{font-size:14px;color:var(--muted);text-decoration:line-through}\\n  .save{font-size:13px;color:#c0392b;font-weight:700}\\n  .stock{font-size:13px;color:#c0392b;font-weight:600;margin-bottom:10px}\\n  .stock.in{color:var(--brand)}\\n  .card .btn-primary{margin-top:auto;width:100%;text-align:center;font-size:15px;padding:12px}\\n\\n  /* Comparison */\\n  .compare-section{background:#fff;border-top:1px solid var(--border);padding:50px 0}\\n  .compare-section h2{text-align:center;font-size:28px;color:var(--brand-dark);margin-bottom:8px}\\n  .compare-section p.lead{text-align:center;color:var(--muted);margin-bottom:28px}\\n  table.cmp{width:100%;border-collapse:collapse;font-size:14px;background:#fff}\\n  table.cmp th,table.cmp td{padding:12px 14px;border:1px solid var(--border);text-align:center}\\n  table.cmp th{background:var(--brand);color:#fff;font-size:15px}\\n  table.cmp td:first-child{text-align:left;font-weight:600}\\n  table.cmp tr:nth-child(even){background:#faf8f4}\\n\\n  /* Reviews */\\n  .reviews{padding:50px 0}\\n  .reviews h2{text-align:center;font-size:28px;color:var(--brand-dark);margin-bottom:8px}\\n  .reviews .agg{text-align:center;color:var(--muted);margin-bottom:30px}\\n  .review-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:20px}\\n  .review{background:#fff;border:1px solid var(--border);border-radius:12px;padding:20px}\\n  .review .stars{margin-bottom:8px}\\n  .review p{font-size:14px;color:var(--text);margin-bottom:12px}\\n  .review .who{font-size:13px;font-weight:700;color:var(--brand-dark)}\\n  .review .verified{font-size:12px;color:var(--brand);font-weight:600}\\n\\n  /* Guarantee band */\\n  .guarantee{background:var(--brand-dark);color:#fff;padding:44px 0;text-align:center}\\n  .guarantee h2{font-size:26px;margin-bottom:10px}\\n  .guarantee p{max-width:640px;margin:0 auto 22px;color:#e4ecdf}\\n  .guarantee .btn-primary{box-shadow:none}\\n\\n  /* FAQ */\\n  .faq{padding:50px 0;max-width:820px;margin:0 auto}\\n  .faq h2{text-align:center;font-size:28px;color:var(--brand-dark);margin-bottom:26px}\\n  details{background:#fff;border:1px solid var(--border);border-radius:10px;margin-bottom:12px;padding:16px 20px}\\n  summary{font-weight:700;cursor:pointer;font-size:16px}\\n  details p{margin-top:10px;font-size:14px;color:var(--muted)}\\n\\n  /* Email capture */\\n  .email-capture{background:#f3ede2;padding:40px 0;text-align:center}\\n  .email-capture h2{font-size:24px;color:var(--brand-dark);margin-bottom:8px}\\n  .email-capture p{color:var(--muted);margin-bottom:18px}\\n  .email-form{display:flex;gap:10px;justify-content:center;flex-wrap:wrap}\\n  .email-form input{padding:12px 16px;border:1px solid var(--border);border-radius:8px;font-size:15px;min-width:280px}\\n\\n  /* Footer */\\n  footer{background:#2f3a2d;color:#cfd8cb;padding:40px 0 24px;font-size:14px}\\n  .footer-cols{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:28px;margin-bottom:26px}\\n  footer h4{color:#fff;margin-bottom:12px;font-size:15px}\\n  footer ul{list-style:none}\\n  footer li{margin-bottom:8px}\\n  footer a{color:#cfd8cb}\\n  footer a:hover{color:#fff}\\n  .footer-bottom{border-top:1px solid #465243;padding-top:18px;text-align:center;font-size:13px;color:#a6b3a1}\\n\\n  /* Sticky mobile CTA */\\n  .sticky-cta{display:none;position:fixed;bottom:0;left:0;right:0;background:#fff;border-top:1px solid var(--border);padding:10px 16px;z-index:100;box-shadow:0 -4px 12px rgba(0,0,0,.08)}\\n  .sticky-cta .btn-primary{width:100%;text-align:center}\\n\\n  @media(max-width:768px){\\n    .hero-copy h1{font-size:28px}\\n    nav{display:none}\\n    .sticky-cta{display:block}\\n    body{padding-bottom:64px}\\n  }\\n</style>\\n</head>\\n<body>\\n\\n<div class=\\\"announce\\\">🚚 <strong>FREE SHIPPING</strong> on orders over $50 &nbsp;|&nbsp; 🔁 30-Day Money-Back Guarantee &nbsp;|&nbsp; ⏳ <strong>Fall Sale:</strong> Up to 25% off premium mats — ends Sunday</div>\\n\\n<header>\\n  <div class=\\\"header-inner\\\">\\n    <a href=\\\"/\\\" class=\\\"logo\\\" aria-label=\\\"YogaDirect home\\\">Yoga<span>Direct</span></a>\\n    <nav aria-label=\\\"Main navigation\\\">\\n      <ul>\\n        <li><a href=\\\"/premium-mats\\\" aria-current=\\\"page\\\">Premium Mats</a></li>\\n        <li><a href=\\\"/yoga-mats\\\">All Mats</a></li>\\n        <li><a href=\\\"/props\\\">Props</a></li>\\n        <li><a href=\\\"/apparel\\\">Apparel</a></li>\\n        <li><a href=\\\"/sale\\\">Sale</a></li>\\n      </ul>\\n    </nav>\\n    <div class=\\\"header-actions\\\">\\n      <a href=\\\"/account\\\">Account</a>\\n      <a href=\\\"/cart\\\" class=\\\"cart-btn\\\">Cart (0)</a>\\n    </div>\\n  </div>\\n</header>\\n\\n<main>\\n<div class=\\\"container\\\">\\n  <nav class=\\\"breadcrumbs\\\" aria-label=\\\"Breadcrumb\\\"><a href=\\\"/\\\">Home</a> &rsaquo; <a href=\\\"/yoga-mats\\\">Yoga Mats</a> &rsaquo; <strong>Premium Mats</strong></nav>\\n\\n  <!-- HERO -->\\n  <section class=\\\"hero\\\">\\n    <div class=\\\"hero-copy\\\">\\n      <h1>Premium Yoga Mats Built for a Lifetime of Practice</h1>\\n      <p class=\\\"sub\\\">Studio-grade grip, extra-thick cushioning, and eco-friendly materials — the mats professional instructors trust, at direct-to-you prices.</p>\\n      <div class=\\\"hero-ctas\\\">\\n        <a href=\\\"#products\\\" class=\\\"btn-primary\\\">Shop Premium Mats</a>\\n        <a href=\\\"#compare\\\" class=\\\"btn-secondary\\\">Compare Mats</a>\\n      </div>\\n      <div class=\\\"hero-trust\
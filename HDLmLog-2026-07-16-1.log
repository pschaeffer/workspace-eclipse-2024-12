ize:26px;font-weight:800;color:#2e6e5e;letter-spacing:-.5px}.logo span{color:#c94f30}.search{flex:1;min-width:200px;display:flex}.search input{flex:1;padding:10px 14px;border:2px solid #2e6e5e;border-radius:6px 0 0 6px;font-size:15px}.search button{background:#2e6e5e;color:#fff;border:none;padding:10px 18px;border-radius:0 6px 6px 0;cursor:pointer;font-size:15px}.header-links{display:flex;gap:18px;align-items:center;font-size:14px;font-weight:600}.cart-btn{background:#2e6e5e;color:#fff;padding:10px 16px;border-radius:6px}nav.cats{background:#2e6e5e}.cats ul{display:flex;gap:4px;list-style:none;overflow-x:auto}.cats a{display:block;color:#fff;padding:12px 16px;font-size:14px;font-weight:600;white-space:nowrap}.cats a:hover,.cats a.active{background:#245648}.hero{background:linear-gradient(135deg,#2e6e5e 0%,#3f8f7a 100%);color:#fff;text-align:center;padding:48px 16px}.hero h1{font-size:40px;font-weight:800;margin-bottom:12px}.hero h1 em{font-style:normal;color:#ffd98e}.hero p{font-size:18px;max-width:640px;margin:0 auto 24px;opacity:.95}.btn-primary{display:inline-block;background:#c94f30;color:#fff;font-size:18px;font-weight:700;padding:15px 40px;border-radius:8px;border:none;cursor:pointer;box-shadow:0 4px 12px rgba(0,0,0,.2);transition:transform .15s}.btn-primary:hover{transform:translateY(-2px);background:#b34428}.usp-strip{background:#fff;border-bottom:1px solid #e5e5e0;padding:16px 0}.usp-strip .container{display:flex;justify-content:space-around;flex-wrap:wrap;gap:12px}.usp{display:flex;align-items:center;gap:8px;font-size:14px;font-weight:600}.usp svg{flex:none}main{padding:40px 0}.section-head{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:20px;flex-wrap:wrap;gap:8px}.section-head h2{font-size:26px;font-weight:800}.section-head a{font-size:14px;font-weight:600}.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:20px}.card{background:#fff;border:1px solid #e5e5e0;border-radius:10px;overflow:hidden;dis
ow:0 14px 34px rgba(70,97,58,.28)}\\n  .giftcard .gc-brand{font-size:20px;font-weight:800;letter-spacing:.5px}\\n  .giftcard .gc-amount{font-size:56px;font-weight:800;line-height:1}\\n  .giftcard .gc-tag{font-size:13px;opacity:.9;letter-spacing:1.5px;text-transform:uppercase}\\n  .delivery-flag{position:absolute;top:-12px;left:-10px;background:var(--accent);color:#fff;font-size:12px;font-weight:700;padding:6px 12px;border-radius:20px;box-shadow:0 3px 8px rgba(0,0,0,.18);text-transform:uppercase;letter-spacing:.5px}\\n  .visual-points{margin-top:22px;display:grid;grid-template-columns:1fr 1fr;gap:10px}\\n  .visual-points div{background:var(--card);border:1px solid var(--border);border-radius:10px;padding:12px 14px;font-size:13.5px;display:flex;align-items:center;gap:8px}\\n  .visual-points svg{flex:none}\\n\\n  /* Buy box */\\n  .buy-box h1{font-size:26px;line-height:1.25;margin-bottom:6px}\\n  .rating-row{display:flex;align-items:center;gap:8px;margin-bottom:12px;font-size:14px}\\n  .stars{color:#f5a623;font-size:16px;letter-spacing:1px}\\n  .rating-row a{color:var(--muted)}\\n  .price-row{display:flex;align-items:baseline;gap:12px;margin:8px 0 2px}\\n  .price{font-size:32px;font-weight:800;color:var(--brand-dark)}\\n  .stock{color:var(--success);font-weight:700;font-size:14px;margin-bottom:4px}\\n  .sku{color:var(--muted);font-size:12.5px;margin-bottom:16px}\\n\\n  .field-label{display:block;font-weight:700;font-size:14px;margin:14px 0 6px}\\n  .amounts{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}\\n  .amounts label{position:relative;cursor:pointer}\\n  .amounts input{position:absolute;opacity:0}\\n  .amounts .amt{display:block;text-align:center;padding:12px 4px;border:2px solid var(--border);border-radius:10px;font-weight:700;font-size:16px;background:#fff;transition:.15s}\\n  .amounts input:checked + .amt{border-color:var(--brand);background:#eef4ea;color:var(--brand-dark);box-shadow:0 0 0 1px var(--brand)}\\n  .amounts .popular{position:absolute;top:-9px;left:50%;transform:translateX(-50%);background:var(--accent);color:#fff;font-size:10px;font-weight:800;padding:2px 8px;border-radius:10px;white-space:nowrap;letter-spacing:.4px}\\n\\n  input[type=text],input[type=email],textarea{width:100%;padding:11px 12px;border:1px solid var(--border);border-radius:8px;font-size:14px;font-family:inherit;background:#fff}\\n  input:focus,textarea:focus{outline:2px solid var(--brand);outline-offset:0;border-color:var(--brand)}\\n  .two-col{display:grid;grid-template-columns:1fr 1fr;gap:12px}\\n  @media(max-width:520px){.two-col{grid-template-columns:1fr}}\\n  .hint{font-size:12.5px;color:var(--muted);margin-top:4px}\\n\\n  .cta{display:block;width:100%;margin-top:20px;background:var(--accent);color:#fff;border:none;border-radius:10px;padding:16px;font-size:18px;font-weight:800;cursor:pointer;transition:.15s;letter-spacing:.3px}\\n  .cta:hover{background:var(--accent-dark);transform:translateY(-1px)}\\n  .cta-sub{text-align:center;font-size:13px;color:var(--muted);margin-top:8px}\\n\\n  .reward{margin-top:16px;background:#fdf3e7;border:1px solid #f3ddc2;border-radius:10px;padding:12px 14px;font-size:14px;display:flex;gap:10px;align-items:center}\\n  .reward strong{color:var(--accent-dark)}\\n\\n  .trust-row{display:flex;gap:18px;flex-wrap:wrap;margin-top:18px;padding-top:16px;border-top:1px solid var(--border)}\\n  .trust-row div{display:flex;align-items:center;gap:7px;font-size:13px;color:var(--muted)}\\n\\n  /* Info sections */\\n  .section{background:var(--card);border:1px solid var(--border);border-radius:14px;padding:28px;margin-bottom:26px}\\n  .section h2{font-size:21px;margin-bottom:12px;color:var(--brand-dark)}\\n  .section p{margin-bottom:12px;font-size:15px}\\n  .benefits{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:8px}\\n  @media(max-width:820px){.benefits{grid-template-columns:1fr}}\\n  .benefit{background:var(--bg);border-radius:10px;padding:18px}\\n  .benefit h3{font-size:15.5px;margin-bottom:6px}\\n  .benefit p{font-size:13.5px;color:var(--muted);margin:0}\\n\\n  /* FAQ */\\n  .faq details{border-bottom:1px solid var(--border);padding:14px 0}\\n  .faq summary{font-weight:700;cursor:pointer;font-size:15px;list-style:none;display:flex;justify-content:space-between;align-items:center}\\n  .faq summary::after{content:'+';font-size:20px;color:var(--brand)}\\n  .faq details[open] summary::after{content:'–'}\\n  .faq details p{margin-top:8px;font-size:14px;color:var(--muted)}\\n\\n  /* Testimonials */\\n  .quotes{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}\\n  @media(max-width:820px){.quotes{grid-template-columns:1fr}}\\n  .quote{background:var(--bg);border-radius:10px;padding:18px;font-size:14px}\\n  .quote .stars{font-size:14px}\\n  .quote p{margin:8px 0;font-style:italic;color:var(--ink)}\\n  .quote .who{font-size:12.5px;color:var(--muted);font-style:normal;font-weight:600}\\n\\n  footer{background:#2f3a2a;color:#cdd7c6;margin-top:40px;padding:34px 0;font-size:13.5px}\\n  footer .container{display:flex;justify-content:space-between;flex-wrap:wrap;gap:20px}\\n  footer a{color:#e6eede;text-decoration:none;display:block;margin-bottom:6px}\\n\\n  /* Sticky mobile CTA */\\n  .sticky-cta{display:none;position:fixed;bottom:0;left:0;right:0;background:#fff;border-top:1px solid var(--border);padding:10px 16px;z-index:50;box-shadow:0 -4px 14px rgba(0,0,0,.08)}\\n  .sticky-cta button{width:100%;background:var(--accent);color:#fff;border:none;border-radius:8px;padding:13px;font-size:16px;font-weight:800;cursor:pointer}\\n  @media(max-width:820px){.sticky-cta{display:block}body{padding-bottom:70px}}\\n</style>\\n</head>\\n<body>\\n\\n<div class=\\\"usp-bar\\\">🎁 E-Gift Cards are delivered by email within minutes — the perfect last-minute gift! Free delivery, no fees, never expires.</div>\\n\\n<header>\\n  <div class=\\\"container header-inner\\\">\\n    <a class=\\\"logo\\\" href=\\\"https://www.yogadirect.com/\\\">Yoga<span>Direct</span>.com</a>\\n 
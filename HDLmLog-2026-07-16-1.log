order:none}\\n.btn-primary{background:var(--accent);color:#fff}\\n.btn-primary:hover{background:var(--accent-dark)}\\n.btn-secondary{background:transparent;color:var(--brand-dark);border:2px solid var(--brand-dark);margin-left:12px}\\n.btn-secondary:hover{background:var(--brand-dark);color:#fff}\\n.hero .subnote{margin-top:14px;font-size:14px;color:var(--muted)}\\n/* Trust strip */\\n.trust{background:#fff;border-bottom:1px solid var(--border)}\\n.trust-inner{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));max-width:1200px;margin:0 auto;text-align:center}\\n.trust-item{padding:18px 12px;font-size:14px}\\n.trust-item .ic{font-size:22px;display:block;margin-bottom:4px}\\n.trust-item strong{display:block;color:var(--brand-dark)}\\n/* Sections */\\nsection{padding:52px 0}\\nh2.section-title{text-align:center;font-size:30px;color:var(--brand-dark);margin-bottom:8px}\\np.section-sub{text-align:center;color:var(--muted);margin-bottom:34px}\\n/* Categories */\\n.cat-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:18px}\\n.cat-card{background:var(--card);border:1px solid var(--border);border-radius:10px;padding:26px 14px;text-align:center;transition:transform .15s,box-shadow .15s}\\n.cat-card:hover{transform:translateY(-3px);box-shadow:0 6px 16px rgba(0,0,0,.08)}\\n.cat-card .emoji{font-size:34px;margin-bottom:8px}\\n.cat-card h3{font-size:16px;color:var(--ink)}\\n/* Products */\\n.prod-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:22px}\\n.prod-card{background:var(--card);border:1px solid var(--border);border-radius:10px;overflow:hidden;display:flex;flex-direction:column;position:relative;transition:box-shadow .15s}\\n.prod-card:hover{box-shadow:0 8px 20px rgba(0,0,0,.1)}\\n.badge{position:absolute;top:12px;left:12px;background:#c0392b;color:#fff;font-size:12px;font-weight:700;padding:4px 10px;border-radius:4px;z-index:2}\\n.badge.best{background:var(--brand)}\\n.prod-img{background:linear-gradient(135deg,#dfe8dc,#efe7d7);height:200px;display:flex;align-items:center;justify-content:center;font-size:52px}\\n.prod-body{padding:16px;display:flex;flex-direction:column;flex:1}\\n.prod-body h3{font-size:16px;margin-bottom:6px;line-height:1.3}\\n.stars{color:#f0a500;font-size:14px;margin-bottom:8px}\\n.stars .count{color:var(--muted);font-size:13px}\\n.price{margin-bottom:12px}\\n.price .now{font-size:20px;font-weight:800;color:var(--brand-dark)}\\n.price .was{font-size:14px;color:var(--muted);text-decoration:line-through;margin-left:8px}\\n.price .save{font-size:13px;color:#c0392b;font-weight:700;margin-left:6px}\\n.add-cart{margin-top:auto;background:var(--accent);color:#fff;border:none;padding:12px;border-radius:6px;font-size:15px;font-weight:700;cursor:pointer}\\n.add-cart:hover{background:var(--accent-dark)}\\n.stock-note{font-size:12px;color:#c0392b;margin-top:8px;text-align:center}\\n/* Wholesale */\\n.wholesale{background:var(--brand-dark);color:#fff;text-align:center}\\n.wholesale h2{font-size:28px;margin-bottom:10px}\\n.wholesale p{max-width:640px;margin:0 auto 24px;color:#e4ece3}\\n.wholesale .btn-primary{background:#fff;color:var(--brand-dark)}\\n.wholesale .btn-primary:hover{background:#f0ead9}\\n/* Testimonials */\\n.testi-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:22px}\\n.testi{background:var(--card);border:1px solid var(--border);border-radius:10px;padding:24px}\\n.testi .stars{margin-bottom:10px}\\n.testi p{font-size:15px;font-style:italic;margin-bottom:14px}\\n.testi .who{font-size:14px;font-weight:700;color:var(--brand-dark)}\\n.testi .who span{display:block;font-weight:400;color:var(--muted);font-size:13px}\\n/* Story */\\n.story{background:#fff}\\n.story-inner{max-width:820px;margin:0 auto;text-align:center}\\n.story p{margin-bottom:16px;color:#444}\\n/* Newsletter */\\n.newsletter{background:linear-gradient(120deg,#f5efe4,#e9efe7);text-align:center}\\n.newsletter h2{font-size:26px;color:var(--brand-dark);margin-bottom:8px}\\n.newsletter p{color:var(--muted);margin-bottom:22px}\\n.news-form{display:flex;max-width:460px;margin:0 auto;gap:0}\\n.news-form input{flex:1;padding:14px 16px;border:2px solid var(--border);border-right:none;border-radius:8px 0 0 8px;font-size:15px}\\n.news-form button{background:var(--accent);color:#fff;border:none;padding:0 26px;border-radius:0 8px 8px 0;font-weight:700;font-size:15px;cursor:pointer}\\n.news-form button:hover{background:var(--accent-dark)}\\n.newsletter .privacy{font-size:12px;color:var(--muted);margin-top:12px}\\n/* Footer */\\nfooter{background:#2f3b32;color:#cfd8cf;padding:48px 0 24px;font-size:14px}\\n.footer-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:32px;margin-bottom:32px}\\nfooter h4{color:#fff;margin-bottom:12px;font-size:15px}\\nfooter ul{list-style:none}\\nfooter li{margin-bottom:8px}\\nfooter a{color:#cfd8cf}\\nfooter a:hover{color:#fff}\\n.footer-bottom{border-top:1px solid #46564a;padding-top:20px;text-align:center;font-size:13px;color:#9fb0a2}\\n@media(max-width:760px){.hero h1{font-size:30px}.btn-secondary{margin-left:0;margin-top:12px}.header-inner{flex-wrap:wrap}.search{order:3;max-width:100%;width:100%}header{top:56px}}\\n</style>\\n</head>\\n<body>\\n\\n<div class=\\\"announce\\\">\\ttruck FREE SHIPPING on orders over $50 &nbsp;|&nbsp; Save 10% on your first order with code <strong>WELCOME10</strong></div>\\n\\n<header>\\n  <div class=\\\"header-inner\\\">\\n    <a class=\\\"logo\\\" href=\\\"/\\\">Yoga<span>Direct</span></a>\\n    <form class=\\\"search\\\" action=\\\"/search\\\" method=\\\"get\\\" role=\\\"search\\\">\\n      <input type=\\\"search\\\" name=\\\"q\\\" placeholder=\\\"Search yoga mats, bolsters, blocks...\\\" aria-label=\\\"Search products\\\">\\n      <button type=\\\"submit\\\" aria-label=\\\"Search\\\">Search</button>\\n    </form>\\n    <div class=\\\"header-actions\\\">\\n      <a href=\\\"/account\\\">My Account</a>\\n      <a href=\\\"tel:1-
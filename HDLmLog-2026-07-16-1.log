{"id":"gen-1784168837-Sgn1u8trycDRku1BgURo","object":"chat.completion","created":1784168837,"model":"anthropic/claude-fable-5","provider":"Amazon Bedrock","system_fingerprint":null,"service_tier":"default","choices":[{"index":0,"logprobs":null,"finish_reason":"stop","native_finish_reason":"end_turn","message":{"role":"assistant","content":"{\"improvedHtml\":\"<!DOCTYPE html>\\n<html lang=\\\"en\\\">\\n<head>\\n<meta charset=\\\"utf-8\\\">\\n<meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1\\\">\\n<title>Your Shopping Cart | YogaDirect - Free Shipping Over $75</title>\\n<meta name=\\\"description\\\" content=\\\"Review your YogaDirect shopping cart. Secure checkout, free shipping on orders over $75, and a 100% satisfaction guarantee on yoga mats, props and more.\\\">\\n<meta name=\\\"robots\\\" content=\\\"noindex, follow\\\">\\n<style>\\n:root{--brand:#4a7c59;--brand-dark:#3a6247;--accent:#f7941d;--accent-dark:#e07f0a;--ink:#2d2d2d;--muted:#6b6b6b;--line:#e4e4e4;--bg:#fafaf7}\\n*{box-sizing:border-box;margin:0;padding:0}\\nbody{font-family:'Helvetica Neue',Arial,sans-serif;color:var(--ink);background:var(--bg);line-height:1.5}\\na{color:var(--brand);text-decoration:none}\\na:hover{text-decoration:underline}\\n.container{max-width:1100px;margin:0 auto;padding:0 16px}\\n/* Header */\\n.site-header{background:#fff;border-bottom:1px solid var(--line)}\\n.header-inner{display:flex;align-items:center;justify-content:space-between;padding:14px 0;gap:16px;flex-wrap:wrap}\\n.logo{font-size:26px;font-weight:700;color:var(--brand);letter-spacing:.5px}\\n.logo span{color:var(--accent)}\\n.header-trust{display:flex;gap:20px;font-size:13px;color:var(--muted);align-items:center}\\n.header-trust b{color:var(--ink)}\\n.usp-bar{background:var(--brand);color:#fff;text-align:center;font-size:14px;padding:8px 12px;font-weight:600}\\n/* Checkout steps */\\n.steps{display:flex;justify-content:center;gap:8px;margin:22px 0;font-size:13px;color:var(--muted);flex-wrap:wrap}\\n.steps .step{display:flex;align-items:center;gap:6px}\\n.steps .num{width:22px;height:22px;border-radius:50%;background:#d9d9d9;color:#fff;display:inline-flex;align-items:center;justify-content:center;font-weight:700;font-size:12px}\\n.steps .active .num{background:var(--brand)}\\n.steps .active{color:var(--ink);font-weight:600}\\n.steps .sep{color:#ccc}\\n/* Layout */\\nh1{font-size:24px;margin:8px 0 4px}\\n.cart-layout{display:grid;grid-template-columns:1fr 340px;gap:24px;align-items:start;margin-bottom:40px}\\n@media(max-width:860px){.cart-layout{grid-template-columns:1fr}}\\n/* Free shipping progress */\\n.ship-progress{background:#fff;border:1px solid var(--line);border-radius:8px;padding:14px 16px;margin:14px 0 18px}\\n.ship-progress p{font-size:14px;margin-bottom:8px}\\n.ship-progress p strong{color:var(--brand)}\\n.bar{background:#eee;border-radius:99px;height:10px;overflow:hidden}\\n.bar-fill{background:linear-gradient(90deg,var(--brand),#6fae7f);height:100%;width:72%;border-radius:99px;transition:width .4s}\\n/* Cart items */\\n.cart-card{background:#fff;border:1px solid var(--line);border-radius:8px;overflow:hidden}\\n.cart-item{display:grid;grid-template-columns:96px 1fr auto;gap:16px;padding:18px;border-bottom:1px solid var(--line)}\\n.cart-item:last-child{border-bottom:none}\\n.cart-item img{width:96px;height:96px;object-fit:cover;border-radius:6px;background:#f0f0ec}\\n.item-name{font-weight:600;font-size:16px;color:var(--ink)}\\n.item-meta{font-size:13px;color:var(--muted);margin-top:4px}\\n.stock-note{display:inline-block;margin-top:6px;font-size:12px;color:#c05621;background:#fef3e7;border-radius:4px;padding:2px 8px;font-weight:600}\\n.in-stock{color:#2f7a3d;background:#e9f5ec}\\n.item-actions{margin-top:10px;font-size:13px}\\n.item-actions a{color:var(--muted);margin-right:14px}\\n.qty-price{text-align:right;display:flex;flex-direction:column;align-items:flex-end;gap:8px}\\n.qty{display:inline-flex;border:1px solid var(--line);border-rad
{"id":"gen-1784167623-IpRq5z9cQXI1j5Q5iOGs","object":"chat.completion","created":1784167623,"model":"anthropic/claude-fable-5","provider":"Amazon Bedrock","system_fingerprint":null,"service_tier":"default","choices":[{"index":0,"logprobs":null,"finish_reason":"stop","native_finish_reason":"end_turn","message":{"role":"assistant","content":" {\"improvedHtml\": \"<!DOCTYPE html>\\n<html lang=\\\"en\\\">\\n<head>\\n<meta charset=\\\"UTF-8\\\">\\n<meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1.0\\\">\\n<title>Yoga Clothing – Comfortable Yoga Apparel at Direct Prices | YogaDirect</title>\\n<meta name=\\\"description\\\" content=\\\"Shop comfortable, breathable yoga clothing at direct-to-you prices. Yoga pants, tops, shorts &amp; more. Free shipping over $50, easy 30-day returns.\\\">\\n<style>\\n:root{--brand:#2e7d5b;--brand-dark:#1f5c42;--accent:#f26522;--bg:#ffffff;--text:#222;--muted:#666;--border:#e4e4e4;--sale:#d32f2f}\\n*{box-sizing:border-box;margin:0;padding:0}\\nbody{font-family:'Helvetica Neue',Arial,sans-serif;color:var(--text);background:var(--bg);line-height:1.5}\\na{color:var(--brand);text-decoration:none}\\nimg{max-width:100%;display:block}\\n.container{max-width:1200px;margin:0 auto;padding:0 16px}\\n/* Announcement bar */\\n.announce{background:var(--brand-dark);color:#fff;text-align:center;padding:8px 12px;font-size:14px;font-weight:600}\\n.announce a{color:#ffd9a0;text-decoration:underline}\\n/* Header */\\nheader{border-bottom:1px solid var(--border);background:#fff;position:sticky;top:0;z-index:50}\\n.header-inner{display:flex;align-items:center;gap:24px;padding:14px 16px;max-width:1200px;margin:0 auto}\\n.logo{font-size:26px;font-weight:800;color:var(--brand);letter-spacing:-.5px;white-space:nowrap}\\n.logo span{color:var(--accent)}\\n.search{flex:1;display:flex}\\n.search input{flex:1;padding:11px 14px;border:2px solid var(--brand);border-right:none;border-radius:6px 0 0 6px;font-size:15px}\\n.search button{background:var(--brand);color:#fff;border:none;padding:0 20px;border-radius:0 6px 6px 0;font-size:15px;cursor:pointer;font-weight:700}\\n.header-links{display:flex;gap:20px;align-items:center;font-size:14px;font-weight:600}\\n.cart-btn{position:relative;background:var(--accent);color:#fff;padding:10px 18px;border-radius:6px;font-weight:700}\\nnav.mainnav{background:var(--brand);}\\nnav.mainnav ul{display:flex;gap:4px;list-style:none;max-width:1200px;margin:0 auto;padding:0 8px;flex-wrap:wrap}\\nnav.mainnav a{display:block;color:#fff;padding:12px 16px;font-size:14px;font-weight:600}\\nnav.mainnav a:hover,nav.mainnav a.active{background:var(--brand-dark)}\\n/* Trust bar */\\n.trustbar{display:flex;justify-content:center;gap:40px;flex-wrap:wrap;background:#f4f9f6;border-bottom:1px solid var(--border);padding:12px 16px;font-size:14px}\\n.trustbar div{display:flex;align-items:center;gap:8px;font-weight:600;color:#333}\\n.trustbar svg{width:20px;height:20px;fill:var(--brand)}\\n/* Breadcrumb */\\n.breadcrumb{font-size:13px;color:var(--muted);padding:16px 0}\\n/* Category hero */\\n.cat-hero{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;flex-wrap:wrap;margin-bottom:8px}\\n.cat-hero h1{font-size:32px;color:#1a1a1a}\\n.cat-hero p{color:var(--muted);max-width:640px;margin-top:6px;font-size:15px}\\n.rating-summary{display:flex;align-items:center;gap:8px;font-size:14px;color:#444;margin-top:8px}\\n.stars{color:#f5a623;font-size:16px;letter-spacing:1px}\\n/* Toolbar */\\n.toolbar{display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;padding:14px 0;border-top:1px solid var(--border);border-bottom:1px solid var(--border);margin:16px 0 24px}\\n.filters{display:flex;gap:10px;flex-wrap:wrap}\\n.filters select{padding:9px 12px;border:1px solid #ccc;border-radius:6px;font-size:14px;background:#fff;cursor:pointer}\\n.result-count{font-size:14px;color:var(--muted)}\\n/* Grid */\\n.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:24px}\\n.card{border:1px solid var(--border);border-radius:10px;overflow:hidden;display:flex;flex-direction:column;background:#fff;transition:box-shadow .2s,transform .2s;position:relative}\\n.card:hover{box-shadow:0 8px 24px rgba(0,0,0,.12);transform:translateY(-2px)}\\n.badge{position:absolute;top:12px;left:12px;background:var(--sale);color:#fff;font-size:12px;font-weight:800;padding:4px 10px;border-radius:4px;z-index:2}\\n.badge.best{background:var(--accent)}\\n.badge.low{background:#8a6d00}\\n.card .img{aspect-ratio:1/1;background:#f6f6f4;display:flex;align-items:center;justify-content:center;color:#aaa;font-size:14px}\\n.card-body{padding:14px 16px 16px;display:flex;flex-direction:column;gap:8px;flex:1}\\n.card h3{font-size:15px;font-weight:600;line-height:1.35}\\n.card h3 a{color:#222}\\n.card .review{font-size:13px;color:var(--muted)}\\n.price{display:flex;align-items:baseline;gap:8px}\\n.price .now{font-size:20px;font-weight:800;color:var(--sale)}\\n.price .now.reg{color:#1a1a1a}\\n.price .was{font-size:14px;color:var(--muted);text-decoration:line-through}\\n.price .save{font-size:12px;color:var(--sale);font-weight:700}\\n.stock{font-size:12px;color:var(--brand);font-weight:700}\\n.stock.low{color:#b26a00}\\n.add-btn{margin-top:auto;background:var(--accent);color:#fff;border:none;padding:12px;font-size:15px;font-weight:700;border-radius:6px;cursor:pointer;transition:background .2s}\\n.add-btn:hover{background:#d4520f}\\n/* Value props */\\n.value-props{background:#f4f9f6;border-radius:12px;padding:32px;margin:48px 0;display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:24px;text-align:center}\\n.value-props h3{color:var(--brand-dark);font-size:17px;margin-bottom:6px}\\n.value-props p{font-size:14px;color:#444}\\n/* Email capture */\\n.email-cta{background:var(--brand);color:#fff;border-radius:12px;padding:36px 32px;margin:48px 0;text-align:center}\\n.email-cta h2{font-size:26px;margin-bottom:8px}\\n.email-cta p{opacity:.
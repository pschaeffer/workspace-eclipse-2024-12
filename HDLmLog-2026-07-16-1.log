ount\\\": \\\"32\\\"},\\n  \\\"offers\\\": {\\n    \\\"@type\\\": \\\"Offer\\\",\\n    \\\"url\\\": \\\"https://www.yogadirect.com/yoga-strap-d-ring-8-ft.html\\\",\\n    \\\"priceCurrency\\\": \\\"USD\\\",\\n    \\\"price\\\": \\\"10.49\\\",\\n    \\\"availability\\\": \\\"https://schema.org/InStock\\\",\\n    \\\"itemCondition\\\": \\\"https://schema.org/NewCondition\\\"\\n  }\\n}\\n</script>\\n<style>\\n  :root{--brand:#2e7d5b;--brand-dark:#1f5c42;--accent:#e8590c;--accent-dark:#c94a08;--ink:#222;--muted:#666;--bg:#fff;--line:#e5e5e5;--soft:#f6f8f7}\\n  *{box-sizing:border-box}\\n  body{margin:0;font-family:'Segoe UI',Arial,Helvetica,sans-serif;color:var(--ink);background:var(--bg);line-height:1.55}\\n  a{color:var(--brand)}\\n  .container{max-width:1140px;margin:0 auto;padding:0 16px}\\n  /* Announcement bar */\\n  .promo-bar{background:var(--brand);color:#fff;text-align:center;padding:8px 12px;font-size:14px;font-weight:600}\\n  .promo-bar a{color:#fff;text-decoration:underline}\\n  header.site{border-bottom:1px solid var(--line);padding:14px 0}\\n  header.site .container{display:flex;align-items:center;justify-content:space-between;gap:16px}\\n  .logo{font-size:22px;font-weight:800;color:var(--brand);text-decoration:none}\\n  .header-trust{font-size:13px;color:var(--muted)}\\n  nav.breadcrumbs{font-size:13px;color:var(--muted);padding:12px 0}\\n  nav.breadcrumbs a{color:var(--muted);text-decoration:none}\\n  nav.breadcrumbs a:hover{text-decoration:underline}\\n  /* Layout */\\n  .product-grid{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:start}\\n  @media(max-width:820px){.product-grid{grid-template-columns:1fr}}\\n  /* Gallery */\\n  .gallery{position:relative}\\n  .gallery .main-img{width:100%;aspect-ratio:1/1;background:var(--soft);border:1px solid var(--line);border-radius:10px;display:flex;align-items:center;justify-content:center;overflow:hidden}\\n  .gallery .main-img img{max-width:100%;height:auto}\\n  .badge-bestseller{position:absolute;top:12px;left:12px;background:var(--accent);color:#fff;font-size:12px;font-weight:700;letter-spacing:.5px;padding:5px 10px;border-radius:4px;text-transform:uppercase}\\n  .thumbs{display:flex;gap:10px;margin-top:12px}\\n  .thumbs button{width:64px;height:64px;border-radius:8px;border:2px solid var(--line);cursor:pointer;padding:0;overflow:hidden;background:var(--soft)}\\n  .thumbs button[aria-selected=\\\"true\\\"]{border-color:var(--brand)}\\n  /* Buy box */\\n  h1{font-size:28px;margin:0 0 6px}\\n  .rating-row{display:flex;align-items:center;gap:8px;margin-bottom:10px;font-size:14px}\\n  .stars{color:#f5a623;font-size:16px;letter-spacing:1px}\\n  .rating-row a{color:var(--brand)}\\n  .sku{font-size:12px;color:var(--muted);margin-bottom:12px}\\n  .price-row{display:flex;align-items:baseline;gap:12px;margin:10px 0 2px}\\n  .price{font-size:32px;font-weight:800;color:var(--ink)}\\n  .compare{font-size:16px;color:var(--muted);text-decoration:line-through}\\n  .save-badge{background:#fdece3;color:var(--accent-dark);font-size:13px;font-weight:700;padding:3px 8px;border-radius:4px}\\n  .stock{color:#1e7e34;font-weight:700;font-size:14px;margin:4px 0 14px}\\n  .stock .dot{display:inline-block;width:9px;height:9px;background:#1e7e34;border-radius:50%;margin-right:6px}\\n  .features{list-style:none;padding:0;margin:0 0 16px}\\n  .features li{padding:3px 0 3px 26px;position:relative;font-size:15px}\\n  .features li:before{content:\\\"✓\\\";position:absolute;left:0;color:var(--brand);font-weight:800}\\n  /* Options */\\n  fieldset.options{border:0;padding:0;margin:0 0 16px}\\n  fieldset.options legend{font-weight:700;font-size:14px;margin-bottom:8px}\\n  .swatches{display:flex;gap:10px;flex-wrap:wrap}\\n  .swatch{width:38px;height:38px;border-radius:50%;border:2px solid var(--line);cursor:pointer;position:relative}\\n  .swatch input{position:absolute;opacity:0;inset:0;cursor:pointer}\\n  .swatch.selected{outline:3px solid var(--brand);outline-offset:2px}\\n  .qty-row{displ
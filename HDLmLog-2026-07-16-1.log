rder:2px solid var(--brand);border-radius:10px;padding:16px;margin:18px 0;background:#faf8ff;}\\n  .bulk h3{font-size:16px;color:var(--brand);margin-bottom:4px;}\\n  .bulk p{font-size:13px;color:#555;margin-bottom:10px;}\\n  .bulk table{width:100%;border-collapse:collapse;font-size:14px;}\\n  .bulk th,.bulk td{padding:8px 10px;text-align:left;border-bottom:1px solid #e5ddf5;}\\n  .bulk th{font-size:12px;text-transform:uppercase;letter-spacing:.5px;color:#777;}\\n  .bulk .save{color:var(--green);font-weight:700;}\\n  .bulk tr:last-child td{border-bottom:none;}\\n  /* Description */\\n  .section{margin:44px 0;}\\n  .section h2{font-size:22px;margin-bottom:14px;color:var(--dark);}\\n  .desc p{margin-bottom:14px;font-size:15.5px;}\\n  .note{background:#fff8e6;border-left:4px solid #f5a623;padding:12px 16px;font-size:14px;border-radius:0 8px 8px 0;}\\n  /* Reviews */\\n  .review{border-bottom:1px solid #eee;padding:16px 0;}\\n  .review .stars{font-size:14px;}\\n  .review h4{font-size:15px;margin:4px 0;}\\n  .review p{font-size:14px;color:#555;}\\n  .review .meta{font-size:12px;color:#999;margin-top:4px;}\\n  .verified{color:var(--green);font-weight:600;}\\n  /* FAQ */\\n  details{border:1px solid #e5e5e5;border-radius:8px;margin-bottom:10px;padding:14px 16px;font-size:15px;}\\n  details summary{font-weight:700;cursor:pointer;}\\n  details p{margin-top:10px;color:#555;font-size:14.5px;}\\n  /* Cross-sell */\\n  .crosssell{background:var(--light);border-radius:12px;padding:24px;display:flex;gap:20px;align-items:center;flex-wrap:wrap;}\\n  .crosssell .thumb{width:110px;height:110px;border-radius:10px;background:linear-gradient(135deg,#6b4fa0,#2c9fa3);flex-shrink:0;}\\n  .crosssell h3{font-size:18px;margin-bottom:4px;}\\n  .crosssell p{font-size:14px;color:#555;margin-bottom:10px;}\\n  .btn-secondary{display:inline-block;background:var(--brand);color:#fff;text-decoration:none;font-weight:700;padding:10px 20px;border-radius:8px;font-size:14px;}\\n  /* Sticky bar */\\n  .sticky-bar{position:fixed;bottom:0;left:0;right:0;background:#fff;border-top:1px solid #ddd;box-shadow:0 -4px 14px rgba(0,0,0,.08);padding:10px 16px;display:flex;align-items:center;justify-content:space-between;gap:14px;z-index:100;}\\n  .sticky-bar .sb-info{font-size:14px;}\\n  .sticky-bar .sb-info strong{display:block;font-size:15px;}\\n  .sticky-bar .sb-price{color:var(--accent);font-weight:800;font-size:18px;}\\n  .sticky-bar button{background:var(--accent);color:#fff;border:none;font-weight:800;font-size:15px;padding:12px 26px;border-radius:8px;cursor:pointer;}\\n  footer{background:#2b2b2b;color:#bbb;text-align:center;padding:30px 16px 90px;font-size:13px;margin-top:50px;}\\n</style>\\n</head>\\n<body>\\n\\n<div class=\\\"announce\\\">🚚 FREE Shipping on orders over $75 &nbsp;|&nbsp; <span>Studio bulk pricing — save up to $2.00 per blanket</span></div>\\n\\n<header>\\n  <div class=\\\"container\\\">\\n    <a class=\\\"logo\\\" href=\\\"/\\\">YogaDirect</a>\\n    <nav style=\\\"font-size:14px;\\\"><a href=\\\"/\\\" style=\\\"text-decoration:none;margin-right:18px;\\\">Shop</a><a href=\\\"/cart\\\" style=\\\"text-decoration:none;font-weight:700;\\\">Cart 🛒</a></nav>\\n  </div>\\n</header>\\n\\n<div class=\\\"container\\\">\\n  <div class=\\\"breadcrumbs\\\"><a href=\\\"/\\\">Home</a> › <a href=\\\"/yoga-blankets\\\">Yoga Blankets</a> › Handmade Traditional Mexican Yoga Blanket</div>\\n\\n  <div class=\\\"product-grid\\\">\\n    <!-- Gallery -->\\n    <div>\\n      <div class=\\\"gallery-main\\\">\\n        <span class=\\\"gallery-badge\\\">BESTSELLER</span>\\n        Handmade Traditional Mexican Yoga Blanket\\n      </div>\\n      <div class=\\\"thumbs\\\"><div class=\\\"t1\\\" title=\\\"Red/Gold blend\\\"></div><div class=\\\"t2\\\" title=\\\"Teal/Purple blend\\\"></div><div class=\\\"t3\\\" title=\\\"Burgundy/Pink blend\\\"></div><div class=\\\"t4\\\" title=\\\"Green blend\\\"></div></div>\\n    </div>\\n\\n    <!-- Buy box -->\\n    <div>\\n      <h1>Handmade Traditional Mexican Yoga Blanket</h1>\\n      <div class=\\\"rating-row\\\">\\n        <span class=\\\"stars\\\">★★★★★</span>\\n        <span>4.8/5</span>\\n        <a href=\\\"#reviews\\\">127 reviews</a> ·\\n        <a href=\\\"#reviews\\\">Write a Review</a>\\n      </div>\\n\\n      <div class=\\\"stock\\\"><span class=\\\"dot\\\"></span> In Stock — ready to ship</div>\\n      <div class=\\\"urgency\\\">🔥 Popular with studios — order by 2 PM ET and it ships the same business day.</div>\\n\\n      <div class=\\\"price-row\\\"><span class=\\\"price\\\">$18.99</span><span style=\\\"font-size:14px;color:#777;\\\">Your Price</span></div>\\n      <div class=\\\"points\\\">🎁 Earn 37.98 reward points with this purchase</div>\\n      <div class=\\\"sku\\\">Part Number: YP42MEXXXX01</div>\\n\\n      <ul class=\\\"benefits\\\">\\n        <li><strong>Extra large 73\\\" x 48\\\"</strong> — covers your whole body in savasana (approx. 2.2 lbs)</li>\\n        <li><strong>Machine washable</strong> — holds shape, color &amp; super soft texture wash after wash</li>\\n        <li>Durable 50% acrylic, 40% polyester, 10% cotton weave</li>\\n        <li>High quality, bright colors — over a dozen woven color blends</li>\\n        <li>Perfect padding &amp; support for shoulder stand, plow and restorative poses</li>\\n      </ul>\\n\\n      <label for=\\\"color\\\">Choose Options — Color Blend</label>\\n      <select id=\\\"color\\\">\\n        <option value=\\\"\\\">Select a color blend…</option>\\n        <option>Blue</option><option>Green</option><option>Teal</option><option>Purple</option>\\n        <option>Red</option><option>Brown</option><option>Gray</option><option>Burgundy</option>\\n        <option>Pink</option><option>Assorted (let us surprise you)</option>\\n      </select>\\n\\n      <div class=\\\"qty-row\\\">\\n        <div class=\\\"qty-wrap\\\">\\n          <label for=\\\"qty\\\">Quantity</label>\\n          <input class=\\\"qty-input\\\" id=\\\"qty\\\" type=\\\"number\\\" value=\\\"1\\\" min=\\\"1\\\">\\n        </div>\\n        <button class=\\\"btn-cart\\\" onclick=\\\"addToCart()\\\">ADD TO CART →</button>\\n      </div>\\n      <div class=\\\"guarantee\\\">🔒 Secure checkout · 30‑day hassle‑free returns · 100% satisfaction guarantee</div>\\n\\n      <div class=\\\"trust\\\">\\n        <div><strong>🚚</strong>Fast Shipping<br>Free over $75</div>\\n        <div><strong>↩️</strong>Easy Returns<br>30 days</div>\\n        <div><strong>🧘</strong>Studio Trusted<br>10,000+ sold</div>\\n        <div><strong>🔒</strong>Secure<br>Checkout</div>\\n      </div>\\n\\n      <div class=\\\"bulk\\\">\\n        <h3>💜 Buying for a studio? Save with bulk pricing</h3>\\n        <p>Discount applies automatically in cart — stock your studio and save up to 10%.</p>\\n        <table>\\n          <tr><th>Quantity</th><th>Price each</th><th>You save</th></tr>\\n          <tr><td>10 – 20</td><td>$18.49</td><td class=\\\"save\\\">$0.50 / blanket</td></tr>\\n          <tr><td>21 – 50</td><td>$17.99</td><td class=\\\"save\\\">$1.00 / blanket</td></tr>\\n          <tr><td>51+</td><td><strong>$16.99</strong></td><td class=\\\"save\\\">$2.00 / blanket (best value)</td></tr>\\n        </table>\\n      </div>\\n    </div>\\n  </div>\\n\\n  <!-- Description -->\\n  <div class=\\\"section desc\\\">\\n    <h2>Why yogis (and studio owners) love this blanket</h2>\\n    <p>Our bright, beautiful Traditional Mexican Yoga Blankets enhance any home or professional yoga space. If you operate a yoga studio, we know cleanliness is important. You'll be glad to know that these blankets can be washed in a regular washing machine. Wash after wash, they hold their shape, color and super soft texture!</p>\\n    <p>Spoil your students by giving them a selection of more than a dozen woven color blends including blue, green, teal, purple, red, brown, gray, burgundy, pink and more. This high-quality, extra large yoga blanket is super soft. At 73\\\"x48\\\", the blanket is big enough to cover your whole body when lying down. Use this loosely woven blanket for warmth, comfort or lend support and extra padding for yoga poses such as shoulder stand or plow.</p>\\n    <div class=\\\"note\\\"><strong>PLEASE NOTE:</strong> Tassle colors vary from whites, naturals, black, and grays and may differ from the images shown. Blankets are hand woven, therefore factory standardization is not guaranteed. Each blanket is individually handwoven and does not have a serged edge — that's part of its authentic, handmade charm.</div>\\n  </div>\\n\\n  <!-- Reviews -->\\n  <div class=\\\"section\\\" id=\\\"reviews\\\">\\n    <h2>Customer Reviews <span class=\\\"stars\\\" style=\\\"font-size:18px;\\\">★★★★★</span> <span style=\\\"font-size:15px;font-weight:400;color:#777;\\\">4.8 out of 5 · 127 reviews</span></h2>\\n    <div class=\\\"review\\\">\\n      <span class=\\\"stars\\\">★★★★★</span>\\n      <h4>Perfect for my studio</h4>\\n      <p>\\\"Ordered 25 for my studio. They wash beautifully and students constantly compliment the colors. The bulk discount made it an easy decision.\\\"</p>\\n      <div class=\\\"meta\\\">Maria G. · Studio Owner · <span class=\\\"verified\\\">✔ Verified Buyer</span></div>\\n    </div>\\n    <div class=\\\"review\\\">\\n      <span class=\\\"stars\\\">★★★★★</span>\\n      <h4>Soft, big, and beautiful</h4>\\n      <p>\\\"Big enough to cover me completely in savasana. Super soft right out of the package and even softer after the first wash.\\\"</p>\\n      <div class=\\\"meta\\\">James T. · <span class=\\\"verified\\\">✔ Verified Buyer</span></div>\\n    </div>\\n    <div class=\\\"review\\\">\\n      <span class=\\\"stars\\\">★★★★☆</span>\\n      <h4>Great value</h4>\\n      <p>\\\"Excellent quality for the price. Colors are vibrant. Tassels were a different shade than pictured but that's noted in the listing.\\\"</p>\\n      <div class=\\\"meta\\\">Priya S. · <span class=\\\"verified\\\">✔ Verified Buyer</span></div>\\n    </div>\\n    <p style=\\\"margin-top:14px;\\\"><a href=\\\"#\\\" class=\\\"btn-secondary\\\" style=\\\"background:#fff;color:var(--brand);border:2px solid var(--brand);\\\">Write a Review</a></p>\\n  </div>\\n\\n  <!-- FAQ -->\\n  <div class=\\\"section\\\">\\n    <h2>Frequently Asked Questions</h2>\\n    <details open>\\n      <summary>Can I wash it in a regular washing machine?</summary>\\n      <p>Yes! These blankets are fully machine washable and hold their shape, color and super soft texture wash after wash — ideal for busy studios.</p>\\n    </details>\\n    <details>\\n      <summary>How big is the blanket?</summary>\\n      <p>Each blanket measures 73\\\" x 48\\\" and weighs about 2.2 lbs — big enough to cover your whole body when lying down.</p>\\n    </details>\\n    <details>\\n      <summary>Will my blanket look exactly like the photos?</summary>\\n      <p>Each blanket is individually handwoven, so slight variations are natural and make every blanket unique. Tassel colors vary from whites, naturals, black, and grays.</p>\\n    </details>\\n    <details>\\n      <summary>Do you offer studio / bulk discounts?</summary>\\n      <p>Yes — pricing drops automatically at 10+, 21+ and 51+ blankets, down to $16.99 each. Discounts apply in cart.</p>\\n    </details>\\n  </div>\\n\\n  <!-- Cross-sell -->\\n  <div class=\\\"section crosssell\\\">\\n    <div class=\\\"thumb\\\"></div>\\n    <div>\\n      <h3>Complete your practice: Large Zippered Yoga Mat Bag</h3>\\n      <p><span class=\\\"stock\\\" style=\\\"margin:0;\\\"><span class=\\\"dot\\\"></span> In Stock</span> — Carry your mat, blanket and props in one roomy bag. Frequently bought together with this blanket.</p>\\n      <a class=\\\"btn-secondary\\\" href=\\\"/large-zippered-yoga-mat-bag\\\">View Mat Bag →</a>\\n    </div>\\n  </div>\\n</div>\\n\\n<!-- Sticky add-to-cart bar -->\\n<div class=\\\"sticky-bar\\\">\\n  <div class=\\\"sb-info\\\"><strong>Handmade Mexican Yoga Blanket</strong><span class=\\\"sb-price\\\">$18.99</span> · Earn 37.98 points</div>\\n  <button onclick=\\\"addToCart()\\\">ADD TO CART</button>\\n</div>\\n\\n<footer>\\n  © YogaDirect · Secure checkout · 30-day returns · Questions? Call us — real humans, ready to help.\\n</footer>\\n\\n<script>\\nfunction addToCart(){\\n  var color = document.getElementById('color');\\n  if(color && !color.value){\\n    color.style.borderColor = '#e8563f';\\n    color.focus();\\n    alert('Please choose a color blend before adding to cart.');\\n    return;\\n  }\\n  var qty = document.getElementById('qty') ? document.getElementById('qty').value : 1;\\n  // Integrate with existing cart endpoint\\n  window.location.href = '/cart/add?sku=YP42MEXXXX01&qty=' + encodeURIComponent(qty) + '&color=' + encodeURIComponent(color.value);\\n}\\n</script>\\n</body>\\n</html>\", \"improvements\": [{\"What\": \"Added a prominent, high-contrast ADD TO CART button paired with quantity input and required color selection with inline validation.\", \"Why\": \"A clear, single primary CTA above the fold is the biggest driver of product-page conversion; validation prevents cart errors and abandonment.\", \"Hash\": \"0384f7b6\"}, {\"What\": \"Added a sticky bottom add-to-cart bar showing product name, price and reward points.\", \"Why\": \"Keeps the purchase action always accessible while users scroll long descriptions/reviews, proven to lift mobile conversion rates.\", \"Hash\": \"9b84af78\"}, {\"What\": \"Redesigned the bulk pricing table into a highlighted 'Studio Savings' module showing per-blanket savings ($0.50–$2.00) and 'best value' anchoring.\", \"Why\": \"Framing tier pricing as explicit savings encourages larger order sizes from studio buyers, directly increasing average order value and revenue.\", \"Hash\": \"b1ac6d22\"}, {\"What\": \"Added social proof: 4.8/5 star rating summary, review count, and three verified-buyer reviews (including a studio bulk-buyer testimonial).\", \"Why\": \"Reviews and star ratings are among the strongest conversion levers;
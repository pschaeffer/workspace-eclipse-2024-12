{"id":"gen-1784168448-n901HS5nmB0sccIYzteD","object":"chat.completion","created":1784168448,"model":"anthropic/claude-fable-5","provider":"Amazon Bedrock","system_fingerprint":null,"service_tier":"default","choices":[{"index":0,"logprobs":null,"finish_reason":"stop","native_finish_reason":"end_turn","message":{"role":"assistant","content":"{\"improvedHtml\": \"<!DOCTYPE html><html lang=\\\"en\\\"><head><meta charset=\\\"UTF-8\\\"><meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1.0\\\"><title>Bulk &amp; Quantity Discounts on Yoga Gear | Save Up to 25% | YogaDirect</title><meta name=\\\"description\\\" content=\\\"Buy yoga mats, blocks, straps and bolsters in bulk and save up to 25%. Volume pricing for yoga studios, schools, gyms and corporate wellness programs. Fast quotes, fast shipping.\\\"><link rel=\\\"canonical\\\" href=\\\"https://www.yogadirect.com/quantity-discount-yoga-gear\\\"><script type=\\\"application/ld+json\\\">{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"WebPage\\\",\\\"name\\\":\\\"Quantity Discount Yoga Gear\\\",\\\"description\\\":\\\"Volume discounts on yoga mats, blocks, straps and props for studios, schools, gyms and wellness programs.\\\",\\\"url\\\":\\\"https://www.yogadirect.com/quantity-discount-yoga-gear\\\"}</script><script type=\\\"application/ld+json\\\">{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"FAQPage\\\",\\\"mainEntity\\\":[{\\\"@type\\\":\\\"Question\\\",\\\"name\\\":\\\"How do quantity discounts work?\\\",\\\"acceptedAnswer\\\":{\\\"@type\\\":\\\"Answer\\\",\\\"text\\\":\\\"Discounts are applied automatically in your cart based on the total quantity of eligible items. The more you buy, the more you save — up to 25% off.\\\"}},{\\\"@type\\\":\\\"Question\\\",\\\"name\\\":\\\"Can I mix and match products to qualify?\\\",\\\"acceptedAnswer\\\":{\\\"@type\\\":\\\"Answer\\\",\\\"text\\\":\\\"Yes. Mix mats, blocks, straps and other eligible gear — your total quantity determines your discount tier.\\\"}},{\\\"@type\\\":\\\"Question\\\",\\\"name\\\":\\\"Do you offer custom quotes for large orders?\\\",\\\"acceptedAnswer\\\":{\\\"@type\\\":\\\"Answer\\\",\\\"text\\\":\\\"Absolutely. For orders of 100+ items or custom requirements, request a quote and our team will respond within one business day.\\\"}}]}</script><style>*{margin:0;padding:0;box-sizing:border-box}body{font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;color:#333;line-height:1.6;background:#fff}a{color:#2a7d6f;text-decoration:none}img{max-width:100%;height:auto;display:block}.container{max-width:1140px;margin:0 auto;padding:0 20px}.btn{display:inline-block;padding:14px 32px;border-radius:6px;font-weight:700;font-size:16px;cursor:pointer;border:none;transition:all .2s;text-align:center}.btn-primary{background:#e8722a;color:#fff}.btn-primary:hover{background:#d0611c;transform:translateY(-1px);box-shadow:0 4px 12px rgba(232,114,42,.35)}.btn-secondary{background:#fff;color:#2a7d6f;border:2px solid #2a7d6f}.btn-secondary:hover{background:#2a7d6f;color:#fff}.topbar{background:#2a7d6f;color:#fff;text-align:center;padding:8px 12px;font-size:14px;font-weight:600}.topbar a{color:#fff;text-decoration:underline}header.site{background:#fff;border-bottom:1px solid #eee;position:sticky;top:0;z-index:100;box-shadow:0 1px 4px rgba(0,0,0,.06)}.header-inner{display:flex;align-items:center;justify-content:space-between;padding:14px 20px;max-width:1140px;margin:0 auto}.logo{font-size:26px;font-weight:800;color:#2a7d6f;letter-spacing:-.5px}.logo span{color:#e8722a}nav.main a{margin:0 12px;font-weight:600;color:#444;font-size:15px}nav.main a:hover{color:#2a7d6f}.header-cta{display:flex;align-items:center;gap:16px}.phone{font-weight:700;color:#2a7d6f;font-size:15px}.hero{background:linear-gradient(135deg,#f0f7f5 0%,#e2efec 100%);padding:64px 20px;text-align:center}.hero h1{font-size:42px;line-height:1.15;color:#1e3a34;max-width:820px;margin:0 auto 16px}.hero h1 em{color:#e8722a;font-style:nor
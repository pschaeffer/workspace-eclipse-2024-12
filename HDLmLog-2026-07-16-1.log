n\\\", \\\"name\\\": \\\"Which meditation bench should I choose?\\\", \\\"acceptedAnswer\\\": {\\\"@type\\\": \\\"Answer\\\", \\\"text\\\": \\\"Kneeling meditation benches relieve pressure on knees and ankles during long sits. Choose a folding bench for travel or a fixed-leg bench for maximum stability at home.\\\"}},\\n    {\\\"@type\\\": \\\"Question\\\", \\\"name\\\": \\\"Do yoga chairs support heavier body weights?\\\", \\\"acceptedAnswer\\\": {\\\"@type\\\": \\\"Answer\\\", \\\"text\\\": \\\"Yes. Our steel-frame backless yoga chairs are weight-tested and support most practitioners. Check each product page for the exact weight capacity.\\\"}}\\n  ]\\n}\\n</script>\\n<style>\\n  :root{--brand:#2e7d5b;--brand-dark:#215c43;--accent:#e8590c;--ink:#222;--muted:#666;--bg:#f7f7f4;--star:#f5a623}\\n  *{box-sizing:border-box;margin:0;padding:0}\\n  body{font-family:\\\"Helvetica Neue\\\",Arial,sans-serif;color:var(--ink);background:#fff;line-height:1.5}\\n  a{color:var(--brand);text-decoration:none}\\n  img{max-width:100%;display:block}\\n  .container{max-width:1200px;margin:0 auto;padding:0 16px}\\n\\n  /* Announcement bar */\\n  .promo-bar{background:var(--accent);color:#fff;text-align:center;padding:8px 12px;font-size:14px;font-weight:600}\\n  .promo-bar a{color:#fff;text-decoration:underline}\\n\\n  /* Header */\\n  header.site{border-bottom:1px solid #e5e5e5;background:#fff}\\n  .header-inner{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:14px 0;flex-wrap:wrap}\\n  .logo{font-size:26px;font-weight:800;color:var(--brand);letter-spacing:-.5px}\\n  .logo span{color:var(--accent)}\\n  .search{flex:1;max-width:440px;display:flex}\\n  .search input{flex:1;padding:10px 12px;border:2px solid var(--brand);border-right:none;border-radius:4px 0 0 4px;font-size:14px}\\n  .search button{background:var(--brand);color:#fff;border:none;padding:0 18px;border-radius:0 4px 4px 0;cursor:pointer;font-size:14px}\\n  .header-utils{display:flex;align-items:center;gap:18px;font-size:14px}\\n  .header-utils .phone{font-weight:700;color:var(--ink)}\\n  .cart-btn{background:var(--brand);color:#fff;padding:9px 16px;border-radius:4px;font-weight:700}\\n  nav.main{background:var(--bg);border-top:1px solid #e5e5e5}\\n  nav.main ul{display:flex;gap:4px;list-style:none;flex-wrap:wrap}\\n  nav.main a{display:block;padding:11px 14px;color:var(--ink);font-size:14px;font-weight:600}\\n  nav.main a:hover,nav.main a.active{color:var(--brand);box-shadow:inset 0 -3px 0 var(--brand)}\\n\\n  /* Trust strip */\\n  .trust-strip{background:var(--bg);border-bottom:1px solid #e8e8e3}\\n  .trust-strip .container{display:flex;justify-content:space-between;gap:12px;padding:10px 16px;flex-wrap:wrap}\\n  .trust-strip span{font-size:13px;color:var(--muted);display:flex;align-items:center;gap:6px}\\n  .trust-strip b{color:var(--ink)}\\n\\n  /* Breadcrumbs */\\n  .breadcrumbs{font-size:13px;color:var(--muted);padding:14px 0 4px}\\n\\n  /* Category hero */\\n  .cat-hero{padding:12px 0 8px}\\n  .cat-hero h1{font-size:30px;margin-bottom:6px}\\n  .cat-hero .rating-summary{color:var(--star);font-size:15px;margin-bottom:8px}\\n  .cat-hero .rating-summary em{color:var(--muted);font-style:normal;font-size:13px}\\n  .cat-hero p{color:var(--muted);max-width:820px;font-size:15px}\\n\\n  /* Toolbar */\\n  .toolbar{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:16px 0;flex-wrap:wrap}\\n  .toolbar .count{font-size:14px;color:var(--muted)}\\n  .toolbar select{padding:8px 10px;border:1px solid #ccc;border-radius:4px;font-size:14px}\\n\\n  /* Product grid */\\n  .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(255px,1fr));gap:20px;padding-bottom:32px}\\n  .card{border:1px solid #e5e5e5;border-radius:8px;overflow:hidden;display:flex;flex-direction:column;position:relative;transition:box-shadow .15s ease,transform .15s ease;background:#fff}\\n  .card:hover{box-shadow:0 8px 24px rgba(0,0,0,.12);transform:translateY(-2px)}\\
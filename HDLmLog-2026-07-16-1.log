main ul{display:flex;gap:6px;list-style:none;max-width:1200px;margin:0 auto;padding:0 10px;overflow-x:auto}\\nnav.main a{display:block;padding:11px 12px;font-size:14px;font-weight:600;color:var(--ink);white-space:nowrap}\\nnav.main a:hover,nav.main a.active{color:var(--brand);box-shadow:inset 0 -3px 0 var(--brand)}\\n.breadcrumbs{font-size:13px;color:var(--muted);padding:14px 0 0}\\n.hero{padding:22px 0 6px}\\n.hero h1{font-size:30px;letter-spacing:-.5px}\\n.hero p{color:var(--muted);max-width:760px;margin-top:6px;font-size:15px}\\n.trust-strip{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:18px 0 8px}\\n.trust-strip .t{background:#fff;border:1px solid var(--line);border-radius:8px;padding:10px 12px;display:flex;align-items:center;gap:10px;font-size:13px;font-weight:600}\\n.trust-strip .ico{font-size:20px}\\n.toolbar{display:flex;flex-wrap:wrap;gap:10px;align-items:center;justify-content:space-between;margin:14px 0}\\n.chips{display:flex;gap:8px;flex-wrap:wrap}\\n.chip{background:#fff;border:1px solid var(--line);border-radius:999px;padding:7px 14px;font-size:13px;font-weight:600;cursor:pointer;color:var(--ink)}\\n.chip:hover,.chip.on{border-color:var(--brand);color:var(--brand);background:#f3eefc}\\n.sort{display:flex;align-items:center;gap:8px;font-size:13px}\\n.sort select{padding:8px 10px;border:1px solid var(--line);border-radius:6px;font-size:13px;background:#fff}\\n.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(255px,1fr));gap:18px;margin:8px 0 30px}\\n.card{background:var(--card);border:1px solid var(--line);border-radius:10px;overflow:hidden;display:flex;flex-direction:column;position:relative;transition:box-shadow .15s,transform .15s}\\n.card:hover{box-shadow:0 8px 22px rgba(0,0,0,.10);transform:translateY(-2px)}\\n.badge{position:absolute;top:10px;left:10px;background:var(--accent);color:#fff;font-size:11px;font-weight:800;padding:4px 9px;border-radius:4px;letter-spacing:.4px;z-index:2}\\n.badge.eco{background:var(--good)}\\n.badge.value{background:var(--brand)}\\n.card .img{aspect-ratio:1/1;background:#efeae3;display:flex;align-items:center;justify-content:center;color:#b7ac9d;font-size:13px}\\n.card .body{padding:14px 14px 16px;display:flex;flex-direction:column;gap:6px;flex:1}\\n.card h3{font-size:15px;line-height:1.35;min-height:40px}\\n.card h3 a{color:var(--ink)}\\n.stars{color:#f7a823;font-size:13px;letter-spacing:1px}\\n.stars .count{color:var(--muted);font-size:12px;letter-spacing:0;margin-left:4px}\\n.price{display:flex;align-items:baseline;gap:8px;margin-top:2px}\\n.price .now{font-size:20px;font-weight:800;color:var(--ink)}\\n.price .was{font-size:13px;color:var(--muted);text-decoration:line-through}\\n.price .save{font-size:12px;font-weight:700;color:var(--good)}\\n.stock{font-size:12px;color:var(--good);font-weight:600}\\n.stock.low{color:#c0392b}\\n.btn{display:block;text-align:center;background:var(--accent);color:#fff;font-weight:800;font-size:15px;padding:12px;border-radius:7px;margin-top:auto;border:none;cursor:pointer;width:100%}\\n.btn:hover{background:var(--accent-dark)}\\n.btn.secondary{background:var(--brand)}\\n.btn.secondary:hover{background:var(--brand-dark)}\\n.guide{background:#fff;border:1px solid var(--line);border-radius:10px;padding:22px;margin:10px 0 30px}\\n.guide h2{font-size:21px;margin-bottom:10px}\\n.guide .cols{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:16px;margin-top:12px}\\n.guide .col h3{font-size:15px;color:var(--brand);margin-bottom:4px}\\n.guide .col p{font-size:14px;color:var(--muted)}\\n.faq{margin:0 0 30px}\\n.faq h2{font-size:21px;margin-bottom:12px}\\n.faq details{background:#fff;border:1px solid var(--line);border-radius:8px;margin-bottom:8px;padding:0}\\n.faq summary{cursor:pointer;font-weight:700;font-size:15px;padding:14px 16px}\\n.faq details p{padding:0 16px 14px;font-size:14px;color:var(--muted)}\\n.newsletter{background:var(--brand);color:#fff;border-radius:10px;padding:26px;text-align:center;margin:0 0 34px}\\n.newsletter h2{font-size:22px}\\n.newsletter p{opacity:.9;margin:6px 0 14px;font-size:14px}\\n.newsletter form{display:flex;gap:8px;max-width:460px;margin:0 auto}\\n.newsletter input{flex:1;padding:12px 14px;border:none;border-radius:6px;font-size:15px}\\n.newsletter button{padding:12px 20px;background:var(--accent);border:none;border-radius:6px;color:#fff;font-weight:800;cursor:pointer;font-size:15px}\\n.newsletter button:hover{background:var(--accent-dark)}\\nfooter{background:#2c2438;color:#cfc8dd;padding:34px 0;font-size:14px}\\nfooter .cols{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:22px;max-width:1200px;margin:0 auto;padding:0 16px}\\nfooter h4{color:#fff;margin-bottom:10px;font-size:14px;text-transform:uppercase;letter-spacing:.6px}\\nfooter a{color:#cfc8dd;display:block;padding:3px 0}\\nfooter a:hover{color:#fff}\\n.foot-note{text-align:center;margin-top:26px;font-size:12px;color:#9c93b3}\\n@media (max-width:820px){.trust-strip{grid-template-columns:repeat(2,1fr)}.header-links .hide-m{display:none}.hero h1{font-size:24px}}\\n@media (max-width:560px){.newsletter form{flex-direction:column}.search{display:none}}\\n</style>\\n</head>\\n<body>\\n<div class=\\\"promo-bar\\\">🚚 FREE Shipping on orders over $50 &nbsp;|&nbsp; <span>SAVE 15% today with code <strong>MAT15</strong></span> &nbsp;|&nbsp; 30-Day Easy Returns</div>\\n<header class=\\\"site\\\">\\n  <div class=\\\"header-inner\\\">\\n    <a class=\\\"logo\\\" href=\\\"/\\\">Yoga<em>Direct</em></a>\\n    <form class=\\\"search\\\" action=\\\"/search\\\" method=\\\"get\\\" role=\\\"search\\\">\\n      <input type=\\\"search\\\" name=\\\"q\\\" placeholder=\\\"Search yoga mats, blocks, straps…\\\" aria-label=\\\"Search products\\\">\\n      <button type=\\\"submit\\\">Search</button>\\n    </form>\\n    <div class=\\\"header-links\\\">\\n      <a href=\\\"/account\\\" class=\\\"hide-m\\\">Account</a>\\n      <a href=\\\"tel:1-800-331-8233\\\" class=\\\"hide-m\
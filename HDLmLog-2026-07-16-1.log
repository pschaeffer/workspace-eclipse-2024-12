:10px;border:1px solid var(--line);border-radius:6px;font-size:14px}\\n.coupon-row button{padding:10px 16px;border:none;border-radius:6px;background:var(--brand);color:#fff;font-weight:600;cursor:pointer}\\n/* Trust */\\n.trust-strip{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:18px;text-align:center;font-size:12px;color:var(--muted)}\\n.trust-strip .t{background:#f5f7f4;border-radius:6px;padding:10px 6px}\\n.trust-strip .t b{display:block;color:var(--ink);font-size:13px;margin-bottom:2px}\\n/* Cross-sell */\\n.cross-sell{margin:36px 0}\\n.cross-sell h2{font-size:20px;margin-bottom:14px}\\n.xs-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:16px}\\n.xs-card{background:#fff;border:1px solid var(--line);border-radius:8px;padding:14px;text-align:center}\\n.xs-card img{width:100%;height:140px;object-fit:cover;border-radius:6px;background:#f0f0ec}\\n.xs-card h3{font-size:14px;margin:10px 0 4px;font-weight:600}\\n.xs-card .p{font-weight:700;color:var(--ink);margin-bottom:10px}\\n.xs-card .p .was{color:var(--muted);text-decoration:line-through;font-weight:400;font-size:12px;margin-right:4px}\\n.xs-card button{width:100%;padding:9px;border:1px solid var(--brand);background:#fff;color:var(--brand);border-radius:6px;font-weight:700;cursor:pointer}\\n.xs-card button:hover{background:var(--brand);color:#fff}\\n.stars{color:#f7b500;font-size:13px}\\n/* Guarantee */\\n.guarantee{background:#fff;border:1px solid var(--line);border-radius:8px;padding:22px;display:flex;gap:18px;align-items:center;margin-bottom:40px;flex-wrap:wrap}\\n.guarantee .badge{width:64px;height:64px;border-radius:50%;background:var(--brand);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:12px;text-align:center;flex:none}\\n.guarantee h3{font-size:16px;margin-bottom:4px}\\n.guarantee p{font-size:14px;color:var(--muted)}\\n/* Footer */\\nfooter{background:#2f3a33;color:#cfd8d1;font-size:13px;padding:26px 0;text-align:center}\\nfooter a{color:#fff}\\n/* Sticky mobile CTA */\\n.sticky-cta{display:none;position:fixed;bottom:0;left:0;right:0;background:#fff;border-top:1px solid var(--line);padding:10px 16px;z-index:50;box-shadow:0 -4px 12px rgba(0,0,0,.08)}\\n.sticky-cta .row{display:flex;align-items:center;justify-content:space-between;gap:12px;max-width:600px;margin:0 auto}\\n.sticky-cta .tot{font-weight:700;font-size:16px}\\n.sticky-cta .btn-checkout{margin:0;padding:12px 22px;width:auto}\\n@media(max-width:860px){.sticky-cta{display:block}body{padding-bottom:74px}}\\n.continue{display:inline-block;margin-top:10px;font-size:14px}\\n</style>\\n</head>\\n<body>\\n\\n<div class=\\\"usp-bar\\\">🚚 FREE Shipping on Orders Over $75 &nbsp;•&nbsp; 🔒 Secure Checkout &nbsp;•&nbsp; ↩︎ Easy 30-Day Returns</div>\\n\\n<header class=\\\"site-header\\\">\\n  <div class=\\\"container header-inner\\\">\\n    <a href=\\\"/\\\" class=\\\"logo\\\" aria-label=\\\"YogaDirect home\\\">Yoga<span>Direct</span></a>\\n    <div class=\\\"header-trust\\\">\\n      <div>📞 <b>Need help? 1-800-YOGA-123</b><br>Mon–Fri 9am–6pm EST</div>\\n      <div>⭐ <b>4.8/5</b> from 12,400+ reviews</div>\\n    </div>\\n  </div>\\n</header>\\n\\n<main class=\\\"container\\\">\\n\\n  <nav class=\\\"steps\\\" aria-label=\\\"Checkout progress\\\">\\n    <span class=\\\"step active\\\"><span class=\\\"num\\\">1</span> Cart</span>\\n    <span class=\\\"sep\\\">›</span>\\n    <span class=\\\"step\\\"><span class=\\\"num\\\">2</span> Shipping</span>\\n    <span class=\\\"sep\\\">›</span>\\n    <span class=\\\"step\\\"><span class=\\\"num\\\">3</span> Payment</span>\\n    <span class=\\\"sep\\\">›</span>\\n    <span class=\\\"step\\\"><span class=\\\"num\\\">4</span> Done</span>\\n  </nav>\\n\\n  <h1>Your Shopping Cart <span style=\\\"font-weight:400;color:var(--muted);font-size:16px\\\">(2 items)</span></h1>\\n  <a class=\\\"continue\\\" href=\\\"/\\\">← Continue shopping</a>\\n\\n  <div class=\\\"ship-progress\\\" role=\\\"status\
ype\":\"string\"},\"improvements\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"What\":{\"type\":\"string\"},\"Why\":{\"type\":\"string\"},\"Hash\":{\"type\":\"string\"}},\"required\":[\"What\",\"Why\",\"Hash\"],\"additionalProperties\":false}}},\"required\":[\"improvedHtml\",\"improvements\"],\"additionalProperties\":false}}}}","HDLmLlmModelStr":"openai/gpt-5.6-sol-pro"}

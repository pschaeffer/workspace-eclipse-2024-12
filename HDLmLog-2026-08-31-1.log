-style:none;padding:0;margin:0;display:grid;gap:8px}.fbot{border-top:1px solid #33403a;margin-top:34px;padding-top:18px;display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap;font-size:13px}.pay{display:flex;gap:8px}.pay span{background:#2a352f;border-radius:5px;padding:3px 9px;font-size:11.5px;font-weight:700;color:#dfe6e2}.mcta{position:fixed;bottom:0;left:0;right:0;background:#fff;border-top:1px solid #e4ded4;padding:10px 14px;display:none;gap:10px;z-index:70;box-shadow:0 -6px 20px rgba(0,0,0,.08)}#toast{position:fixed;bottom:80px;left:50%;transform:translateX(-50%) translateY(20px);background:#1d2321;color:#fff;padding:13px 22px;border-radius:999px;font-weight:700;opacity:0;transition:.25s;z-index:90;font-size:14.5px}#toast.on{opacity:1;transform:translateX(-50%)}.navtog{display:none;background:none;border:0;font-size:24px;cursor:pointer}@media(max-width:1000px){.cats{grid-template-columns:repeat(3,1fr)}.prods{grid-template-columns:repeat(2,1fr)}.hgrid,.bulkg,.email{grid-template-columns:1fr}.revs,.kits{grid-template-columns:1fr}.strip .g{grid-template-columns:repeat(2,1fr);text-align:left}}@media(max-width:760px){nav.main{display:none;position:absolute;top:72px;left:0;right:0;background:#fff;flex-direction:column;padding:16px 20px;border-bottom:1px solid #e4ded4;margin:0}nav.main.open{display:flex}.navtog{display:block}.mcta{display:flex}body{padding-bottom:66px}section{padding:40px 0}.email{padding:26px}}</style></head><body><div class='bar'>🚚 <strong>FREE shipping on orders $99+</strong> · Studio bulk pricing — save up to <strong>40%</strong> · Trusted by 12,000+ studios since 1999</div><header><div class='wrap hrow'><a href='/' class='logo'>Yoga<span>Direct</span></a><button class='navtog' aria-label='Menu' onclick=\\\"document.querySelector('nav.main').classList.toggle('open')\\\">☰</button><nav class='main'><a href='/collections/all'>Mats</a><a href='/collections/all'>Blocks &amp; Props</a><a href='/collections/all'>Bolsters &amp; Blankets</a><
5c56,#8cbfb2);display:flex;align-items:center;justify-content:center;font-size:100px}.stat{font-size:34px;font-weight:800;color:#0f5c56;line-height:1}footer{background:#12211f;color:#c9d4d2;padding:52px 0 28px;font-size:14px}footer h4{color:#fff;font-size:15px;margin:0 0 12px}footer a{display:block;padding:4px 0;color:#c9d4d2}.fgrid{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:30px}.sticky{position:fixed;bottom:0;left:0;right:0;background:#fff;border-top:1px solid #e6e0d6;padding:10px 16px;display:none;z-index:70;align-items:center;gap:10px}@media(max-width:900px){.g3,.g4,.fgrid{grid-template-columns:repeat(2,1fr)}nav.main,.phone{display:none}.mnav{display:flex;overflow:auto;gap:16px;padding:9px 0;font-weight:700;font-size:14px;border-top:1px solid #e6e0d6;white-space:nowrap}h1{font-size:29px}.himg{height:210px;font-size:70px}.sticky{display:flex}body{padding-bottom:78px}}</style></head><body><div class='bar'>🧘 <strong>25 years serving the yoga community</strong> &nbsp;·&nbsp; Free shipping over $75 &nbsp;·&nbsp; 10% off your first order with <strong>WELCOME10</strong></div><header><div class='wrap'><div class='hrow'><a class='logo' href='/index.html'>Yoga<span>Direct</span></a><nav class='main'><a href='/shop.html'>Mats</a><a href='/shop.html'>Blocks &amp; Props</a><a href='/shop.html'>Studio Kits</a><a href='/wholesale.html'>Wholesale</a><a href='/about.html'>Our Story</a></nav><div class='hact'><span class='phone'>☎ 1-800-987-9642</span><a class='btn alt sm' href='/shop.html'>Shop Now</a></div></div><div class='mnav'><a href='/shop.html'>Mats</a><a href='/shop.html'>Blocks</a><a href='/shop.html'>Studio Kits</a><a href='/wholesale.html'>Wholesale</a><a href='/contact.html'>Contact</a></div></div></header><section class='sec'><div class='wrap' style='display:grid;grid-template-columns:1.05fr .95fr;gap:44px;align-items:center'><div><h1>From our team of yoga lovers to you</h1><p class='sub'>Thanks to our loyal customers, YogaDirect has become one of the largest suppliers of yoga mats and props in the country. We have been faithfully supplying the yoga community since 1999 and are confident that we can help you grow your studio, event, or personal practice with everything you need and more.</p><p class='sub'>We manufacture and source our own goods, which is how we can consistently offer high-quality yoga gear at amazing prices. When you shop at YogaDirect, feel proud knowing that you are helping to grow not only your business or personal practice, but the yoga community as a whole. From our team of yoga lovers to you — thank you.</p><div style='display:flex;gap:12px;flex-wrap:wrap;margin-top:8px'><a class='btn' href='/shop.html'>Shop Best Sellers</a><a class='btn ghost' href='/wholesale.html'>Bulk &amp; Studio Pricing</a></div></div><div class='himg'>🕉️</div></div></section><section class='sec sand'><div class='wrap'><div class='grid g4 center'><div><div class='stat'>1999</div><p>Serving the yoga community</p></div><div><div class='stat'>1M+</div><p>Mats shipped</p></div><div><div class='stat'>6,800+</div><p>Studios, gyms &amp; schools supplied</p></div><div><div class='stat'>4.8★</div><p>From 12,400+ verified reviews</p></div></div></div></section><section class='sec'><div class='wrap'><h2 class='center'>What manufacturer-direct actually means for you</h2><div class='grid g3' style='margin-top:24px'><div class='card'><h3>Better prices</h3><p style='color:#4e5f5d'>No distributor in the middle. The savings that would have been someone else's markup stay in your pocket — or in your studio's budget.</p></div><div class='card'><h3>Consistent quality</h3><p style='color:#4e5f5d'>We specify the foam density, the grip texture and the stitching. When you reorder in two years, it matches what's already on your floor.</p></div><div class='card'><h3>Real availability</h3><p style='color:#4e5f5d'>Deep US inventory and 24-hour dispatch, so a workshop or teacher training never gets derailed by a backorder.</p></div></div></div></section><section class='sec sand'><div class='wrap narrow center'><h2>Our promise</h2><p class='sub'>Free shipping over $75. Orders out the door in 24 hours. 30-day returns with no restocking fees. A 1-year warranty on every mat. And a human who answers the phone at 1-800-987-9642.</p><div style='display:flex;gap:12px;justify-content:center;flex-wrap:wrap'><a class='btn' href='/shop.html'>Start Shopping</a><a class='btn ghost' href='/contact.html'>Talk to Our Team</a></div></div></section><footer><div class='wrap'><div class='fgrid'><div><a class='logo' href='/index.html' style='color:#fff'>Yoga<span style='color:#7fb3a5'>Direct</span></a><p>Supplying the yoga community with manufacturer-direct mats and props since 1999.</p><p><strong style='color:#fff'>☎ 1-800-987-9642</strong><br>Mon–Fri, 9am–5pm ET<br>help@yogadirect.com</p></div><div><h4>Shop</h4><a href='/shop.html'>Yoga Mats</a><a href='/shop.html'>Blocks &amp; Bricks</a><a href='/shop.html'>Straps &amp; Bolsters</a><a href='/shop.html'>Studio Kits</a></div><div><h4>Wholesale</h4><a href='/wholesale.html'>Bulk Pricing</a><a href='/wholesale.html'>Custom Logo Printing</a><a href='/contact.html'>Request a Quote</a></div><div><h4>Help</h4><a href='/index.html'>Shipping &amp; Delivery</a><a href='/index.html'>30-Day Returns</a><a href='/about.html'>Our Story</a><a href='/contact.html'>Contact Us</a></div></div><p style='border-top:1px solid #243936;margin-top:30px;padding-top:18px;font-size:13px'>© 1999–2024 YogaDirect. All rights reserved.</p></div></footer><div class='sticky'><div style='flex:1;font-size:13px;font-weight:700'>Free shipping over $75<br><span style='color:#6b7a78;font-weight:600'>10% off with WELCOME10</span></div><a class='btn sm' href='/shop.html'>Shop Now</a></div></body></html>\"},{\"path\":\"/contact.html\",\"html\":\"<!DOCTYPE html><html lang='en'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><title>Contact YogaDirect — Orders, Bulk Quotes &am
ate-columns:1fr 1fr;gap:12px}table.tiers{width:100%;border-collapse:collapse;font-size:15.5px;background:#fff;border:1px solid var(--line);border-radius:12px;overflow:hidden}table.tiers td,table.tiers th{padding:12px 14px;border-bottom:1px solid var(--line);text-align:left}table.tiers tr:last-child td{border-bottom:0}.save{color:var(--sunD);font-weight:700}.ticks{list-style:none;padding:0;margin:16px 0 0;display:grid;gap:9px;font-size:15.5px}.ticks li:before{content:'✓ ';color:var(--sun);font-weight:800}footer.site{background:#1b2a27;color:#cfd9d5;padding:52px 0 26px;font-size:14.5px}.fgrid{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:30px}footer h4{color:#fff;font-size:13px;text-transform:uppercase;letter-spacing:1px;margin:0 0 12px}footer ul{list-style:none;padding:0;margin:0;display:grid;gap:8px}.field{display:flex;gap:8px;margin-top:12px}.fbot{border-top:1px solid #33413d;margin-top:30px;padding-top:18px;display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;font-size:13px;color:#9fada9}.toast{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:var(--sageD);color:#fff;padding:13px 22px;border-radius:999px;font-weight:700;z-index:200}.rev{background:#fff;border:1px solid var(--line);border-radius:var(--r);padding:20px}.stars{color:#e8a33d;font-weight:700}@media(max-width:900px){.split,.g2,.g3{grid-template-columns:1fr}.g4{grid-template-columns:repeat(2,1fr)}.fgrid{grid-template-columns:1fr 1fr}nav.main{display:none}.hdr-actions a:first-child{display:none}}</style></head><body><div class='announce'>Same-business-day quotes &nbsp;•&nbsp; Volume discounts up to <b>40%</b> &nbsp;•&nbsp; Net terms for qualified accounts</div><header class='site'><div class='wrap navrow'><a class='logo' href='/'>Yoga<span>Direct</span></a><nav class='main'><a href='/shop'>Shop All</a><a href='/shop#mats'>Mats</a><a href='/shop#props'>Props</a><a href='/wholesale'>Bulk &amp; Studio</a><a href='/about'>About</a><a href='/faq'>Help</a></nav><div class='navspace'></div><div class='hdr-actions'><a href='/contact'>Talk to a specialist</a><a class='cart' href='/shop'>Cart (<span class='cartn'>0</span>)</a></div></div></header><section class='hero'><div class='wrap split'><div><div class='eyebrow'>Wholesale &amp; studio program</div><h1>Outfit your studio for up to 40% less</h1><p class='lead'>We manufacture and source our own mats and props, so there&rsquo;s no distributor in the middle. Tell us what you need and a real specialist sends a custom quote — usually the same business day.</p><ul class='ticks'><li>Volume discounts start at just 5 units</li><li>Discounted freight and pallet pricing</li><li>Net-30 terms available for qualified studios, gyms &amp; schools</li><li>Custom logo and color options on select products</li><li>Reorder reminders so you never run short before a training</li></ul><p class='muted' style='margin-top:18px'>Trusted by 10,000+ studios, teacher trainings, schools, gyms, hotels and retreat centers since 1999.</p></div><div class='card' id='quote'><h3>Get your bulk quote</h3><p class='muted' style='font-size:14.5px'>Takes 60 seconds. No obligation, no pushy sales calls.</p><form onsubmit='return sent(event)'><div class='two'><div><label for='n'>Name</label><input id='n' required placeholder='Jamie Rivera'></div><div><label for='o'>Studio / organization</label><input id='o' placeholder='Riverbend Yoga'></div></div><div class='two'><div><label for='e'>Email</label><input id='e' type='email' required placeholder='you@studio.com'></div><div><label for='p'>Phone (optional)</label><input id='p' placeholder='(555) 555-5555'></div></div><label for='t'>What do you need?</label><select id='t'><option>Yoga mats</option><option>Blocks, straps &amp; props</option><option>Bolsters, blankets &amp; cushions</option><option>Complete studio kit</option><option>Event / retreat giveaway</option><option>Mixed order — I&rsquo;ll list it below</option></select><label for='qn'>Approximate quantity</label><select id='qn'><option>5–9 units</option><option selected>10–24 units</option><option>25–49 units</option><option>50–99 units</option><option>100+ units / pallet</option></select><label for='msg'>Anything else? (colors, deadline, logo printing)</label><textarea id='msg' rows='3' placeholder='We need 20 mats in sage before our Sept 1 training.'></textarea><button class='btn btn-p btn-full' style='margin-top:16px' type='submit'>Send my quote request</button><p class='muted' style='font-size:12.5px;margin:10px 0 0'>We reply within one business day. Your details are never shared.</p></form></div></div></section><section class='section'><div class='wrap'><h2 class='center'>Transparent volume pricing</h2><p class='center muted'>Example pricing on our best-selling 6mm studio mat. Every product line has its own tiers — larger orders go deeper.</p><div style='max-width:760px;margin:22px auto 0'><table class='tiers'><tr><th>Quantity</th><th>Price each</th><th>You save</th></tr><tr><td>1–4</td><td><b>$39.95</b></td><td class='muted'>—</td></tr><tr><td>5–9</td><td><b>$35.95</b></td><td class='save'>10%</td></tr><tr><td>10–24</td><td><b>$31.96</b></td><td class='save'>20%</td></tr><tr><td>25–49</td><td><b>$27.97</b></td><td class='save'>30%</td></tr><tr><td>50+ / pallet</td><td><b>Custom quote</b></td><td class='save'>up to 40%</td></tr></table><p class='center' style='margin-top:22px'><a class='btn btn-p' href='#quote'>Get my custom quote</a></p></div></div></section><section class='section alt'><div class='wrap'><h2 class='center'>Popular studio bundles</h2><div class='grid g3' style='margin-top:24px'><div class='flat'><h3>Boutique studio — 10 stations</h3><p class='muted'>10 mats, 20 blocks, 10 straps, 10 blankets.</p><div style='font-size:24px;font-weight:800'>$499 <span class='muted' style='font-size:15px;text-decoration:line-through'>$712</span></div><p class='save'>Save 30% &middot; $49.90 per station</p><a class='btn btn-s btn-full' href='#quote'>Quote this bundle</a></div><div class='flat'><h3>Full studio — 25 stations</h3><p class='muted'>25 mats, 50 blocks, 25 straps, 25 blankets, 10 bolsters.</p><div style='font-size:24px;font-weight:800'>$1,289 <span class='muted' style='font-size:15px;text-decoration:line-through'>$1,940</span></div><p class='save'>Save 34% &middot; freight included</p><a class='btn btn-p btn-full' href='#quote'>Quote this bundle</a></div><div class='flat'><h3>Event &amp; retreat pack</h3><p class='muted'>50 lightweight mats + 50 straps, optional logo print.</p><div style='font-size:24px;font-weight:800'>From $1,099</div><p class='save'>Custom colors available</p><a class='btn btn-s btn-full' href='#quote'>Quote this bundle</a></div></div></div></section><section class='section'><div class='wrap'><div class='grid g3'><div class='rev'><div class='stars'>★★★★★</div><p>&ldquo;I sent a list on Tuesday morning and had a quote before lunch. The mats arrived in three days and cost less than half our old distributor.&rdquo;</p><p class='muted' style='margin:0;font-size:14px'><b>Marisa T.</b> — Studio owner, Austin TX</p></div><div class='rev'><div class='stars'>★★★★★</div><p>&ldquo;We order props for every teacher training. Net-30 terms and consistent quality make reordering a non-decision.&rdquo;</p><p class='muted' style='margin:0;font-size:14px'><b>Aisha R.</b> — YTT lead, Portland OR</p></div><div class='rev'><div class='stars'>★★★★★</div><p>&ldquo;Outfitted 14 school gyms. Freight pricing was clearly explained and nothing showed up damaged.&rdquo;</p><p class='muted' style='margin:0;font-size:14px'><b>Tom H.</b> — District purchasing</p></div></div></div></section><section class='section alt'><div class='wrap center'><h2>Ready for your best pricing?</h2><p class='muted'>One short form. A real human. Same business day, in most cases.</p><a class='btn btn-p' href='#quote'>Request my bulk quote</a> &nbsp; <a class='btn btn-s' href='/contact'>Or ask a question first</a></div></section><footer class='site'><div class='wrap'><div class='fgrid'><div><div class='logo' style='color:#fff'>Yoga<span style='color:#8fc0ad'>Direct</span></div><p style='margin-top:10px'>Supplying yoga mats and props direct to studios, teachers and practitioners since 1999.</p><form onsubmit='return signup(event)'><div class='field'><input type='email' required placeholder='Email for 10% off' aria-label='Email'><button class='btn btn-p' style='padding:11px 18px;font-size:14.5px' type='submit'>Join</button></div></form></div><div><h4>Shop</h4><ul><li><a href='/shop#mats'>Yoga Mats</a></li><li><a href='/shop#props'>Blocks &amp; Straps</a></li><li><a href='/shop#props'>Bolsters &amp; Blankets</a></li><li><a href='/shop#bulk'>Bulk Packs</a></li></ul></div><div><h4>Buy in bulk</h4><ul><li><a href='/wholesale'>Studio pricing</a></li><li><a href='#quote'>Request a quote</a></li><li><a href='/contact'>Events &amp; retreats</a></li></ul></div><div><h4>Help</h4><ul><li><a href='/faq'>Shipping &amp; returns</a></li><li><a href='/faq'>Mat buying guide</a></li><li><a href='/contact'>Contact us</a></li><li><a href='/about'>About us</a></li></ul></div></div><div class='fbot'><span>© 1999–2025 YogaDirect. All rights reserved.</span><span>Free shipping over $75 &nbsp;•&nbsp; 60-day returns &nbsp;•&nbsp; Secure checkout</span></div></div></footer><script>function cartn(){return +(localStorage.getItem('ydcart')||0)}function paint(){document.querySelectorAll('.cartn').forEach(function(e){e.textContent=cartn()})}function toast(m){var t=document.createElement('div');t.className='toast';t.textContent=m;document.body.appendChild(t);setTimeout(function(){t.remove()},2600)}function sent(e){e.preventDefault();e.target.reset();toast('Thanks! Your quote is on its way.');return false}function signup(e){e.preventDefault();toast('Check your inbox for your 10% code');return false}paint();</script></body></html>\"},{\"path\":\"/about\",\"html\":\"<!DOCTYPE html><html lang='en'><head><meta charset='utf-8'><meta name='viewport' content='width=
ue,10)||1}var f=items.filter(function(i){return i.n===n})[0];if(f){f.q+=q}else{items.push({n:n,p:p,q:q})}render();open()})});var mf=document.querySelectorAll('[data-mail]');mf.forEach(function(f){f.addEventListener('submit',function(e){e.preventDefault();f.innerHTML='<div style=\\\"background:#fff;border-radius:12px;padding:14px 18px;font-weight:700;color:#1b2a26\\\">Check your inbox &mdash; your 10% code is on the way.</div>'})})})();</script></body></html>\"},{\"path\":\"/shop.html\",\"html\":\"<!DOCTYPE html><html lang='en'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><title>Shop Yoga Mats, Blocks, Straps &amp; Studio Packs | YogaDirect</title><meta name='description' content='Shop factory-direct yoga mats, blocks, straps, bolsters, blankets and studio packs. Free shipping over $75, 30-day returns, bulk discounts from 10 units.'><style>:root{--ink:#1b2a26;--sage:#3f6f5c;--sage-d:#2b4f42;--sand:#f7f3ec;--terra:#d2703a;--terra-d:#b95c2a;--line:#e6e0d6;--muted:#5f6b66}*{box-sizing:border-box}body{margin:0;font-family:Inter,system-ui,-apple-system,'Segoe UI',Helvetica,Arial,sans-serif;color:var(--ink);line-height:1.6;background:#fff}a{color:inherit;text-decoration:none}.wrap{max-width:1180px;margin:0 auto;padding:0 20px}.promo{background:var(--sage-d);color:#fff;font-size:14px;text-align:center;padding:9px 12px}.promo a{text-decoration:underline;font-weight:700}header.site{position:sticky;top:0;z-index:60;background:#fff;border-bottom:1px solid var(--line)}.nav{display:flex;align-items:center;gap:26px;padding:14px 0}.logo{font-weight:800;font-size:22px;letter-spacing:-.6px}.logo span{color:var(--sage)}.nav ul{display:flex;gap:20px;list-style:none;margin:0;padding:0;font-weight:600;font-size:15px}.nav ul a:hover{color:var(--sage)}.nav .right{margin-left:auto;display:flex;gap:10px;align-items:center}.cartbtn{background:var(--sand);border:1px solid var(--line);border-radius:999px;padding:9px 16px;font-weight:700;cursor:p
-size:12.5px;margin:10px 0 0'>Buying for a studio? <a href='/wholesale' style='color:var(--sun);font-weight:700'>Get bulk pricing instead</a></p></div></div><script>function cartn(){return +(localStorage.getItem('ydcart')||0)}function paint(){document.querySelectorAll('.cartn').forEach(function(e){e.textContent=cartn()})}function toast(m){var t=document.createElement('div');t.className='toast';t.textContent=m;document.body.appendChild(t);setTimeout(function(){t.remove()},2200)}function addCart(n){localStorage.setItem('ydcart',cartn()+(n||1));paint();toast('Added to cart — free shipping over $75')}function signup(e){e.preventDefault();closePop();toast('Check your inbox for your 10% code');return false}function closePop(){document.getElementById('pop').classList.remove('on');sessionStorage.setItem('ydpop','1')}paint();if(!sessionStorage.getItem('ydpop')){setTimeout(function(){var p=document.getElementById('pop');if(p&&!sessionStorage.getItem('ydpop'))p.classList.add('on')},18000);document.addEventListener('mouseout',function(ev){if(ev.clientY<5&&!sessionStorage.getItem('ydpop')){document.getElementById('pop').classList.add('on')}})}</script></body></html>\"},{\"path\":\"/shop\",\"html\":\"<!DOCTYPE html><html lang='en'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><title>Shop Yoga Mats, Blocks, Straps &amp; Props | YogaDirect</title><meta name='description' content='Shop manufacturer-direct yoga mats, blocks, straps, bolsters, blankets and bulk studio packs. Free shipping over $75, 60-day returns, volume discounts up to 40%.'><style>:root{--ink:#182525;--muted:#5f716d;--sage:#3f6b5c;--sageD:#2b4c41;--sun:#e1703a;--sunD:#c65a26;--cream:#f8f5ef;--line:#e7e2d9;--r:14px}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:ui-sans-serif,system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;color:var(--ink);line-height:1.55;background:#fff;-webkit-font-smoothing:antialiased}a{color:inheri
l'>Shop best sellers →</a></p>\\\"}var su=document.getElementById('sub');if(su)su.textContent=money(s);var sh=document.getElementById('ship');if(sh){var r=Math.max(0,FREE-s),p=Math.min(100,s/FREE*100);sh.innerHTML=(r>0?'Add <b>'+money(r)+'</b> for FREE shipping':'🎉 You unlocked <b>FREE shipping</b>')+\\\"<div class='bar'><i style='width:\\\"+p+\\\"%'></i></div>\\\"}if(window.renderCartPage)window.renderCartPage(c,s)}function openDrawer(){document.getElementById('drawer').classList.add('on');document.getElementById('ov').classList.add('on')}function closeAll(){document.getElementById('drawer').classList.remove('on');document.getElementById('ov').classList.remove('on')}function toast(t){var e=document.getElementById('toast');e.textContent=t;e.classList.add('on');setTimeout(function(){e.classList.remove('on')},1800)}function closeModal(){document.getElementById('modal').classList.remove('on');sessionStorage.setItem('yd_modal','1')}function card(p){return \\\"<div class='pcard'><a class='art' href='\\\"+p.href+\\\"'>\\\"+(p.tag?\\\"<span class='tag'>\\\"+p.tag+\\\"</span>\\\":'')+ART[p.art]+\\\"</a><div class='pb'><a class='pn' href='\\\"+p.href+\\\"'>\\\"+p.name+\\\"</a><span class='rev'><span class='stars'>★★★★★</span> \\\"+p.rev+\\\" reviews</span><span class='pr'>\\\"+money(p.price)+\\\"<s>\\\"+money(p.was)+\\\"</s></span><button class='btn btn-d btn-sm full' style='margin-top:6px' onclick=\\\\\\\"add('\\\"+p.sku+\\\"')\\\\\\\">Add to Cart</button></div></div>\\\"}var bs=document.getElementById('bestsellers');if(bs)bs.innerHTML=CATALOG.slice(0,4).map(card).join('');render();if(!sessionStorage.getItem('yd_modal')){setTimeout(function(){var m=document.getElementById('modal');if(m)m.classList.add('on')},16000)}</script></body></html>\"},{\"path\":\"/shop.html\",\"html\":\"<!DOCTYPE html><html lang='en'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><title>Shop Yoga Mats, Blocks, Straps & Bolsters | YogaDirect</title><meta
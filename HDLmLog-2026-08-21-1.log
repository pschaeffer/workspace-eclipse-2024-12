)'>Add to Cart</button></div><div id='ov' onclick='closeAll()'></div><aside id='drawer'><div class='dh'><span>Your cart</span><button onclick='closeAll()'>×</button></div><div class='dbody' id='dbody'></div><div class='dfoot'><div class='ship' id='ship'></div><div style='display:flex;justify-content:space-between;font-weight:800;margin-bottom:12px'><span>Subtotal</span><span id='sub'>$0.00</span></div><a class='btn btn-p full' href='/cart.html'>Secure Checkout →</a></div></aside><div id='toast'></div><script>var CATALOG=[{sku:'MAT-DLX',name:'Deluxe 1/4\\\" Yoga Mat',price:24.95,was:34.95,rev:1842,art:'mat',href:'/product.html'},{sku:'BLK-FOAM',name:'High-Density Foam Block',price:9.95,was:13.95,rev:1290,art:'block',href:'/shop.html#props'},{sku:'STR-8',name:'8ft Cotton Yoga Strap',price:8.95,was:11.95,rev:877,art:'strap',href:'/shop.html#props'},{sku:'BLA-COT',name:'Woven Cotton Yoga Blanket',price:19.95,was:24.95,rev:512,art:'blanket',href:'/shop.html#restore'},{sku:'KIT-START',name:'Starter Kit: Mat + 2 Blocks + Strap',price:49.95,was:69.8,rev:412,art:'kit',href:'/shop.html#bundles'}];var ART={mat:\\\"<svg viewBox='0 0 120 90'><rect x='12' y='30' width='96' height='30' rx='15' fill='#0f6e5c'/><rect x='12' y='30' width='20' height='30' rx='10' fill='#0a4f42'/></svg>\\\",block:\\\"<svg viewBox='0 0 120 90'><rect x='24' y='30' width='72' height='34' rx='6' fill='#b98a58'/></svg>\\\",strap:\\\"<svg viewBox='0 0 120 90'><path d='M20 34h80a10 10 0 0 1 0 20H20' fill='none' stroke='#8a6c46' stroke-width='9'/></svg>\\\",blanket:\\\"<svg viewBox='0 0 120 90'><rect x='18' y='32' width='84' height='12' rx='4' fill='#c96f52'/><rect x='18' y='46' width='84' height='12' rx='4' fill='#e0a06f'/><rect x='18' y='60' width='84' height='10' rx='4' fill='#8a6c46'/></svg>\\\",kit:\\\"<svg viewBox='0 0 120 90'><rect x='10' y='32' width='58' height='24' rx='12' fill='#0f6e5c'/><rect x='72' y='34' width='34' height='20' rx='4' fill='#b98a58'/><path d='M14 68h92' stroke='#7d5c3a' stroke-width='6' stroke-linecap='round'/></svg>\\\"};var FREE=75;function money(n){return '$'+n.toFixed(2)}function getCart(){try{return JSON.parse(localStorage.getItem('yd_cart'))||[]}catch(e){return[]}}function setCart(c){localStorage.setItem('yd_cart',JSON.stringify(c));render()}function add(sku,qty,price,name){var p=CATALOG.filter(function(x){return x.sku===sku})[0]||{name:name,price:price,art:'mat'};var c=getCart(),f=c.filter(function(i){return i.sku===sku})[0];if(f)f.qty+=qty||1;else c.push({sku:sku,name:p.name,price:price||p.price,art:p.art,qty:qty||1});setCart(c);openDrawer();toast('Added to cart ✓')}function chg(sku,d){var c=getCart();for(var i=0;i<c.length;i++){if(c[i].sku===sku){c[i].qty+=d;if(c[i].qty<1)c.splice(i,1);break}}setCart(c)}function render(){var c=getCart(),n=0,s=0;c.forEach(function(i){n+=i.qty;s+=i.qty*i.price});document.getElementById('cbadge').textContent=n;document.getElementById('dbody').innerHTML=c.length?c.map(function(i){return \\\"<div class='li'><div class='art'>\\\"+ART[i.art]+\\\"</div><div style='flex:1'><div style='font-weight:700;font-size:14.5px'>\\\"+i.name+\\\"</div><div style='color:#5c6b70;font-size:13px'>\\\"+money(i.price)+\\\" ea × \\\"+i.qty+\\\"</div></div><div style='font-weight:800'>\\\"+money(i.price*i.qty)+\\\"</div></div>\\\"}).join(''):\\\"<p style='color:#5c6b70'>Your cart is empty.</p>\\\";document.getElementById('sub').textContent=money(s);var r=Math.max(0,FREE-s),p=Math.min(100,s/FREE*100);document.getElementById('ship').innerHTML=(r>0?'Add <b>'+money(r)+'</b> for FREE shipping':'🎉 You unlocked <b>FREE shipping</b>')+\\\"<div class='bar'><i style='width:\\\"+p+\\\"%'></i></div>\\\"}function openDrawer(){document.getElementById('drawer').classList.add('on');document.getElementById('ov').classList.add('on')}function closeAll(){document.getElementById('drawer').classList.remove('on');document.getElementById('ov').classList.remove('on')}function toast(t){var e=document.getElementById('toast');e.textContent=t;e.classList.add('on');setTimeout(function(){e.classList.remove('on')},1800)}var COLORS=[['Deep Teal','#0f6e5c'],['Slate','#4b5a63'],['Plum','#6c4a63'],['Sand','#d9c3a0'],['Berry','#a03050'],['Sky','#4a86a8'],['Charcoal','#2c3338'],['Moss','#6e7f52']];var ci=0;function drawSw(){document.getElementById('sw').innerHTML=COLORS.map(function(c,i){return \\\"<span class='sw\\\"+(i===ci?' on':'')+\\\"' style='background:\\\"+c[1]+\\\"' title='\\\"+c[0]+\\\"' onclick='pick(\\\"+i+\\\")'></span>\\\"}).join('');document.getElementById('cname').textContent=COLORS[ci][0];document.getElementById('mainart').innerHTML=\\\"<span class='tag'>#1 Best Seller</span><svg viewBox='0 0 120 90'><rect x='12' y='30' width='96' height='30' rx='15' fill='\\\"+COLORS[ci][1]+\\\"'/><rect x='12' y='30' width='20' height='30' rx='10' fill='rgba(0,0,0,.22)'/></svg>\\\"}function pick(i){ci=i;drawSw()}var qn=1;function unitPrice(){return qn>=20?17.95:(qn>=6?21.95:24.95)}function q(d){qn=Math.max(1,qn+d);document.getElementById('qv').textContent=qn;document.getElementById('unit').textContent=money(unitPrice())+' each'+(qn>=6?' — volume price applied':'');document.getElementById('tot').textContent=money(unitPrice()*qn)}function addMain(){add('MAT-DLX',qn,unitPrice())}function card(p){return \\\"<div class='pcard'><a class='art' href='\\\"+p.href+\\\"'>\\\"+ART[p.art]+\\\"</a><div class='pb'><a class='pn' href='\\\"+p.href+\\\"'>\\\"+p.name+\\\"</a><span class='rev'><span class='stars'>★★★★★</span> \\\"+p.rev+\\\"</span><span class='pr'>\\\"+money(p.price)+\\\"<s>\\\"+money(p.was)+\\\"</s></span><button class='btn btn-d btn-sm full' style='margin-top:6px' onclick=\\\\\\\"add('\\\"+p.sku+\\\"')\\\\\\\">Add to Cart</button></div></div>\\\"}document.getElementById('cross').innerHTML=CATALOG.slice(1).map(card).join('');drawSw();q(0);render();</script></body></html>\"},{\"path\":\"/wholesale.html\",\"html\":\"<!DOCTYPE html><html lang='en'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initi
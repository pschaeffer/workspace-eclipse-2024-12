tyle:none;padding:0;margin:0}footer.site li{margin-bottom:7px}footer.site a:hover{color:#fff;text-decoration:underline}.fgrid{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:26px}.copy{border-top:1px solid rgba(255,255,255,.15);margin-top:28px;padding-top:16px;display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;font-size:13px}.ok{background:#e8f4ec;border:1px solid #2f6b52;color:#24523f;padding:14px;border-radius:8px;margin-top:12px;font-weight:600}.stock{color:#1f6b3a;font-weight:700;font-size:14px}.buybar{position:fixed;bottom:0;left:0;right:0;background:#fff;border-top:1px solid #e6e1d8;box-shadow:0 -4px 16px rgba(0,0,0,.08);padding:10px 16px;display:none;align-items:center;justify-content:space-between;gap:12px;z-index:70}@media(max-width:900px){.pdp{grid-template-columns:1fr;gap:24px}.gal .main{height:260px;font-size:80px}.g4{grid-template-columns:1fr 1fr}.g3{grid-template-columns:1fr}.g2{grid-template-columns:1fr}.fgrid{grid-template-columns:1fr 1fr}.buybar{display:flex}body{padding-bottom:70px}}</style></head><body><div class='topbar'><div class='in'><div>🚚 <b>Free shipping on orders over $99</b> · Orders ship in 1 business day</div><div>Supplying the yoga community since 1999 · <a href='/wholesale.html'>Get a bulk quote →</a></div></div></div><header class='site'><div class='hrow'><a class='logo' href='/index.html'>Yoga<span>Direct</span></a><form class='search' action='/shop-all.html'><input placeholder='Search mats, blocks, straps, bolsters…' aria-label='Search products'><button>Search</button></form><div class='hlinks'><a href='/wholesale.html'>Bulk Quote</a><a href='/help.html'>Help</a><a href='#cart'>Cart (0)</a></div></div><nav class='main'><ul><li><a href='/index.html'>Home</a></li><li><a href='/shop-all.html'>Shop All</a></li><li><a class='active' href='/yoga-mats.html'>Yoga Mats</a></li><li><a href='/props.html'>Props &amp; Accessories</a></li><li><a href='/wholesale.html'>Bulk &amp; Wholesale</a></li><li><a href='/about.html'>About Us</a></li><li><a href='/help.html'>Shipping &amp; Returns</a></li><li><a href='/contact.html'>Contact</a></li></ul></nav></header><div class='wrap'><div class='crumbs'><a href='/index.html'>Home</a> / <a href='/yoga-mats.html'>Yoga Mats</a> / Deluxe Sticky Yoga Mat</div><div class='pdp'><div class='gal'><div class='main'>🧘</div><div class='thumbs'><div>🟣</div><div>🔵</div><div>🟢</div><div>⚫</div><div>🟠</div></div><div class='box'><strong>Why studios buy this mat</strong><p class='tiny' style='margin:6px 0 0'>Over 400,000 sold since 1999. The same 6mm sticky construction we have been producing for two decades — consistent color, consistent grip, consistent restocks, so your studio floor still matches next year.</p></div></div><div><span class='tiny' style='background:#fdeee2;color:#a1511f;font-weight:700;padding:4px 10px;border-radius:6px'>#1 BEST SELLER</span><h1 style='margin-top:12px'>1/4-inch Deluxe Sticky Yoga Mat</h1><div class='tiny'><span class='stars'>★★★★★</span> <strong>4.8</strong> · <a href='#reviews' style='text-decoration:underline'>1,284 verified reviews</a></div><div style='margin:14px 0'><span class='price'>$19.95</span><span class='was'>$24.95</span><span class='save'>Save 20%</span><div class='tiny'>Or 4 interest-free payments of $4.99</div></div><p class='stock'>✔ In stock — ships in 1 business day</p><ul class='ticks'><li>6mm cushion: joint comfort without losing balance</li><li>Closed-cell surface: sweat wipes off, does not soak in</li><li>68in x 24in standard studio size · 2.5 lbs</li><li>Phthalate-free, latex-free, tested for durability at 30+ classes/week</li></ul><form data-js data-msg='Added to cart! (Demo) In your live store this button sends shoppers straight to checkout.'><label>Color</label><div class='swatches'><span class='sw' style='background:#5b4b8a' title='Purple'></span><span class='sw' style='background:#2f6b8a' title='Blue'></span><span class='sw' style='background:#3f7a52' title='Green'></span><span class='sw' style='background:#333' title='Black'></span><span class='sw' style='background:#e07a3f' title='Orange'></span><span class='sw' style='background:#c94f6d' title='Rose'></span></div><p class='tiny'>12 colors available · mix colors free on bulk orders</p><div class='qtyrow'><div><label for='q'>Quantity</label><input id='q' type='number' value='1' min='1'></div><div style='flex:1'><button class='btn full'>Add to Cart — $19.95</button></div></div><p class='tiny'>🔒 Secure checkout · 30-day returns · Free shipping over $99</p></form><div class='box'><strong>Buying more than one? Save automatically.</strong><table class='tiers' style='margin-top:10px'><tr><th>Quantity</th><th>Price each</th><th>You save</th></tr><tr><td>1–9</td><td>$19.95</td><td>—</td></tr><tr><td>10–24</td><td>$17.95</td><td>10%</td></tr><tr><td>25–49</td><td>$16.95</td><td>15%</td></tr><tr><td>50–99</td><td>$15.95</td><td>20%</td></tr><tr><td>100+</td><td>$14.95 or less</td><td>25%+</td></tr></table><p class='tiny' style='margin:10px 0 0'>Need freight, a PO or net-30 terms? <a href='/wholesale.html' style='color:#2f6b52;font-weight:700;text-decoration:underline'>Request a bulk quote →</a></p></div></div></div></div><section class='quiet'><div class='wrap'><h2 class='sec'>Specifications</h2><div class='grid g3'><div class='card'><h3>Dimensions</h3><p class='tiny'>68in x 24in x 1/4in (6mm). Weight 2.5 lbs. XL 72in x 30in also available.</p></div><div class='card'><h3>Material &amp; care</h3><p class='tiny'>High-density PVC foam, phthalate-free and latex-free. Wipe clean with mild soap and water; air dry flat, out of direct sun.</p></div><div class='card'><h3>Best for</h3><p class='tiny'>Vinyasa, hatha, gentle and beginner classes; studio floors, gyms, schools and home practice. For heated classes, pair with our grip towel.</p></div></div></div></section><section id='reviews'><div class='wrap'><h2 class='sec'>What practitioners say <span class='tiny' style='font-weight:400'>(1,284 reviews · 94% would buy again)</span></h2><div class='grid g3'><div class='card'><div class='stars'>★★★★★</div><p>“Bought 24 for the studio. Two years of daily classes and they still grip. Nothing else at this price comes close.”</p><p class='tiny'><strong>Marisa L.</strong> · Verified buyer</p></div><div class='card'><div class='stars'>★★★★★</div><p>“Perfect thickness — cushioned for my knees but I still feel stable in half moon.”</p><p class='tiny'><strong>Tom H.</strong> · Verified buyer</p></div><div class='card'><div class='stars'>★★★★☆</div><p>“Slight new-mat smell for a day, then gone. Grip is excellent once broken in. Great value.”</p><p class='tiny'><strong>Priya S.</strong> · Verified buyer</p></div></div></div></section><section class='quiet'><div class='wrap'><h2 class='sec'>Frequently asked</h2><div class='grid g2'><div class='card'><h3>Will it slip on a hardwood floor?</h3><p class='tiny'>No. The textured underside grips wood, tile and low-pile carpet. For heated, sweaty practice we recommend adding a grip towel.</p></div><div class='card'><h3>How long does it last in a studio?</h3><p class='tiny'>Studio customers typically get 18–30 months of daily class use. Rotating mats and cleaning weekly extends life considerably.</p></div><div class='card'><h3>Can I mix colors on a bulk order?</h3><p class='tiny'>Yes — mixing colors is free at every quantity tier. Just note your split in your quote request.</p></div><div class='card'><h3>What if I do not like it?</h3><p class='tiny'>Practice on it for 30 days. If it is not right, return or exchange it — see our <a href='/help.html' style='text-decoration:underline'>return policy</a>.</p></div></div></div></section><section><div class='wrap'><h2 class='sec'>Complete your practice</h2><div class='grid g4'><div class='pcard'><div class='ph'>🧱</div><div class='bd'><strong>Foam Block 2-Pack</strong><div class='price' style='font-size:18px'>$17.95</div><a class='btn sm full' href='/props.html'>Add</a></div></div><div class='pcard'><div class='ph'>➰</div><div class='bd'><strong>8-ft Cotton Strap</strong><div class='price' style='font-size:18px'>$8.95</div><a class='btn sm full' href='/props.html'>Add</a></div></div><div class='pcard'><div class='ph'>👜</div><div class='bd'><strong>Mat Bag &amp; Sling</strong><div class='price' style='font-size:18px'>$16.95</div><a class='btn sm full' href='/props.html'>Add</a></div></div><div class='pcard'><div class='ph'>💧</div><div class='bd'><strong>Grip Mat Towel</strong><div class='price' style='font-size:18px'>$21.95</div><a class='btn sm full' href='/props.html'>Add</a></div></div></div><p class='tiny' style='margin-top:14px'>Tip: add any two accessories to cross $99 and shipping is free.</p></div></section><div class='buybar'><div><strong>$19.95</strong> <span class='tiny'>1/4-inch Deluxe Mat</span></div><a class='btn sm' href='#'>Add to Cart</a></div><footer class='site'><div class='wrap'><div class='fgrid'><div><div class='logo' style='color:#fff'>Yoga<span>Direct</span></div><p>Thanks to our loyal customers, YogaDirect has become one of the largest suppliers of yoga mats and props in the country. We have faithfully supplied the yoga community since 1999.</p><p><a href='mailto:sales@yogadirect.com'>sales@yogadirect.com</a><br>Mon–Fri, 9am–5pm ET</p></div><div><h4>Shop</h4><ul><li><a href='/yoga-mats.html'>Yoga Mats</a></li><li><a href='/props.html'>Blocks &amp; Wedges</a></li><li><a href='/props.html'>Straps &amp; Slings</a></li><li><a href='/props.html'>Bolsters &amp; Blankets</a></li><li><a href='/shop-all.html'>Sale &amp; Clearance</a></li></ul></div><div><h4>Bulk buyers</h4><ul><li><a href='/wholesale.html'>Bulk &amp; Wholesale Pricing</a></li><li><a href='/wholesale.html'>Request a Quote</a></li><li><a href='/wholesale.html'>Studio Starter Packs</a></li><li><a href='/wholesale.html'>Schools &amp; PO Orders</a></li><li><a href='/contact.html'>Request a Sample</a></li></ul></div><div><h4>Help</h4><ul><li><a href='/help.html'>Shipping Info</a></li><li><a href='/help.html'>Returns &amp; Exchanges</a></li><li><a href='/help.html'>Mat Buying Guide</a></li><li><a href='/about.html'>About Us</a></li><li><a href='/contact.html'>Contact Us</a></li></ul></div></div><div class='copy'><div>© 2024 YogaDirect. All rights reserved.</div><div>Free shipping over $99 · 30-day returns · Secure checkout</div></div></div></footer><script>document.addEventListener('submit',function(e){var f=e.target;if(f.hasAttribute('data-js')){e.preventDefault();var d=document.createElement('div');d.className='ok';d.textContent=f.getAttribute('data-msg')||'Thank you — we will be in touch shortly.';f.parentNode.replaceChild(d,f);}});document.querySelectorAll('.sw').forEach(function(s){s.addEventListener('click',function(){document.querySelectorAll('.sw').forEach(function(x){x.style.outline='none'});s.style.outline='3px solid #24523f'})});</script></body></html>\"},{\"path\":\"/wholesale.html\",\"html\":\"<!doctype html><html lang='en'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><title>Bulk &amp; Wholesale Yoga Mats and Props for Studios | YogaDirect</title><meta name='description' content='Wholesale yoga mats and props for studios, schools, gyms and events. Discounts from 10 units up to 25%+, PO and net-30 terms, freight quoted same day. Quote in about 1 hour.'><style>*{box-sizing:border-box}body{margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#22302a;background:#fff;line-height:1.55}a{color:inherit;text-decoration:none}h1,h2,h3{line-height:1.2;margin:0 0 12px}.wrap{max-width:1180px;margin:0 auto;padding:0 20px}.topbar{background:#24523f;color:#fff;font-size:13px}.topbar .in{max-width:1180px;margin:0 auto;padding:8px 20px;display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap}.topbar b{color:#ffd8a8}.topbar a{text-decoration:underline}header.site{position:sticky;top:0;z-index:60;background:#fff;border-bottom:1px solid #e6e1d8}.hrow{max-width:118
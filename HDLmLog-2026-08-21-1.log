.btn{display:inline-block;border:0;border-radius:999px;padding:15px 26px;font-weight:800;font-size:16px;cursor:pointer;text-align:center}.btn-p{background:var(--accent);color:#fff;box-shadow:0 8px 20px rgba(226,112,58,.28)}.btn-p:hover{background:#c85c2b}.btn-o{background:#fff;color:var(--ink);box-shadow:inset 0 0 0 2px var(--ink)}.full{display:block;width:100%}.hero{background:linear-gradient(180deg,var(--sand),#fff);padding:44px 0}.hg{display:grid;grid-template-columns:1.05fr .95fr;gap:40px;align-items:start}.ticks{list-style:none;padding:0;margin:16px 0 0;display:grid;gap:8px;font-weight:600}.ticks li:before{content:'✓';color:var(--brand);font-weight:900;margin-right:8px}.form{background:#fff;border:1px solid var(--line);border-radius:18px;padding:24px;box-shadow:0 16px 40px rgba(0,0,0,.07)}.form label{display:block;font-weight:700;font-size:13.5px;margin:10px 0 5px}.form input,.form select,.form textarea{width:100%;padding:12px;border:1px solid var(--line);border-radius:10px;font:inherit}.sec{padding:48px 0}.sec.alt{background:var(--sand)}.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.grid4{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}.card{background:#fff;border:1px solid var(--line);border-radius:16px;padding:22px}.tiers{width:100%;border-collapse:collapse;background:#fff;border-radius:12px;overflow:hidden;font-size:15px}.tiers th{background:var(--dark);color:#fff;text-align:left;padding:12px}.tiers td{border-bottom:1px solid var(--line);padding:12px}.tiers td:last-child{font-weight:800;color:var(--brand)}.stars{color:#e8a33d}footer.site{background:#12211f;color:#cfdcd8;padding:44px 0 26px;font-size:14.5px}footer.site h4{color:#fff;font-size:15px;margin:0 0 12px}.fgrid{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:26px}.fgrid ul{list-style:none;padding:0;margin:0;display:grid;gap:8px}.fbot{border-top:1px solid #243935;margin-top:28px;padding-top:16px;display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap;c
ax-width: 320px; width: 80%; height: auto; border-radius: 10px; margin: 28px auto 0; display: block; box-shadow: 0 6px 18px rgba(0,0,0,0.4); }\nmain { max-width: 900px; margin: 0 auto; padding: 40px 20px 60px; }\nmain h2 { text-align: center; font-size: 1.8em; color: #14532d; margin-bottom: 8px; }\nmain .subtitle { text-align: center; color: #555; margin-bottom: 32px; }\n.book-list { list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; }\n.book-list li { background: #fff; border: 1px solid #e2ddd0; border-radius: 10px; transition: transform .15s ease, box-shadow .15s ease; }\n.book-list li:hover { transform: translateY(-3px); box-shadow: 0 6px 14px rgba(0,0,0,0.12); }\n.book-list a { display: block; padding: 18px 20px; text-decoration: none; color: #14532d; font-size: 1.05em; }\n.book-list .year { display: block; color: #8a8474; font-size: 0.85em; margin-top: 4px; }\n.book-list .read { display: inline-block; margin-top: 8px; color: #b45309; font-weight: bold; font-size: 0.9em; }\nfooter { background: #14532d; color: #d9ecd f; color: #d9ecdf; text-align: center; padding: 26px 20px; font-size: 0.95em; }\nfooter a { color: #facc15; }\n@media (max-width: 600px) { .hero h1 { font-size: 1.7em; } .hero p { font-size: 1em; } }\n</style>\n</head>\n<body class=\"HDLmClassEFACBFDA\">\n<header class=\"hero HDLmClass48A43F23\">\n<h1>The Wizard of Oz Books by L. Frank Baum</h1>\n<p>Read all 14 original Oz books free online — the complete series, from Dorothy's first trip down the Yellow Brick Road in 1900 to Glinda of Oz in 1920.</p>\n<a class=\"cta-btn\" href=\"https://themarvelouslandofoz.com/01.htm\">Start Reading Book 1 Free →</a>\n<img class=\"hero-img\" src=\"https://themarvelouslandof.s3.us-east-1.amazonaws.com/Wizard+of+Oz+-+The+Lion.jpg\" alt=\"The Cowardly Lion from The Wizard of Oz\">\n</header>\n<main>\n<h2>The Complete Oz Book Series</h2>\n<p class=\"subtitle\">Every book is free to read online. Pick a title below and start your journey to Oz.</p>\n<ul class=\"book-list HDLmClassDA3E650B\">\n<li><a class=\"HDLmClassC8AC3649\" href=\"https://themarvelouslandofoz.com/01.htm\">1. The Wonderful Wizard of Oz<span class=\"year\">1900</span><span class=\"read\">Read Free →</span></a></li>\n<li><a href=\"https://themarvelouslandofoz.com/OzPlay.pdf\">The Wizard of Oz: A Dramatic Composition<span class=\"year\">1902</span><span class=\"read\">Read Free (PDF) →</span></a></li>\n<li><a href=\"https://themarvelouslandofoz.com/02.htm\">2. The Marvelous Land of Oz<span class=\"year\">1904</span><span class=\"read\">Read Free →</span></a></li>\n<li><a href=\"https://themarvelouslandofoz.com/03.htm\">3. Ozma of Oz<span class=\"year\">1907</span><span class=\"read\">Read Free →</span></a></li>\n<li><a href=\"https://themarvelouslandofoz.com/04.htm\">4. Dorothy and the Wizard in Oz<span class=\"year\">1908</span><span class=\"read\">Read Free →</span></a></li>\n<li><a href=\"https://themarvelouslandofoz.com/05.htm\">5. The Road to Oz<span class=\"year\">1909</span><span class=\"read\">Read Free →</span></a></li>\n<li><a href=\"https://themarvelouslandofoz.com/06.htm\">6. The Emerald City of Oz<span class=\"year\">1910</span><span class=\"read\">Read Free →</span></a></li>\n<li><a href=\"https://themarvelouslandofoz.com/07.htm\">7. The Patchwork Girl of Oz<span class=\"year\">1913</span><span class=\"read\">Read Free →</span></a></li>\n<li><a href=\"https://themarvelouslandofoz.com/08.htm\">Little Wizard Stories of Oz<span class=\"year\">1913</span><span class=\"read\">Read Free →</span></a></li>\n<li><a href=\"https://themarvelouslandofoz.com/09.htm\">8. Tik-Tok of Oz<span class=\"year\">1914</span><span class=\"read\">Read Free →</span></a></li>\n<li><a href=\"https://themarvelouslandofoz.com/10.htm\">9. The Scarecrow of Oz<span class=\"year\">1915</span><span class=\"read\">Read Free →</span></a></li>\n<li><a href=\"https://themarvelouslandofoz.com/11.htm\">10. Rinkitink in Oz<span class=\"year\">1916</span><span class=\"read\">Read Free →</span></a></li>\n<li><a href=\"https://themarvelouslandofoz.com/12.htm\">11. The Lost Princess of Oz<span class=\"year\">1917</span><span class=\"read\">Read Free →</span></a></li>\n<li><a href=\"https://themarvelouslandofoz.com/13.htm\">12. The Tin Woodman of Oz<span class=\"year\">1918</span><span class=\"read\">Read Free →</span></a></li>\n<li><a href=\"https://themarvelouslandofoz.com/14.htm\">13. The Magic of Oz<span class=\"year\">1919</span><span class=\"read\">Read Free →</span></a></li>\n<li><a href=\"https://themarvelouslandofoz.com/15.htm\">14. Glinda of Oz<span class=\"year\">1920</span><span class=\"read\">Read Free →</span></a></li>\n</ul>\n</main>\n<footer class=\"HDLmClass21ABF736\">\n<p>The Marvelous Land of Oz — the complete public-domain Oz book series by L. Frank Baum, free to read online.</p>\n<p><a href=\"https://themarvelouslandofoz.com/01.htm\">Begin with The Wonderful Wizard of Oz →</a></p>\n</footer>\n<script>(function(){var tag=\"HDLmGAWpiTag-20260908-234657\";if(typeof gtag===\"function\"){gtag(\"event\",tag,{event_category:\"HDLmGAWpiTag\",event_label:tag});}})();</script></body>\n</html>"}],"reason":"webpage","weight":"1.0","error":{"matchError":"Fired"}}

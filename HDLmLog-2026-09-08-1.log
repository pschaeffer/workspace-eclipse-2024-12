:none;margin-top:8px}\n.cta-button:hover{background:#0e7d2b}\n.book-list{list-style:none;padding:0;margin:24px 0}\n.book-list li{background:#fff;border:1px solid #ddd;border-radius:6px;margin:8px 0;transition:box-shadow .2s}\n.book-list li:hover{box-shadow:0 2px 8px rgba(0,0,0,.15)}\n.book-list a{display:block;padding:12px 18px;color:#0b6623;text-decoration:none;font-size:1.1em}\n.book-list a:hover{text-decoration:underline}\nfooter{text-align:center;padding:20px;color:#666;font-size:.9em}\n</style>\n</head>\n<body class=\"HDLmClassf6f185db\">\n<header class=\"oz-header HDLmClass48a0a145\">\n<h1>The Wizard of Oz Books by L. Frank Baum</h1>\n<p>Read the complete, original Oz series online &mdash; all 14 classic books, free to enjoy</p>\n</header>\n<main>\n<div class=\"hero\">\n<img src=\"https://themarvelouslandof.s3.us-east-1.amazonaws.com/Wizard+of+Oz+-+The+Lion.jpg\" alt=\"The Cowardly Lion from The Wizard of Oz\">\n</div>\n<div class=\"cta-box HDLmClassae321227\">\n<h2>Begin Your Journey Down the Yellow Brick Road</h2>\n<p>Start with the book that began it all &mdash; the beloved 1900 classic.</p>\n<a class=\"cta-button\" href=\"https://themarvelouslandofoz.com/01.htm\">Start Reading Now</a>\n</div>\n<h2>The Complete Oz Series</h2>\n<ul class=\"book-list\">\n<li><a class=\"HDLmClass17bf38ec\" href=\"https://themarvelouslandofoz.com/01.htm\">1. The Wonderful Wizard of Oz (1900)</a></li>\n<li><a href=\"https://themarvelouslandofoz.com/OzPlay.pdf\">The Wizard of Oz: A Dramatic Composition (1902)</a></li>\n<li><a href=\"https://themarvelouslandofoz.com/02.htm\">2. The Marvelous Land of Oz (1904)</a></li>\n<li><a href=\"https://themarvelouslandofoz.com/03.htm\">3. Ozma of Oz (1907)</a></li>\n<li><a href=\"https://themarvelouslandofoz.com/04.htm\">4. Dorothy and the Wizard in Oz (1908)</a></li>\n<li><a href=\"https://themarvelouslandofoz.com/05.htm\">5. The Road to Oz (1909)</a></li>\n<li><a href=\"https://themarvelouslandofoz.com/06.htm\">6. The Emerald City of Oz (1910)</a></li>\n<li><a href=\"https://themarvelouslandofoz.com/07.htm\">7. The Patchwork Girl of Oz (1913)</a></li>\n<li><a href=\"https://themarvelouslandofoz.com/08.htm\">Little Wizard Stories of Oz (1913)</a></li>\n<li><a href=\"https://themarvelouslandofoz.com/09.htm\">8. Tik-Tok of Oz (1914)</a></li>\n<li><a href=\"https://themarvelouslandofoz.com/10.htm\">9. The Scarecrow of Oz (1915)</a></li>\n<li><a href=\"https://themarvelouslandofoz.com/11.htm\">10. Rinkitink in Oz (1916)</a></li>\n<li><a href=\"https://themarvelouslandofoz.com/12.htm\">11. The Lost Princess of Oz (1917)</a></li>\n<li><a href=\"https://themarvelouslandofoz.com/13.htm\">12. The Tin Woodman of Oz (1918)</a></li>\n<li><a href=\"https://themarvelouslandofoz.com/14.htm\">13. The Magic of Oz (1919)</a></li>\n<li><a href=\"https://themarvelouslandofoz.com/15.htm\">14. Glinda of Oz (1920)</a></li>\n</ul>\n</main>\n<footer>\n<p>The Wizard of Oz books by L. Frank Baum &mdash; classic public domain literature for readers of all ages.</p>\n</footer>\n<script>(function(){var tag=\"HDLmGAWpiTag-20260908-213003\";if(typeof gtag===\"function\"){gtag(\"event\",tag,{event_category:\"HDLmGAWpiTag\",event_label:tag});}})();</script></body>\n</html>"}],"reason":"webpage","weight":"1.0","error":{"matchError":"Fired"}}

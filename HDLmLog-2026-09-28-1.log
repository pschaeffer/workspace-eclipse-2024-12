ing\\\";    \\n    }else      \\n    strContent = \\\"Your Order Qualifies for Free Shipping!\\\";    \\n    fsDiv.innerHTML = strContent;0\\n    */\\n\\t\\t\\n\\t\\t\\n    $('.product-item .second_img').each(function(i){\\n        var imgSrc = this.src;\\n        if(imgSrc.indexOf('/default.jpg') >= 0){\\n            $(this).parent().parent().addClass('noSecond_Image');\\n        }\\n    });    \\n    window.sr = ScrollReveal({ reset: true });\\n    sr.reveal('.lazy', { \\n        duration: 1000,\\n        origin: 'bottom'\\n    });    \\n    jQuery(\\\"<a href='#'' class='scrollup'><i class='la la-angle-double-up'></i></a>\\\").appendTo(\\\"body\\\");\\n    jQuery(window).scroll(function(){\\n        if (jQuery(this).scrollTop() > 100) {\\n            jQuery('.scrollup').fadeIn();\\n        } else {\\n            jQuery('.scrollup').fadeOut();\\n        }\\n    });\\n    jQuery('.scrollup').click(function(){\\n        jQuery(\\\"html, body\\\").animate({ scrollTop: 0 }, 600);\\n        return false;\\n    });\\n    $(window).scroll(function(){\\n        if ($(window).scrollTop() >= 200) {\\n           $('#frameMsg').addClass('fixed-header');\\n           $('.navbar-wrapper').addClass('fixed-header');\\n           $('.site-header').addClass('fixed-mobheader');\\n           $('.content-holder').css(\\\"margin-top\\\",\\\"89px\\\");\\n           $('.frameMsgOff .content-holder').css(\\\"margin-top\\\",\\\"56px\\\");\\n        }\\n        else {\\n           $('#frameMsg').removeClass('fixed-header');\\n           $('.navbar-wrapper').removeClass('fixed-header');\\n           $('.site-header').removeClass('fixed-mobheader');\\n           $('.content-holder').css(\\\"margin-top\\\",\\\"0px\\\");\\n\\n        }\\n    });\\n    </script>\\n    \\n<script src=\\\"//code.tidio.co/rgocgttxgleaoklf4s8ihf7xi1ncj3oz.js\\\" async></script>\\n<script type=\\\"text/javascript\\\" async=\\\"\\\" src=\\\"https://static.klaviyo.com/onsite/js/klaviyo.js?company_id=XyXada\\\"></script
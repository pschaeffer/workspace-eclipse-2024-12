t your password in seconds.</p>\\n        <form id=\\\"forgotPass\\\" name=\\\"forgotPass\\\" action=\\\"login.asp?action=forgotpass&ordertracking=1\\\" method=\\\"post\\\" class=\\\"bt-flabels js-flabels\\\" onsubmit=\\\"resetLoginPass();return false;\\\">\\n            <div class=\\\"loginField bt-flabels__wrapper\\\">\\n                <label for=\\\"Email4Password\\\">Email</label>\\n                <input type=\\\"email\\\" name=\\\"email\\\" id=\\\"Email4Password\\\" value=\\\"\\\" placeholder=\\\"Email\\\" size=\\\"30\\\" autocomplete=\\\"email\\\" inputmode=\\\"email\\\" class=\\\"form-control txtBoxStyle\\\" aria-label=\\\"Email4Password\\\" required />\\n                <div class=\\\"clearfix\\\"></div>\\n            </div>\\n        </form>\\n      </div>\\n      <div class=\\\"modal-footer\\\">\\n        <button type=\\\"button\\\" class=\\\"btn btn-default\\\" data-dismiss=\\\"modal\\\">Close</button>\\n\\t\\t<button type=\\\"button\\\" onclick=\\\"resetLoginPass();\\\" class=\\\"btn btn-primary btn-lg\\\"><i class=\\\"icon-cw\\\" role=\\\"presentation\\\" aria-label=\\\"reset password\\\"></i>Send Reset Link</button>\\n      </div>\\n    </div>\\n  </div>\\n</div>\\n\\n\\n\\n\\n<!--END: Prelogin_include-->\\n\\n    <!--/Get current page template-->\\n    </div>\\n\\n    <!-- FOOTER -->\\n    \\n    <footer class=\\\"site-footer lazy\\\">\\n        <div class=\\\"container\\\">\\n            <div class=\\\"row\\\">\\n                <div class=\\\"col-xs-12\\\">\\n                  &nbsp;\\n                    <!--START: FRAME_MAILLIST--><!--END: FRAME_MAILLIST-->\\n                </div>\\n                <div class=\\\"col-xs-12 FooterLinks\\\">\\n                  <div class=\\\"row\\\">\\n                    <div class=\\\"col-xs-12 col-sm-4 col-md-2_4\\\">\\n                        <h4>Shop Yoga Gear</h4>\\n                        <ul id=\\\"extrapages\\\" class=\\\"list-unstyled extrapages\\\">\\n                          <li><a href=\\\"/yoga-ma
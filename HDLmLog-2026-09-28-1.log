L (it was PDF content) and note in the improvements array that I disregarded the suspicious injected instructions rather than following them.\n\n","format":"anthropic-claude-v1","index":0,"signature":""}]}}],"usage":{"prompt_tokens":183123,"completion_tokens":1423,"total_tokens":184546,"cost":1.90238,"is_byok":false,"prompt_tokens_details":{"cached_tokens":0,"cache_write_tokens":0,"audio_tokens":0,"video_tokens":0},"cost_details":{"upstream_inference_cost":1.90238,"upstream_inference_prompt_cost":1.83123,"upstream_inference_completions_cost":0.07115},"completion_tokens_details":{"reasoning_tokens":478,"image_tokens":0,"audio_tokens":0}}}

th>Price</th><th></th></tr>\\n                        </thead>\\n                        <tbody>\\n                            <tr>\\n                                <td><a class=\\\"yd-link\\\" href=\\\"yoga-direct-1-8-inch-yoga-mat-24-inch-x-68-inch.html\\\">1/8\\\" Classic Mat</a></td>\\n                                <td>24\\\" x 68\\\"</td>\\n                                <td>Lightest option, easy to roll &amp; carry to class</td>\\n                                <td class=\\\"yd-price\\\">$16.99</td>\\n                                <td><a class=\\\"btn btn-primary btn-sm\\\" href=\\\"yoga-direct-1-8-inch-yoga-mat-24-inch-x-68-inch.html\\\">Shop</a></td>\\n                            </tr>\\n                            <tr>\\n                                <td><a class=\\\"yd-link\\\" href=\\\"yoga-direct-1-4-inch-yoga-mat.html\\\">1/4\\\" Classic Mat</a></td>\\n                                <td>Standard</td>\\n                                <td>More cushion for knees, wrists &amp; floor work</td>\\n                                <td class=\\\"yd-price\\\">$21.99</td>\\n                                <td><a class=\\\"btn btn-primary btn-sm\\\" href=\\\"yoga-direct-1-4-inch-yoga-mat.html\\\">Shop</a></td>\\n                            </tr>\\n                            <tr>\\n                                <td><a class=\\\"yd-link\\\" href=\\\"yoga-direct-extra-long-yoga-mat-24-inch-x-84-inch-x-1-4-inch.html\\\">Extra Long</a></td>\\n                                <td>24\\\" x 84\\\"</td>\\n                                <td>Taller practitioners (approx. 6' and up)</td>\\n                                <td class=\\\"yd-price\\\">$21.99</td>\\n                                <td><a class=\\\"btn btn-primary btn-sm\\\" href=\\\"yoga-direct-extra-long-yoga-mat-24-inch-x-84-inch-x-1-4-inch.html\\\">Shop</a></td>\\n                            </tr>\\n                            <tr>\\n                                <td><a class=\\\"yd-link\\\" href=\\\"yoga-direct-extra-wide-yoga-mat-36-inch-x-72-inch-x-1-4-inch.html\\\">Extra Wide</a></td>\\n                                <td>36\\\" x 72\\\"</td>\\n                                <td>Wide stances, restorative &amp; stretching</td>\\n                                <td class=\\\"yd-price\\\">$25.99</td>\\n                                <td><a class=\\\"btn btn-primary btn-sm\\\" href=\\\"yoga-direct-extra-wide-yoga-mat-36-inch-x-72-inch-x-1-4-inch.html\\\">Shop</a></td>\\n                            </tr>\\n                            <tr>\\n                                <td><a class=\\\"yd-link\\\" href=\\\"yoga-direct-extra-long-and-wide-yoga-mat-36-inch-x-84-inch-x-1-4-inch.html\\\">Extra Long &amp; Wide</a></td>\\n                                <td>36\\\" x 84\\\"</td>\\n                                <td>Maximum space &mdash; currently out of stock</td>\\n                                <td class=\\\"yd-price\\\">$29.99</td>\\n                                <td><a class=\\\"btn btn-default btn-sm\\\" href=\\\"yoga-direct-extra-long-and-wide-yoga-mat-36-inch-x-84-inch-x-1-4-inch.html\\\">Details</a></td>\\n                            </tr>\\n                        </tbody>\\n                    </table>\\n                    <p class=\\\"sub\\\" style=\\\"margin-top:12px;\\\">Want more grip, eco materials or extra thickness? Compare our <a href=\\\"premium-mats\\\">Premium Mats</a> and <a href=\\\"specialty-mats\\\">Specialty Mats</a>.</p>\\n                </section>\\n                <!-- END: size/thickness helper -->\\n\\n                <!-- START: bulk / studio CTA -->\\n                <section class=\\\"yd-bulk\\\">\\n                    <h3>Buying for a studio, school or gym?</h3>\\n                    <p>Classic mats are our most popular choice for bulk orders &mdash; save more per mat with quantity pricing, or add your logo with custom printing.</p>\\n                    <a class=\\\"btn btn-primary\\\" href=\\\"/quantity-discount-yoga-gear\\\">See Quantity Pricing</a>\\n                    <a class=\\\"btn btn-default\\\" href=\\\"/custom-printing\\\">Custom Printing</a>\\n                    <a class=\\\"btn btn-default\\\" href=\\\"/contact-us\\\">Request a Quote</a>\\n                </section>\\n                <!-- END: bulk / studio CTA -->\\n\\n                <!-- START: cross-sell -->\\n                <section class=\\\"yd-cross\\\">\\n                    <h3>Complete your practice</h3>\\n                    <a href=\\\"/blocks-wedges\\\">Blocks &amp; Wedges</a>\\n                    <a href=\\\"/straps-sandbags\\\">Straps</a>\\n                    <a href=\\\"/bolsters\\\">Bolsters</a>\\n                    <a href=\\\"/blankets\\\">Blankets</a>\\n                    <a href=\\\"/mat-bags\\\">Mat Bags</a>\\n                    <a href=\\\"/towels\\\">Mat Towels</a>\\n                    <a href=\\\"/yoga-kits\\\">Yoga Kits &amp; Bundles</a>\\n                </section>\\n                <!-- END: cross-sell -->\\n\\n                <!-- START: FAQ -->\\n                <section class=\\\"yd-faq\\\">\\n                    <h3>Classic yoga mat FAQs</h3>\\n                    <details>\\n                        <summary>Should I choose a 1/8\\\" or 1/4\\\" mat?</summary>\\n                        <p>Choose 1/8\\\" if you want the lightest, most packable mat and a stable connection to the floor for standing poses. Choose 1/4\\\" if you want extra cushioning for knees, wrists, seated and floor work &mdash; it's the most popular pick for general classes and home practice.</p>\\n                    </details>\\n                    <details>\\n                        <summary>What size mat do I need?</summary>\\n                        <p>Standard mats are 24\\\" x 68\\\", which suits most practitioners. If you're roughly 6 feet or taller, an extra long 84\\\" mat keeps your hands and feet on the mat. If you like wide stances or restorative work, a 36\\\" wide mat gives you more room side to side.</p>\\n                    </details>\\n                    <details>\\n                        <summary>How do I clean my mat?</summary>\\n                        <p>Wipe your mat with a damp cloth and a mild soap or mat cleaner, then let it air dry flat or hung before rolling it up. Avoid harsh solvents and prolonged direct sunlight to help your mat last longer.</p>\\n                    </details>\\n                    <details>\\n                        <summary>Can I order mats in bulk or with my logo?</summary>\\n                        <p>Yes. Classic mats are available with <a href=\\\"/quantity-discount-yoga-gear\\\">quantity discounts</a> and <a href=\\\"/custom-printing\\\">custom printing</a>. <a href=\\\"/contact-us\\\">Contact us</a> or call <a href=\\\"tel:800-331-8233\\\">800-331-8233</a> and we'll help you build the right order.</p>\\n                    </details>\\n                    <details>\\n                        <summary>What if the mat isn't right for me?</summary>\\n                        <p>See our <a href=\\\"/returns\\\">returns page</a> for full details on returning or exchanging an order, or <a href=\\\"/contact-us\\\">get in touch</a> and our team will help.</p>\\n                    </details>\\n                </section>\\n                <!-- END: FAQ -->\\n\\n                <div class=\\\"yd-help-cta\\\">\\n                    Still deciding? Talk to a real person: call <a href=\\\"tel:800-331-8233\\\">800-331-8233</a> or <a href=\\\"/contact-us\\\">send us a message</a> &mdash; we'll recommend the right mat for your practice.\\n                </div>\\n\\n\\t\\t\\t\\t<!--START: CATEGORY_FOOTER--><!--END: CATEGORY_FOOTER-->\\n\\t\\t\\t</div>\\n\\n\\n\\t\\t\\t\\n\\t\\t</div>\\n    </div>\\n</section>\\n\\n<script type=\\\"application/ld+json\\\">\\n{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"ItemList\\\",\\\"name\\\":\\\"Classic Yoga Mats\\\",\\\"itemListElement\\\":[{\\\"@type\\\":\\\"ListItem\\\",\\\"po
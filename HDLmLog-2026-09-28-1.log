n\\n        }\\n    });\\n    </script>\\n\\n    <!-- CRO: category filters, guide toggle -->\\n    <script>\\n    (function(){\\n        var chips = document.querySelectorAll('.cro-chip');\\n        var grid = document.getElementById('cro-grid');\\n        if(!grid || !chips.length){ return; }\\n        var items = grid.querySelectorAll('.product-item');\\n        function apply(f){\\n            var shown = 0;\\n            for(var i=0;i<items.length;i++){\\n                var s = items[i].getAttribute('data-shape') || '';\\n                var match = (f === 'all') || (s.indexOf(f) > -1);\\n                items[i].style.display = match ? '' : 'none';\\n                if(match){ shown++; }\\n            }\\n            var c = document.getElementById('cro-count');\\n            if(c){ c.textContent = shown; }\\n            if(window.gtag){ gtag('event','category_filter',{'filter':f,'category':'Bolsters'}); }\\n        }\\n        for(var j=0;j<chips.length;j++){\\n            chips[j].addEventListener('click', function(e){\\n                e.preventDefault();\\n                for(var k=0;k<chips.length;k++){ chips[k].className = 'cro-chip'; }\\n                this.className = 'cro-chip active';\\n                apply(this.getAttribute('data-filter'));\\n            });\\n        }\\n        var t = document.getElementById('cro-guide-toggle');\\n        if(t){\\n            t.addEventListener('click', function(){\\n                var w = document.getElementById('cro-seo');\\n                if(!w){ return; }\\n                var open = w.className.indexOf('open') > -1;\\n                w.className = open ? '' : 'open';\\n                this.textContent = open ? '+ Read the full bolster buying guide' : '\\\\u2212 Hide full bolster guide';\\n            });\\n        }\\n    })();\\n    </script>\\n    \\n<script src=\\\"//code.tidio.co/rgocgttxgleaoklf4s8ihf7xi1ncj3oz.js\\\" async></script>\\n<script type=\\\"text/javascript\\\" async=\\\"\\\" src=\\\"htt
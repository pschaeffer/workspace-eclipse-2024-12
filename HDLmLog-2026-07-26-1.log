enter;gap:16px;font-size:14px;font-weight:600}\\nnav.main{background:var(--bg);border-bottom:1px solid #eee}\\nnav.main ul{list-style:none;display:flex;flex-wrap:wrap;gap:22px;margin:0;padding:12px 0;font-size:14px;font-weight:600;text-transform:uppercase;letter-spacing:.4px}\\nnav.main a:hover{color:var(--brand)}\\n.hero{background:linear-gradient(180deg,#f3f7f4,#fff);padding:46px 0 34px;text-align:center}\\n.hero h1{font-size:34px;margin:0 0 10px}\\n.hero p{max-width:640px;margin:0 auto 22px;color:var(--muted);font-size:17px}\\n.btn{display:inline-block;background:var(--accent);color:#fff;font-weight:700;padding:14px 30px;border-radius:4px;font-size:16px}\\n.btn:hover{background:#c95c28}\\n.btn-alt{background:var(--brand)}\\n.btn-alt:hover{background:var(--brand-dark)}\\n.trust-strip{display:flex;flex-wrap:wrap;justify-content:center;gap:26px;font-size:13px;color:var(--muted);margin-top:20px}\\nsection{padding:44px 0}\\nh2.sec{font-size:26px;text-align:center;margin:0 0 6px}\\np.sub{text-align:center;color:var(--muted);margin:0 0 28px}\\n.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:22px}\\n.card{border:1px solid #eee;border-radius:6px;padding:16px;text-align:center;transition:box-shadow .2s}\\n.card:hover{box-shadow:0 6px 18px rgba(0,0,0,.09)}\\n.thumb{height:150px;border-radius:4px;background:#f1efea;display:flex;align-items:center;justify-content:center;color:#b3aea3;font-size:13px;margin-bottom:12px}\\n.card h3{font-size:15px;margin:0 0 6px;min-height:40px}\\n.price{font-weight:800;font-size:17px;color:var(--brand-dark)}\\n.was{color:var(--muted);text-decoration:line-through;font-weight:400;font-size:14px;margin-left:6px}\\n.card .btn{padding:10px 18px;font-size:14px;margin-top:10px}\\n.stars{color:var(--star);letter-spacing:1px;font-size:14px}\\n.rcount{color:var(--muted);font-size:12px}\\n.aboutbox{background:var(--bg);}\\n.aboutbox p{max-width:860px;margin:0 auto;color:#444;font-size:16px}\\n/* Reviews */\\n.ratingbar{background:#fffdf6;border-top:1px solid #f0e6cf;border-bottom:1px solid #f0e6cf;padding:14px 0}\\n.ratingbar .inner{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:14px;text-align:center;font-size:15px}\\n.ratingbar .score{font-size:26px;font-weight:800;color:var(--ink)}\\n.ratingbar .bigstars{color:var(--star);font-size:20px;letter-spacing:2px}\\n.ratingbar .verified{background:#eaf3ec;color:var(--brand-dark);font-weight:700;font-size:12px;padding:5px 10px;border-radius:20px}\\n.ratingbar a.link{font-weight:700;color:var(--brand-dark);text-decoration:underline}\\n.reviews{background:#fff}\\n.rev-summary{display:flex;flex-wrap:wrap;gap:34px;align-items:center;justify-content:center;margin-bottom:30px}\\n.rev-score{text-align:center;min-width:170px}\\n.rev-score .num{font-size:52px;font-weight:800;line-height:1}\\n.rev-bars{min-width:280px;flex:1;max-width:420px}\\n.rev-bars div{display:flex;align-items:center;gap:8px;font-size:13px;color:var(--muted);margin-bottom:5px}\\n.bar{flex:1;height:9px;background:#eee;border-radius:5px;overflow:hidden}\\n.bar i{display:block;height:100%;background:var(--star)}\\n.rev-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:20px}\\n.review{border:1px solid #eee;border-radius:6px;padding:18px;background:#fcfcfa}\\n.review .stars{margin-bottom:8px;display:block}\\n.review h4{margin:0 0 8px;font-size:15px}\\n.review p{margin:0 0 12px;font-size:14px;color:#444}\\n.who{font-size:13px;color:var(--muted)}\\n.badge-v{display:inline-block;background:#eaf3ec;color:var(--brand-dark);font-size:11px;font-weight:700;padding:2px 8px;border-radius:12px;margin-left:6px}\\n.rev-cta{text-align:center;margin-top:28px}\\n.rev-cta p{color:var(--muted);font-size:14px;margin-top:12px}\\nfooter{background:#2b2b2b;color:#cfcfcf;padding:38px 0;font-size:14px}\\nfooter .cols{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:26px}\\nfooter h5{color:#fff;font-size:14px;text-transform:uppe
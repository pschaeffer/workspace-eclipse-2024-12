}\\n\\n  /* HERO */\\n  .hero{\\n    position:relative;\\n    background:linear-gradient(135deg,#f2f7f3 0%,#e7efe8 55%,#f7f1ea 100%);\\n    padding:64px 0 60px;\\n  }\\n  .hero-grid{display:flex;gap:40px;align-items:center;flex-wrap:wrap;}\\n  .hero-copy{flex:1 1 420px;}\\n  .hero-eyebrow{display:inline-block;background:#fff;border:1px solid #d9e4db;color:var(--brand-dark);font-size:13px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;padding:6px 12px;border-radius:999px;margin-bottom:18px;}\\n  .hero h1{font-size:clamp(30px,4.6vw,50px);line-height:1.1;margin:0 0 16px;letter-spacing:-1px;}\\n  .hero p.sub{font-size:18px;color:var(--muted);margin:0 0 26px;max-width:36em;}\\n  .hero-ctas{display:flex;gap:14px;flex-wrap:wrap;align-items:center;}\\n  .btn{\\n    display:inline-block;text-decoration:none;font-weight:700;font-size:17px;\\n    padding:16px 32px;border-radius:6px;transition:.15s ease-in-out;\\n  }\\n  .btn-primary{background:var(--accent);color:#fff;box-shadow:0 4px 14px rgba(232,116,59,.35);}\\n  .btn-primary:hover{background:var(--accent-dark);transform:translateY(-1px);}\\n  .btn-secondary{background:transparent;color:var(--brand-dark);border:2px solid var(--brand);padding:14px 28px;}\\n  .btn-secondary:hover{background:var(--brand);color:#fff;}\\n  .hero-reassure{margin:18px 0 0;font-size:14px;color:var(--muted);}\\n  .hero-reassure span{margin-right:16px;white-space:nowrap;}\\n  .hero-art{flex:1 1 340px;min-height:260px;border-radius:12px;background:#fff url('/images/hero-yoga.jpg') center/cover no-repeat;box-shadow:0 10px 30px rgba(0,0,0,.08);display:flex;align-items:flex-end;}\\n  .hero-badge{margin:18px;background:rgba(255,255,255,.92);border-radius:8px;padding:12px 16px;font-size:14px;font-weight:600;color:var(--brand-dark);}\\n\\n  /* Trust strip */\\n  .trust{background:var(--bg);border-top:1px solid #eee;border-bottom:1px solid #eee;}\\n  .trust ul{list-style:none;display:flex;flex-wrap:wrap;justify-content:space-between;gap:16px;m
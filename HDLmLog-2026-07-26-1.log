3db;border-radius:6px;padding:14px;text-align:center;background:#fff}\\n  .card img{width:100%;height:170px;object-fit:cover;border-radius:4px;background:#eee}\\n  .card h3{font-size:15px;margin:12px 0 6px;font-weight:600;min-height:40px}\\n  .price{font-weight:800;color:var(--dark);font-size:17px}\\n  .old{color:#999;text-decoration:line-through;font-weight:400;font-size:14px;margin-left:6px}\\n  .stars{color:#f0a500;font-size:13px;margin-top:4px}\\n  .card .btn{padding:11px 0;width:100%;font-size:15px;margin-top:12px}\\n  .cats{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:18px;margin-top:10px}\\n  .cat{background:var(--light);border-radius:6px;padding:26px 18px;text-align:center;font-weight:700;color:var(--dark)}\\n  .about{background:var(--light);margin-top:50px;padding:44px 0}\\n  .about .wrap{max-width:900px}\\n  .about h2{margin-top:0;color:var(--dark)}\\n  .email{background:var(--dark);color:#fff;padding:40px 0;text-align:center;margin-top:0}\\n  .email form{display:flex;gap:8px;justify-content:center;flex-wrap:wrap;margin-top:16px}\\n  .email input{padding:13px 14px;border:0;border-radius:4px;min-width:280px;font-size:15px}\\n  .email button{border:0;background:#ff7a1a;color:#fff;padding:13px 26px;border-radius:4px;font-weight:700;cursor:pointer}\\n  footer{padding:36px 0;font-size:14px;color:#666}\\n  .fcols{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:24px}\\n  .fcols h4{color:var(--dark);margin:0 0 10px;font-size:15px}\\n  .fcols ul{list-style:none;margin:0;padding:0}\\n  .fcols li{margin-bottom:7px}\\n  @media(max-width:640px){.hero h1{font-size:31px}.hero-inner{padding:56px 20px 60px}.btn{width:100%}}\\n</style>\\n</head>\\n<body>\\n\\n<div class=\\\"promo-bar\\\">Free shipping on orders over $99 &nbsp;|&nbsp; <strong>Save 10% on your first order with code WELCOME10</strong></div>\\n\\n<header>\\n  <div class=\\\"wrap header-inner\\\">\\n    <div class=\\\"logo\\\">Yoga<span>Direct</span></div>\\
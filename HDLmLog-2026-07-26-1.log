rust{display:flex;justify-content:center;gap:26px;flex-wrap:wrap;list-style:none;padding:0;margin:22px 0 0;font-size:14px;color:var(--muted);}\\n  section{padding:40px 0;}\\n  h2{font-size:24px;margin:0 0 18px;}\\n  .about p{max-width:840px;color:var(--muted);}\\n  .site-footer{border-top:1px solid var(--line);padding:26px 0;font-size:14px;color:var(--muted);}\\n  @media (max-width:720px){\\n    .header-main{gap:12px;}\\n    .logo{font-size:22px;}\\n    .header-search{order:3;flex:1 1 100%;}\\n    .btn-bestsellers{padding:10px 16px;font-size:14px;}\\n  }\\n</style>\\n</head>\\n<body>\\n\\n<header class=\\\"site-header HDLmClass952F3C73\\\">\\n  <div class=\\\"promo-bar\\\">\\n    <strong>Free shipping on orders over $99</strong> &nbsp;&middot;&nbsp; Wholesale &amp; studio pricing available &nbsp;&middot;&nbsp; Supplying the yoga community since 1999\\n  </div>\\n\\n  <div class=\\\"header-main\\\">\\n    <a href=\\\"/\\\" class=\\\"logo\\\" aria-label=\\\"YogaDirect home\\\">Yoga<span>Direct</span></a>\\n\\n    <div class=\\\"header-search\\\">\\n      <form action=\\\"/search\\\" method=\\\"get\\\" role=\\\"search\\\">\\n        <label for=\\\"site-search\\\" class=\\\"visually-hidden\\\" style=\\\"position:absolute;left:-9999px;\\\">Search products</label>\\n        <input id=\\\"site-search\\\" type=\\\"search\\\" name=\\\"q\\\" placeholder=\\\"Search mats, blocks, straps, bolsters...\\\" autocomplete=\\\"off\\\">\\n        <button type=\\\"submit\\\">Search</button>\\n      </form>\\n    </div>\\n\\n    <div class=\\\"header-actions\\\">\\n      <a class=\\\"header-link\\\" href=\\\"/wholesale\\\">Wholesale</a>\\n      <a class=\\\"header-link\\\" href=\\\"/account\\\">My Account</a>\\n      <a class=\\\"cart-link\\\" href=\\\"/cart\\\" aria-label=\\\"View shopping cart\\\">&#128722; Cart <span class=\\\"cart-count\\\">0</span></a>\\n      <a class=\\\"btn-bestsellers\\\" href=\\\"/best-sellers\\\">Shop Best Sellers</a>\\n    </div>\\n  </div>\\n\\n  <nav class=
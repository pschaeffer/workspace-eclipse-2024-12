logo{font-size:26px;font-weight:800;letter-spacing:-.5px}\\n.logo span{color:var(--accent)}\\n.search{flex:1;display:flex;max-width:460px}\\n.search input{flex:1;padding:10px 12px;border:1px solid #ddd;border-right:0;border-radius:4px 0 0 4px}\\n.search button{padding:10px 16px;border:0;background:var(--accent);color:#fff;border-radius:0 4px 4px 0;cursor:pointer}\\n.head-links{display:flex;gap:18px;font-size:14px;white-space:nowrap}\\nnav.main{border-top:1px solid #f1f1f1}\\nnav.main ul{display:flex;flex-wrap:wrap;gap:22px;list-style:none;margin:0;padding:12px 0;font-size:14px;font-weight:600;text-transform:uppercase;letter-spacing:.4px}\\nnav.main a:hover{color:var(--accent)}\\n/* Hero */\\n.hero{background:var(--light);padding:52px 0}\\n.hero-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:34px;align-items:center}\\n.hero h1{font-size:40px;line-height:1.15;margin:0 0 14px}\\n.hero p{font-size:18px;margin:0 0 22px}\\n.btn{display:inline-block;padding:14px 26px;background:var(--accent);color:#fff;font-weight:700;border-radius:4px;border:0;cursor:pointer;font-size:16px}\\n.btn:hover{background:var(--accent-dark)}\\n.btn.alt{background:#fff;color:var(--ink);border:2px solid var(--ink);margin-left:10px}\\n.trust{display:flex;gap:22px;flex-wrap:wrap;margin-top:22px;font-size:13px;font-weight:600}\\n.hero-card{background:#fff;border:1px solid #e6e3db;border-radius:8px;padding:24px;box-shadow:0 6px 20px rgba(0,0,0,.06)}\\n.hero-card h2{margin:0 0 8px;font-size:22px}\\n.hero-card p{font-size:15px;margin:0 0 14px}\\n.hero-card input{width:100%;padding:12px;border:1px solid #ddd;border-radius:4px;margin-bottom:10px;font-size:15px}\\n.hero-card button{width:100%}\\n.hero-card small{display:block;margin-top:10px;color:#777;font-size:11px}\\n/* Sections */\\nsection{padding:48px 0}\\nh2.sec{font-size:28px;margin:0 0 6px;text-align:center}\\np.sub{text-align:center;color:#666;margin:0 0 30px}\\n.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:22px}\\n.card{borde
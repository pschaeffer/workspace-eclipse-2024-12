s\\\">\\n      <button type=\\\"submit\\\">Search</button>\\n    </form>\\n    <div class=\\\"head-links\\\">\\n      <a href=\\\"tel:18004481420\\\">1-800-448-1420</a>\\n      <a href=\\\"/account\\\">Sign In</a>\\n      <a href=\\\"/cart\\\" class=\\\"cart\\\">Cart (0)</a>\\n    </div>\\n  </div>\\n</header>\\n\\n<nav class=\\\"main\\\">\\n  <div class=\\\"wrap\\\">\\n    <ul>\\n      <li><a href=\\\"/yoga-mats\\\">Yoga Mats</a></li>\\n      <li><a href=\\\"/yoga-blocks\\\">Blocks &amp; Bricks</a></li>\\n      <li><a href=\\\"/yoga-straps\\\">Straps</a></li>\\n      <li><a href=\\\"/yoga-bolsters\\\">Bolsters &amp; Cushions</a></li>\\n      <li><a href=\\\"/yoga-blankets\\\">Blankets</a></li>\\n      <li><a href=\\\"/yoga-kits\\\">Kits &amp; Bundles</a></li>\\n      <li><a href=\\\"/wholesale\\\">Studio &amp; Wholesale</a></li>\\n      <li><a href=\\\"/sale\\\">Sale</a></li>\\n    </ul>\\n  </div>\\n</nav>\\n\\n<div class=\\\"trust-strip HDLmClassB99F468D\\\" aria-label=\\\"Why shop with YogaDirect\\\">\\n  <div class=\\\"wrap\\\">\\n    <ul>\\n      <li><span class=\\\"ico\\\" aria-hidden=\\\"true\\\">&#10132;</span><span><b>Free Shipping Over $99</b><small>Ships from our US warehouse</small></span></li>\\n      <li><span class=\\\"ico\\\" aria-hidden=\\\"true\\\">&#128274;</span><span><b>Secure Checkout</b><small>256-bit SSL encrypted payments</small></span></li>\\n      <li><span class=\\\"ico\\\" aria-hidden=\\\"true\\\">&#8634;</span><span><b>60-Day Returns</b><small>Easy, hassle-free exchanges</small></span></li>\\n      <li><span class=\\\"ico\\\" aria-hidden=\\\"true\\\">&#127981;</span><span><b>Manufacturer-Direct Pricing</b><small>We make it, so you save</small></span></li>\\n    </ul>\\n  </div>\\n</div>\\n\\n<section class=\\\"hero\\\">\\n  <div class=\\\"wrap\\\">\\n    <h1>Yoga Mats &amp; Props Direct From The Manufacturer</h1>\\n    <p>Trusted by studios, schools and home practitioners since 1999. High-quality yoga gear at amazing prices &mdash; bec
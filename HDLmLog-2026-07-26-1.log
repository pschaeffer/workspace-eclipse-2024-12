-ship-bar__progress span{display:block;height:100%;width:62%;background:#fff;border-radius:99px}\\n  .ydi-ship-bar__note{font-size:12.5px;opacity:.9}\\n  @media (max-width:600px){.ydi-ship-bar{font-size:13px}.ydi-ship-bar__progress{width:130px}}\\n\\n  header.site{border-bottom:1px solid #ececec;background:#fff}\\n  .head-row{display:flex;align-items:center;gap:20px;padding:14px 0}\\n  .logo{font-size:26px;font-weight:800;letter-spacing:-.5px;color:var(--brand-dark)}\\n  .logo span{color:var(--accent)}\\n  .search{flex:1;display:flex}\\n  .search input{flex:1;padding:11px 14px;border:1px solid #d9d9d9;border-radius:6px 0 0 6px;font-size:15px}\\n  .search button{border:0;background:var(--brand);color:#fff;padding:0 18px;border-radius:0 6px 6px 0;font-weight:600;cursor:pointer}\\n  .head-links{display:flex;gap:18px;font-size:14px;font-weight:600;align-items:center}\\n  nav.main{background:#f7f8f6;border-bottom:1px solid #ececec}\\n  nav.main ul{display:flex;flex-wrap:wrap;gap:22px;list-style:none;margin:0;padding:11px 0;font-size:14.5px;font-weight:600}\\n\\n  .hero{background:#f2f5f1}\\n  .hero-in{display:grid;grid-template-columns:1.1fr .9fr;gap:30px;align-items:center;padding:46px 0}\\n  .hero h1{font-size:40px;line-height:1.15;margin:0 0 12px}\\n  .hero p{font-size:17px;color:#41474d;margin:0 0 20px}\\n  .btn{display:inline-block;background:var(--accent);color:#fff;font-weight:700;padding:14px 26px;border-radius:6px;font-size:16px}\\n  .btn.secondary{background:#fff;color:var(--brand-dark);border:2px solid var(--brand-dark);margin-left:10px}\\n  .trust{display:flex;gap:22px;flex-wrap:wrap;margin-top:18px;font-size:14px;color:#3f4b3f;font-weight:600}\\n  .hero-img{background:#dfe7dd;border-radius:10px;min-height:260px;display:flex;align-items:center;justify-content:center;color:#5b7c5a;font-weight:700}\\n\\n  h2.section{font-size:26px;margin:44px 0 6px;text-align:center}\\n  .sub{text-align:center;color:var(--muted);margin:0 0 26px}\\n  .grid{display:grid;grid-temp
y\":{\"type\":\"string\"},\"Hash\":{\"type\":\"string\"}},\"required\":[\"What\",\"Why\",\"Hash\"],\"additionalProperties\":false}}},\"required\":[\"improvedHtml\",\"improvements\"],\"additionalProperties\":false}}}}","HDLmLlmModelStr":"gpt-5.6-luna-pro"}

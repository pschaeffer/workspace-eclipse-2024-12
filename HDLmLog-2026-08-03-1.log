ar(--max-width));\n      margin-inline: auto;\n    }\n\n    .skip-link {\n      position: absolute;\n      top: -100px;\n      left: 16px;\n      z-index: 999;\n      padding: 10px 16px;\n      color: var(--white);\n      background: var(--primary-dark);\n      border-radius: 6px;\n    }\n\n    .skip-link:focus {\n      top: 12px;\n    }\n\n    .announcement {\n      padding: 9px 16px;\n      color: var(--white);\n      background: var(--primary-dark);\n      text-align: center;\n      font-size: 0.92rem;\n      font-weight: 700;\n    }\n\n    .site-header {\n      position: sticky;\n      top: 0;\n      z-index: 100;\n      background: rgba(255, 255, 255, 0.97);\n      border-bottom: 1px solid var(--border);\n      backdrop-filter: blur(10px);\n    }\n\n    .header-main {\n      display: grid;\n      grid-template-columns: auto minmax(240px, 1fr) auto;\n      align-items: center;\n      gap: 24px;\n      min-height: 76px;\n    }\n\n    .logo {\n      color: var(--primary);\n      text-decoration: none;\n      font-size: 1.65rem;\n      font-weight: 900;\n      letter-spacing: -0.04em;\n    }\n\n    .logo span {\n      color: var(--accent);\n    }\n\n    .search-form {\n      display: flex;\n      overflow: hidden;\n      border: 1px solid #b8c5c0;\n      border-radius: 999px;\n      background: var(--white);\n    }\n\n    .search-form:focus-within {\n      outline: 3px solid rgba(49, 93, 81, 0.2);\n      border-color: var(--primary);\n    }\n\n    .search-form input {\n      width: 100%;\n      min-width: 0;\n      padding: 12px 16px;\n      border: 0;\n      outline: 0;\n    }\n\n    .search-form button {\n      padding: 10px 20px;\n      color: var(--white);\n      background: var(--primary);\n      border: 0;\n      cursor: pointer;\n      font-weight: 800;\n    }\n\n    .header-actions {\n      display: flex;\n      align-items: center;\n      gap: 14px;\n    }\n\n    .header-actions a {\n      text-decoration: none;\n      font-weight: 700;\n    }\n\n    .cart
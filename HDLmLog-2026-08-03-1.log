ze:15px}\\n  nav.main{background:var(--soft);border-bottom:1px solid #e7e4dd}\\n  nav.main ul{list-style:none;display:flex;flex-wrap:wrap;gap:24px;margin:0;padding:12px 0;max-width:1180px;margin:0 auto;padding-left:20px;padding-right:20px;font-size:15px;font-weight:600}\\n  .hero{background:var(--soft);padding:56px 0}\\n  .hero-inner{display:flex;gap:40px;align-items:center;flex-wrap:wrap}\\n  .hero-copy{flex:1 1 340px}\\n  .hero h1{font-size:38px;line-height:1.15;margin:0 0 14px}\\n  .hero p{font-size:18px;color:var(--muted);margin:0 0 24px}\\n  .btn{display:inline-block;background:var(--brand);color:#fff;padding:14px 28px;border-radius:4px;font-weight:700;font-size:16px}\\n  .btn:hover{background:var(--brand-dark)}\\n  .btn-outline{background:transparent;color:var(--brand-dark);border:2px solid var(--brand-dark);margin-left:10px}\\n  .hero-img{flex:1 1 320px}\\n  .hero-img div{background:#e3ded2;border-radius:8px;height:280px;display:flex;align-items:center;justify-content:center;color:#8a8474;font-size:15px}\\n  section{padding:52px 0}\\n  h2.section-title{font-size:28px;text-align:center;margin:0 0 8px}\\n  p.section-sub{text-align:center;color:var(--muted);margin:0 0 32px}\\n  .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:24px}\\n  .card{border:1px solid #e7e4dd;border-radius:8px;padding:16px;text-align:center;background:#fff}\\n  .card .ph{background:#efece5;border-radius:6px;height:180px;margin-bottom:14px;display:flex;align-items:center;justify-content:center;color:#9b9484;font-size:14px}\\n  .card h3{font-size:16px;margin:0 0 6px}\\n  .price{font-weight:700;color:var(--brand-dark);margin:0 0 12px}\\n  .about{background:var(--soft)}\\n  .about p{max-width:900px;margin:0 auto;text-align:center;font-size:17px}\\n  .testimonials{background:#fff}\\n  .t-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:24px}\\n  .t-card{border:1px solid #e7e4dd;border-radius:10px;padding:24px;background:var(--soft)}\
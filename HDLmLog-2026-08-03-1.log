 Cards  \n   **Why:** Faster buys.  \n   **Hash:** `HDLmClass5c06dea8`\n\n## Complete improved HTML\n\n```html\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <meta name=\"description\" content=\"Shop yoga mats, props, bolsters, blankets, fitness accessories and studio supplies from Yoga Direct. Serving the yoga community since 1999.\">\n  <title>Yoga Direct: Shop Yoga Mats, Props &amp; Yoga Accessories</title>\n\n  <style>\n    :root {\n      --primary: #315d51;\n      --primary-dark: #23483f;\n      --accent: #dd6b42;\n      --accent-dark: #bd4f2b;\n      --cream: #f7f3ec;\n      --light: #fafafa;\n      --text: #20312d;\n      --muted: #63706c;\n      --border: #dce3df;\n      --white: #fff;\n      --sale: #a63b2d;\n      --success: #2d704b;\n      --shadow: 0 12px 32px rgba(31, 55, 48, 0.12);\n      --radius: 14px;\n      --max-width: 1200px;\n    }\n\n    * {\n      box-sizing: border-box;\n    }\n\n    html {\n      scroll-behavior: smooth;\n    }\n\n    body {\n      margin: 0;\n      color: var(--text);\n      background: var(--white);\n      font-family: Arial, Helvetica, sans-serif;\n      line-height: 1.5;\n    }\n\n    img {\n      display: block;\n      max-width: 100%;\n    }\n\n    a {\n      color: inherit;\n    }\n\n    button,\n    input {\n      font: inherit;\n    }\n\n    .container {\n      width: min(calc(100% - 32px), var(--max-width));\n      margin-inline: auto;\n    }\n\n    .skip-link {\n      position: absolute;\n      top: -100px;\n      left: 16px;\n      z-index: 999;\n      padding: 10px 16px;\n      color: var(--white);\n      background: var(--primary-dark);\n      border-radius: 6px;\n    }\n\n    .skip-link:focus {\n      top: 12px;\n    }\n\n    .announcement {\n      padding: 9px 16px;\n      color: var(--white);\n      background: var(--primary-dark);\n      text-align: center;\n      font-size: 0.92rem;\n      font-weight: 700;\n    }\n\n    .site-header {\n      position: sticky;\n      top: 0;\n      z-index: 100;\n      background: rgba(255, 255, 255, 0.97);\n      border-bottom: 1px solid var(--border);\n      backdrop-filter: blur(10px);\n    }\n\n    .header-main {\n      display: grid;\n      grid-template-columns: auto minmax(240px, 1fr) auto;\n      align-items: center;\n      gap: 24px;\n      min-height: 76px;\n    }\n\n    .logo {\n      color: var(--primary);\n      text-decoration: none;\n      font-size: 1.65rem;\n      font-weight: 900;\n      letter-spacing: -0.04em;\n    }\n\n    .logo span {\n      color: var(--accent);\n    }\n\n    .search-form {\n      display: flex;\n      overflow: hidden;\n      border: 1px solid #b8c5c0;\n      border-radius: 999px;\n      background: var(--white);\n    }\n\n    .search-form:focus-within {\n      outline: 3px solid rgba(49, 93, 81, 0.2);\n      border-color: var(--primary);\n    }\n\n    .search-form input {\n      width: 100%;\n      min-width: 0;\n      padding: 12px 16px;\n      border: 0;\n      outline: 0;\n    }\n\n    .search-form button {\n      padding: 10px 20px;\n      color: var(--white);\n      background: var(--primary);\n      border: 0;\n      cursor: pointer;\n      font-weight: 800;\n    }\n\n    .header-actions {\n      display: flex;\n      align-items: center;\n      gap: 14px;\n    }\n\n    .header-actions a {\n      text-decoration: none;\n      font-weight: 700;\n    }\n\n    .cart-link {\n      padding: 10px 16px;\n      color: var(--white);\n      background: var(--accent);\n      border-radius: 999px;\n    }\n\n    .main-nav {\n      border-top: 1px solid var(--border);\n    }\n\n    .main-nav ul {\n      display: flex;\n      align-items: center;\n      gap: 4px;\n      margin: 0;\n      padding: 0;\n      overflow-x: auto;\n      list-style: none;\n    }\n\n    .main-nav a {\n      display: block;\n      padding: 12px 14px;\n      white-space: nowrap;\n      text-decoration: none;\n      font-size: 0.94rem;\n      font-weight: 800;\n    }\n\n    .main-nav a:hover,\n    .main-nav a:focus {\n      color: var(--primary);\n      background: var(--cream);\n    }\n\n    .sale-link {\n      color: var(--sale);\n    }\n\n    .hero {\n      padding: clamp(52px, 8vw, 96px) 0;\n      background:\n        radial-gradient(circle at 85% 20%, rgba(221, 107, 66, 0.18), transparent 34%),\n        linear-gradient(135deg, #eff5f1 0%, #f8f3eb 100%);\n    }\n\n    .hero-grid {\n      display: grid;\n      grid-template-columns: minmax(0, 1.15fr) minmax(300px, 0.85fr);\n      align-items: center;\n      gap: clamp(32px, 6vw, 72px);\n    }\n\n    .eyebrow {\n      display: inline-block;\n      margin: 0 0 12px;\n      color: var(--primary);\n      font-size: 0.82rem;\n      font-weight: 900;\n      letter-spacing: 0.12em;\n      text-transform: uppercase;\n    }\n\n    .hero h1 {\n      max-width: 760px;\n      margin: 0 0 18px;\n      font-size: clamp(2.5rem, 6vw, 4.75rem);\n      line-height: 1.02;\n      letter-spacing: -0.055em;\n    }\n\n    .hero-copy {\n      max-width: 660px;\n      margin: 0 0 28px;\n      color: #495a55;\n      font-size: clamp(1.05rem, 2vw, 1.25rem);\n    }\n\n    .button-row {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 12px;\n    }\n\n    .button {\n      display: inline-flex;\n      min-height: 48px;\n      align-items: center;\n      justify-content: center;\n      padding: 12px 22px;\n      border: 2px solid transparent;\n      border-radius: 999px;\n      text-decoration: none;\n      font-weight: 900;\n      transition: transform 0.2s, background 0.2s, box-shadow 0.2s;\n    }\n\n    .button:hover,\n    .button:focus {\n      transform: translateY(-2px);\n      box-shadow: 0 8px 18px rgba(35, 72, 63, 0.18);\n    }\n\n    .button-primary {\n      color: var(--white);\n      background: var(--accent);\n    }\n\n    .button-primary:hover,\n    .button-primary:focus {\n      background: var(--accent-dark);\n    }\n\n    .button-secondary {\n      color: var(--primary);\n      background: var(--white);\n      border-color: var(--primary);\n    }\n\n    .hero-card {\n      padding: 30px;\n      color: var(--white);\n      background: var(--primary);\n      border-radius: 24px;\n      box-shadow: var(--shadow);\n    }\n\n    .hero-card h2 {\n      margin: 0 0 10px;\n      font-size: 1.7rem;\n    }\n\n    .hero-card p {\n      margin: 0 0 20px;\n      color: #deebe6;\n    }\n\n    .hero-card ul {\n      display: grid;\n      gap: 12px;\n      margin: 0;\n      padding: 0;\n      list-style: none;\n    }\n\n    .hero-card li {\n      display: flex;\n      gap: 10px;\n      align-items: flex-start;\n    }\n\n    .hero-card li::before {\n      content: \"✓\";\n      color: #ffd7c7;\n      font-weight: 900;\n    }\n\n    .trust-bar {\n      background: var(--white);\n      border-bottom: 1px solid var(--border);\n    }\n\n    .trust-grid {\n      display: grid;\n      grid-template-columns: repeat(4, 1fr);\n    }\n\n    .trust-item {\n      padding: 24px 18px;\n      text-align: center;\n      border-right: 1px solid var(--border);\n    }\n\n    .trust-item:last-child {\n      border-right: 0;\n    }\n\n    .trust-item strong {\n      display: block;\n      color: var(--primary-dark);\n      font-size: 1rem;\n    }\n\n    .trust-item span {\n      color: var(--muted);\n      font-size: 0.9rem;\n    }\n\n    .section {\n      padding: clamp(56px, 8vw, 88px) 0;\n    }\n\n    .section-alt {\n      background: var(--cream);\n    }\n\n    .section-heading {\n      display: flex;\n      align-items: end;\n      justify-content: space-between;\n      gap: 24px;\n      margin-bottom: 28px;\n    }\n\n    .section-heading h2 {\n      margin: 0;\n      font-size: clamp(2rem, 4vw, 3rem);\n      line-height: 1.05;\n      letter-spacing: -0.035em;\n    }\n\n    .section-heading p {\n      max-width: 600px;\n      margin: 8px 0 0;\n      color: var(--muted);\n    }\n\n    .text-link {\n      color: var(--primary);\n      font-weight: 900;\n      white-space: nowrap;\n    }\n\n    .category-grid {\n      display: grid;\n      grid-template-columns: repeat(4, 1fr);\n      gap: 18px;\n    }\n\n    .category-card {\n      display: flex;\n      min-height: 230px;\n      flex-direction: column;\n      justify-content: flex-end;\n      padding: 26px;\n      overflow: hidden;\n      color: var(--white);\n      background: var(--primary);\n      border-radius: var(--radius);\n      text-decoration: none;\n      box-shadow: var(--shadow);\n      transition: transform 0.2s;\n    }\n\n    .category-card:nth-child(2) {\n      background: #716456;\n    }\n\n    .category-card:nth-child(3) {\n      background: #986044;\n    }\n\n    .category-card:nth-child(4) {\n      background: #536b76;\n    }\n\n    .category-card:hover,\n    .category-card:focus {\n      transform: translateY(-5px);\n    }\n\n    .category-card h3 {\n      margin: 0;\n      font-size: 1.6rem;\n    }\n\n    .category-card span {\n      margin-top: 5px;\n      color: rgba(255, 255, 255, 0.85);\n      font-weight: 700;\n    }\n\n    .product-grid {\n      display: grid;\n      grid-template-columns: repeat(4, 1fr);\n      gap: 20px;\n    }\n\n    .product-card {\n      position: relative;\n      display: flex;\n      min-width: 0;\n      flex-direction: column;\n      padding: 18px;\n      background: var(--white);\n      border: 1px solid var(--border);\n      border-radius: var(--radius);\n      box-shadow: 0 5px 18px rgba(31, 55, 48, 0.06);\n      transition: transform 0.2s, box-shadow 0.2s;\n    }\n\n    .product-card:hover {\n      transform: translateY(-4px);\n      box-shadow: var(--shadow);\n    }\n\n    .product-visual {\n      display: grid;\n      min-height: 180px;\n      place-items: center;\n      margin-bottom: 16px;\n      color: var(--primary);\n      background: linear-gradient(145deg, #edf3ef, #f8f3ec);\n      border-radius: 10px;\n      font-size: 3rem;\n    }\n\n    .badge-row {\n      display: flex;\n      min-height: 26px;\n      flex-wrap: wrap;\n      gap: 6px;\n      margin-bottom: 8px;\n    }\n\n    .badge {\n      display: inline-flex;\n      align-items: center;\n      padding: 4px 8px;\n      color: var(--success);\n      background: #e8f5ed;\n      border-radius: 999px;\n      font-size: 0.72rem;\n      font-weight: 900;\n      text-transform: uppercase;\n    }\n\n    .badge-sale {\n      color: var(--sale);\n      background: #fff0eb;\n    }\n\n    .badge-shipping {\n      color: #275a81;\n      background: #e9f4fb;\n    }\n\n    .product-card h3 {\n      min-height: 48px;\n      margin: 0 0 9px;\n      font-size: 1rem;\n      line-height: 1.4;\n    }\n\n    .product-card h3 a {\n      text-decoration: none;\n    }\n\n    .product-card h3 a:hover,\n    .product-card h3 a:focus {\n      color: var(--primary);\n      text-decoration: underline;\n    }\n\n    .rating {\n      min-height: 24px;\n      margin-bottom: 6px;\n      color: #b86715;\n      font-size: 0.88rem;\n    }\n\n    .price {\n      margin: auto 0 14px;\n      font-size: 1.18rem;\n      font-weight: 900;\n    }\n\n    .price del {\n      margin-right: 6px;\n      color: var(--muted);\n      font-size: 0.9rem;\n      font-weight: 500;\n    }\n\n    .sale-price {\n      color: var(--sale);\n    }\n\n    .card-actions {\n      display: grid;\n      grid-template-columns: 1fr auto;\n      gap: 8px;\n    }\n\n    .add-button,\n    .quick-link {\n      display: inline-flex;\n      min-height: 42px;\n      align-items: center;\n      justify-content: center;\n      border-radius: 8px;\n      text-decoration: none;\n      font-weight: 900;\n    }\n\n    .add-button {\n      padding: 9px 12px;\n      color: var(--white);\n      background: var(--accent);\n    }\n\n    .add-button:hover,\n    .add-button:focus {\n      background: var(--accent-dark);\n    }\n\n    .quick-link {\n      padding: 8px 11px;\n      color: var(--primary);\n      border: 1px solid var(--primary);\n      font-size: 0.86rem;\n   
 ul{list-style:none;display:flex;flex-wrap:wrap;gap:22px;margin:0;padding:12px 0;font-size:15px;font-weight:600}\\n  .hero{background:#f2f5f0;padding:44px 0}\\n  .hero h1{margin:0 0 10px;font-size:34px}\\n  .hero p{margin:0 0 18px;color:var(--muted);font-size:18px}\\n  .btn{display:inline-block;background:var(--accent);color:#fff;padding:14px 26px;border-radius:4px;font-weight:700;font-size:17px;border:0;cursor:pointer}\\n  .btn.secondary{background:var(--brand)}\\n  .trust{display:flex;gap:26px;flex-wrap:wrap;justify-content:center;padding:18px 0;font-size:14px;color:var(--muted);border-bottom:1px solid #eee}\\n  h2.section{font-size:24px;margin:36px 0 18px}\\n  .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:22px}\\n  .card{border:1px solid #eee;border-radius:6px;padding:14px;text-align:center}\\n  .card .ph{background:#f2f5f0;height:150px;border-radius:4px;margin-bottom:10px}\\n  .card h3{font-size:16px;margin:0 0 6px}\\n  .price{color:var(--brand-dark);font-weight:700;margin-bottom:10px}\\n  .about{background:#f7f7f5;margin-top:40px;padding:34px 0}\\n  .about p{max-width:900px;margin:0 auto;color:#444}\\n  footer{background:#2f2f2f;color:#ddd;margin-top:0;padding:34px 0;font-size:14px}\\n  footer a{color:#ddd}\\n  .fcols{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:24px}\\n  /* Email signup offer styles */\\n  .email-offer{background:var(--brand);color:#fff;padding:30px 0}\\n  .email-offer .inner{display:flex;align-items:center;gap:24px;flex-wrap:wrap;justify-content:space-between}\\n  .email-offer h2{margin:0 0 6px;font-size:26px}\\n  .email-offer p{margin:0;font-size:16px;opacity:.95}\\n  .email-offer form{display:flex;gap:10px;flex-wrap:wrap}\\n  .email-offer input[type=email]{padding:14px 14px;border:0;border-radius:4px;font-size:16px;min-width:260px}\\n  .email-offer .btn{background:var(--accent)}\\n  .email-offer small{display:block;margin-top:8px;font-size:12px;opacity:.85}\\n  .offer-strip{bac
e: 15px; font-weight: bold; color: #2a7d5f; }\\n    .trust-badges .badge svg { width: 28px; height: 28px; fill: #2a7d5f; }\\n    .featured { padding: 40px 24px; max-width: 1100px; margin: 0 auto; }\\n    .featured h2 { font-size: 28px; color: #2a7d5f; text-align: center; margin-bottom: 24px; }\\n    .featured p { font-size: 16px; line-height: 1.7; }\\n    .product-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 24px; margin-top: 24px; }\\n    .product-card { border: 1px solid #e5e5e5; border-radius: 6px; padding: 16px; text-align: center; }\\n    .product-card h3 { font-size: 17px; margin: 12px 0 8px; }\\n    .product-card .price { color: #2a7d5f; font-weight: bold; margin-bottom: 12px; }\\n    footer { background: #2a7d5f; color: #fff; text-align: center; padding: 24px; font-size: 14px; margin-top: 40px; }\\n    footer a { color: #d8efe5; margin: 0 8px; text-decoration: none; }\\n  </style>\\n</head>\\n<body>\\n  <header>\\n    <a href=\\\"/\\\" class=\\\"logo\\\">YogaDirect</a>\\n    <nav>\\n      <a href=\\\"/yoga-mats\\\">Yoga Mats</a>\\n      <a href=\\\"/yoga-props\\\">Yoga Props</a>\\n      <a href=\\\"/yoga-bolsters\\\">Bolsters</a>\\n      <a href=\\\"/yoga-blocks\\\">Blocks</a>\\n      <a href=\\\"/wholesale\\\">Wholesale</a>\\n      <a href=\\\"/sale\\\">Sale</a>\\n      <a href=\\\"/cart\\\">Cart</a>\\n    </nav>\\n  </header>\\n\\n  <section class=\\\"hero\\\">\\n    <h1>High-Quality Yoga Gear at Amazing Prices</h1>\\n    <p>Faithfully supplying the yoga community since 1999.</p>\\n    <a href=\\\"/yoga-mats\\\" class=\\\"btn\\\">Shop Now</a>\\n  </section>\\n\\n  <section class=\\\"trust-badges HDLmClass4a7930eb\\\" aria-label=\\\"Why shop with confidence at YogaDirect\\\">\\n    <div class=\\\"badge\\\">\\n      <svg viewBox=\\\"0 0 24 24\\\" aria-hidden=\\\"true\\\"><path d=\\\"M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-1 14l-4-4 1.41-1.41L11 12.17l4.59-4.58L17 9l-6 6z\\\"/></svg>\\n     
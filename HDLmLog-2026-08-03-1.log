{"id":"gen-1785705281-S2tWmBjoq0rXBHtDmMAF","object":"chat.completion","created":1785705281,"model":"anthropic/claude-fable-5","provider":"Amazon Bedrock","system_fingerprint":null,"service_tier":"default","choices":[{"index":0,"logprobs":null,"finish_reason":"stop","native_finish_reason":"end_turn","message":{"role":"assistant","content":"{\"improvedHtml\": \"<!DOCTYPE html>\\n<html lang=\\\"en\\\">\\n<head>\\n<meta charset=\\\"utf-8\\\">\\n<meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1\\\">\\n<title>YogaDirect - Yoga Mats, Yoga Props, Yoga Supplies and Yoga Gear</title>\\n<meta name=\\\"description\\\" content=\\\"YogaDirect is one of the largest suppliers of yoga mats and props in the country, faithfully supplying the yoga community since 1999 with high-quality yoga gear at amazing prices.\\\">\\n<style>\\nbody { font-family: Arial, Helvetica, sans-serif; margin: 0; color: #333; }\\nheader { background: #fff; border-bottom: 1px solid #e5e5e5; padding: 15px 30px; display: flex; align-items: center; justify-content: space-between; }\\nheader .logo { font-size: 26px; font-weight: bold; color: #4a7c59; text-decoration: none; }\\nnav a { margin: 0 12px; color: #333; text-decoration: none; font-size: 15px; }\\nnav a:hover { color: #4a7c59; }\\n.hero { background: #f4f7f4; text-align: center; padding: 60px 20px; }\\n.hero h1 { font-size: 34px; margin: 0 0 10px; }\\n.hero p { font-size: 18px; color: #555; }\\n.hero .cta { display: inline-block; margin-top: 20px; background: #4a7c59; color: #fff; padding: 14px 32px; border-radius: 4px; text-decoration: none; font-size: 17px; }\\n.section { max-width: 1100px; margin: 0 auto; padding: 50px 20px; }\\n.section h2 { text-align: center; font-size: 28px; margin-bottom: 30px; }\\n.about-text { max-width: 800px; margin: 0 auto; font-size: 16px; line-height: 1.7; text-align: center; }\\n.testimonials { background: #f4f7f4; }\\n.testimonial-grid { display: flex; flex-wrap: wrap; gap: 24px; justify-content: center; }\\n.testimonial-card { background: #fff; border: 1px solid #e0e0e0; border-radius: 8px; padding: 24px; flex: 1 1 280px; max-width: 340px; box-shadow: 0 2px 6px rgba(0,0,0,0.06); }\\n.testimonial-card .stars { color: #f5a623; font-size: 20px; letter-spacing: 2px; margin-bottom: 12px; }\\n.testimonial-card blockquote { margin: 0 0 16px; font-size: 15px; line-height: 1.6; color: #444; font-style: italic; }\\n.testimonial-card .author { font-weight: bold; font-size: 14px; }\\n.testimonial-card .role { font-size: 13px; color: #777; }\\nfooter { background: #333; color: #ccc; text-align: center; padding: 30px 20px; font-size: 14px; }\\nfooter a { color: #ccc; margin: 0 10px; text-decoration: none; }\\n</style>\\n</head>\\n<body>\\n<header>\\n  <a href=\\\"/\\\" class=\\\"logo\\\">YogaDirect</a>\\n  <nav>\\n    <a href=\\\"/yoga-mats/\\\">Yoga Mats</a>\\n    <a href=\\\"/yoga-props/\\\">Yoga Props</a>\\n    <a href=\\\"/yoga-bolsters/\\\">Bolsters</a>\\n    <a href=\\\"/yoga-blocks/\\\">Blocks</a>\\n    <a href=\\\"/wholesale/\\\">Wholesale</a>\\n    <a href=\\\"/contact/\\\">Contact</a>\\n  </nav>\\n</header>\\n\\n<section class=\\\"hero\\\">\\n  <h1>High-Quality Yoga Gear at Amazing Prices</h1>\\n  <p>Faithfully supplying the yoga community since 1999.</p>\\n  <a href=\\\"/yoga-mats/\\\" class=\\\"cta\\\">Shop Now</a>\\n</section>\\n\\n<section class=\\\"section\\\">\\n  <h2>Featured Products</h2>\\n  <p class=\\\"about-text\\\">Thanks to our loyal customers, YogaDirect has become one of the largest suppliers of yoga mats and props in the country. We have been faithfully supplying the Yoga community since 1999 and are confident that we can help you grow your studio, event, or personal practice with everything you need and more. We manufacture and source our own goods which is how we can consistently offer high-quality yoga gear at amazing prices. When you shop at YogaDirect, feel proud in knowing that you are helping to grow not only your business or personal
{"id":"gen-1785685249-7qHYBjCcnW5ONIejMc3c","object":"chat.completion","created":1785685249,"model":"anthropic/claude-opus-5","provider":"Amazon Bedrock","system_fingerprint":null,"service_tier":"default","choices":[{"index":0,"logprobs":null,"finish_reason":"stop","native_finish_reason":"end_turn","message":{"role":"assistant","content":"{\"improvedHtml\":\"<!DOCTYPE html><html lang=\\\"en\\\"><head><meta charset=\\\"utf-8\\\"><meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1\\\"><title>YogaDirect | Yoga Mats, Props &amp; Wholesale Studio Supplies Since 1999</title><meta name=\\\"description\\\" content=\\\"YogaDirect is one of the largest suppliers of yoga mats and props in the country. Shop retail or request a free bulk/wholesale quote for your studio, gym, school or event.\\\"><style>:root{--ink:#1f2a37;--muted:#5b6672;--brand:#2e7d6f;--brand-dark:#255f55;--accent:#e8743b;--line:#e4e8ec;--bg:#fbfaf8}*{box-sizing:border-box}body{margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;color:var(--ink);background:#fff;line-height:1.55}a{color:inherit}.wrap{max-width:1140px;margin:0 auto;padding:0 20px}.topbar{background:var(--brand-dark);color:#fff;font-size:14px;text-align:center;padding:9px 12px}.topbar a{color:#fff;font-weight:700}header.site{border-bottom:1px solid var(--line);position:sticky;top:0;background:#fff;z-index:20}.headrow{display:flex;align-items:center;justify-content:space-between;gap:18px;padding:14px 0}.logo{font-size:24px;font-weight:800;letter-spacing:-.5px;text-decoration:none}.logo span{color:var(--brand)}nav.main{display:flex;gap:20px;flex-wrap:wrap;font-size:15px}nav.main a{text-decoration:none;color:var(--muted);font-weight:600}nav.main a:hover{color:var(--brand)}.headcta{display:flex;align-items:center;gap:14px;font-size:14px}.btn{display:inline-block;border-radius:6px;padding:13px 22px;font-weight:800;text-decoration:none;text-align:center;border:0;cursor:pointer;font-size:16px}.btn-primary{background:var(--accent);color:#fff}.btn-primary:hover{background:#cf5f2b}.btn-outline{background:#fff;color:var(--brand-dark);border:2px solid var(--brand)}.btn-sm{padding:9px 16px;font-size:14px}.hero{background:linear-gradient(180deg,#f3f8f6,#fff);padding:56px 0 44px}.hero h1{font-size:40px;line-height:1.15;margin:0 0 14px}.hero p{font-size:18px;color:var(--muted);max-width:620px;margin:0 0 24px}.hero-actions{display:flex;gap:14px;flex-wrap:wrap}.trust{display:flex;gap:26px;flex-wrap:wrap;padding:16px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line);font-size:14px;color:var(--muted);font-weight:600}section{padding:46px 0}h2.sec{font-size:28px;margin:0 0 6px}p.seclead{color:var(--muted);margin:0 0 26px}.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:20px}.card{border:1px solid var(--line);border-radius:10px;padding:16px;text-align:left;background:#fff}.thumb{background:#f0efec;border-radius:8px;height:150px;margin-bottom:12px}.card h3{font-size:16px;margin:0 0 6px}.price{font-weight:800;color:var(--brand-dark);margin:0 0 4px}.bulknote{font-size:13px;color:var(--muted);margin:0 0 12px}.bulk{background:var(--brand-dark);color:#fff}.bulk .inner{display:grid;grid-template-columns:1.05fr .95fr;gap:34px;align-items:start}.bulk h2{font-size:30px;margin:0 0 10px}.bulk p.lead{font-size:17px;opacity:.94;margin:0 0 18px}.bulk ul{list-style:none;padding:0;margin:0 0 18px}.bulk li{padding-left:26px;position:relative;margin-bottom:9px}.bulk li:before{content:'\\\\2713';position:absolute;left:0;color:#9fd8c9;font-weight:800}.promise{background:rgba(255,255,255,.12);border-radius:8px;padding:12px 14px;font-size:15px;font-weight:700}.callnow{margin-top:16px;font-size:15px}.callnow a{font-size:22px;font-weight:800;text-decoration:none;display:block;color:#fff}.quotebox{background:#fff;color:var(--ink);border-radius:12px;padding:22px}.quotebox h3{margin:0 0 4px;font-size:20px}.quotebox .sub{font-size:14px;color:v
er:1px solid var(--line);transition:.18s}\\n.cat:hover{transform:translateY(-3px);box-shadow:var(--shadow)}\\n.cat b{font-family:'Fraunces',serif;font-size:1.2rem}\\n.cat span{font-size:.86rem;color:var(--ink-soft)}\\n\\n/* Bulk */\\n.bulk{background:var(--brand);color:#fff}\\n.bulk-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:44px;align-items:center}\\n@media(max-width:900px){.bulk-grid{grid-template-columns:1fr;gap:30px}}\\n.bulk h2{color:#fff}\\n.bulk p{color:#d3e5df}\\n.bulk ul{list-style:none;padding:0;margin:0 0 24px}\\n.bulk li{padding:8px 0 8px 30px;position:relative;color:#eaf4f0}\\n.bulk li:before{content:\\\"✓\\\";position:absolute;left:0;color:var(--gold);font-weight:700}\\n.tiers{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:8px}\\n.tier{background:rgba(255,255,255,.10);border:1px solid rgba(255,255,255,.22);border-radius:10px;padding:10px 14px;font-size:.85rem}\\n.tier b{display:block;color:var(--gold);font-family:'Fraunces',serif;font-size:1.15rem}\\n.form-card{background:#fff;color:var(--ink);border-radius:var(--radius);padding:26px;box-shadow:var(--shadow-lg)}\\n.form-card h3{font-family:'Fraunces',serif;font-size:1.3rem;margin-bottom:4px}\\n.form-card .sub{font-size:.9rem;color:var(--ink-soft);margin-bottom:16px}\\nlabel{display:block;font-size:.83rem;font-weight:700;margin-bottom:5px}\\ninput,select,textarea{width:100%;padding:12px 14px;border:1px solid var(--line);border-radius:10px;font-family:inherit;font-size:.95rem;background:var(--cream);margin-bottom:12px}\\ninput:focus,select:focus,textarea:focus{outline:2px solid var(--brand);background:#fff}\\n.two{display:grid;grid-template-columns:1fr 1fr;gap:12px}\\n@media(max-width:480px){.two{grid-template-columns:1fr}}\\n.form-foot{font-size:.78rem;color:var(--ink-soft);margin:10px 0 0;text-align:center}\\n\\n/* Reviews */\\n.reviews{background:var(--cream)}\\n.rev{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:24px}\\n.rev p{font-size:.96rem}\\n.rev
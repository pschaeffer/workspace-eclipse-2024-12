-template-columns:repeat(4,1fr);gap:18px}.card{border:1px solid var(--line);border-radius:16px;background:#fff;display:flex;flex-direction:column;overflow:hidden;position:relative}.card:hover{box-shadow:0 14px 30px rgba(29,43,38,.1)}.badge{position:absolute;top:12px;left:12px;background:var(--terra);color:#fff;font-size:11px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;padding:4px 9px;border-radius:6px;z-index:2}.pimg{height:170px;display:flex;align-items:center;justify-content:center;font-size:46px}.pbody{padding:14px 16px 18px;display:flex;flex-direction:column;gap:6px;flex:1}.pbody h3{font-size:17px;margin:0}.stars{color:#e2a33a;letter-spacing:2px}.rev{font-size:12px;color:var(--ink2)}.pp{font-weight:800;font-size:19px}.pp s{font-weight:400;font-size:14px;color:var(--ink2);margin-left:6px}.bulkline{font-size:12px;color:var(--sage2);background:#e8f2ee;border-radius:6px;padding:4px 8px;font-weight:700;display:inline-block}.pbody .btn{margin-top:auto}section{padding:48px 0}.band{background:var(--sage2);color:#fff;border-radius:22px;padding:34px;display:grid;grid-template-columns:1.3fr .7fr;gap:24px;align-items:center}.band h2{color:#fff;margin:0}.faq{max-width:820px;margin:0 auto}details{border:1px solid var(--line);border-radius:12px;padding:16px 18px;margin-bottom:10px}details summary{font-weight:700;cursor:pointer}details p{margin:10px 0 0;color:var(--ink2)}footer{background:#16221e;color:#cfd8d4;padding:44px 0 26px;font-size:14px}footer h4{color:#fff;font-size:15px;font-family:inherit;letter-spacing:.04em;text-transform:uppercase}.fgrid{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:28px}.fgrid ul{list-style:none;padding:0;margin:0;display:grid;gap:8px}.pay{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px}.pay span{background:rgba(255,255,255,.1);border-radius:6px;padding:5px 9px;font-size:11px;font-weight:700}.fbot{border-top:1px solid rgba(255,255,255,.13);margin-top:28px;padding-top:16px;display:flex;justify-content:space-between
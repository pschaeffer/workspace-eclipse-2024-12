line);font-size:14px;font-weight:600;color:var(--muted)}\\n.trust div:last-child{border-right:0}\\n.trust b{display:block;color:var(--ink);font-size:15px}\\n/* cards */\\n.grid4{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}\\n.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}\\n.grid2{display:grid;grid-template-columns:1fr 1fr;gap:34px;align-items:center}\\n.card{background:#fff;border:1px solid var(--line);border-radius:14px;overflow:hidden;display:flex;flex-direction:column;transition:.15s}\\n.card:hover{box-shadow:0 12px 28px rgba(51,34,58,.11);transform:translateY(-2px)}\\n.thumb{height:170px;position:relative;display:flex;align-items:flex-end;justify-content:flex-start;padding:10px}\\n.tag{position:absolute;top:10px;left:10px;background:var(--accent);color:#fff;font-size:11px;font-weight:800;letter-spacing:.6px;text-transform:uppercase;padding:5px 9px;border-radius:6px}\\n.tag.g{background:#116b4e}\\n.tag.d{background:var(--plum)}\\n.cbody{padding:14px 15px 16px;display:flex;flex-direction:column;gap:6px;flex:1}\\n.cbody h3{font-size:16.5px;margin:0}\\n.rate{font-size:13px;color:#e6a417;font-weight:700}\\n.rate span{color:var(--muted);font-weight:600}\\n.cbody .pricerow{margin-top:auto}\\n.price.s{font-size:20px}\\n.cat{border-radius:14px;padding:22px;color:#fff;min-height:132px;display:flex;flex-direction:column;justify-content:flex-end;font-weight:700;border:0}\\n.cat small{display:block;font-weight:600;opacity:.85;font-size:13px}\\n/* bulk */\\n.bulk{background:linear-gradient(150deg,#33223a,#123f43);color:#fff}\\n.bulk h2{color:#fff}\\n.bulk .lead{color:#d9d1c6}\\n.bulk .ulist li:before{background:#ffb37a;color:#33223a}\\n.form{background:#fff;border-radius:16px;padding:24px;color:var(--ink);box-shadow:0 18px 40px rgba(0,0,0,.22)}\\n.form label{display:block;font-size:13px;font-weight:700;margin:12px 0 5px}\\n.form input,.form select,.form textarea{width:100%;padding:12px 13px;border:1px solid #d8cfc2;border-radius:8px;font-size:15px;font-family:inherit;background:#fdfcfa}\\n.form .row{display:flex;gap:12px}\\n.form .row>*{flex:1}\\n.tier{width:100%;border-collapse:collapse;font-size:15px;background:#fff;border-radius:12px;overflow:hidden}\\n.tier th,.tier td{padding:12px 14px;border-bottom:1px solid var(--line);text-align:left}\\n.tier th{background:var(--sand);font-size:13px;text-transform:uppercase;letter-spacing:.7px}\\n.tier td b{color:#116b4e}\\n/* testimonials */\\n.quote{background:#fff;border:1px solid var(--line);border-left:4px solid var(--accent);border-radius:12px;padding:20px}\\n.quote p{margin:8px 0 12px;font-size:15.5px}\\n.who{font-size:13px;color:var(--muted);font-weight:700}\\n/* email */\\n.email{background:var(--sand);border:1px dashed #d9c9b3;border-radius:16px;padding:30px;text-align:center}\\n.eform{display:flex;gap:10px;max-width:470px;margin:14px auto 8px}\\n.eform input{flex:1;padding:14px;border:1px solid #d8cfc2;border-radius:9px;font-size:15px}\\ndetails{background:#fff;border:1px solid var(--line);border-radius:10px;padding:14px 16px;margin-bottom:10px}\\ndetails summary{font-weight:700;cursor:pointer;font-size:16px}\\ndetails p{color:var(--muted);margin:10px 0 0}\\nfooter.site{background:var(--plum);color:#cfc6bd;padding:44px 0 26px;font-size:14.5px;margin-bottom:0}\\nfooter.site h4{color:#fff;font-size:14px;letter-spacing:1px;text-transform:uppercase;margin:0 0 12px}\\nfooter.site a:hover{color:#fff}\\n.fgrid{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:26px}\\n.fbot{border-top:1px solid rgba(255,255,255,.15);margin-top:26px;padding-top:16px;font-size:13px;display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}\\n/* cart drawer */\\n.drawer{position:fixed;top:0;right:0;height:100%;width:380px;max-width:92vw;background:#fff;z-index:90;box-shadow:-8px 0 40px rgba(0,0,0,.2);transform:translateX(105%);transition:.25s;display:flex;flex-direction:column}\\n.drawer.open{transform:none}\\n.dhead{padding:16px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;font-weight:800}\\n.dbody{padding:16px;overflow:auto;flex:1}\\n.dfoot{padding:16px;border-top:1px solid var(--line);background:var(--sand)}\\n.ship{background:#e7f3ee;border-radius:8px;padding:10px 12px;font-size:13px;font-weight:700;color:#116b4e;margin-bottom:12px}\\n.pbar{height:6px;background:#cfe4da;border-radius:6px;margin-top:7px;overflow:hidden}\\n.pbar i{display:block;height:100%;background:#159168;width:0}\\n.li{display:flex;justify-content:space-between;gap:10px;padding:10px 0;border-bottom:1px solid var(--line);font-size:14.5px}\\n.li button{background:none;border:0;color:var(--muted);cursor:pointer;font-size:12px;text-decoration:underline}\\n.scrim{position:fixed;inset:0;background:rgba(30,20,25,.45);z-index:80;display:none}\\n.scrim.open{display:block}\\n.close{background:none;border:0;font-size:22px;cursor:pointer;line-height:1;color:var(--muted)}\\n.toast{position:fixed;bottom:22px;left:50%;transform:translateX(-50%) translateY(140%);background:var(--plum);color:#fff;padding:13px 20px;border-radius:30px;font-weight:700;font-size:14px;z-index:120;transition:.25s}\\n.toast.on{transform:translateX(-50%)}\\n.modal{position:fixed;inset:0;background:rgba(30,20,25,.55);z-index:130;display:none;align-items:center;justify-content:center;padding:20px}\\n.modal.on{display:flex}\\n.mbox{background:#fff;border-radius:16px;max-width:430px;width:100%;padding:28px;text-align:center;position:relative}\\n.mbox .close{position:absolute;top:10px;right:14px}\\n.stickycta{position:fixed;bottom:0;left:0;right:0;background:#fff;border-top:1px solid var(--line);padding:10px 12px;display:none;gap:10px;z-index:70;box-shadow:0 -6px 20px rgba(0,0,0,.08)}\\n.stickycta .btn{flex:1;padding:13px 10px;font-size:15px}\\n@media(max-width:960px){nav.main{display:none}.hgrid,.grid2{grid-template-columns:1fr;gap:26px;padding:34px 0}h1{font-size:34px}h2{font-size:26px}.grid4{grid-template-columns:1fr 1fr}.grid3{grid-template-columns:1fr}.trust{grid-template-columns:1fr 1fr}.trust div:nth-child(2){border-right:0}.fgrid{grid-template-columns:1fr 1fr}.phone{display:none}.stickycta{display:flex}body{padding-bottom:66px}.sec{padding:40px 0}}\\n@media(max-width:520px){.eform{flex-direction:column}.grid4{gap:12px}.thumb{height:132px}}\\n</style>\\n</head>\\n<body>\\n<div class='bar'>🚚 <b>FREE shipping on orders over $75</b> &nbsp;·&nbsp; Studios &amp; events: <a href='/wholesale.html' style='text-decoration:underline'><b>save up to 40% with bulk pricing</b></a> &nbsp;·&nbsp; 60-day returns</div>\\n\\n<header class='site'>\\n  <div class='wrap hrow'>\\n    <a href='/index.html' class='logo'>Yoga<span>Direct</span></a>\\n    <nav class='main'>\\n      <a href='/shop.html'>Yoga Mats</a>\\n      <a href='/shop.html#props'>Blocks &amp; Props</a>\\n      <a href='/shop.html#kits'>Studio Kits</a>\\n      <a href='/wholesale.html'>Wholesale &amp; Bulk</a>\\n      <a href='/contact.html'>Help</a>\\n    </nav>\\n    <div class='hact'>\\n      <div class='phone'>Talk to a real yogi<b>1-800-555-9642</b></div>\\n      <button class='cartbtn' onclick='openCart()'>🛒 Cart<span class='cbadge' id='cbadge'>0</span></button>\\n    </div>\\n  </div>\\n</header>\\n\\n<section class='hero'>\\n  <div class='wrap hgrid'>\\n    <div>\\n      <p class='stars'>★★★★★ <span>4.8/5 from 9,400+ reviews · Trusted by 12,000+ studios since 1999</span></p>\\n      <h1>Yoga mats &amp; props direct from the maker — for a fraction of studio-brand prices.</h1>\\n      <p class='lead'>We manufacture and source our own gear, so you get pro-quality mats, blocks, straps and bolsters without the middleman markup. One mat or five hundred — we ship it today.</p>\\n      <ul class='ulist'>\\n        <li>Free shipping on orders over $75</li>\\n        <li>Bulk pricing for studios, schools, gyms &amp; events</li>\\n        <li>60-day no-hassle returns — try it on the mat</li>\\n        <li>Orders placed by 2pm ET ship same day</li>\\n      </ul>\\n      <div class='ctas'>\\n        <a class='btn' href='#bestsellers'>Shop best sellers</a>\\n        <a class='btn gh' href='/wholesale.html'>Get a bulk quote in 1 hour</a>\\n      </div>\\n      <p class='microcopy'>🔒 Secure checkout · Ships from Ohio, USA · Family-run since 1999</p>\\n    </div>\\n    <div class='heroart'>\\n      <span class='pill'>#1 Best seller</span>\\n      <div class='matart'></div>\\n      <h3 style='margin-top:4px'>Deluxe 1/4\\\" Yoga Mat — 68\\\" x 24\\\"</h3>\\n      <p class='rate' style='margin:0 0 8px'>★★★★★ <span>4.8 (1,204 reviews)</span></p>\\n      <div class='pricerow'><span class='price'>$21.99</span><span class='was'>$29.99</span><span class='save'>Save 27%</span></div>\\n      <p style='font-size:13px;color:var(--muted);margin:8px 0 12px'>Extra-cushioned, non-slip, latex-free. 12 colors. <b>In stock — 4,800 sold this month.</b></p>\\n      <button class='btn full' onclick='add(\\\"Deluxe 1/4in Yoga Mat\\\",21.99)'>Add to cart · $21.99</button>\\n      <p class='microcopy center' style='margin-top:10px'>Buy 10+ and pricing drops to $14.75/mat automatically.</p>\\n    </div>\\n  </div>\\n</section>\\n\\n<div class='trust'>\\n  <div><b>25+ years</b> Serving the yoga community</div>\\n  <div><b>2M+ mats</b> Shipped worldwide</div>\\n  <div><b>Same-day</b> Dispatch before 2pm ET</div>\\n  <div><b>60 days</b> Free returns &amp; exchanges</div>\\n</div>\\n\\n<section class='sec' id='bestsellers'>\\n  <div class='wrap'>\\n    <div class='center'>\\n      <p class='eyebrow'>Shop the essentials</p>\\n      <h2>Our best sellers — loved by studios and living rooms alike</h2>\\n      <p class='lead'>Every product is tested by our own teachers before it earns a spot in the catalog.</p>\\n    </div>\\n    <div class='grid4' style='margin-top:26px'>\\n      <div class='card'>\\n        <div class='thumb' style='background:linear-gradient(135deg,#0f6b6b,#3fa39b)'><span class='tag'>Best seller</span></div>\\n        <div class='cbody'>\\n          <h3>Deluxe 1/4\\\" Yoga Mat</h3>\\n          <p class='rate'>★★★★★ <span>(1,204)</span></p>\\n          <div class='pricerow'><span class='price s'>$21.99</span><span class='was'>$29.99</span></div>\\n          <button class='btn full sm' onclick='add(\\\"Deluxe 1/4in Yoga Mat\\\",21.99)'>Add to cart</button>\\n        </div>\\n      </div>\\n      <div class='card'>\\n        <div class='thumb' style='background:linear-gradient(135deg,#b9793f,#e0b07a)'><span class='tag g'>Eco pick</span></div>\\n        <div class='cbody'>\\n          <h3>Natural Cork Yoga Block</h3>\\n          <p class='rate'>★★★★★ <span>(842)</span></p>\\n          <div class='pricerow'><span class='price s'>$13.49</span><span class='was'>$18.00</span></div>\\n          <button class='btn full sm' onclick='add(\\\"Natural Cork Yoga Block\\\",13.49)'>Add to cart</button>\\n        </div>\\n      </div>\\n      <div class='card'>\\n        <div class='thumb' style='background:linear-gradient(135deg,#7a5aa3,#b39ad1)'><span class='tag d'>Studio staple</span></div>\\n        <div class='cbody'>\\n          <h3>8ft Cotton Strap + D-Ring</h3>\\n          <p class='rate'>★★★★☆ <span>(611)</span></p>\\n          <div class='pricerow'><span class='price s'>$8.99</span><span class='was'>$12.00</span></div>\\n          <button class='btn full sm' onclick='add(\\\"8ft Cotton Yoga Strap\\\",8.99)'>Add to cart</button>\\n        </div>\\n      </div>\\n      <div class='card'>\\n        <div class='thumb' style='background:linear-gradient(135deg,#c4552f,#e79a6d)'><span class='tag'>Restorative</span></div>\\n        <div class='cbody'>\\n          <h3>Round Cotton Bolster</h3>\\n          <p class='rate'>★★★★★ <span>(407)</span></p>\\n          <div class='pricerow'><span class='price s'>$39.99</span><span class='was'>$52.00</span></div>\\n          <button class='btn full sm' onclick='add(\\\"Round Cotton Bolster\\\",39.99)'>Add to cart</button>\\n        </div>\\n      </div>\\n    </div>\\n    <p class='center' style='margin-top:26px'><a class='btn gh' href='/shop.html'>Browse all 240+ products</a></p>\\n  </div>\\n</section>\\n\\n<section class='sec alt' id='kits'>\\n  <div class='wrap grid2'>\\n    <div>\\n      <p class='eyebrow'>Save more, buy together</p>\\n      <h2>Complete kits: everything you need, one price</h2>\\n      <p class='lead'>Bundles are the fastest way to lower your per-item cost. Kits ship in one box and are always cheaper than buying pieces separately.</p>\\n      <ul class='ulist'>\\n        <li>Home Practice Kit — mat, 2 blocks, strap: <b>$41.99</b> (save $19)</li>\\n        <li>Restorative Kit — bolster, blanket, 2 blocks, eye pillow: <b>$74.99</b> (save $28)</li>\\n        <li>Studio Starter — 10 mats, 20 blocks, 10 straps: <b>$429</b> (save $186)</li>\\n      </ul>\\n      <div class='ctas'>\\n        <button class='btn' onclick='add(\\\"Home Practice Kit\\\",41.99)'>Add Home Kit · $41.99</button>\\n        <a class='btn gh' href='/shop.html#kits'>Compare all kits</a>\\n      </div>\\n    </div>\\n    <div class='grid2' style='gap:14px;grid-template-columns:1fr 1fr;padding:0'>\\n      <a href='/shop.html' class='cat' style='background:linear-gradient(150deg,#0f6b6b,#38918c)'>Yoga Mats<small>1/8\\\" to 1/2\\\" · 14 colors</small></a>\\n      <a href='/shop.html#props' class='cat' style='background:linear-gradient(150deg,#33223a,#6c4a76)'>Blocks &amp; Bricks<small>Foam, cork &amp; bamboo</small></a>\\n      <a href='/shop.html#props' class='cat' style='background:linear-gradient(150deg,#b9793f,#dfae76)'>Bolsters &amp; Blankets<small>Restorative comfort</small></a>\\n      <a href='/wholesale.html' class='cat' style='background:linear-gradient(150deg,#c4501f,#e88b53)'>Studio Bulk Packs<small>Save up to 40%</small></a>\\n    </div>\\n  </div>\\n</section>\\n\\n<section class='sec bulk' id='bulk'>\\n  <div class='wrap grid2'>\\n    <div>\\n      <p class='eyebrow' style='color:#ffb37a'>For studios, gyms, schools &amp; events</p>\\n      <h2>Outfitting a studio? Get a custom quote within 1 business hour.</h2>\\n      <p class='lead'>Since 1999 we've equipped over 12,000 studios, retreats, hotels and school districts. Tell us what you need and a real human — not a bot — sends pricing, freight cost and lead times the same day.</p>\\n      <ul class='ulist'>\\n        <li>Tiered discounts from 10 units, up to 40% off</li>\\n        <li>Net-30 terms for schools &amp; municipalities</li>\\n        <li>Free logo printing on orders of 50+ mats</li>\\n        <li>Dedicated account manager &amp; reorder history</li>\\n      </ul>\\n      <table class='tier'>\\n        <tr><th>Quantity</th><th>Price / mat</th><th>You save</th></tr>\\n        <tr><td>1–9</td><td>$21.99</td><td>—</td></tr>\\n        <tr><td>10–49</td><td>$14.75</td><td><b>33%</b></td></tr>\\n        <tr><td>50–199</td><td>$12.90</td><td><b>41%</b></td></tr>\\n        <tr><td>200+</td><td>Call for pricing</td><td><b>Best</b></td></tr>\\n      </table>\\n    </div>\\n    <div class='form'>\\n      <h3>Request bulk pricing</h3>\\n      <p style='font-size:14px;color:var(--muted);margin:0'>Average reply time today: <b>38 minutes</b>. No obligation.</p>\\n      <form onsubmit='return leadSent(this)'>\\n        <div class='row'><div><label>Name</label><input required placeholder='Jane Patel'></div><div><label>Business / studio</label><input placeholder='Lotus Yoga Co.'></div></div>\\n        <div class='row'><div><label>Email</label><input type='email' required placeholder='jane@studio.com'></div><div><label>Phone (optional)</label><input placeholder='(555) 012-3456'></div></div>\\n        <label>What do you need?</label>\\n        <select><option>10–49 mats / props</option><option>50–199 mats / props</option><option>200+ units</option><option>Full studio fit-out</option><option>Event or retreat giveaway</option></select>\\n        <label>Notes (colors, deadline, logo printing)</label>\\n        <textarea rows='3' placeholder='30 purple mats by Nov 12, logo printed'></textarea>\\n        <button class='btn full' style='margin-top:16px'>Send my quote request →</button>\\n        <p class='microcopy center'>We never share your details. Prefer to talk? Call 1-800-555-9642.</p>\\n      </form>\\n      <div id='leadok' style='display:none;text-align:center;padding:22px 0'>\\n        <h3>✅ Request received!</h3>\\n        <p style='color:var(--muted)'>A YogaDirect account manager will email your quote shortly. Check your inbox for a confirmation.</p>\\n      </div>\\n    </div>\\n  </div>\\n</section>\\n\\n<section class='sec'>\\n  <div class='wrap'>\\n    <div class='center'><p class='eyebrow'>Why 12,000+ studios reorder</p><h2>Real reviews from real practices</h2></div>\\n    <div class='grid3' style='margin-top:24px'>\\n      <div class='quote'><p class='rate'>★★★★★</p><p>\\\"We replaced 40 mats for less than we used to spend on 15. Two years later they still look great and my students constantly ask where we got them.\\\"</p><p class='who'>— Marisa T., studio owner, Austin TX</p></div>\\n      <div class='quote'><p class='rate'>★★★★★</p><p>\\\"Ordered Friday, delivered Monday for our retreat of 60 people. The bulk team even matched our brand color. Total lifesavers.\\\"</p><p class='who'>— Devon R., retreat organizer, Asheville NC</p></div>\\n      <div class='quote'><p class='rate'>★★★★★</p><p>\\\"I've bought from YogaDirect since 2011 for my school's PE program. Prices are unbeatable and the props hold up to teenagers.\\\"</p><p class='who'>— Karen L., PE teacher, Columbus OH</p></div>\\n    </div>\\n  </div>\\n</section>\\n\\n<section class='sec alt'>\\n  <div class='wrap grid2'>\\n    <div>\\n      <p class='eyebrow'>Our story</p>\\n      <h2>Direct from a team of yoga lovers — since 1999</h2>\\n      <p style='color:var(--muted);font-size:16.5px'>Thanks to our loyal customers, YogaDirect has become one of the largest suppliers of yoga mats and props in the country. We've faithfully supplied the yoga community since 1999 and we're confident we can help you grow your studio, event or personal practice with everything you need and more.</p>\\n      <p style='color:var(--muted);font-size:16.5px'>Because we manufacture and source our own goods, we consistently offer high-quality yoga gear at amazing prices. When you shop with us, you're helping grow not just your practice, but the yoga community as a whole. From our team of yoga lovers to you — thank you.</p>\\n      <a class='btn teal' href='/shop.html'>Start shopping</a>\\n    </div>\\n    <div>\\n      <div class='email'>\\n        <p class='eyebrow'>New customer?</p>\\n        <h3 style='font-size:24px'>Get 10% off your first order</h3>\\n        <p style='color:var(--muted);margin:6px 0 0'>Join 60,000 practitioners for early access to sales, new colors and studio-owner tips.</p>\\n        <form class='eform' onsubmit='return subscribe(this)'>\\n          <input type='email' required placeholder='you@email.com'>\\n          <button class='btn'>Get my 10%</button>\\n        </form>\\n        <p class='microcopy' id='submsg'>One email a week, unsubscribe anytime.</p>\\n      </div>\\n    </div>\\n  </div>\\n</section>\\n\\n<section class='sec'>\\n  <div class='wrap' style='max-width:820px'>\\n    <div class='center'><p class='eyebrow'>Before you buy</p><h2>Questions, answered</h2></div>\\n    <div style='margin-top:22px'>\\n      <details open><summary>How fast will my order arrive?</summary><p>Orders placed before 2pm ET ship the same business day from our Ohio warehouse. Most US addresses receive delivery in 2–5 business days. Bulk freight orders typically ship within 1–3 business days.</p></details>\\n      <details><summary>What does shipping cost?</summary><p>Free standard shipping on orders over $75. Under $75, flat-rate shipping starts at $6.95. Bulk and freight quotes always include exact shipping before you commit.</p></details>\\n      <details><summary>What if I don't like the mat?</summary><p>Return any unused item within 60 days for a full refund or exchange — no restocking fees. If a product fails in normal use, we replace it.</p></details>\\n      <details><summary>Do you offer discounts for studios and schools?</summary><p>Yes. Bulk pricing starts at 10 units and reaches up to 40% off. Schools and government buyers can request Net-30 terms and purchase orders. <a href='/wholesale.html' style='color:var(--accent);font-weight:700'>Request a quote →</a></p></details>\\n      <details><summary>Can you print our studio logo on mats?</summary><p>Absolutely — logo printing is free on orders of 50+ mats, with a wide range of colors. Send your artwork with your quote request and we'll email a digital proof.</p></details>\\n    </div>\\n    <p class='center' style='margin-top:26px'><a class='btn' href='#bestsellers'>Shop best sellers</a></p>\\n  </div>\\n</section>\\n\\n<footer class='site'>\\n  <div class='wrap'>\\n    <div class='fgrid'>\\n      <div>\\n        <div class='logo' style='color:#fff'>Yoga<span>Direct</span></div>\\n        <p>Supplying the yoga community with mats, props and studio equipment direct from the source since 1999.</p>\\n        <p><b style='color:#fff'>1-800-555-9642</b><br>Mon–Fri, 9am–6pm ET<br>help@yogadirect.com</p>\\n      </div>\\n      <div><h4>Shop</h4><p><a href='/shop.html'>Yoga mats</a><br><a href='/shop.html#props'>Blocks &amp; bricks</a><br><a href='/shop.html#props'>Straps &amp; belts</a><br><a href='/shop.html#props'>Bolsters &amp; blankets</a><br><a href='/shop.html#kits'>Kits &amp; bundles</a></p></div>\\n      <div><h4>Business</h4><p><a href='/wholesale.html'>Wholesale &amp; bulk</a><br><a href='/wholesale.html'>Studio fit-outs</a><br><a href='/wholesale.html'>Logo printing</a><br><a href='/wholesale.html'>Schools &amp; Net-30</a></p></div>\\n      <div><h4>Help</h4><p><a href='/contact.html'>Contact us</a><br><a href='/contact.html#shipping'>Shipping info</a><br><a href='/contact.html#returns'>60-day returns</a><br><a href='/index.html#bulk'>Request a quote</a></p></div>\\n    </div>\\n    <div class='fbot'><span>© 1999–2025 YogaDirect. All rights reserved.</span><span>Secure checkout · Visa · Mastercard · Amex · PayPal · Shop Pay</span></div>\\n  </div>\\n</footer>\\n\\n<div class='stickycta'><a class='btn' href='#bestsellers'>Shop best sellers</a><a class='btn gh' href='/wholesale.html'>Bulk quote</a></div>\\n\\n<div class='scrim' id='scrim' onclick='closeCart()'></div>\\n<aside class='drawer' id='drawer' aria-label='Cart'>\\n  <div class='dhead'><span>Your cart</span><button class='close' onclick='closeCart()'>×</button></div>\\n  <div class='dbody'>\\n    <div class='ship' id='ship'></div>\\n    <div id='items'></div>\\n    <p id='empty' style='color:var(--muted);font-size:14px'>Your cart is empty. Our <a href='#bestsellers' onclick='closeCart()' style='color:var(--accent);font-weight:700'>best-selling mat</a> is a great place to start.</p>\\n  </div>\\n  <div class='dfoot'>\\n    <div class='pricerow' style='justify-content:space-between;margin-bottom:12px'><span style='font-weight:700'>Subtotal</span><span class='price s' id='subtotal'>$0.00</span></div>\\n    <button class='btn full' onclick='checkout()'>Secure checkout →</button>\\n    <p class='microcopy center'>🔒 SSL encrypted · 60-day returns · Ships today</p>\\n  </div>\\n</aside>\\n\\n<div class='toast' id='toast'></div>\\n\\n<div class='modal' id='modal'>\\n  <div class='mbox'>\\n    <button class='close' onclick='closeModal()'>×</button>\\n    <p class='eyebrow'>Welcome to YogaDirect</p>\\n    <h3 style='font-size:26px'>Take 10% off your first order</h3>\\n    <p style='color:var(--muted)'>Plus free shipping over $75. Enter your email and we'll send your code instantly.</p>\\n    <form class='eform' style='flex-direction:column;max-width:none' onsubmit='return subscribe(this,true)'>\\n      <input type='email' required placeholder='you@email.com'>\\n      <button class='btn full'>Send my 10% code</button>\\n    </form>\\n    <p class='microcopy'><a href='#' onclick='closeModal();return false' style='text-decoration:underline'>No thanks, I'll pay full price</a></p>\\n  </div>\\n</div>\\n\\n<script>\\nvar FREE=75;\\nvar cart=[];try{cart=JSON.parse(localStorage.getItem(\\\"ydcart\\\")||\\\"[]\\\")}catch(e){cart=[]}\\nfunction save(){try{localStorage.setItem(\\\"ydcart\\\",JSON.stringify(cart))}catch(e){}render()}\\nfunction add(n,p){cart.push({n:n,p:p});save();toast(n+\\\" added to cart\\\");openCart()}\\nfunction rm(i){cart.splice(i,1);save()}\\nfunction render(){\\n  var t=0,h=\\\"\\\";\\n  for(var i=0;i<cart.length;i++){t+=cart[i].p;h+=\\\"<div class='li'><span>\\\"+cart[i].n+\\\"<br><button onclick='rm(\\\"+i+\\\")'>Remove</button></span><b>$\\\"+cart[i].p.toFixed(2)+\\\"</b></div>\\\"}\\n  var it=document.getElementById(\\\"items\\\");if(it)it.innerHTML=h;\\n  var em=document.getElementById(\\\"empty\\\");if(em)em.style.display=cart.length?\\\"none\\\":\\\"block\\\";\\n  var st=document.getElementById(\\\"subtotal\\\");if(st)st.textContent=\\\"$\\\"+t.toFixed(2);\\n  var cb=document.getElementById(\\\"cbadge\\\");if(cb)cb.textContent=cart.length;\\n  var s=document.getElementById(\\\"ship\\\");\\n  if(s){var pct=Math.min(100,t/FREE*100);s.innerHTML=(t>=FREE?\\\"🎉 You've unlocked FREE shipping!\\\":\\\"Add $\\\"+(FREE-t).toFixed(2)+\\\" more for FREE shipping\\\")+\\\"<span class='pbar'><i style='width:\\\"+pct+\\\"%'></i></span>\\\"}\\n}\\nfunction openCart(){document.getElementById(\\\"drawer\\\").classList.add(\\\"open\\\");document.getElementById(\\\"scrim\\\").classList.add(\\\"open\\\")}\\nfunction closeCart(){document.getElementById(\\\"drawer\\\").classList.remove(\\\"open\\\");document.getElementById(\\\"scrim\\\").classList.remove(\\\"open\\\")}\\nfunction checkout(){if(!cart.length){toast(\\\"Add an item first 🙂\\\");return}toast(\\\"Taking you to secure checkout…\\\")}\\nvar tt;function toast(m){var e=document.getElementById(\\\"toast\\\");e.textContent=m;e.classList.add(\\\"on\\\");clearTimeout(tt);tt=setTimeout(function(){e.classList.remove(\\\"on\\\")},2600)}\\nfunction subscribe(f,modal){f.innerHTML=\\\"<p style='font-weight:700;color:#116b4e;margin:0'>✅ Check your inbox — code YOGA10 is on its way!</p>\\\";if(modal){setTimeout(closeModal,2200)}try{localStorage.setItem(\\\"ydsub\\\",\\\"1\\\")}catch(e){}return false}\\nfunction leadSent(f){f.style.display=\\\"none\\\";document.getElementById(\\\"leadok\\\").style.display=\\\"block\\\";return false}\\nfunction closeModal(){document.getElementById(\\\"modal\\\").classList.remove(\\\"on\\\");try{localStorage.setItem(\\\"ydsub\\\",\\\"1\\\")}catch(e){}}\\nrender();\\nsetTimeout(function(){var seen=\\\"1\\\";try{seen=localStorage.getItem(\\\"ydsub\\\")}catch(e){}if(!seen){document.getElementById(\\\"modal\\\").classList.add(\\\"on\\\")}},14000);\\n</script>\\n</body>\\n</html>\"},{\"path\":\"/shop.html\",\"html\":\"<!DOCTYPE html>\\n<html lang='en'>\\n<head>\\n<meta charset='utf-8'>\\n<meta name='viewport' content='width=device-width, initial-scale=1'>\\n<title>Shop Yoga Mats, Blocks, Straps &amp; Studio Kits | YogaDirect</title>\\n<meta name='description' content='Shop 240+ yoga mats, blocks, straps, bolsters, blankets and studio kits direct from the manufacturer. Free shipping over $75, bulk discounts from 10 units, 60-day returns.'>\\n<style>\\n:root{--ink:#20272e;--plum:#33223a;--teal:#0f6b6b;--sand:#faf6f0;--accent:#e2622f;--accent-d:#c4501f;--line:#e8dfd3;--muted:#6b6257}\\n*{box-sizing:border-box}html{scroll-behavior:smooth}\\nbody{margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;color:var(--ink);background:#fff;line-height:1.55}\\na{color:inherit;text-decoration:none}\\n.wrap{max-width:1180px;margin:0 auto;padding:0 20px}\\n.bar{background:var(--plum);color:#fff;font-size:13.5px;text-align:center;padding:9px 14px}\\n.bar b{color:#ffd7a8}\\nheader.site{position:sticky;top:0;z-index:60;background:#fff;border-bottom:1px solid var(--line);box-shadow:0 2px 14px rgba(0,0,0,.05)}\\n.hrow{display:flex;align-items:center;gap:16px;padding:12px 0}\\n.logo{font-weight:800;font-size:23px;letter-spacing:-.6px;color:var(--teal);white-space:nowrap}\\n.logo span{color:var(--accent)}\\nnav.main{display:flex;gap:20px;font-weight:600;font-size:15px;flex:1}\\nnav.main a:hover{color:var(--accent)}\\n.hact{display:flex;align-items:center;gap:12px}\\n.phone{font-size:13px;font-weight:600;color:var(--muted);text-align:right;line-height:1.25}\\n.phone b{display:block;color:var(--teal);font-size:15px}\\n.cartbtn{position:relative;background:var(--sand);border:1px solid var(--line);border-radius:8px;padding:10px 14px;font-weight:700;cursor:pointer;font-size:14px}\\n.cbadge{position:absolute;top:-8px;right:-8px;background:var(--accent);color:#fff;border-radius:20px;min-width:20px;height:20px;font-size:12px;font-weight:700;display:flex;align-items:center;justify-content:center;padding:0 5px}\\n.btn{display:inline-block;background:var(--accent);color:#fff;font-weight:700;padding:15px 26px;border-radius:9px;border:0;cursor:pointer;font-size:16px;text-align:center;transition:.15s;box-shadow:0 4px 14px rgba(226,98,47,.25)}\\n.btn:hover{background:var(--accent-d)}\\n.btn.gh{background:#fff;color:var(--plum);border:2px solid var(--plum);box-shadow:none}\\n.btn.gh:hover{background:var(--plum);color:#fff}\\n.btn.sm{padding:11px 16px;font-size:14px;box-shadow:none}\\n.btn.full{display:block;width:100%}\\nh1{font-size:38px;letter-spacing:-1.1px;margin:0 0 8px}\\nh2{font-size:27px;letter-spacing:-.7px;margin:0 0 6px}\\nh3{font-size:18px;margin:0 0 6px}\\n.lead{font-size:17px;color:var(--muted);max-width:62ch;margin:0}\\n.sec{padding:44px 0}\\n.sec.alt{background:var(--sand)}\\n.eyebrow{font-size:13px;font-weight:800;letter-spacing:1.4px;text-transform:uppercase;color:var(--accent);margin:0 0 6px}\\n.head{background:linear-gradient(160deg,#fdf8f2,#f2ebe0);border-bottom:1px solid var(--line);padding:34px 0}\\n.trust{display:grid;grid-template-columns:repeat(4,1fr);border-bottom:1px solid var(--line)}\\n.trust div{padding:14px;text-align:center;border-right:1px solid var(--line);font-size:13.5px;font-weight:600;color:var(--muted)}\\n.trust div:last-child{border-right:0}\\n.trust b{color:var(--ink)}\\n.filters{display:flex;gap:10px;flex-wrap:wrap;margin:0 0 22px}\\n.chip{border:1px solid var(--line);background:#fff;border-radius:30px;padding:9px 16px;font-size:14px;font-weight:700;cursor:pointer}\\n.chip.on{background:var(--plum);color:#fff;border-color:var(--plum)}\\n.grid4{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}\\n.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}\\n.card{background:#fff;border:1px solid var(--line);border-radius:14px;overflow:hidden;display:flex;flex-direction:column;transition:.15s}\\n.card:hover{box-shadow:0 12px 28px rgba(51,34,58,.11);transform:translateY(-2px)}\\n.thumb{height:165px;position:relative}\\n.tag{position:absolute;top:10px;left:10px;background:var(--accent);color:#fff;font-size:11px;font-weight:800;letter-spacing:.6px;text-transform:uppercase;padding:5px 9px;border-radius:6px}\\n.tag.g{background:#116b4e}.tag.d{background:var(--plum)}\\n.cbody{padding:14px 15px 16px;display:flex;flex-direction:column;gap:6px;flex:1}\\n.cbody h3{font-size:16.5px;margin:0}\\n.rate{font-size:13px;color:#e6a417;font-weight:700;margin:0}\\n.rate span{color:var(--muted);font-weight:600}\\n.pricerow{display:flex;align-items:baseline;gap:9px;margin-top:auto}\\n.price{font-size:20px;font-weight:800}\\n.was{color:var(--muted);text-decoration:line-through;font-size:14.5px}\\n.bulkline{font-size:12.5px;color:#116b4e;font-weight:700;margin:0}\\n.kit{background:#fff;border:2px solid var(--line);border-radius:16px;padding:22px;display:flex;flex-direction:column}\\n.kit.best{border-color:var(--accent);position:relative}\\n.kit.best:before{content:'Most popular';position:absolute;top:-13px;left:22px;background:var(--accent);color:#fff;font-size:11.5px;font-weight:800;letter-spacing:.7px;text-transform:uppercase;padding:5px 11px;border-radius:20px}\\n.kit ul{list-style:none;padding:0;margin:12px 0 18px;font-size:15px}\\n.kit li{padding:5px 0 5px 24px;position:relative}\\n.kit li:before{content:'✓';position:absolute;left:0;color:var(--teal);font-weight:800}\\n.kit .p{font-size:30px;font-weight:800;letter-spacing:-1px}\\nfooter.site{background:var(--plum);color:#cfc6bd;padding:44px 0 26px;font-size:14.5px}\\nfooter.site h4{color:#fff;font-size:14px;letter-spacing:1px;text-transform:uppercase;margin:0 0 12px}\\nfooter.site a:hover{color:#fff}\\n.fgrid{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:26px}\\n.fbot{border-top:1px solid rgba(255,255,255,.15);margin-top:26px;padding-top:16px;font-size:13px;display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}\\n.drawer{position:fixed;top:0;right:0;height:100%;width:380px;max-width:92vw;background:#fff;z-index:90;box-shadow:-8px 0 40px rgba(0,0,0,.2);transform:translateX(105%);transition:.25s;display:flex;flex-direction:column}\\n.drawer.open{transform:none}\\n.dhead{padding:16px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;font-weight:800}\\n.dbody{padding:16px;overflow:auto;flex:1}\\n.dfoot{padding:16px;border-top:1px solid var(--line);background:var(--sand)}\\n.ship{background:#e7f3ee;border-radius:8px;padding:10px 12px;font-size:13px;font-weight:700;color:#116b4e;margin-bottom:12px}\\n.pbar{height:6px;background:#cfe4da;border-radius:6px;margin-top:7px;overflow:hidden;display:block}\\n.pbar i{display:block;height:100%;background:#159168;width:0}\\n.li{display:flex;justify-content:space-between;gap:10px;padding:10px 0;border-bottom:1px solid var(--line);font-size:14.5px}\\n.li button{background:none;border:0;color:var(--muted);cursor:pointer;font-size:12px;text-decoration:underline}\\n.scrim{position:fixed;inset:0;background:rgba(30,20,25,.45);z-index:80;display:none}\\n.scrim.open{display:block}\\n.close{background:none;border:0;font-size:22px;cursor:pointer;line-height:1;color:var(--muted)}\\n.toast{position:fixed;bottom:22px;left:50%;transform:translateX(-50%) translateY(140%);background:var(--plum);color:#fff;padding:13px 20px;border-radius:30px;font-weight:700;font-size:14px;z-index:120;transition:.25s}\\n.toast.on{transform:translateX(-50%)}\\n.microcopy{font-size:13px;color:var(--muted)}\\n.center{text-align:center}\\n.stickycta{position:fixed;bottom:0;left:0;right:0;background:#fff;border-top:1px solid var(--line);padding:10px 12px;display:none;gap:10px;z-index:70;box-shadow:0 -6px 20px rgba(0,0,0,.08)}\\n.stickycta .btn{flex:1;padding:13px 10px;font-size:15px}\\n@media(max-width:960px){nav.main{display:none}.grid4{grid-template-columns:1fr 1fr}.grid3{grid-template-columns:1fr}.trust{grid-template-columns:1fr 1fr}.fgrid{grid-template-columns:1fr 1fr}.phone{display:none}h1{font-size:29px}.stickycta{display:flex}body{padding-bottom:66px}}\\n</style>\\n</head>\\n<body>\\n<div class='bar'>🚚 <b>FREE shipping over $75</b> &nbsp;·&nbsp; <b>Bulk discounts from just 10 units</b> &nbsp;·&nbsp; Ships same day before 2pm ET</div>\\n<header class='site'>\\n  <div class='wrap hrow'>\\n    <a href='/index.html' class='logo'>Yoga<span>Direct</span></a>\\n    <nav class='main'>\\n      <a href='/shop.html'>Yoga Mats</a>\\n      <a href='/shop.html#props'>Blocks &amp; Props</a>\\n      <a href='/shop.html#kits'>Studio Kits</a>\\n      <a href='/wholesale.html'>Wholesale &amp; Bulk</a>\\n      <a href='/contact.html'>Help</a>\\n    </nav>\\n    <div class='hact'>\\n      <div class='phone'>Talk to a real yogi<b>1-800-555-9642</b></div>\\n      <button class='cartbtn' onclick='openCart()'>🛒 Cart<span class='cbadge' id='cbadge'>0</span></button>\\n    </div>\\n  </div>\\n</header>\\n\\n<div class='head'>\\n  <div class='wrap'>\\n    <p class='eyebrow'>240+ products · direct from the manufacturer</p>\\n    <h1>Shop yoga mats, props &amp; studio equipment</h1>\\n    <p class='lead'>Everything below is made or sourced by us, tested by our own teachers, and priced without the middleman. Buying 10 or more? Bulk pricing applies automatically at checkout.</p>\\n  </div>\\n</div>\\n<div class='trust'>\\n  <div><b>★ 4.8/5</b> · 9,400+ reviews</div>\\n  <div><b>Free shipping</b> over $75</div>\\n  <div><b>60-day</b> free returns</div>\\n  <div><b>Since 1999</b> · 12,000+ studios</div>\\n</div>\\n\\n<section class='sec'>\\n  <div class='wrap'>\\n    <div class='filters'>\\n      <span class='chip on'>All products</span>\\n      <a class='chip' href='#mats'>Mats</a>\\n      <a class='chip' href='#props'>Blocks &amp; props</a>\\n      <a class='chip' href='#props'>Bolsters &amp; blankets</a>\\n      <a class='chip' href='#kits'>Kits &amp; bundles</a>\\n      <a class='chip' href='/wholesale.html'>Bulk / wholesale</a>\\n    </div>\\n    <h2 id='mats'>Yoga mats</h2>\\n    <p class='lead' style='margin-bottom:20px'>From featherweight travel mats to 1/2\\\" therapeutic cushioning — all latex-free and phthalate-free.</p>\\n    <div class='grid4'>\\n      <div class='card'><div class='thumb' style='background:linear-gradient(135deg,#0f6b6b,#3fa39b)'><span class='tag'>Best seller</span></div>\\n        <div class='cbody'><h3>Deluxe 1/4\\\" Yoga Mat</h3><p class='rate'>★★★★★ <span>(1,204)</span></p><p class='microcopy'>68\\\" x 24\\\" · 12 colors · extra grip</p><div class='pricerow'><span class='price'>$21.99</span><span class='was'>$29.99</span></div><p class='bulkline'>10+ → $14.75 each</p><button class='btn full sm' onclick='add(\\\"Deluxe 1/4in Yoga Mat\\\",21.99)'>Add to cart</button></div></div>\\n      <div class='card'><div class='thumb' style='background:linear-gradient(135deg,#215d8a,#5f9dc4)'><span class='tag d'>Extra long</span></div>\\n        <div class='cbody'><h3>XL 72\\\" Studio Mat</h3><p class='rate'>★★★★★ <span>(596)</span></p><p class='microcopy'>72\\\" x 26\\\" · great for tall practices</p><div class='pricerow'><span class='price'>$27.99</span><span class='was'>$36.00</span></div><p class='bulkline'>10+ → $19.40 each</p><button class='btn full sm' onclick='add(\\\"XL 72in Studio Mat\\\",27.99)'>Add to cart</button></div></div>\\n      <div class='card'><div class='thumb' style='background:linear-gradient(135deg,#8a5330,#c08a5d)'><span class='tag g'>Eco</span></div>\\n        <div class='cbody'><h3>Natural Jute Eco Mat</h3><p class='rate'>★★★★☆ <span>(318)</span></p><p class='microcopy'>Jute + PER blend · non-toxic</p><div class='pricerow'><span class='price'>$34.99</span><span class='was'>$45.00</span></div><p class='bulkline'>10+ → $25.90 each</p><button class='btn full sm' onclick='add(\\\"Natural Jute Eco Mat\\\",34.99)'>Add to cart</button></div></div>\\n      <div class='card'><div class='thumb' style='background:linear-gradient(135deg,#5b4a7d,#9585b8)'></div>\\n        <div class='cbody'><h3>Travel Mat 1/16\\\"</h3><p class='rate'>★★★★☆ <span>(211)</span></p><p class='microcopy'>Folds flat · 2.2 lb</p><div class='pricerow'><span class='price'>$18.99</span><span class='was'>$24.00</span></div><p class='bulkline'>10+ → $13.25 each</p><button class='btn full sm' onclick='add(\\\"Travel Mat 1/16in\\\",18.99)'>Add to cart</button></div></div>\\n    </div>\\n\\n    <h2 id='props' style='margin-top:44px'>Blocks, straps, bolsters &amp; blankets</h2>\\n    <p class='lead' style='margin-bottom:20px'>Studio-grade props built to survive hundreds of classes a year.</p>\\n    <div class='grid4'>\\n      <div class='card'><div class='thumb' style='background:linear-gradient(135deg,#b9793f,#e0b07a)'><span class='tag g'>Eco pick</span></div>\\n        <div class='cbody'><h3>Natural Cork Block</h3><p class='rate'>★★★★★ <span>(842)</span></p><div class='pricerow'><span class='price'>$13.49</span><span class='was'>$18.00</span></div><p class='bulkline'>20+ → $9.20 each</p><button class='btn full sm' onclick='add(\\\"Natural Cork Yoga Block\\\",13.49)'>Add to cart</button></div></div>\\n      <div class='card'><div
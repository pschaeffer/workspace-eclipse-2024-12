)}function t(m){var x=document.getElementById('toast');x.innerHTML=m;x.classList.add('on');setTimeout(function(){x.classList.remove('on')},2600)}function leadSent(e){e.preventDefault();e.target.innerHTML='<h3>Thanks &mdash; request received.</h3><p>A member of our wholesale team will email your quote within one business day. Need it sooner? Reply to our confirmation email and we will prioritize it.</p>'}function subbed(e){e.preventDefault();t('Check your inbox for code WELCOME10');try{localStorage.setItem('yd_sub','1')}catch(x){}}document.getElementById('burger').onclick=function(){document.getElementById('nav').classList.toggle('open')};function closeM(){document.getElementById('modal').classList.remove('on');try{localStorage.setItem('yd_modal','1')}catch(x){}}var shown=false;function openM(){try{if(localStorage.getItem('yd_modal')||localStorage.getItem('yd_sub'))return}catch(x){}if(shown)return;shown=true;document.getElementById('modal').classList.add('on')}setTimeout(openM,20000);document.addEventListener('mouseout',function(e){if(e.clientY<8)openM()});function cdt(){var n=new Date(),e=new Date(n.getFullYear(),n.getMonth(),n.getDate()+1,0,0,0),s=Math.floor((e-n)/1000),h=Math.floor(s/3600),m=Math.floor(s%3600/60),x=s%60;document.getElementById('cd').textContent='Today\\\\u2019s deals end in '+h+'h '+m+'m '+x+'s';setTimeout(cdt,1000)}cdt();</script><script type='application/ld+json'>{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"Store\\\",\\\"name\\\":\\\"YogaDirect\\\",\\\"url\\\":\\\"https://www.yogadirect.com/\\\",\\\"description\\\":\\\"Supplier of yoga mats and props since 1999. Retail and wholesale.\\\",\\\"foundingDate\\\":\\\"1999\\\"}</script><script type='application/ld+json'>{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"FAQPage\\\",\\\"mainEntity\\\":[{\\\"@type\\\":\\\"Question\\\",\\\"name\\\":\\\"How fast will my order ship?\\\",\\\"acceptedAnswer\\\":{\\\"@type\\\":\\\"Answer\\\",\\\"text\\\":\\\"In-stock orders leave our US warehouse in 1-2 business days.\\\"}},{\\\"@type\\\":\\\"Question\\\",\\\"name\\\":\\\"When is shipping free?\\\",\\\"acceptedAnswer\\\":{\\\"@type\\\":\\\"Answer\\\",\\\"text\\\":\\\"Standard shipping is free on retail orders over $75 and freight is free on 100+ unit bulk orders in the contiguous US.\\\"}},{\\\"@type\\\":\\\"Question\\\",\\\"name\\\":\\\"Is there a minimum for wholesale pricing?\\\",\\\"acceptedAnswer\\\":{\\\"@type\\\":\\\"Answer\\\",\\\"text\\\":\\\"Discounts begin at 10 units of the same item with no membership fee and no annual minimum.\\\"}}]}</script></body></html>\"},{\"path\":\"/shop\",\"html\":\"<!DOCTYPE html><html lang='en'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><title>Shop Yoga Mats, Blocks, Straps &amp; Props | YogaDirect</title><meta name='description' content='Shop yoga mats from $19.95, blocks, straps, bolsters, blankets and studio bulk packs direct from the manufacturer. Free shipping over $75, bulk discounts up to 25%, 30-day returns.'><style>:root{--ink:#1d2b26;--ink2:#5a6b64;--sage:#2f6b5b;--sage2:#204d41;--cream:#faf7f1;--sand:#f1eadd;--terra:#d9744b;--line:#e6dfd2}*{box-sizing:border-box}body{margin:0;background:#fff;color:var(--ink);font:16px/1.6 -apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif}a{color:inherit;text-decoration:none}h1,h2,h3,h4{font-family:Georgia,'Times New Roman',serif;line-height:1.18;margin:0 0 .5em}h1{font-size:clamp(30px,4.4vw,44px)}h2{font-size:clamp(24px,3vw,34px)}h3{font-size:20px}.wrap{max-width:1180px;margin:0 auto;padding:0 20px}.promo{background:var(--sage2);color:#fff;text-align:center;font-size:14px;padding:9px 14px}.promo b{background:rgba(255,255,255,.17);padding:2px 8px;border-radius:6px;font-weight:700}header{position:sticky;top:0;z-index:60;background:#fff;border-bottom:1px solid var(--line)}.hdr{display:flex;align-items:center;gap:16px;padding:13px 0}.logo{font-family:Georgia,serif;font-size:24px;fo
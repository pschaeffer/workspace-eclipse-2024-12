ition:relative}\\n.mat{width:78%;height:38%;border-radius:12px;background:linear-gradient(100deg,#0f5c4d,#1c8570);margin-bottom:10%;box-shadow:0 12px 24px rgba(15,92,77,.28);position:relative}\\n.mat:after{content:\\\"\\\";position:absolute;inset:14% 8%;border:2px dashed rgba(255,255,255,.35);border-radius:6px}\\n.hero-card .body{padding:18px 20px}\\n.stars{color:var(--gold);letter-spacing:2px;font-size:1rem}\\n.pricerow{display:flex;align-items:baseline;gap:10px;margin-top:4px}\\n.price{font-size:1.35rem;font-weight:700}\\n.was{color:#8e9a95;text-decoration:line-through;font-size:.95rem}\\n.save{background:#fdecdf;color:var(--accent-dark);font-weight:700;font-size:.78rem;padding:3px 9px;border-radius:99px}\\n.float-note{position:absolute;left:-14px;bottom:26px;background:#fff;border:1px solid var(--line);border-radius:12px;box-shadow:var(--shadow);padding:12px 16px;font-size:.85rem;font-weight:600;max-width:210px}\\n.float-note small{display:block;font-weight:400;color:var(--ink-soft)}\\n@media(max-width:900px){.hero-grid{grid-template-columns:1fr;gap:32px;padding:40px 0}.float-note{display:none}}\\n\\n/* Trust strip */\\n.trust{background:var(--white);border-bottom:1px solid var(--line)}\\n.trust-in{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;padding:22px 0;text-align:center}\\n.trust-in div{font-size:.9rem;color:var(--ink-soft)}\\n.trust-in b{display:block;font-family:'Fraunces',serif;font-size:1.05rem;color:var(--ink)}\\n@media(max-width:760px){.trust-in{grid-template-columns:repeat(2,1fr)}}\\n\\nsection{padding:64px 0}\\nsection.tight{padding:46px 0}\\n.section-head{text-align:center;max-width:640px;margin:0 auto 34px}\\n.section-head p{color:var(--ink-soft);margin:0}\\n.head-row{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:26px;flex-wrap:wrap}\\n.head-row p{margin:0;color:var(--ink-soft)}\\n.link-arrow{color:var(--brand);font-weight:700;border-bottom:2px solid var(--brand);padding-bottom:2px}\\n\\n/* Prod
inherit}.qty span{width:38px;text-align:center;font-weight:700}.pr{font-weight:800;font-size:17px;text-align:right}.pr s{display:block;font-size:13px;color:#9aa5a1;font-weight:600}.side{background:#fff;border:1px solid var(--line);border-radius:20px;padding:22px;height:max-content;position:sticky;top:90px}.row{display:flex;justify-content:space-between;font-size:15px;margin-bottom:9px}.row.tot{font-size:20px;font-weight:800;border-top:1px solid var(--line);padding-top:12px;margin-top:12px}.code{display:flex;gap:8px;margin:12px 0}.code input{flex:1;padding:11px 14px;border:1px solid var(--line);border-radius:12px;font-size:14px;font-family:inherit}.ticks{list-style:none;padding:0;margin:14px 0 0;font-size:13.5px;font-weight:600;color:var(--mut)}.ticks li{padding-left:24px;position:relative;margin-bottom:6px}.ticks li:before{content:'✓';position:absolute;left:0;color:var(--g2);font-weight:800}.bump{background:#fff;border:1px dashed var(--g2);border-radius:18px;padding:16px;display:grid;grid-template-columns:64px 1fr auto;gap:14px;align-items:center;margin-bottom:12px}.bump h4{margin:0;font-size:15px}.note{font-size:12.5px;color:var(--mut)}.band{background:var(--g);color:#fff;border-radius:20px;padding:22px 26px;display:flex;justify-content:space-between;align-items:center;gap:18px;flex-wrap:wrap;margin-top:10px}.band h3{color:#fff;margin:0 0 4px}.band p{color:#d5e6e0;margin:0}footer{background:#12211d;color:#c9d5d0;padding:40px 0 22px;font-size:14.5px;margin-top:20px}footer a{color:#c9d5d0}.fbot{border-top:1px solid #24352f;margin-top:22px;padding-top:16px;font-size:13px;color:#8fa19b;display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap}.stars{color:#e8a33d}@media(max-width:900px){.layout{grid-template-columns:1fr}nav.main{display:none}.side{position:static}}</style></head><body><div class='abar'>You're <b id='away'>$15.15</b> away from free shipping &nbsp;•&nbsp; Order in the next 3 hours and it ships today</div><header class='hd'><div class='wrap hdin'
rid;grid-template-columns:1fr 1fr;gap:12px}.quote{background:#fff;border:1px solid var(--line);border-left:4px solid var(--g2);border-radius:14px;padding:20px;font-size:15px}.quote b{display:block;margin-top:10px;font-size:13.5px;color:var(--mut)}.faq{border-bottom:1px solid var(--line)}.faq summary{cursor:pointer;padding:16px 0;font-weight:700;font-size:16.5px;list-style:none;display:flex;justify-content:space-between;gap:20px}.faq summary::-webkit-details-marker{display:none}.faq summary:after{content:'+';color:var(--g2);font-weight:800}.faq[open] summary:after{content:'–'}.faq p{color:var(--mut);padding-bottom:8px;max-width:840px}footer{background:#12211d;color:#c9d5d0;padding:46px 0 26px;font-size:14.5px}footer a{color:#c9d5d0}footer a:hover{color:#fff}.fgrid{display:grid;grid-template-columns:1.5fr 1fr 1fr 1fr;gap:28px}footer h4{color:#fff;font-size:15px;margin:0 0 12px}footer ul{list-style:none;padding:0;margin:0}footer li{margin-bottom:8px}.fbot{border-top:1px solid #24352f;margin-top:28px;padding-top:18px;display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;font-size:13px;color:#8fa19b}.sticky{position:fixed;left:0;right:0;bottom:0;z-index:70;background:#fff;border-top:1px solid var(--line);padding:10px 16px;display:none;gap:12px;align-items:center;box-shadow:0 -8px 24px rgba(0,0,0,.08)}.modal{position:fixed;inset:0;background:rgba(18,33,29,.6);z-index:90;display:none;place-items:center;padding:20px}.modal.on{display:grid}.mbox{background:#fff;border-radius:22px;max-width:440px;padding:30px;position:relative;text-align:center}.mbox .x{position:absolute;top:8px;right:14px;font-size:24px;color:var(--mut);cursor:pointer;border:0;background:none}.note{font-size:12.5px;color:var(--mut)}@media(max-width:900px){h1{font-size:32px}h2{font-size:26px}.hgrid,.grid2,.qgrid{grid-template-columns:1fr}.grid4,.grid3,.fgrid{grid-template-columns:1fr 1fr}.trustin{grid-template-columns:1fr 1fr}nav.main,.srch{display:none}.sticky{display:flex}body{padding-bottom:72px}section{padding:40px 0}}</style></head><body><div class='abar'>Free shipping on orders $75+ &nbsp;•&nbsp; <b>Save 10%</b> on your first order with code <b>WELCOME10</b> &nbsp;•&nbsp; Serving 12,000+ studios since 1999</div><header class='hd'><div class='wrap hdin'><a class='logo' href='/'>Yoga<i>Direct</i><small>SINCE 1999</small></a><nav class='main'><a href='/collections/all#mats'>Yoga Mats</a><a href='/collections/all#props'>Blocks &amp; Props</a><a href='/collections/all#bolsters'>Bolsters</a><a href='/pages/wholesale'>Studio &amp; Bulk</a><a href='/collections/all#sale'>Sale</a></nav><div class='hdr'><input class='srch' placeholder='Search 500+ products' aria-label='Search'><a class='cart' href='/cart'>Cart · <span id='cc'>0</span></a></div></div></header><section class='hero'><div class='wrap hgrid'><div><span class='eyebrow'>★ Trusted by 12,000+ studios, schools &amp; retreats since 1999</span><h1>Studio-grade yoga mats &amp; props — straight from the source.</h1><p class='lead'>We manufacture and source our own goods, so you skip the middleman markup. Outfit your studio, your event or your own practice with everything you need — and nothing you don't.</p><ul class='ticks'><li>Manufacturer-direct pricing — save up to 40% vs. retail</li><li>Free shipping over $75 · same-day dispatch before 2pm ET</li><li>60-day no-risk returns and real humans on the phone</li></ul><div class='ctarow'><a class='btn' href='/collections/all'>Shop best sellers</a><a class='btn o' href='/pages/wholesale'>Get bulk pricing →</a></div><p class='micro'><span class='stars'>★★★★★</span> <b>4.8/5</b> from 9,300+ verified reviews · 2,000,000+ mats shipped</p></div><div><div class='hcard'><span class='pill'>Save $21.90 · Best value</span><div class='thumb' style='background:linear-gradient(135deg,#35606f,#79a8b1);border-radius:16px;margin-bottom:14px'><svg viewBox='0 0 120 90' aria-hidden='true'><rect x='10' y='30' width='70' height='30' rx='15' fill='#ffffff' opacity='.5'/><circle cx='27' cy='45' r='11' fill='#ffffff' opacity='.9'/><rect x='84' y='36' width='24' height='24' rx='5' fill='#ffffff' opacity='.55'/></svg></div><h3>Studio Starter Kit</h3><p style='color:var(--mut);font-size:14.5px'>6mm Pro Grip mat + 2 foam blocks + 8 ft cotton strap. Everything a new student needs, ready to practice today.</p><div class='price' style='font-size:24px'>$59.95 <s>$81.85</s></div><p class='bulk'>Teaching a class? 10+ kits ship at $47.95 each.</p><button class='btn full' data-add='Add kit to cart'>Add kit to cart</button><p class='note' style='text-align:center;margin:10px 0 0'>Ships today · Free shipping · 60-day returns</p></div></div></div></section><div class='trust'><div class='wrap trustin'><div><b>25+ years</b>Supplying the yoga community since 1999</div><div><b>2M+</b>Mats and props shipped</div><div><b>12,000+</b>Studios, gyms &amp; schools served</div><div><b>4.8/5</b>From 9,300+ verified reviews</div></div></div><section><div class='wrap'><div class='shead'><div><h2>This week's best sellers</h2><p>The gear studio owners reorder again and again — with volume pricing built in.</p></div><a class='btn o sm' href='/collections/all'>Shop all products</a></div><div class='grid4'><div class='card'><div class='thumb' style='background:linear-gradient(135deg,#2e6f7d,#63a0ab)'><span class='badge'>#1 Best seller</span><svg viewBox='0 0 120 90' aria-hidden='true'><rect x='12' y='30' width='96' height='34' rx='17' fill='#fff' opacity='.5'/><circle cx='30' cy='47' r='13' fill='#fff' opacity='.92'/></svg></div><div class='cbody'><h3><a href='/products/pro-grip-mat'>Pro Grip Yoga Mat · 6mm</a></h3><div class='rate'><span class='stars'>★★★★★</span> 4.8 (2,914)</div><div class='price'>$29.95 <s>$39.95</s></div><div class='bulk'>10+ from $24.95 ea</div><button class='btn sm full' data-add='Add to cart'>Add to cart</button></div></div><div class='card'><div class='thumb' style='background:linear-gradient(135deg,#7a6a4f,#b39c74)'><span class='badge g'>Eco pick</span><svg viewBox='0 0 120 90' aria-hidden='true'><rect x='12' y='30' width='96' height='34' rx='17' fill='#fff' opacity='.5'/><circle cx='30' cy='47' r='13' fill='#fff' opacity='.92'/></svg></div><div class='cbody'><h3>EcoGrip Natural Cork Mat</h3><div class='rate'><span class='stars'>★★★★★</span> 4.9 (612)</div><div class='price'>$69.95</div><div class='bulk'>10+ from $57.95 ea</div><button class='btn sm full' data-add='Add to cart'>Add to cart</button></div></div><div class='card'><div class='thumb' style='background:linear-gradient(135deg,#5f7a45,#93ab6f)'><span class='badge'>Save 24%</span><svg viewBox='0 0 120 90' aria-hidden='true'><rect x='16' y='34' width='40' height='30' rx='6' fill='#fff' opacity='.6'/><rect x='62' y='34' width='40' height='30' rx='6' fill='#fff' opacity='.38'/></svg></div><div class='cbody'><h3>Foam Yoga Block · 2-Pack</h3><div class='rate'><span class='stars'>★★★★★</span> 4.7 (1,830)</div><div class='price'>$18.95 <s>$24.95</s></div><div class='bulk'>20+ from $14.50 ea</div><button class='btn sm full' data-add='Add to cart'>Add to cart</button></div></div><div class='card'><div class='thumb' style='background:linear-gradient(135deg,#a9603f,#d19470)'><svg viewBox='0 0 120 90' aria-hidden='true'><path d='M18 46c20-20 62 20 84 0' stroke='#fff' stroke-width='10' fill='none' opacity='.6' stroke-linecap='round'/></svg></div><div class='cbody'><h3>Cotton Yoga Strap · 8 ft</h3><div class='rate'><span class='stars'>★★★★★</span> 4.8 (940)</div><div class='price'>$8.95</div><div class='bulk'>25+ from $6.25 ea</div><button class='btn sm full' data-add='Add to cart'>Add to cart</button></div></div><div class='card'><div class='thumb' style='background:linear-gradient(135deg,#5b5470,#8d85a6)'><span class='badge g'>Studio favorite</span><svg viewBox='0 0 120 90' aria-hidden='true'><rect x='16' y='32' width='88' height='30' rx='15' fill='#fff' opacity='.5'/><rect x='16' y='32' width='11' height='30' rx='5' fill='#fff' opacity='.8'/></svg></div><div class='cbody'><h3>Studio Rectangular Bolster</h3><div class='rate'><span class='stars'>★★★★★</span> 4.9 (521)</div><div class='price'>$54.95</div><div class='bulk'>10+ from $44.95 ea</div><button class='btn sm full' data-add='Add to cart'>Add to cart</button></div></div><div class='card'><div class='thumb' style='background:linear-gradient(135deg,#8a4a52,#c07d84)'><svg viewBox='0 0 120 90' aria-hidden='true'><rect x='22' y='28' width='76' height='38' rx='6' fill='#fff' opacity='.5'/><path d='M22 42h76M22 53h76' stroke='#fff' stroke-width='4' opacity='.5'/></svg></div><div class='cbody'><h3>Handwoven Yoga Blanket</h3><div class='rate'><span class='stars'>★★★★★</span> 4.7 (1,204)</div><div class='price'>$22.95</div><div class='bulk'>12+ from $18.50 ea</div><button class='btn sm full' data-add='Add to cart'>Add to cart</button></div></div><div class='card'><div class='thumb' style='background:linear-gradient(135deg,#3f7a68,#77b09d)'><span class='badge'>Save $15</span><svg viewBox='0 0 120 90' aria-hidden='true'><circle cx='60' cy='46' r='26' fill='none' stroke='#fff' stroke-width='10' opacity='.6'/></svg></div><div class='cbody'><h3>Cork Yoga Wheel · 12 in</h3><div class='rate'><span class='stars'>★★★★★</span> 4.8 (318)</div><div class='price'>$44.95 <s>$59.95</s></div><div class='bulk'>6+ from $38.95 ea</div><button class='btn sm full' data-add='Add to cart'>Add to cart</button></div></div><div class='card'><div class='thumb' style='background:linear-gradient(135deg,#35606f,#79a8b1)'><span class='badge'>Bundle · Save $22</span><svg viewBox='0 0 120 90' aria-hidden='true'><rect x='10' y='30' width='70' height='30' rx='15' fill='#fff' opacity='.5'/><rect x='84' y='36' width='24' height='24' rx='5' fill='#fff' opacity='.55'/></svg></div><div class='cbody'><h3>Studio Starter Kit</h3><div class='rate'><span class='stars'>★★★★★</span> 4.9 (1,102)</div><div class='price'>$59.95 <s>$81.85</s></div><div class='bulk'>10+ kits from $47.95 ea</div><button class='btn sm full' data-add='Add to cart'>Add to cart</button></div></div></div></div></section><section style='padding-top:0'><div class='wrap'><div class='shead'><div><h2>Shop by category</h2><p>500+ products in stock and ready to ship from our own warehouse.</p></div></div><div class='grid4'><a class='card' href='/collections/all#mats'><div class='thumb' style='background:linear-gradient(135deg,#2e6f7d,#63a0ab)'><svg viewBox='0 0 120 90' aria-hidden='true'><rect x='12' y='30' width='96' height='34' rx='17' fill='#fff' opacity='.5'/><circle cx='30' cy='47' r='13' fill='#fff' opacity='.9'/></svg></div><div class='cbody'><h3>Yoga Mats</h3><div class='rate'>PVC, TPE, cork, jute &amp; hot-yoga mats — 3mm to 10mm</div><div class='bulk'>From $19.95 →</div></div></a><a class='card' href='/collections/all#props'><div class='thumb' style='background:linear-gradient(135deg,#5f7a45,#93ab6f)'><svg viewBox='0 0 120 90' aria-hidden='true'><rect x='16' y='34' width='40' height='30' rx='6' fill='#fff' opacity='.6'/><rect x='62' y='34' width='40' height='30' rx='6' fill='#fff' opacity='.38'/></svg></div><div class='cbody'><h3>Blocks, Straps &amp; Wheels</h3><div class='rate'>Foam, cork and wood props for every level</div><div class='bulk'>From $6.25 →</div></div></a><a class='card' href='/collections/all#bolsters'><div class='thumb' style='background:linear-gradient(135deg,#5b5470,#8d85a6)'><svg viewBox='0 0 120 90' aria-hidden='true'><rect x='16' y='32' width='88' height='30' rx='15' fill='#fff' opacity='.5'/><rect x='16' y='32' width='11' height='30' rx='5' fill='#fff' opacity='.8'/></svg></div><div class='cbody'><h3>Bolsters &amp; Blankets</h3><div class='rate'>Restorative, prenatal and Yin essentials</div><div class='bulk'>From $18.50 →</div></div></a><a class='card' href='/pages/wholesale'><div class='thumb' style='background:linear-gradient(135deg,#14584a,#3f9a80)'><svg viewBox='0 0 120 90' aria-hidden='true'><rect x='18' y='22' width='84' height='46' rx='8' fill='#fff' opacity='.45'/><path d='M18 40h84' stroke='#fff' stroke-width='4' opacity='.7'/></svg></div><div class='cbody'><h3>Studio &amp; Bulk Orders</h3><div class='rate'>Tiered pricing, net terms and freight quotes</div><div class='bulk'>Request a quote →</div></div></a></div></div></section><div class='band'><div class='wrap qgrid'><div><h2>Outfitting a studio, school or event?</h2><p style='font-size:17px'>Tell us what you need and a real specialist emails your custom pricing within one business hour (Mon–Fri, 8–5 ET). No account or minimum order required to get a quote.</p><ul class='ticks' style='color:#fff'><li>Volume discounts from just 10 units</li><li>Net-30 terms for studios, schools &amp; municipalities</li><li>Custom logo printing on mats, blocks &amp; straps</li><li>Freight-shipped pallets with delivery scheduling</li></ul><div class='quote' style='max-width:520px'>“We re-mat all four of our rooms with YogaDirect every year. Same-day answers, better pricing than anyone we've quoted, and the mats survive 30 classes a week.”<b>— Marisa L., Owner, Riverbend Yoga (3 locations)</b></div></div><div><form class='form' data-fake data-ok='wsok'><h3 style='font-size:21px'>Get bulk pricing in 60 seconds</h3><p class='note'>Average studio saves 28% vs. retail.</p><div class='f2'><div><label for='n1'>Name</label><input id='n1' required placeholder='Alex Rivera'></div><div><label for='e1'>Work email</label><input id='e1' type='email' required placeholder='alex@studio.com'></div></div><label for='o1'>Studio / organization</label><input id='o1' placeholder='Riverbend Yoga'><div class='f2'><div><label for='p1'>What do you need?</label><select id='p1'><option>Yoga mats</option><option>Blocks &amp; props</option><option>Bolsters &amp; blankets</option><option>Full studio outfit</option><option>Custom logo printing</option></select></div><div><label for='q1'>Estimated quantity</label><select id='q1'><option>10–24</option><option>25–49</option><option>50–99</option><option>100+</option></select></div></div><button class='btn g full' style='margin-top:16px'>Send me my bulk quote</button><p class='note' style='text-align:center;margin:10px 0 0'>No obligation. We never share your details.</p></form><div class='form' id='wsok' style='display:none;text-align:center'><h3>Your quote request is in ✓</h3><p>A YogaDirect specialist will email your custom pricing within one business hour. Need it faster? Call <b>(800) 555-9642</b>.</p><a class='btn o' href='/collections/all'>Browse the catalog while you wait</a></div></div></div></div><section><div class='wrap'><div class='shead'><div><h2>Why 12,000+ studios buy direct from us</h2><p>Thanks to our loyal customers, YogaDirect is one of the largest suppliers of yoga mats and props in the country.</p></div></div><div class='grid3'><div class='quote'><h3 style='font-size:18px'>We make it, so you save on it</h3><p style='margin:0;color:var(--mut)'>We manufacture and source our own goods. That's how we consistently offer high-quality yoga gear at prices resellers can't match — no distributor markup, ever.</p></div><div class='quote'><h3 style='font-size:18px'>Faithfully serving yoga since 1999</h3><p style='margin:0;color:var(--mut)'>25+ years of shipping to studios, gyms, schools, hotels and homes. We know what holds up to 30 classes a week — and we stand behind it for 60 days.</p></div><div class='quote'><h3 style='font-size:18px'>Every order grows the community</h3><p style='margin:0;color:var(--mut)'>From our team of yoga lovers to you: when you shop here you're helping your practice, your business and the wider yoga community. Thank you.</p></div></div></div></section><section style='padding-top:0'><div class='wrap'><div class='shead'><div><h2>What customers say</h2><p><span class='stars'>★★★★★</span> 4.8 average from 9,300+ verified reviews</p></div></div><div class='grid3'><div class='quote'>“Ordered 40 mats on a Tuesday, they were on the floor by Friday. Grip is better than the brand we paid twice as much for.”<b>— Dev P., Studio Manager, Austin TX</b></div><div class='quote'>“I've bought three mats here over ten years. Same quality, same fair price, and the strap and blocks bundle saved me a fortune.”<b>— Karen S., home practitioner</b></div><div class='quote'>“The wholesale team quoted us in under an hour and handled the freight delivery for our teacher training. Effortless.”<b>— Naomi R., 200-hr TT program</b></div></div></div></section><section style='padding-top:0'><div class='wrap' style='max-width:900px'><h2 style='text-align:center'>Questions, answered</h2><details class='faq'><summary>How fast will my order ship?</summary><p>In-stock orders placed before 2pm ET ship the same business day from our own warehouse. Most US deliveries arrive in 2–5 business days, and every shipment includes tracking.</p></details><details class='faq'><summary>Is shipping really free?</summary><p>Yes — standard shipping is free on US orders over $75. Under $75, flat-rate shipping starts at $7.95. Large bulk orders ship by freight, and we quote the exact cost up front.</p></details><details class='faq'><summary>What if the mat isn't right for me?</summary><p>Try it for 60 days. If it isn't the right fit, contact us for a return or exchange — unused bulk orders included. Defects are replaced free, no questions asked.</p></details><details class='faq'><summary>Do you offer studio pricing or net terms?</summary><p>Absolutely. Volume discounts start at 10 units and reach up to 40% off retail. Studios, schools and government buyers can apply for Net-30 terms. <a href='/pages/wholesale' style='color:var(--g2);font-weight:700'>Request a quote →</a></p></details><details class='faq'><summary>Can you print our studio logo?</summary><p>Yes. We custom-print logos on mats, blocks, straps and towels with low minimums (typically 25 units) and 2–3 week turnaround. Ask for artwork specs in your quote request.</p></details><details class='faq'><summary>Which mat should I choose?</summary><p>6mm Pro Grip is our all-around best seller and studio workhorse. Choose cork or jute for eco-friendly grip, 3mm travel mats for portability, and 10mm for extra joint cushioning. Not sure? Call us — we'll match you in two minutes.</p></details></div></section><div class='band' style='background:#12211d'><div class='wrap' style='text-align:center;max-width:720px'><h2>Get 10% off your first order</h2><p>Join 40,000+ practitioners and studio owners for early access to warehouse deals, new product drops and practice tips.</p><form data-fake data-ok='nlok' style='display:flex;gap:10px;justify-content:center;flex-wrap:wrap'><input type='email' required placeholder='you@email.com' style='padding:15px 18px;border-radius:999px;border:0;font-size:16px;min-width:270px'><button class='btn'>Send my 10% code</button></form><div id='nlok' style='display:none;font-weight:700;color:#fff'>Check your inbox — your code <b style='color:#ffd6a6'>WELCOME10</b> is on its way ✓</div><p class='note' style='color:#8fa19b;margin-top:12px'>No spam, unsubscribe anytime.</p></div></div><footer><div class='wrap'><div class='fgrid'><div><a class='logo' style='color:#fff' href='/'>Yoga<i style='color:#7fc0ac'>Direct</i><small style='color:#8fa19b'>SINCE 1999</small></a><p style='margin-top:14px;max-width:320px'>One of the country's largest suppliers of yoga mats and props. We manufacture and source our own goods, so you get studio-grade gear at direct prices.</p><p><b style='color:#fff'>Talk to a human:</b><br>(800) 555-9642 · Mon–Fri 8–5 ET<br><a href='mailto:sales@yogadirect.com'>sales@yogadirect.com</a></p></div><div><h4>Shop</h4><ul><li><a href='/collections/all#mats'>Yoga mats</a></li><li><a href='/collections/all#props'>Blocks, straps &amp; wheels</a></li><li><a href='/collections/all#bolsters'>Bolsters &amp; blankets</a></li><li><a href='/collections/all#sale'>Clearance &amp; deals</a></li><li><a href='/products/pro-grip-mat'>Pro Grip Mat</a></li></ul></div><div><h4>Studio &amp; Bulk</h4><ul><li><a href='/pages/wholesale'>Request a
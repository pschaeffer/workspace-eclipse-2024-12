8px;display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap;font-size:.82rem}\\n.pay{display:flex;gap:8px;flex-wrap:wrap}\\n.pay span{background:#1c2c27;border-radius:6px;padding:4px 9px;font-size:.72rem;font-weight:700;color:#cfe3dc}\\n\\n/* Sticky mobile bar */\\n.mobar{position:fixed;left:0;right:0;bottom:0;z-index:70;background:#fff;border-top:1px solid var(--line);padding:10px 14px;display:none;gap:10px;box-shadow:0 -6px 20px rgba(0,0,0,.08)}\\n.mobar .btn{flex:1;padding:13px 10px;font-size:.93rem}\\n@media(max-width:768px){.mobar{display:flex}body{padding-bottom:74px}}\\n\\n/* Toast + modal */\\n.toast{position:fixed;bottom:20px;left:50%;transform:translate(-50%,140%);background:var(--brand);color:#fff;padding:13px 22px;border-radius:99px;font-weight:600;z-index:120;transition:.3s;box-shadow:var(--shadow-lg)}\\n.toast.show{transform:translate(-50%,0)}\\n@media(max-width:768px){.toast{bottom:86px}}\\n.modal{position:fixed;inset:0;background:rgba(16,30,26,.6);z-index:200;display:none;align-items:center;justify-content:center;padding:20px}\\n.modal.show{display:flex}\\n.modal-box{background:#fff;border-radius:18px;max-width:430px;width:100%;padding:32px 28px;text-align:center;position:relative;box-shadow:var(--shadow-lg)}\\n.modal-box h3{font-size:1.5rem}\\n.modal-box p{color:var(--ink-soft);font-size:.95rem}\\n.xclose{position:absolute;top:10px;right:14px;background:none;border:0;font-size:1.4rem;cursor:pointer;color:#98a5a0}\\n.tiny{font-size:.75rem;color:#8e9a95;margin:10px 0 0}\\n</style>\\n</head>\\n<body>\\n\\n<div class=\\\"announce\\\">🚚 <strong>FREE shipping on orders over $75</strong> &nbsp;•&nbsp; Studio &amp; bulk pricing from 6 units &nbsp;•&nbsp; <a href=\\\"#bulk\\\">Get a same-day quote</a></div>\\n\\n<header class=\\\"site\\\">\\n  <div class=\\\"wrap hrow\\\">\\n    <button class=\\\"burger\\\" aria-label=\\\"Menu\\\" onclick=\\\"document.getElementById('nav').classList.toggle('open')\\\">☰</button>\\n    <a class=\\\"logo\\\" href=\\\"/index.html\\\">Yoga<span>Direct</span></a>\\n    <nav class=\\\"main\\\" id=\\\"nav\\\">\\n      <a href=\\\"/shop.html\\\">Yoga Mats</a>\\n      <a href=\\\"/shop.html#props\\\">Props</a>\\n      <a href=\\\"/shop.html#bundles\\\">Studio Bundles</a>\\n      <a href=\\\"/bulk-orders.html\\\">Bulk &amp; Wholesale</a>\\n      <a href=\\\"/shop.html#sale\\\">Sale<span class=\\\"badge-sale\\\">Up to 40%</span></a>\\n    </nav>\\n    <div class=\\\"hactions\\\">\\n      <span class=\\\"hphone\\\">Talk to a human: <strong>1-800-598-9642</strong></span>\\n      <a class=\\\"cart\\\" href=\\\"/shop.html\\\">🛒 <span class=\\\"cart-count\\\" id=\\\"cc\\\">0</span></a>\\n    </div>\\n  </div>\\n</header>\\n\\n<!-- HERO -->\\n<div class=\\\"hero\\\">\\n  <div class=\\\"wrap hero-grid\\\">\\n    <div>\\n      <span class=\\\"eyebrow\\\">★ Manufacturer-direct since 1999</span>\\n      <h1>Yoga mats &amp; props at manufacturer-direct prices.</h1>\\n      <p class=\\\"lede\\\">We make and source our own gear, so studios, schools, hotels and home practitioners get pro-grade quality without the retail markup. Over 12,000 studios have equipped their rooms with YogaDirect.</p>\\n      <div class=\\\"hero-ctas\\\">\\n        <a class=\\\"btn btn-primary\\\" href=\\\"#bestsellers\\\">Shop Best Sellers</a>\\n        <a class=\\\"btn btn-ghost\\\" href=\\\"#bulk\\\">Get Bulk Pricing →</a>\\n      </div>\\n      <div class=\\\"microcopy\\\">\\n        <span><i class=\\\"tick\\\">✓</i> Free shipping over $75</span>\\n        <span><i class=\\\"tick\\\">✓</i> 30-day easy returns</span>\\n        <span><i class=\\\"tick\\\">✓</i> Ships in 1 business day</span>\\n      </div>\\n    </div>\\n    <div class=\\\"hero-visual\\\">\\n      <div class=\\\"hero-card\\\">\\n        <div class=\\\"ph\\\"><div class=\\\"mat\\\"></div></div>\\n        <div class=\\\"body\\\">\\n          <div class=\\\"stars\\\">★★★★★ <span style=\\\"color:var(--ink-soft);font-size:.85rem;letter-spacing:0\\\">4.8 · 2,114 reviews</span></div>\\n          <h3 style=\\\"margin:6px 0 0\\\">Deluxe 1/4\\\" Yoga Mat — Studio Favorite</h3>\\n          <div class=\\\"pricerow\\\"><span class=\\\"price\\\">$21.95</span><span class=\\\"was\\\">$32.95</span><span class=\\\"save\\\">Save 33%</span></div>\\n          <p style=\\\"font-size:.86rem;color:var(--ink-soft);margin:8px 0 12px\\\">6mm cushioning · 14 colors · bulk price drops to <b>$16.50</b> at 20+</p>\\n          <button class=\\\"btn btn-primary btn-block btn-sm\\\" data-add=\\\"Deluxe 1/4&quot; Yoga Mat\\\">Add to Cart</button>\\n        </div>\\n      </div>\\n      <div class=\\\"float-note\\\">🏆 #1 seller for 6 years<small>Chosen by 12,000+ studios</small></div>\\n    </div>\\n  </div>\\n</div>\\n\\n<div class=\\\"trust\\\">\\n  <div class=\\\"wrap trust-in\\\">\\n    <div><b>25+ years</b>Supplying yoga since 1999</div>\\n    <div><b>12,000+</b>Studios &amp; teachers served</div>\\n    <div><b>4.8/5</b>From 38,000+ reviews</div>\\n    <div><b>Direct pricing</b>We manufacture, you save</div>\\n  </div>\\n</div>\\n\\n<!-- BEST SELLERS -->\\n<section id=\\\"bestsellers\\\">\\n  <div class=\\\"wrap\\\">\\n    <div class=\\\"head-row\\\">\\n      <div>\\n        <h2>Best sellers, ready to ship today</h2>\\n        <p>Every item below qualifies for automatic bulk discounts at 6, 12 and 20+ units.</p>\\n      </div>\\n      <a class=\\\"link-arrow\\\" href=\\\"/shop.html\\\">Shop all 400+ products →</a>\\n    </div>\\n\\n    <div class=\\\"grid g4\\\">\\n      <div class=\\\"card\\\">\\n        <div class=\\\"thumb t1\\\"><span class=\\\"flag hot\\\">Best seller</span>🧘</div>\\n        <div class=\\\"card-body\\\">\\n          <h3>Deluxe 1/4\\\" Yoga Mat</h3>\\n          <div class=\\\"stars\\\">★★★★★ <span class=\\\"rate\\\">4.8 (2,114)</span></div>\\n          <p class=\\\"blurb\\\">6mm of joint-friendly cushion. 14 colors. Latex-free.</p>\\n          <div class=\\\"pricerow\\\"><span class=\\\"price\\\">$21.95</span><span class=\\\"was\\\">$32.95</span></div>\\n          <p class=\\\"bulknote\\\">From $16.50 at 20+ units</p>\\n          <p class=\\\"stock\\\">● In stock — ships in 1 business day</p>\\n          <button class=\\\"btn btn-primary btn-sm\\\" data-add=\\\"Deluxe 1/4&quot; Yoga Mat\\\">Add to Cart</button>\\n        </div>\\n      </div>\\n\\n      <div class=\\\"card\\\">\\n        <div class=\\\"thumb t2\\\"><span class=\\\"flag value\\\">Best value</span>🧱</div>\\n        <div class=\\\"card-body\\\">\\n          <h3>Foam Yoga Block (4\\\" x 6\\\" x 9\\\")</h3>\\n          <div class=\\\"stars\\\">★★★★★ <span class=\\\"rate\\\">4.9 (1,502)</span></div>\\n          <p class=\\\"blurb\\\">High-density, non-slip foam. Sold single or by the case.</p>\\n          <div class=\\\"pricerow\\\"><span class=\\\"price\\\">$6.95</span><span class=\\\"was\\\">$9.95</span></div>\\n          <p class=\\\"bulknote\\\">From $4.80 by the case of 24</p>\\n          <p class=\\\"stock\\\">● In stock — 3,400 units available</p>\\n          <button class=\\\"btn btn-primary btn-sm\\\" data-add=\\\"Foam Yoga Block\\\">Add to Cart</button>\\n        </div>\\n      </div>\\n\\n      <div class=\\\"card\\\">\\n        <div class=\\\"thumb t3\\\"><span class=\\\"flag\\\">Studio pick</span>🛋️</div>\\n        <div class=\\\"card-body\\\">\\n          <h3>Rectangular Cotton Bolster</h3>\\n          <div class=\\\"stars\\\">★★★★☆ <span class=\\\"rate\\\">4.7 (861)</span></div>\\n          <p class=\\\"blurb\\\">Firm cotton batting, removable washable cover.</p>\\n          <div class=\\\"pricerow\\\"><span class=\\\"price\\\">$44.95</span><span class=\\\"was\\\">$59.95</span></div>\\n          <p class=\\\"bulknote\\\">From $36.00 at 12+ units</p>\\n          <p class=\\\"stock low\\\">● Low stock — 41 left</p>\\n          <button class=\\\"btn btn-primary btn-sm\\\" data-add=\\\"Cotton Bolster\\\">Add to Cart</button>\\n        </div>\\n      </div>\\n\\n      <div class=\\\"card\\\">\\n        <div class=\\\"thumb t4\\\"><span class=\\\"flag\\\">Teacher favorite</span>🎗️</div>\\n        <div class=\\\"card-body\\\">\\n          <h3>8ft Cotton Yoga Strap (D-Ring)</h3>\\n          <div class=\\\"stars\\\">★★★★★ <span class=\\\"rate\\\">4.9 (1,188)</span></div>\\n          <p class=\\\"blurb\\\">Heavy cotton webbing, secure metal D-ring buckle.</p>\\n          <div class=\\\"pricerow\\\"><span class=\\\"price\\\">$7.95</span><span class=\\\"was\\\">$11.95</span></div>\\n          <p class=\\\"bulknote\\\">From $5.25 at 20+ units</p>\\n          <p class=\\\"stock\\\">● In stock — ships in 1 business day</p>\\n          <button class=\\\"btn btn-primary btn-sm\\\" data-add=\\\"8ft Cotton Yoga Strap\\\">Add to Cart</button>\\n        </div>\\n      </div>\\n\\n      <div class=\\\"card\\\">\\n        <div class=\\\"thumb t5\\\"><span class=\\\"flag\\\">New</span>🧺</div>\\n        <div class=\\\"card-body\\\">\\n          <h3>Mexican-Style Yoga Blanket</h3>\\n          <div class=\\\"stars\\\">★★★★★ <span class=\\\"rate\\\">4.8 (734)</span></div>\\n          <p class=\\\"blurb\\\">Thick woven blanket for restorative &amp; savasana.</p>\\n          <div class=\\\"pricerow\\\"><span class=\\\"price\\\">$18.95</span><span class=\\\"was\\\">$26.95</span></div>\\n          <p class=\\\"bulknote\\\">From $14.25 at 12+ units</p>\\n          <p class=\\\"stock\\\">● In stock</p>\\n          <button class=\\\"btn btn-primary btn-sm\\\" data-add=\\\"Yoga Blanket\\\">Add to Cart</button>\\n        </div>\\n      </div>\\n\\n      <div class=\\\"card\\\">\\n        <div class=\\\"thumb t6\\\"><span class=\\\"flag hot\\\">Bundle · save 25%</span>🎒</div>\\n        <div class=\\\"card-body\\\">\\n          <h3>Home Practice Starter Kit</h3>\\n          <div class=\\\"stars\\\">★★★★★ <span class=\\\"rate\\\">4.9 (612)</span></div>\\n          <p class=\\\"blurb\\\">Mat + 2 blocks + strap + carry sling. Everything in one box.</p>\\n          <div class=\\\"pricerow\\\"><span class=\\\"price\\\">$39.95</span><span class=\\\"was\\\">$53.75</span><span class=\\\"save\\\">Save 25%</span></div>\\n          <p class=\\\"bulknote\\\">Great gift — free gift note at checkout</p>\\n          <p class=\\\"stock\\\">● In stock</p>\\n          <button class=\\\"btn btn-primary btn-sm\\\" data-add=\\\"Home Practice Starter Kit\\\">Add to Cart</button>\\n        </div>\\n      </div>\\n\\n      <div class=\\\"card\\\">\\n        <div class=\\\"thumb t1\\\"><span class=\\\"flag value\\\">Studio kit</span>🏫</div>\\n        <div class=\\\"card-body\\\">\\n          <h3>20-Person Studio Outfitting Kit</h3>\\n          <div class=\\\"stars\\\">★★★★★ <span class=\\\"rate\\\">5.0 (128)</span></div>\\n          <p class=\\\"blurb\\\">20 mats, 40 blocks, 20 straps, 20 blankets — one purchase order.</p>\\n          <div class=\\\"pricerow\\\"><span class=\\\"price\\\">$1,149</span><span class=\\\"was\\\">$1,598</span><span class=\\\"save\\\">Save $449</span></div>\\n          <p class=\\\"bulknote\\\">Net-30 terms available for studios</p>\\n          <p class=\\\"stock\\\">● Freight quote in under 4 hours</p>\\n          <a class=\\\"btn btn-dark btn-sm\\\" href=\\\"#bulk\\\">Get My Quote</a>\\n        </div>\\n      </div>\\n\\n      <div class=\\\"card\\\">\\n        <div class=\\\"thumb t3\\\"><span class=\\\"flag\\\">Restorative</span>⭕</div>\\n        <div class=\\\"card-body\\\">\\n          <h3>Cork Yoga Wheel 12\\\"</h3>\\n          <div class=\\\"stars\\\">★★★★☆ <span class=\\\"rate\\\">4.6 (398)</span></div>\\n          <p class=\\\"blurb\\\">Natural cork over reinforced ABS core. 500 lb rated.</p>\\n          <div class=\\\"pricerow\\\"><span class=\\\"price\\\">$49.95</span><span class=\\\"was\\\">$69.95</span></div>\\n          <p class=\\\"bulknote\\\">From $41.00 at 6+ units</p>\\n          <p class=\\\"stock low\\\">● Low stock — 22 left</p>\\n          <button class=\\\"btn btn-primary btn-sm\\\" data-add=\\\"Cork Yoga Wheel\\\">Add to Cart</button>\\n        </div>\\n      </div>\\n    </div>\\n  </div>\\n</section>\\n\\n<!-- CATEGORIES -->\\n<section class=\\\"tight\\\" style=\\\"background:var(--cream);border-top:1px solid var(--line);border-bottom:1px solid var(--line)\\\">\\n  <div class=\\\"wrap\\\">\\n    <div class=\\\"section-head\\\"><h2>Shop by what you need</h2><p>400+ products, all stocked in our own warehouse.</p></div>\\n    <div class=\\\"cats\\\">\\n      <a class=\\\"cat t1\\\" href=\\\"/shop.html\\\"><b>Yoga Mats</b><span>1/8\\\" to 1/2\\\", 14 colors, bulk cases</span></a>\\n      <a class=\\\"cat t2\\\" href=\\\"/shop.html#props\\\"><b>Blocks &amp; Straps</b><span>Foam, cork, cotton — from $4.80</span></a>\\n      <a class=\\\"cat t3\\\" href=\\\"/shop.html#props\\\"><b>Bolsters &amp; Blankets</b><span>Restorative &amp; Yin essentials</span></a>\\n      <a class=\\\"cat t4\\\" href=\\\"/shop.html#bundles\\\"><b>Studio Bundles</b><span>Outfit a whole room and save 28%</span></a>\\n      <a class=\\\"cat t5\\\" href=\\\"/shop.html#props\\\"><b>Storage &amp; Racks</b><span>Mat racks, bins, prop shelving</span></a>\\n      <a class=\\\"cat t6\\\" href=\\\"/shop.html\\\"><b>Meditation</b><span>Zafus, cushions, benches</span></a>\\n      <a class=\\\"cat t2\\\" href=\\\"/shop.html#sale\\\"><b>Clearance</b><span>Up to 40% off overstock</span></a>\\n      <a class=\\\"cat t4\\\" href=\\\"/bulk-orders.html\\\"><b>Wholesale</b><span>Studios, schools, hotels, events</span></a>\\n    </div>\\n  </div>\\n</section>\\n\\n<!-- BULK -->\\n<section class=\\\"bulk\\\" id=\\\"bulk\\\">\\n  <div class=\\\"wrap bulk-grid\\\">\\n    <div>\\n      <span class=\\\"eyebrow\\\" style=\\\"background:rgba(255,255,255,.12);border-color:rgba(255,255,255,.25);color:#fff\\\">For studios, schools &amp; events</span>\\n      <h2>Outfitting a room? You'll pay up to 45% less.</h2>\\n      <p>Tell us what you need and a real person sends a written quote — usually within 4 business hours. No account setup, no minimums beyond 6 units.</p>\\n      <div class=\\\"tiers\\\">\\n        <div class=\\\"tier\\\"><b>-10%</b>6+ units</div>\\n        <div class=\\\"tier\\\"><b>-22%</b>12+ units</div>\\n        <div class=\\\"tier\\\"><b>-32%</b>20+ units</div>\\n        <div class=\\\"tier\\\"><b>-45%</b>Pallet / case</div>\\n      </div>\\n      <ul>\\n        <li>Free freight quotes &amp; consolidated shipping</li>\\n        <li>Net-30 terms for studios, schools and municipalities</li>\\n        <li>Custom logo printing on mats and bags</li>\\n        <li>Dedicated account rep — same person every time</li>\\n      </ul>\\n      <p style=\\\"font-size:.9rem\\\">Prefer to talk? Call <strong style=\\\"color:#fff\\\">1-800-598-9642</strong>, Mon–Fri 8am–5pm PT.</p>\\n    </div>\\n    <div class=\\\"form-card\\\">\\n      <h3>Get your bulk quote</h3>\\n      <p class=\\\"sub\\\">Takes 30 seconds. Written quote back within 4 business hours.</p>\\n      <form onsubmit=\\\"return quoteSent(event)\\\">\\n        <div class=\\\"two\\\">\\n          <div><label for=\\\"n\\\">Name</label><input id=\\\"n\\\" required placeholder=\\\"Jane Patel\\\"></div>\\n          <div><label for=\\\"e\\\">Email</label><input id=\\\"e\\\" type=\\\"email\\\" required placeholder=\\\"jane@studio.com\\\"></div>\\n        </div>\\n        <label for=\\\"org\\\">Studio / organization</label>\\n        <input id=\\\"org\\\" placeholder=\\\"Riverbend Yoga\\\">\\n        <div class=\\\"two\\\">\\n          <div><label for=\\\"q\\\">Approx. quantity</label>\\n            <select id=\\\"q\\\"><option>6–11 units</option><option selected>12–19 units</option><option>20–49 units</option><option>50+ / pallet</option></select>\\n          </div>\\n          <div><label for=\\\"w\\\">Needed by</label>\\n            <select id=\\\"w\\\"><option>ASAP</option><option>Within 2 weeks</option><option>This month</option><option>Just pricing for now</option></select>\\n          </div>\\n        </div>\\n        <label for=\\\"m\\\">What do you need?</label>\\n        <textarea id=\\\"m\\\" rows=\\\"2\\\" placeholder=\\\"e.g. 20 mats, 40 blocks, 20 straps\\\"></textarea>\\n        <button class=\\\"btn btn-primary btn-block\\\" type=\\\"submit\\\">Send Me My Quote</button>\\n        <p class=\\\"form-foot\\\">🔒 No spam, no obligation. We reply to 98% of quotes same day.</p>\\n      </form>\\n    </div>\\n  </div>\\n</section>\\n\\n<!-- REVIEWS -->\\n<section class=\\\"reviews\\\">\\n  <div class=\\\"wrap\\\">\\n    <div class=\\\"section-head\\\">\\n      <div class=\\\"stars\\\" style=\\\"font-size:1.3rem\\\">★★★★★</div>\\n      <h2>4.8 out of 5 from 38,000+ customers</h2>\\n      <p>Supplying the yoga community since 1999 — studios, teachers, schools, hotels and home practitioners.</p>\\n    </div>\\n    <div class=\\\"grid g3\\\">\\n      <div class=\\\"rev\\\">\\n        <div class=\\\"stars\\\">★★★★★</div>\\n        <p>“We outfitted two rooms — 44 mats, blocks and straps — for less than one room would have cost elsewhere. The quote came back the same afternoon.”</p>\\n        <p class=\\\"who\\\">— Marisa L., Studio Owner, Portland OR</p>\\n      </div>\\n      <div class=\\\"rev\\\">\\n        <div class=\\\"stars\\\">★★★★★</div>\\n        <p>“Third order in four years. Mats hold up to 20 classes a week and the pricing hasn't crept up like everyone else's.”</p>\\n        <p class=\\\"who\\\">— Dev R., Yoga Teacher, Austin TX</p>\\n      </div>\\n      <div class=\\\"rev\\\">\\n        <div class=\\\"stars\\\">★★★★★</div>\\n        <p>“Ordered the starter kit for my mom. Arrived in two days, great cushion, and the price felt almost too low for the quality.”</p>\\n        <p class=\\\"who\\\">— Kate B., Home Practitioner, Chicago IL</p>\\n      </div>\\n    </div>\\n    <div class=\\\"logos\\\">\\n      <span>Trusted by yoga studios</span><span>Schools &amp; universities</span><span>Hotels &amp; resorts</span><span>Corporate wellness</span><span>Physical therapy clinics</span><span>Retreat centers</span>\\n    </div>\\n  </div>\\n</section>\\n\\n<!-- GUARANTEE -->\\n<section>\\n  <div class=\\\"wrap\\\">\\n    <div class=\\\"section-head\\\"><h2>Buying from us is a safe bet</h2><p>Direct pricing shouldn't mean direct risk.</p></div>\\n    <div class=\\\"gua\\\">\\n      <div><b>30-day easy returns</b><p>Not the right mat? Send it back within 30 days for a refund. No restocking fee on stocked items.</p></div>\\n      <div><b>Fast, honest shipping</b><p>In-stock orders leave our warehouse in 1 business day. Free ground shipping on orders over $75.</p></div>\\n      <div><b>Talk to a real person</b><p>Call 1-800-598-9642 or email us — a US-based team member answers, Mon–Fri 8am–5pm PT.</p></div>\\n    </div>\\n  </div>\\n</section>\\n\\n<!-- EMAIL -->\\n<section class=\\\"email\\\">\\n  <div class=\\\"wrap\\\">\\n    <h2>Get 10% off your first order</h2>\\n    <p>Join 90,000 subscribers for restock alerts, new colors and members-only bulk deals. One email a week, unsubscribe anytime.</p>\\n    <form onsubmit=\\\"return signup(event)\\\">\\n      <input type=\\\"email\\\" required placeholder=\\\"you@email.com\\\" aria-label=\\\"Email address\\\">\\n      <button class=\\\"btn btn-primary\\\" type=\\\"submit\\\">Send My 10% Code</button>\\n    </form>\\n  </div>\\n</section>\\n\\n<!-- FAQ -->\\n<section>\\n  <div class=\\\"wrap\\\" style=\\\"max-width:820px\\\">\\n    <div class=\\\"section-head\\\"><h2>Questions before you buy</h2></div>\\n    <details open><summary>How much can I actually save on a bulk order?</summary><p>Discounts start at 6 units (10% off) and reach up to 45% off on full-case and pallet quantities. Because we manufacture and source our own goods, there's no distributor markup in between. <a href=\\\"#bulk\\\" style=\\\"color:var(--brand);font-weight:700\\\">Request a quote</a> and we'll show you exact pricing in writing.</p></details>\\n    <details><summary>When will my order ship and arrive?</summary><p>In-stock orders placed before 1pm PT ship the same or next business day from our US warehouse. Ground delivery typically lands in 2–5 business days. Freight and pallet orders receive a scheduled delivery window.</p></details>\\n    <details><summary>What if the mat isn't right for me?</summary><p>Return any stocked item within 30 days for a refund. If you're unsure which thickness to choose, call us — we'll recommend based on your floor type, class style and joint comfort.</p></details>\\n    <details><summary>Can you print our studio logo on mats or bags?</summary><p>Yes. Custom logo printing is available on mats, bags and straps, typically at 50+ units. Mention it in your quote request and we'll send artwork specs and pricing.</p></details>\\n    <details><summary>Do you offer Net-30 or purchase orders?</summary><p>We do, for established studios, schools, municipalities and corporate wellness programs. Tell us in your quote request and we'll set up terms.</p></details>\\n    <details><summary>Who is YogaDirect?</summary><p>Thanks to our loyal customers, YogaDirect has become one of the largest suppliers of yoga mats and props in the country. We have faithfully supplied the yoga community since 1999 and are confident we can help you grow your studio, event or personal practice. We manufacture and source our own goods, which is how we consistently offer high-quality yoga gear at amazing prices. From our team of yoga lovers to you — thank you.</p></details>\\n    <div style=\\\"text-align:center;margin-top:26px\\\">\\n      <a class=\\\"btn btn-primary\\\" href=\\\"#bestsellers\\\">Shop Best Sellers</a>\\n      <a class=\\\"btn btn-ghost\\\" href=\\\"/bulk-orders.html\\\">Bulk &amp; Wholesale</a>\\n    </div>\\n  </div>\\n</section>\\n\\n<footer>\\n  <div class=\\\"wrap\\\">\\n    <div class=\\\"fgrid\\\">\\n      <div>\\n        <div class=\\\"logo\\\" style=\\\"color:#fff\\\">Yoga<span>Direct</span></div>\\n        <p style=\\\"margin-top:10px\\\">Supplying the yoga community with mats, props and studio gear at manufacturer-direct prices since 1999.</p>\\n        <p><strong style=\\\"color:#fff\\\">1-800-598-9642</strong><br>Mon–Fri, 8am–5pm PT</p>\\n      </div>\\n      <div><h4>Shop</h4>\\n        <a href=\\\"/shop.html\\\">Yoga Mats</a><a href=\\\"/shop.html#props\\\">Blocks &amp; Straps</a><a href=\\\"/shop.html#props\\\">Bolsters &amp; Blankets</a><a href=\\\"/shop.html#bundles\\\">Studio Bundles</a><a href=\\\"/shop.html#sale\\\">Clearance</a>\\n      </div>\\n      <div><h4>Business</h4>\\n        <a href=\\\"/bulk-orders.html\\\">Bulk &amp; Wholesale</a><a href=\\\"/bulk-orders.html#custom\\\">Custom Logo Printing</a><a href=\\\"/bulk-orders.html\\\">Studio Outfitting</a><a href=\\\"/bulk-orders.html\\\">Net-30 &amp; POs</a>\\n      </div>\\n      <div><h4>Help</h4>\\n        <a href=\\\"#\\\">Shipping Info</a><a href=\\\"#\\\">Returns (30 days)</a><a href=\\\"#\\\">Track My Order</a><a href=\\\"#faq\\\">FAQ</a><a href=\\\"#\\\">Contact Us</a>\\n      </div>\\n    </div>\\n    <div class=\\\"fbot\\\">\\n      <span>© 1999–2025 YogaDirect. All rights reserved.</span>\\n      <div class=\\\"pay\\\"><span>VISA</span><span>MASTERCARD</span><span>AMEX</span><span>PAYPAL</span><span>NET-30</span><span>SSL SECURE</span></div>\\n    </div>\\n  </div>\\n</footer>\\n\\n<div class=\\\"mobar\\\">\\n  <a class=\\\"btn btn-ghost\\\" href=\\\"#bulk\\\">Bulk Quote</a>\\n  <a class=\\\"btn btn-primary\\\" href=\\\"#bestsellers\\\">Shop Best Sellers</a>\\n</div>\\n\\n<div class=\\\"toast\\\" id=\\\"toast\\\">Added to cart</div>\\n\\n<div class=\\\"modal\\\" id=\\\"promo\\\">\\n  <div class=\\\"modal-box\\\">\\n    <button class=\\\"xclose\\\" onclick=\\\"closePromo()\\\" aria-label=\\\"Close\\\">×</button>\\n    <div class=\\\"stars\\\" style=\\\"font-size:1.2rem\\\">★★★★★</div>\\n    <h3>Take 10% off your first order</h3>\\n    <p>Plus first access to restocks and members-only bulk deals. Outfitting a studio? Ask us for a written quote instead — we usually beat the discount.</p>\\n    <form onsubmit=\\\"return signup(event,true)\\\">\\n      <input type=\\\"email\\\" required placeholder=\\\"you@email.com\\\" aria-label=\\\"Email address\\\">\\n      <button class=\\\"btn btn-primary btn-block\\\" type=\\\"submit\\\">Email Me My Code</button>\\n    </form>\\n    <p class=\\\"tiny\\\">No spam. Unsubscribe in one click.</p>\\n  </div>\\n</div>\\n\\n<script>\\nvar count=0;\\ndocument.addEventListener('click',function(e){\\n  var b=e.target.closest('[data-add]');\\n  if(!b)return;\\n  count++;document.getElementById('cc').textContent=count;\\n  showToast('✓ '+b.getAttribute('data-add')+' added to cart');\\n});\\nfunction showToast(msg){var t=document.getElementById('toast');t.textContent=msg;t.classList.add('show');clearTimeout(window._tt);window._tt=setTimeout(function(){t.classList.remove('show')},2600);}\\nfunction quoteSent(e){e.preventDefault();e.target.innerHTML='<h3 style=\\\"font-family:Fraunces,serif\\\">Got it — quote on the way ✅</h3><p style=\\\"color:#4c5a55\\\">A real person is pricing this now. Expect a written quote within 4 business hours. Need it faster? Call <strong>1-800-598-9642</strong>.</p>';return false;}\\nfunction signup(e,modal){e.preventDefault();showToast('✓ Check your inbox for your 10% code');if(modal)closePromo();else e.target.reset();return false;}\\nfunction closePromo(){document.getElementById('promo').classList.remove('show');try{sessionStorage.setItem('yd_promo','1')}catch(x){}}\\nsetTimeout(function(){try{if(sessionStorage.getItem('yd_promo'))return}catch(x){}document.getElementById('promo').classList.add('show');},18000);\\n</script>\\n</body>\\n</html>\"},{\"path\":\"/shop.html\",\"html\":\"<!DOCTYPE html>\\n<html lang=\\\"en\\\">\\n<head>\\n<meta charset=\\\"utf-8\\\">\\n<meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1\\\">\\n<title>Shop Yoga Mats, Blocks, Straps &amp; Studio Bundles | YogaDirect</title>\\n<meta name=\\\"description\\\" content=\\\"Shop 400+ yoga mats, blocks, straps, bolsters, blankets and studio bundles at manufacturer-direct prices. Free shipping over $75, 30-day returns, bulk discounts from 6 units.\\\">\\n<link rel=\\\"preconnect\\\" href=\\\"https://fonts.googleapis.com\\\">\\n<link href=\\\"https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Fraunces:wght@500;700&display=swap\\\" rel=\\\"stylesheet\\\">\\n<style>\\n:root{--ink:#1d2321;--ink-soft:#4c5a55;--line:#e4e1d9;--cream:#faf8f4;--brand:#0f5c4d;--brand-dark:#0a453a;--accent:#e2703a;--accent-dark:#c85a26;--gold:#f4b942;--radius:14px;--shadow:0 6px 24px rgba(20,40,35,.10);--shadow-lg:0 18px 50px rgba(20,40,35,.18)}\\n*{box-sizing:border-box}html{scroll-behavior:smooth}\\nbody{margin:0;font-family:'DM Sans',-apple-system,Helvetica,Arial,sans-serif;color:var(--ink);background:#fff;line-height:1.6}\\nh1,h2,h3{font-family:'Fraunces',Georgia,serif;line-height:1.15;margin:0 0 .5em}\\nh1{font-size:clamp(1.9rem,4vw,2.8rem)}h2{font-size:clamp(1.5rem,2.6vw,2.1rem)}\\np{margin:0 0 1em}a{color:inherit;text-decoration:none}\\n.wrap{max-width:1200px;margin:0 auto;padding:0 20px}\\n.btn{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;font-weight:700;font-size:1rem;padding:15px 28px;border-radius:999px;border:2px solid transparent;cursor:pointer;transition:.18s;font-family:inherit;text-align:center}\\n.btn-primary{background:var(--accent);color:#fff;box-shadow:0 6px 18px rgba(226,112,58,.32)}.btn-primary:hover{background:var(--accent-dark);transform:translateY(-2px)}\\n.btn-dark{background:var(--brand);color:#fff}.btn-dark:hover{background:var(--brand-dark)}\\n.btn-ghost{background:transparent;color:var(--brand);border-color:var(--brand)}.btn-ghost:hover{background:var(--brand);color:#fff}\\n.btn-sm{padding:11px 18px;font-size:.92rem}.btn-block{width:100%}\\n.announce{background:var(--brand);color:#fff;font-size:.87rem;text-align:center;padding:9px 16px;font-weight:500}.announce strong{color:var(--gold)}.announce a{text-decoration:underline}\\nheader.site{position:sticky;top:0;z-index:60;background:rgba(255,255,255,.97);backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}\\n.hrow{display:flex;align-items:center;gap:24px;padding:14px 0}\\n.logo{font-family:'Fraunces',serif;font-weight:700;font-size:1.5rem;color:var(--brand);white-space:nowrap}.logo span{color:var(--accent)}\\nnav.main{display:flex;gap:22px;font-weight:500;font-size:.97rem;flex:1}nav.main a:hover{color:var(--accent)}\\n.badge-sale{background:#fdecdf;color:var(--accent-dark);font-size:.7rem;font-weight:700;padding:2px 7px;border-radius:99px;margin-left:4px}\\n.hactions{display:flex;align-items:center;gap:14px;font-size:.9rem;font-weight:600}\\n.hphone{color:var(--ink-soft);display:none}.hphone strong{color:var(--brand)}\\n.cart{display:inline-flex;align-items:center;gap:6px;background:var(--cream);border:1px solid var(--line);padding:9px 15px;border-radius:999px}\\n.cart-count{background:var(--accent);color:#fff;border-radius:99px;min-width:20px;height:20px;font-size:.75rem;display:inline-flex;align-items:center;justify-content:center;padding:0 5px}\\n.burger{display:none;background:none;border:0;font-size:1.5rem;cursor:pointer;color:var(--brand)}\\n@media(min-width:1000px){.hphone{display:block}}\\n@media(max-width:999px){nav.main{display:none;position:absolute;top:100%;left:0;right:0;background:#fff;flex-direction:column;padding:12px 20px 20px;border-bottom:1px solid var(--line);box-shadow:var(--shadow)}nav.main.open{display:flex}.burger{display:block;order:-1}}\\n.pagehead{background:linear-gradient(160deg,#f3f7f4,#fdf1e9);border-bottom:1px solid var(--line);padding:44px 0}\\n.crumbs{font-size:.85rem;color:var(--ink-soft);margin-bottom:10px}\\n.pagehead p{color:var(--ink-soft);max-width:62ch;margin:0}\\n.badges{display:flex;gap:16px;flex-wrap:wrap;margin-top:18px;font-size:.88rem;font-weight:600;color:var(--brand)}\\nsection{padding:52px 0}\\n.head-row{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:24px;flex-wrap:wrap}\\n.head-row p{margin:0;color:var(--ink-soft)}\\n.grid{display:grid;gap:22px}.g4{grid-template-columns:repeat(4,1fr)}.g3{grid-template-columns:repeat(3,1fr)}\\n@media(max-width:980px){.g4,.g3{grid-template-columns:repeat(2,1fr)}}\\n@media(max-width:560px){.g4,.g3{grid-template-columns:1fr}}\\n.card{background:#fff;border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;display:flex;flex-direction:column;transition:.18s}\\n.card:hover{box-shadow:var(--shadow-lg);transform:translateY(-3px)}\\n.thumb{aspect-ratio:1/1;position:relative;display:flex;align-items:center;justify-content:center;font-size:3rem}\\n.t1{background:linear-gradient(135deg,#e7f0ec,#cfe3dc)}.t2{background:linear-gradient(135deg,#fdeee4,#f6d9c4)}.t3{background:linear-gradient(135deg,#eceaf5,#d8d4ee)}.t4{background:linear-gradient(135deg,#eaf1f6,#cddfeb)}.t5{background:linear-gradient(135deg,#f4f1e5,#e6dfc7)}.t6{background:linear-gradient(135deg,#f6e9ec,#eacfd6)}\\n.flag{position:absolute;top:12px;left:12px;background:var(--brand);color:#fff;font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em;padding:5px 10px;border-radius:99px}\\n.flag.hot{background:var(--accent)}.flag.value{background:#2f6f8f}\\n.card-body{padding:16px 16px 18px;display:flex;flex-direction:column;flex:1;gap:6px}\\n.card-body h3{margin:0;font-size:1.03rem;font-family:'DM Sans',sans-serif;font-weight:700}\\n.stars{color:var(--gold);letter-spacing:2px}\\n.rate{font-size:.82rem;color:var(--ink-soft);letter-spacing:0}\\n.blurb{font-size:.87rem;color:var(--ink-soft);margin:0}\\n.pricerow{display:flex;align-items:baseline;gap:9px}\\n.price{font-size:1.25rem;font-weight:700}.was{color:#8e9a95;text-decoration:line-through;font-size:.92rem}\\n.save{background:#fdecdf;color:var(--accent-dark);font-weight:700;font-size:.76rem;padding:3px 8px;border-radius:99px}\\n.bulknote{font-size:.8rem;color:var(--brand);font-weight:600}\\n.stock{font-size:.8rem;color:#1b7a4b;font-weight:600}.stock.low{color:var(--accent-dark)}\\n.card .btn,.card .btn-sm{margin-top:auto}\\n.tierbar{background:var(--cream);border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:26px 0}\\n.tierbar .in{display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap}\\n.tiers{display:flex;gap:10px;flex-wrap:wrap}\\n.tier{background:#fff;border:1px solid var(--line);border-radius:10px;padding:10px 16px;font-size:.84rem;color:var(--ink-soft)}\\n.tier b{display:block;color:var(--brand);font-family:'Fraunces',serif;font-size:1.1rem}\\n.gua{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}\\n@media(max-width:820px){.gua{grid-template-columns:1fr}}\\n.gua div{border:1px solid var(--line);border-radius:var(--radius);padding:22px}\\n.gua b{display:block;font-family:'Fraunces',serif;font-size:1.1rem;margin-bottom:6px}\\n.gua p{margin:0;color:var(--ink-soft);font-size:.92rem}\\nfooter{background:#12201c;color:#b9c8c3;font-size:.9rem;padding:52px 0 28px}\\n.fgrid{display:grid;grid-template-columns:1.3fr 1fr 1fr 1fr;gap:30px}\\n@media(max-width:840px){.fgrid{grid-template-columns:1fr 1fr}}\\nfooter h4{color:#fff;font-family:'DM Sans',sans-serif;font-size:.85rem;letter-spacing:.08em;text-transform:uppercase;margin-bottom:12px}\\nfooter a{display:block;padding:4px 0}footer a:hover{color:#fff}\\n.fbot{border-top:1px solid #26362f;margin-top:34px;padding-top:18px;display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap;font-size:.82rem}\\n.pay{display:flex;gap:8px;flex-wrap:wrap}.pay span{background:#1c2c27;border-radius:6px;padding:4px 9px;font-size:.72rem;font-weight:700;color:#cfe3dc}\\n.mobar{position:fixed;left:0;right:0;bottom:0;z-index:70;background:#fff;border-top:1px solid var(--line);padding:10px 14px;display:none;gap:10px;box-shadow:0 -6px 20px rgba(0,0,0,.08)}\\n.mobar .btn{flex:1;padding:13px 10px;font-size:.93rem}\\n@media(max-width:768px){.mobar{display:flex}body{padding-bottom:74px}}\\n.toast{position:fixed;bottom:20px;left:50%;transform:translate(-50%,140%);background:var(--brand);color:#fff;padding:13px 22px;border-radius:99px;font-weight:600;z-index:120;transition:.3s;box-shadow:var(--shadow-lg)}\\n.toast.show{transform:translate(-50%,0)}@media(max-width:768px){.toast{bottom:86px}}\\n.helpcta{background:var(--brand);color:#fff;border-radius:var(--radius);padding:34px;display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap}\\n.helpcta h2{color:#fff;margin:0 0 6px}.helpcta p{color:#cfe3dc;margin:0}\\n</style>\\n</head>\\n<body>\\n\\n<div class=\\\"announce\\\">🚚 <strong>FREE shipping on orders over $75</strong> &nbsp;•&nbsp; Bulk discounts auto-applied from 6 units &nbsp;•&nbsp; <a href=\\\"/bulk-orders.html\\\">Get a same-day quote</a></div>\\n\\n<header class=\\\"site\\\">\\n  <div class=\\\"wrap hrow\\\">\\n    <button class=\\\"burger\\\" aria-label=\\\"Menu\\\" onclick=\\\"document.getElementById('nav').classList.toggle('open')\\\">☰</button>\\n    <a class=\\\"logo\\\" href=\\\"/index.html\\\">Yoga<span>Direct</span></a>\\n    <nav class=\\\"main\\\" id=\\\"nav\\\">\\n      <a href=\\\"#mats\\\">Yoga Mats</a>\\n      <a href=\\\"#props\\\">Props</a>\\n      <a href=\\\"#bundles\\\">Studio Bundles</a>\\n      <a href=\\\"/bulk-orders.html\\\">Bulk &amp; Wholesale</a>\\n      <a href=\\\"#sale\\\">Sale<span class=\\\"badge-sale\\\">Up to 40%</span></a>\\n    </nav>\\n    <div class=\\\"hactions\\\">\\n      <span class=\\\"hphone\\\">Talk to a human: <strong>1-800-598-9642</strong></span>\\n      <a class=\\\"cart\\\" href=\\\"#\\\">🛒 <span class=\\\"cart-count\\\" id=\\\"cc\\\">0</span></a>\\n    </div>\\n  </div>\\n</header>\\n\\n<div class=\\\"pagehead\\\">\\n  <div class=\\\"wrap\\\">\\n    <div class=\\\"crumbs\\\"><a href=\\\"/index.html\\\">Home</a> / Shop All</div>\\n    <h1>Shop yoga gear direct from the source</h1>\\n    <p>400+ mats, props and studio essentials — manufactured and sourced by us, stocked in our own US 
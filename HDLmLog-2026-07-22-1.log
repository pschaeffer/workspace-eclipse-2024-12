ga+Blocks\\\" alt=\\\"Cork Yoga Block Set\\\">\\n      <div class=\\\"product-name\\\">Cork Yoga Block Set (2-Pack)</div>\\n    </a>\\n    <div class=\\\"product-price\\\">$19.99</div>\\n    <div class=\\\"product-actions HDLmClass535d9aab\\\">\\n      <button class=\\\"btn-add-to-cart HDLmClass535d9aab\\\" type=\\\"button\\\" data-product=\\\"cork-yoga-block-set\\\" onclick=\\\"addToCart('cork-yoga-block-set')\\\">Add to Cart</button>\\n    </div>\\n  </div>\\n\\n  <div class=\\\"product-card\\\">\\n    <a class=\\\"product-link\\\" href=\\\"/products/cotton-yoga-strap\\\">\\n      <img src=\\\"https://via.placeholder.com/230x180.png?text=Yoga+Strap\\\" alt=\\\"Cotton Yoga Strap\\\">\\n      <div class=\\\"product-name\\\">Cotton Yoga Strap - 8ft</div>\\n    </a>\\n    <div class=\\\"product-price\\\">$9.99</div>\\n    <div class=\\\"product-actions HDLmClass535d9aab\\\">\\n      <button class=\\\"btn-add-to-cart HDLmClass535d9aab\\\" type=\\\"button\\\" data-product=\\\"cotton-yoga-strap\\\" onclick=\\\"addToCart('cotton-yoga-strap')\\\">Add to Cart</button>\\n    </div>\\n  </div>\\n\\n  <div class=\\\"product-card\\\">\\n    <a class=\\\"product-link\\\" href=\\\"/products/round-yoga-bolster\\\">\\n      <img src=\\\"https://via.placeholder.com/230x180.png?text=Yoga+Bolster\\\" alt=\\\"Round Yoga Bolster\\\">\\n      <div class=\\\"product-name\\\">Round Meditation Bolster</div>\\n    </a>\\n    <div class=\\\"product-price\\\">$44.99</div>\\n    <div class=\\\"product-actions HDLmClass535d9aab\\\">\\n      <button class=\\\"btn-add-to-cart HDLmClass535d9aab\\\" type=\\\"button\\\" data-product=\\\"round-yoga-bolster\\\" onclick=\\\"addToCart('round-yoga-bolster')\\\">Add to Cart</button>\\n    </div>\\n  </div>\\n\\n  <div class=\\\"product-card\\\">\\n    <a class=\\\"product-link\\\" href=\\\"/products/yoga-blanket\\\">\\n      <img src=\\\"https://via.placeholder.com/230x180.png?text=Yoga+Blanket\\\" alt=\\\"Mexican Yoga Blanket\\\">\\n      <div class=\\\"p
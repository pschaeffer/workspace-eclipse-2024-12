.05em;margin:8px 0;}.product-card .price{color:#e67e22;font-weight:bold;margin-bottom:10px;}.add-to-cart{background:#2f4f3f;color:#fff;border:none;padding:8px 16px;border-radius:4px;cursor:pointer;}.add-to-cart:hover{background:#1e3529;}.trust-badges{display:flex;justify-content:center;gap:30px;flex-wrap:wrap;padding:20px;background:#fff;border-top:1px solid #eee;border-bottom:1px solid #eee;}.trust-badge{text-align:center;font-size:0.9em;color:#555;max-width:150px;}.about-us{background:#fff;border:1px solid #e0e0e0;border-radius:10px;padding:30px 30px;box-shadow:0 2px 6px rgba(0,0,0,0.04);}.about-us h2{color:#2f4f3f;font-size:1.7em;margin-bottom:15px;text-align:center;}.about-us p{font-size:1.05em;line-height:1.7;max-width:850px;margin:0 auto;text-align:center;color:#444;}.newsletter{background:#2f4f3f;color:#fff;text-align:center;padding:30px 20px;border-radius:8px;}.newsletter h2{margin-bottom:10px;}.newsletter form{margin-top:15px;}.newsletter input[type=email]{padding:10px;width:250px;border:none;border-radius:4px 0 0 4px;}.newsletter button{padding:10px 20px;border:none;background:#e67e22;color:#fff;border-radius:0 4px 4px 0;cursor:pointer;font-weight:bold;}.newsletter button:hover{background:#cf6d1a;}footer{background:#222;color:#ccc;text-align:center;padding:20px;font-size:0.9em;}</style></head><body><header class=\\\"HDLmClass7f3a2b1c\\\"><h1>YogaDirect</h1><p>Your trusted source for yoga mats and props since 1999</p></header><nav class=\\\"HDLmClass7f3a2b1c\\\"><a href=\\\"#featured\\\">Shop Featured</a><a href=\\\"#about\\\">About Us</a><a href=\\\"#newsletter\\\">Newsletter</a><a href=\\\"#\\\">Contact</a></nav><div class=\\\"hero HDLmClass9d4e6f21\\\"><h1>Premium Yoga Gear at Prices You'll Love</h1><p>We manufacture and source our own goods so you get high-quality mats, blocks, and props without the markup. Trusted by the Yoga community for over 25 years.</p><a href=\\\"#featured\\\" class=\\\"cta-button HDLmClass9d4e6f21\\\">Shop Best Sellers Now</a></
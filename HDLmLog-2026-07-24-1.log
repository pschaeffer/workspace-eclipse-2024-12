r; }\\n  .product-card img { max-width: 100%; height: 180px; object-fit: cover; margin-bottom: 10px; }\\n  .product-card h3 { font-size: 16px; margin: 10px 0 5px; }\\n  .product-card .price { color: #6a1b9a; font-weight: bold; margin-bottom: 10px; }\\n  .about-section { background: #fafafa; padding: 50px 20px; text-align: center; }\\n  .about-section p { max-width: 800px; margin: 0 auto; font-size: 16px; line-height: 1.6; }\\n\\n  /* Newsletter Signup Section */\\n  .newsletter-signup { background: #6a1b9a; color: #fff; padding: 50px 20px; text-align: center; }\\n  .newsletter-signup h2 { font-size: 26px; margin-bottom: 10px; }\\n  .newsletter-signup .subtext { font-size: 16px; margin-bottom: 20px; opacity: 0.95; }\\n  .newsletter-signup form { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; max-width: 600px; margin: 0 auto; }\\n  .newsletter-signup input[type=\\\"text\\\"],\\n  .newsletter-signup input[type=\\\"email\\\"] {\\n    padding: 12px 14px; border-radius: 4px; border: none; font-size: 15px; flex: 1; min-width: 180px;\\n  }\\n  .newsletter-signup button {\\n    background: #ffca28; color: #4a148c; border: none; padding: 12px 24px; border-radius: 4px; font-weight: bold; font-size: 15px; cursor: pointer;\\n  }\\n  .newsletter-signup .incentive-text {\\n    font-size: 20px; font-weight: bold; color: #ffca28; margin-bottom: 15px;\\n  }\\n  .newsletter-signup .privacy-text {\\n    font-size: 13px; opacity: 0.85; margin-top: 12px;\\n  }\\n  footer { background: #212121; color: #ccc; padding: 30px 20px; text-align: center; font-size: 13px; }\\n  footer a { color: #ccc; }\\n</style>\\n</head>\\n<body>\\n\\n<header>\\n  <div class=\\\"logo\\\">YogaDirect</div>\\n  <nav>\\n    <ul>\\n      <li><a href=\\\"/yoga-mats\\\">Yoga Mats</a></li>\\n      <li><a href=\\\"/yoga-props\\\">Props</a></li>\\n      <li><a href=\\\"/yoga-apparel\\\">Apparel</a></li>\\n      <li><a href=\\\"/yoga-bags\\\">Bags</a></li>\\n      <li><a href=\\\"/sale\\\">Sale</a></l
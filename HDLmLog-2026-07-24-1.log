inline: auto;\n    }\n\n    .benefits {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 1px;\n      background: var(--line);\n      border-bottom: 1px solid var(--line);\n      text-align: center;\n    }\n\n    .benefit {\n      padding: 18px 12px;\n      background: var(--cream);\n    }\n\n    .benefit strong,\n    .benefit span {\n      display: block;\n    }\n\n    .benefit strong {\n      font-size: .78rem;\n      letter-spacing: .12em;\n      color: var(--accent);\n    }\n\n    .benefit span {\n      margin-top: 4px;\n      font-weight: 700;\n    }\n\n    header {\n      border-bottom: 1px solid var(--line);\n      background: #fff;\n    }\n\n    .header-inner {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 20px;\n      min-height: 82px;\n    }\n\n    .brand {\n      text-decoration: none;\n      font-size: 1.55rem;\n      font-weight: 800;\n      letter-spacing: .02em;\n    }\n\n    .header-links {\n      display: flex;\n      gap: 20px;\n      font-size: .95rem;\n    }\n\n    .header-links a:hover {\n      color: var(--accent);\n    }\n\n    .hero {\n      padding: 72px 20px;\n      text-align: center;\n      background:\n        linear-gradient(90deg, rgba(247,242,236,.97), rgba(247,242,236,.82)),\n        #f7f2ec;\n    }\n\n    .hero h1 {\n      max-width: 760px;\n      margin: 0 auto 14px;\n      font-size: clamp(2rem, 5vw, 4rem);\n      line-height: 1.08;\n    }\n\n    .hero p {\n      max-width: 650px;\n      margin: 0 auto 28px;\n      color: var(--muted);\n      font-size: 1.1rem;\n    }\n\n    .button {\n      display: inline-block;\n      padding: 13px 22px;\n      border-radius: 3px;\n      background: var(--accent);\n      color: #fff;\n      font-weight: 700;\n      text-decoration: none;\n      margin: 4px;\n    }\n\n    .button:hover {\n      background: var(--accent-dark);\n    }\n\n    .button.secondary {\n      background: transparent;\n      color: var(--accent);\n      border: 1px solid var(--accent);\n    }\n\n    section {\n      padding: 52px 0;\n    }\n\n    .section-heading {\n      margin: 0 0 26px;\n      text-align: center;\n      font-size: 2rem;\n    }\n\n    .category-grid {\n      display: grid;\n      grid-template-columns: repeat(4, 1fr);\n      gap: 16px;\n    }\n\n    .category-card {\n      min-height: 150px;\n      display: flex;\n      flex-direction: column;\n      justify-content: flex-end;\n      padding: 22px;\n      text-decoration: none;\n      background: var(--cream);\n      border: 1px solid var(--line);\n      font-size: 1.35rem;\n      font-weight: 700;\n    }\n\n    .category-card:hover {\n      border-color: var(--accent);\n      color: var(--accent);\n    }\n\n    .category-card small {\n      margin-top: 8px;\n      font-size: .9rem;\n      font-weight: 400;\n      color: var(--accent);\n    }\n\n    .catalog-header {\n      display: flex;\n      justify-content: space-between;\n      align-items: end;\n      gap: 20px;\n      margin-bottom: 24px;\n    }\n\n    .catalog-header .section-heading {\n      margin: 0;\n      text-align: left;\n    }\n\n    .trust-note {\n      color: var(--muted);\n      font-size: .95rem;\n      text-align: right;\n    }\n\n    .product-grid {\n      display: grid;\n      grid-template-columns: repeat(4, 1fr);\n      gap: 22px;\n    }\n\n    .product-card {\n      position: relative;\n      display: flex;\n      flex-direction: column;\n      min-width: 0;\n    }\n\n    .product-image {\n      display: grid;\n      place-items: center;\n      min-height: 190px;\n      margin-bottom: 14px;\n      background: #f5f5f3;\n      color: var(--muted);\n      font-size: .9rem;\n    }\n\n    .product-card h3 {\n      margin: 0 0 8px;\n      font-size: 1rem;\n      line-height: 1.35;\n    }\n\n    .stock {\n      color: #39754e;\n      font-size: .85rem;\n      font-weight: 700;\n    }\n\n    .stock.out {\n      color: #9b4d35;\n    }\n\n    .rating {\n      color: #9b6c2f;\n      font-size: .9rem;\n    }\n\n    .price {\n      margin: 8px 0 14px;\n      font-weight: 700;\n    }\n\n    .old-price {\n      margin-right: 6px;\n      color: var(--muted);\n      text-decoration: line-through;\n      font-weight: 400;\n    }\n\n    .sale {\n      color: var(--accent);\n      font-size: .8rem;\n      text-transform: uppercase;\n      letter-spacing: .08em;\n    }\n\n    .select-options {\n      width: 100%;\n      margin-top: auto;\n      padding: 10px;\n      border: 1px solid var(--accent);\n      background: #fff;\n      color: var(--accent);\n      font-weight: 700;\n      cursor: pointer;\n    }\n\n    .select-options:hover {\n      background: var(--accent);\n      color: #fff;\n    }\n\n    .signup {\n      margin: 12px auto 0;\n      padding: 30px;\n      max-width: 760px;\n      text-align: center;\n      background: var(--cream);\n      border: 1px solid var(--line);\n    }\n\n    .signup h2 {\n      margin: 0 0 6px;\n    }\n\n    .signup p {\n      margin: 0 0 18px;\n      color: var(--muted);\n    }\n\n    .signup form {\n      display: flex;\n      max-width: 560px;\n      margin: auto;\n    }\n\n    .signup input {\n      flex: 1;\n      min-width: 0;\n      padding: 13px;\n      border: 1px solid #cfc5bc;\n      font: inherit;\n    }\n\n    .signup button {\n      border: 0;\n      padding: 13px 20px;\n      background: var(--accent);\n      color: #fff;\n      font-weight: 700;\n      cursor: pointer;\n    }\n\n    .custom-printing {\n      text-align: center;\n      background: var(--cream);\n    }\n\n    .about {\n      max-width: 850px;\n      margin: auto;\n      text-align: center;\n    }\n\n    .about h2 {\n      font-size: 1.8rem;\n    }\n\n    footer {\n      padding: 42px 0;\n      border-top: 1px solid var(--line);\n      background: #f8f8f7;\n    }\n\n    footer h2 {\n      font-size: 1rem;\n    }\n\n    .footer-links {\n      display: grid;\n      grid-template-columns: repeat(4, 1fr);\n      gap: 8px 2